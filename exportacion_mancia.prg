OPEN DATABASE .\agilsoft_001\masterdb
SELECT a.idpartida as iddocto FROM ctbpartidasdeta a INNER JOIN ctbcuentas b ON a.idcuenta=b.idcuenta WHERE SUBSTR(b.codcta,1,1)='4' INTO CURSOR origen
SELECT 1 as codigo_empresa,a.iddocto as indice,a.iddoctod as correlativo,b.fechadocto as fecha_documento,c.codprod as codigo_gasto,a.producto as nombre_producto,a.costototal as precio,totaliva as iva,totalgravado as total_gravado,0.0 as fovial,0.0 as cotrans,0.0 as cesc FROM cyvcomprasdeta a INNER JOIN cyvcompras b ON a.iddocto=b.iddocto AND b.anulado=0 INNER JOIN invproductos c ON a.idproducto=c.idproducto WHERE a.eliminado=0 AND a.iddocto in (SELECT iddocto FROM origen) ORDER BY a.iddocto,a.iddoctod INTO CURSOR gastos_detalle
COPY TO d:\gde TYPE xl5
SELECT 1 as codigo_empresa,a.iddocto as indice,SUBSTR(a.periodo,5,2)+SUBSTR(a.periodo,1,4) as periodo,IIF(a.condipago=0,'CO','CR') as b_forma_p,a.fechadocto as fecha_documento,c.codclipro as codigo_proveedor,a.clipro,a.direccion,b.cod as codigo_departamento,a.nit,a.nrc,a.giro,a.numero as numero_documento,' ' as concepto,a.gravadodocto as gravada,a.exentodocto as exenta,nosujetodocto as nosujeta,a.ivadocto as iva,a.retperdocto as retencion_iva,a.totaldocto as monto_total,'CER' codigo_estado_movimiento,0000000000.00 as fovial,0000000000.00 cotrans,a.cescdocto as cesc  FROM cyvcompras a INNER JOIN siscata b ON a.iddepto=b.id INNER JOIN cyvclipro c ON a.idclipro=c.idclipro WHERE a.anulado=0 AND a.iddocto in (SELECT iddocto FROM origen) ORDER BY a.fechadocto,a.numero INTO CURSOR gastos_encabezado
COPY TO d:\gen TYPE xl5
SELECT 1 as codigo_empresa,SUBSTR(a.periodo,5,2)+SUBSTR(a.periodo,1,4) as periodo,a.idpartida as correlativo,b.cod as tipo_partida,a.fechapartida as fecha,a.numeropartida as numero,a.concepto as descripcion,1 as b_estado,c.usuario as codigo_usuario FROM ctbpartidas a INNER JOIN siscata b ON a.idtipopar=b.id INNER JOIN sisusuarios c ON a.iduser=c.idusuario WHERE a.idpartida in (SELECT iddocto FROM origen) ORDER BY a.fechapartida,a.numeropartida INTO CURSOR partidas_encabezado READWRITE
COPY TO d:\pen TYPE xl5
SELECT 1 as codigo_empresa,SUBSTR(a.periodo,5,2)+SUBSTR(a.periodo,1,4) as periodo,a.idpartidad as correlativo,a.idpartida as transaccion,c.codcta cuenta,c.cuenta as descripcion,a.conceptod as concepto,a.debe as cargo,a.haber as abono,b.cod as tipo_partida,' ' as codigo_proyecto,IIF(ISNULL(x.codcajban),m.codcajban,x.codcajban) as codigo_caja FROM ctbpartidasdeta a INNER JOIN ctbpartidas z ON a.idpartida=z.idpartida INNER JOIN siscata b ON z.idtipopar=b.id INNER JOIN ctbcuentas c ON a.idcuenta=c.idcuenta LEFT JOIN cyvcompras e ON a.idpartida=e.iddocto LEFT JOIN cybmovimientos y ON a.idpartida=y.iddocto LEFT JOIN cybcajabancos x ON e.idcajban=x.idcajban LEFT JOIN cybcajabancos m ON y.idcajban=m.idcajban WHERE a.idpartida in (SELECT iddocto FROM origen) ORDER BY a.idpartida,c.codcta INTO CURSOR partidas_detalle READWRITE
COPY TO d:\pde TYPE xl5