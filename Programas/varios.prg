FUNCTION _SincronizaSistema(lcmoduloacargar as Integer)

		***********************************
		******* Sucursal (punto de venta en disalcomb)
	IF lcmoduloacargar=1
		WAIT WINDOW "Sincronizando SUCURSALES (PUNTOS DE VENTA)..." NOWAIT 
		USE pcsysdir+pcDB+"\siscata" IN 0 SHARED AGAIN 
		USE pcPTVDisalRuta+'facturacion\t_puntos_venta' IN 0 SHARED AGAIN ALIAS t_PVT

		SELECT 000000000 as id,pvt_codigo,pvt_descripcion FROM t_PVT ;
				WHERE pvt_empresa=pcPTVDisalEmpre AND pvt_codigo NOT in ;
					(SELECT cod FROM siscata WHERE origen='PTV' ) ;
		UNION ALL ;
			SELECT 000000001 as id,pvt_codigo,pvt_descripcion FROM t_PVT ;
				WHERE pvt_empresa=pcPTVDisalEmpre AND pvt_codigo in ;
					(SELECT cod FROM siscata WHERE origen='PTV' ) ;
		INTO CURSOR c_PVT READWRITE 
		REPLACE id WITH _SiguienteIdTabla(pcNodo,"MAS") FOR id=0  
		
		UPDATE siscata SET siscata.nombre=c_PVT.pvt_descripcion ,;
							siscata.fecmod=ldfec, ;
							siscata.nodo=pcnodo, ;
							siscata.iduser=pnIdUsuario, ;
							siscata.pcuser=SYS(0) ;
			from c_PVT WHERE siscata.cod=c_PVT.pvt_codigo AND siscata.origen='SUC' 
		
		INSERT INTO siscata (id,origen,cod,nombre,tipo,eliminado,status,fecalta,fecmod,nodo,iduser,pcuser) ;
			SELECT id,'PTV',pvt_codigo,pvt_descripcion,0,0,1,ldfec,ldfec,;
				pcnodo,pnIdUsuario,SYS(0) ;
			FROM c_PVT WHERE id<>1 
		
		USE IN c_PVT
		USE IN siscata
		USE IN t_PVT	
	ENDIF 
	
	
	***********************************
	******* Centro de Costo (Sucursal en disalcomb)
	IF lcmoduloacargar=2
		WAIT WINDOW "Sincronizando CENTRO DE COSTO (sucursal)..." NOWAIT 
		USE pcsysdir+pcDB+"\siscata" IN 0 SHARED AGAIN 
		USE pcPTVDisalRuta+'facturacion\sucursal' IN 0 SHARED AGAIN ALIAS t_CCO

		SELECT 000000000 as id,cod,nom,direc FROM t_CCO ;
				WHERE cod NOT in ;
					(SELECT cod FROM siscata WHERE origen='CCO') ;
		UNION ALL ;
			SELECT 000000001 as id,cod,nom,direc FROM t_CCO ;
				WHERE cod in ;
					(SELECT cod FROM siscata WHERE origen='CCO') ;
		INTO CURSOR c_CCO READWRITE 
		REPLACE id WITH _SiguienteIdTabla(pcNodo,"MAS") FOR id=0  
		
		UPDATE siscata SET siscata.nombre=c_CCO.nom, ;
							siscata.notas=c_CCO.direc, ;
							siscata.fecmod=ldfec, ;
							siscata.nodo=pcnodo, ;
							siscata.iduser=pnIdUsuario, ;
							siscata.pcuser=SYS(0) ;
			from c_CCO WHERE siscata.cod=c_CCO.cod AND siscata.origen='CCO' 
		
		INSERT INTO siscata (id,origen,cod,nombre,tipo,idpadre,notas,ctainvent,ctacosvta,;
					ctaingvta,eliminado,status,fecalta,fecmod,nodo,iduser,pcuser) ;
			SELECT id,'CCO',cod,nom,0,0,direc,0,0,0,0,1,ldfec,ldfec,;
				pcnodo,pnIdUsuario,SYS(0) ;
			FROM c_CCO WHERE id<>1 
		
		USE IN c_CCO
		USE IN siscata
		USE IN t_CCO
	ENDIF 
	
	
	***********************************
	******* Bodegas 
	IF lcmoduloacargar=3
		WAIT WINDOW "Sincronizando BODEGAS ..." NOWAIT 
		USE pcsysdir+pcDB+"\siscata" IN 0 SHARED AGAIN 
		USE pcPTVDisalRuta+'facturacion\t_bodegas' IN 0 SHARED AGAIN ALIAS t_BOD

		SELECT 000000000 as id,BOD_codigo,BOD_descripcion FROM t_BOD ;
				WHERE BOD_empresa=pcPTVDisalEmpre AND BOD_codigo NOT in ;
					(SELECT cod FROM siscata WHERE origen='BOD' ) ;
		UNION ALL ;
			SELECT 000000001 as id,BOD_codigo,BOD_descripcion FROM t_BOD ;
				WHERE BOD_empresa=pcPTVDisalEmpre AND BOD_codigo in ;
					(SELECT cod FROM siscata WHERE origen='BOD' ) ;
		INTO CURSOR c_BOD READWRITE 
		REPLACE id WITH _SiguienteIdTabla(pcNodo,"MAS") FOR id=0  
		
		UPDATE siscata SET siscata.nombre=c_BOD.BOD_descripcion ,;
							siscata.fecmod=ldfec, ;
							siscata.nodo=pcnodo, ;
							siscata.iduser=pnIdUsuario, ;
							siscata.pcuser=SYS(0) ;
			from c_BOD WHERE siscata.cod=c_BOD.BOD_codigo AND siscata.origen='BOD' 
		
		INSERT INTO siscata (id,origen,cod,nombre,tipo,eliminado,status,fecalta,fecmod,nodo,iduser,pcuser) ;
			SELECT id,'BOD',BOD_codigo,BOD_descripcion,0,0,1,ldfec,ldfec,;
				pcnodo,pnIdUsuario,SYS(0) ;
			FROM c_BOD WHERE id<>1 
		
		USE IN c_BOD
		USE IN siscata
		USE IN t_BOD	
	ENDIF 
	
	***********************************
	******* Rubros (grupos en disalcomb)
	IF lcmoduloacargar=4
		WAIT WINDOW "Sincronizando RUBROS ..." NOWAIT 
		USE pcsysdir+pcDB+"\siscata" IN 0 SHARED AGAIN 
		USE pcPTVDisalRuta+'facturacion\t_grupos' IN 0 SHARED AGAIN ALIAS t_GRP

		SELECT 000000000 as id,GRP_codigo,GRP_descripcion FROM t_GRP ;
				WHERE GRP_empresa=pcPTVDisalEmpre AND GRP_codigo NOT in ;
					(SELECT cod FROM siscata WHERE origen='RUB' ) ;
		UNION ALL ;
			SELECT 000000001 as id,GRP_codigo,GRP_descripcion FROM t_GRP ;
				WHERE GRP_empresa=pcPTVDisalEmpre  AND GRP_codigo in ;
					(SELECT cod FROM siscata WHERE origen='RUB' ) ;
		INTO CURSOR c_GRP READWRITE 
		REPLACE id WITH _SiguienteIdTabla(pcNodo,"MAS") FOR id=0  
		
		UPDATE siscata SET siscata.nombre=c_GRP.GRP_descripcion ,;
							siscata.fecmod=ldfec, ;
							siscata.nodo=pcnodo, ;
							siscata.iduser=pnIdUsuario, ;
							siscata.pcuser=SYS(0) ;
			from c_GRP WHERE siscata.cod=c_GRP.GRP_codigo AND siscata.origen='RUB' 
		
		INSERT INTO siscata (id,origen,cod,nombre,tipo,eliminado,status,fecalta,fecmod,nodo,iduser,pcuser) ;
			SELECT id,'RUB',GRP_codigo,GRP_descripcion,0,0,1,ldfec,ldfec,;
				pcnodo,pnIdUsuario,SYS(0) ;
			FROM c_GRP WHERE id<>1 
		
		USE IN c_GRP
		USE IN siscata
		USE IN t_GRP	
	ENDIF 
	
	
	
	***********************************
	******* Lineas (subs_grupos en disalcomb)
	IF lcmoduloacargar=5
		WAIT WINDOW "Sincronizando LINEAS ..." NOWAIT 
		USE pcsysdir+pcDB+"\siscata" IN 0 SHARED AGAIN 
		USE pcPTVDisalRuta+'facturacion\t_subgrupos' IN 0 SHARED AGAIN ALIAS t_SUB

		SELECT 000000000 as id,SUB_codigo,SUB_descripcion FROM t_SUB ;
				WHERE SUB_empresa=pcPTVDisalEmpre AND SUB_codigo NOT in ;
					(SELECT cod FROM siscata WHERE origen='LIN' ) ;
		UNION ALL ;
			SELECT 000000001 as id,SUB_codigo,SUB_descripcion FROM t_SUB ;
				WHERE SUB_empresa=pcPTVDisalEmpre AND SUB_codigo in ;
					(SELECT cod FROM siscata WHERE origen='LIN' ) ;
		INTO CURSOR c_SUB READWRITE 
		REPLACE id WITH _SiguienteIdTabla(pcNodo,"MAS") FOR id=0  
		
		UPDATE siscata SET siscata.nombre=c_SUB.SUB_descripcion ,;
							siscata.fecmod=ldfec, ;
							siscata.nodo=pcnodo, ;
							siscata.iduser=pnIdUsuario, ;
							siscata.pcuser=SYS(0) ;
			from c_SUB WHERE siscata.cod=c_SUB.SUB_codigo AND siscata.origen='LIN' 
		
		INSERT INTO siscata (id,origen,cod,nombre,tipo,eliminado,status,fecalta,fecmod,nodo,iduser,pcuser) ;
			SELECT id,'LIN',SUB_codigo,SUB_descripcion,0,0,1,ldfec,ldfec,;
				pcnodo,pnIdUsuario,SYS(0) ;
			FROM c_SUB WHERE id<>1 
		
		USE IN c_SUB
		USE IN siscata
		USE IN t_SUB	
	ENDIF 
	
	***********************************
	******* Caja (T_vendedores_cajeros - cajeros) cajero vnc_cargo ='C'
	IF lcmoduloacargar=6
		WAIT WINDOW "Sincronizando CAJAS (PUNTOS DE VENTA)..." NOWAIT 
		USE pcsysdir+pcDB+"\cybcajabancos" IN 0 SHARED AGAIN 
		USE pcPTVDisalRuta+'facturacion\t_vendedores_cajeros' IN 0 SHARED AGAIN ALIAS t_CAJ

		SELECT 000000000 as id,vnc_codigo,vnc_nombre FROM t_CAJ ;
				WHERE vnc_empresa=pcPTVDisalEmpre AND vnc_cargo='C' AND vnc_codigo NOT in ;
					(SELECT codcajban FROM cybcajabancos ) ;
		UNION ALL ;
			SELECT 000000001 as id,vnc_codigo,vnc_nombre FROM t_CAJ ;
				WHERE vnc_empresa=pcPTVDisalEmpre AND vnc_cargo='C' AND vnc_codigo in ;
					(SELECT codcajban FROM cybcajabancos ) ;
		INTO CURSOR c_CAJ READWRITE 
		REPLACE id WITH _SiguienteIdTabla(pcNodo,"MAS") FOR id=0  
		
		UPDATE cybcajabancos SET cybcajabancos.cajban=c_CAJ.vnc_nombre ,;
							cybcajabancos.fecmod=ldfec, ;
							cybcajabancos.nodo=pcnodo, ;
							cybcajabancos.iduser=pnIdUsuario, ;
							cybcajabancos.pcuser=SYS(0) ;
			from c_CAJ WHERE cybcajabancos.codcajban=c_CAJ.vnc_codigo 
		
		INSERT INTO cybcajabancos (idcajban,codcajban,cajban,tipocajban,;
					fondo,saldo,sobregiro,eliminado,status,fecalta,fecmod,nodo,iduser,pcuser) ;
			SELECT id,vnc_codigo,vnc_nombre,1,0,0,1,0,1,ldfec,ldfec,;
				pcnodo,pnIdUsuario,SYS(0) ;
			FROM c_CAJ WHERE id<>1 
		
		USE IN c_CAJ
		USE IN cybcajabancos
		USE IN t_CAJ	
	ENDIF 
	
	
	***********************************
	******* Vendedores (T_vendedores_cajeros - vendedores) cajero vnc_cargo ='V'
	IF lcmoduloacargar=7
		WAIT WINDOW "Sincronizando VENDEDORES ..." NOWAIT 
		USE pcsysdir+pcDB+"\siscata" IN 0 SHARED AGAIN 
		USE pcPTVDisalRuta+'facturacion\t_vendedores_cajeros' IN 0 SHARED AGAIN ALIAS t_VEN

		SELECT 000000000 as id,vnc_codigo,vnc_nombre FROM t_VEN ;
				WHERE vnc_empresa=pcPTVDisalEmpre AND vnc_cargo='V' AND vnc_codigo NOT in ;
					(SELECT cod FROM siscata WHERE origen='VEN' ) ;
		UNION ALL ;
			SELECT 000000001 as id,vnc_codigo,vnc_nombre FROM t_VEN ;
				WHERE vnc_empresa=pcPTVDisalEmpre AND vnc_cargo='V' AND vnc_codigo in ;
					(SELECT cod FROM siscata WHERE origen='VEN' ) ;
		INTO CURSOR c_VEN READWRITE 
		REPLACE id WITH _SiguienteIdTabla(pcNodo,"MAS") FOR id=0  
		
		UPDATE siscata SET siscata.nombre=c_VEN.vnc_nombre ,;
							siscata.fecmod=ldfec, ;
							siscata.nodo=pcnodo, ;
							siscata.iduser=pnIdUsuario, ;
							siscata.pcuser=SYS(0) ;
			from c_VEN WHERE siscata.cod=c_VEN.vnc_codigo AND siscata.origen='VEN' 
		
		INSERT INTO siscata (id,origen,cod,nombre,tipo,eliminado,status,fecalta,fecmod,nodo,iduser,pcuser) ;
			SELECT id,'VEN',vnc_codigo,vnc_nombre,0,0,1,ldfec,ldfec,;
				pcnodo,pnIdUsuario,SYS(0) ;
			FROM c_VEN WHERE id<>1 
		
		USE IN c_VEN
		USE IN siscata
		USE IN t_VEN	
