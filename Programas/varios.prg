FUNCTION NombreColumnaExcel(lnNumeroColumna as Integer)
	****** el numero de la columna de excel
	lnveces=0
	lnLimite=26
	lnSumar=64
	lcLetraColumna=""
	
	IF BETWEEN(lnNumeroColumna,1,702)	&&&&& limite de columnas de excel 2010 en adelante

		lnentero=INT(lnNumeroColumna/lnLimite)
		lnFraccion=((lnNumeroColumna/lnLimite)-lnentero)*lnLimite
		

		IF lnentero=27
			lcLetraColumna='ZZ'
		ELSE 
			lnentero=INT(lnNumeroColumna/lnLimite)
			lnFraccion=((lnNumeroColumna/lnLimite)-lnentero)*lnLimite
			
			IF lnFraccion>0
				lcLetraColumna=CHR(lnFraccion+lnSumar)
			ELSE
				IF lnentero>1
					lcLetraColumna='Z'
				ENDIF 
			ENDIF 
			
			IF lnentero>0
				IF lnFraccion>0
					lcLetraColumna=CHR(lnentero+lnSumar)+lcLetraColumna
				ELSE
					IF lnentero-1<=0
						lcLetraColumna=CHR((lnentero*lnLimite)+lnSumar)+lcLetraColumna
					ELSE
						lcLetraColumna=CHR((lnentero-1)+lnSumar)+lcLetraColumna
					ENDIF 
					
				ENDIF 
			ENDIF 
			
		ENDIF 	
		
	ENDIF 

	RETURN lcLetraColumna
	
ENDFUNC 




FUNCTION _registrosnuevoskardexaplica()
	lcalinueapli=ALIAS()
	lcretornamasregistros=''
	lcandmasregistros=''
	lncuentafilas=0
	USE pcsysdir+pcDB+"\siskardexapli" IN 0 ALIAS ttmapli SHARED AGAIN 
	
	SELECT ttmapli
	
	SELECT * FROM (;
			SELECT iddocto FROM ttmapli WHERE (fecmod>fecactu OR EMPTY(fecactu)) AND nodo=pcnodo ;
		UNION ALL ;
			SELECT iddoctoaplicar FROM ttmapli WHERE (fecmod>fecactu OR EMPTY(fecactu)) AND nodo=pcnodo ;
	) as cc ORDER BY iddocto GROUP BY iddocto INTO CURSOR cc_aplitmp READWRITE 

	SELECT cc_aplitmp
	
	IF !EOF()
		SCAN all
			lncuentafilas=lncuentafilas+1
			
			IF lncuentafilas=25
				lncuentafilas=1
				lcretornamasregistros=lcretornamasregistros+') or inlist(iddocto,'+ALLTRIM(STR(iddocto))
			ELSE
				lcretornamasregistros=lcretornamasregistros+lcandmasregistros+ALLTRIM(STR(iddocto))
			ENDIF 
			
			lcandmasregistros=','
			
		ENDSCAN 
		lcretornamasregistros=' or inlist(iddocto,'+lcretornamasregistros+')'
		
	ENDIF 

	USE IN cc_aplitmp
	USE IN ttmapli

	IF !EMPTY(lcalinueapli)
		SELECT (lcalinueapli)
	ENDIF 
	RETURN lcretornamasregistros
	
ENDFUNC 



