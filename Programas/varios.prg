FUNCTION ValidarMetaVendedores()
	USE pcSysDir+pcdb+'\siscata' share again IN 0
	SELECT siscata
	llexiste=.f.
	FOR gnCount = 1 TO FCOUNT( )  && Loop for number of fields
	   IF ALLTRIM(FIELD(gnCount))=="META"  && Display each field
			llexiste=.T.
	   ENDIF 
	NEXT
	USE IN siscata
	IF !llexiste
		WAIT WINDOW 'Validando Meta de vendedores' NOWAIT 
		USE pcSysDir+pcdb+'\siscata' EXCLUSIVE IN 0
		
		ALTER table siscata ADD COLUMN meta n(16,6) DEFAULT  0
		
		USE IN siscata
		WAIT CLEAR 
	ENDIF 
	RETURN .t.
ENDFUNC 




FUNCTION ValidarSucursalTipoEstablecimiento()
	USE pcSysDir+pcdb+'\siscata' share again IN 0
	SELECT siscata
	llexiste=.f.
	FOR gnCount = 1 TO FCOUNT( )  && Loop for number of fields
	   IF ALLTRIM(FIELD(gnCount))=="TIPOESTABLECIMIENTO"  && Display each field
			llexiste=.T.
	   ENDIF 
	NEXT
	USE IN siscata
	IF !llexiste
		WAIT WINDOW 'Validando Sucursal Tipo Establecimiento' NOWAIT 
		USE pcSysDir+pcdb+'\siscata' EXCLUSIVE IN 0
		
		ALTER table siscata ADD COLUMN tipoEstablecimiento C(20) DEFAULT  '01'
		ALTER table siscata ADD COLUMN codEstableMH C(20) DEFAULT  ''
		ALTER table siscata ADD COLUMN codEstable C(20) DEFAULT  ''
		ALTER table siscata ADD COLUMN codPuntoVentaMH C(20) DEFAULT  ''
		ALTER table siscata ADD COLUMN codPuntoVenta C(20) DEFAULT  ''
		
		USE IN siscata
		
		USE pcSysDir+pcdb+'\cyvClipro' EXCLUSIVE IN 0
		ALTER table cyvClipro ADD COLUMN codGiro c(20) DEFAULT ''
		ALTER table cyvClipro ADD COLUMN codDepartamento c(10) DEFAULT ''
		ALTER table cyvClipro ADD COLUMN codMunicipio c(10) DEFAULT ''
		
		USE IN cyvClipro
		
		IF USED("sisempresas")
			llEmpresaAbierta=.t.
			USE IN sisempresas
		ENDIF 
		USE pcSysDir+pcdb+"\sisempresas" EXCLUSIVE IN 0
		SELECT sisempresas
		ALTER table sisempresas ADD COLUMN codDepartamento c(10) DEFAULT ''
		ALTER table sisempresas ADD COLUMN codMunicipio c(10) DEFAULT ''
		ALTER table sisempresas ADD COLUMN telefono c(10) DEFAULT ''
		ALTER table sisempresas ADD COLUMN correo c(200) DEFAULT ''
		ALTER table sisempresas ADD COLUMN codGiro c(20) DEFAULT ''
		ALTER table sisempresas ADD COLUMN nombreComercial c(250) DEFAULT ''
		
		USE IN sisempresas
		
		IF llEmpresaAbierta
			USE MasterDB!sisempresas share AGAIN
		ENDIF 
		
		WAIT CLEAR 
	ENDIF 
	RETURN .t.
ENDFUNC 




