FUNCTION _ObtenerNivelCta(lcCodCta,llMostrarMensaje)

	IF PCOUNT( )=1
		llMostrarMensaje=.t.
	ENDIF 
	
	lcCodCta=ALLTRIM(lcCodCta)
	lnRetNivelCTA=0
	FOR i=1 TO pnNivelMaximo
		IF LEN(lcCodCta)=paLargoNivel(i)
			lnRetNivelCTA=i
		ENDIF 
	ENDFOR
	
	IF lnRetNivelCTA>1
		IF right(lcCodCta,pnNivel(lnRetNivelCTA))=PADL("",pnNivel(lnRetNivelCTA),"0")
			lnRetNivelCTA=0
		ENDIF 
	ENDIF 
	IF lnRetNivelCTA=0
		IF llMostrarMensaje=.t.
			WAIT WINDOW "La Cuenta esta Incompleta !" NOWAIT 
		ENDIF 
	ENDIF 
	RETURN lnRetNivelCTA
ENDFUNC 




