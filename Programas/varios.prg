FUNCTION formatoNit(lcminit)
	lcminit=ALLTRIM(lcminit)
	lcminit=SUBSTR(lcminit,1,4)+'-'+SUBSTR(lcminit,5,6)+'-'+SUBSTR(lcminit,11,3)+'-'+SUBSTR(lcminit,14,1)
	RETURN lcminit
ENDFUNC 

FUNCTION formatoDui(lcminit)
	lcminit=ALLTRIM(lcminit)
	lnlargonit=LEN(lcminit)
	lcminit=SUBSTR(lcminit,1,lnlargonit-1)+'-'+SUBSTR(lcminit,lnlargonit,1)
	RETURN lcminit
ENDFUNC  

FUNCTION NombreyApellido(lcNombreCompleto,lnPosicion)
	lcNombreApe=""
	lcNombreCompleto=UPPER(ALLTRIM(lcNombreCompleto))

	IF !EMPTY(lcNombreCompleto) AND lnPosicion>0
		lnCuentaSpacio=OCCURS(' ',lcNombreCompleto) 
		IF lnCuentaSpacio=4 AND OCCURS(' DE ',lcNombreCompleto)>0
			lcNombreCompleto=STRTRAN(lcNombreCompleto," DE "," ")
			lnCuentaSpacio=lnCuentaSpacio-1
		ENDIF 
		DO case
			CASE lnCuentaSpacio=3
				IF lnPosicion=4
					lnInicial=AT(' ',lcNombreCompleto,lnCuentaSpacio)+1
					lnLargo=LEN(lcNombreCompleto)-lnInicial+1
					lcNombreApe=SUBSTR(lcNombreCompleto,lnInicial,lnLargo)
				ENDIF 
				IF lnPosicion=3
					lnInicial=AT(' ',lcNombreCompleto,lnCuentaSpacio-1)+1
					lnLargo=AT(' ',lcNombreCompleto,lnCuentaSpacio)-(AT(' ',lcNombreCompleto,lnCuentaSpacio-1)+1)
					lcNombreApe=SUBSTR(lcNombreCompleto,lnInicial,lnLargo)
				ENDIF 
				IF lnPosicion=2
					lnInicial=AT(' ',lcNombreCompleto,lnCuentaSpacio-2)+1
					lnLargo=AT(' ',lcNombreCompleto,lnCuentaSpacio-1)-(AT(' ',lcNombreCompleto,lnCuentaSpacio-2)+1)
					lcNombreApe=SUBSTR(lcNombreCompleto,lnInicial,lnLargo)
				ENDIF 
				IF lnPosicion=1
					lnInicial=1
					lnLargo=AT(' ',lcNombreCompleto,lnCuentaSpacio-2)
					lcNombreApe=SUBSTR(lcNombreCompleto,lnInicial,lnLargo)
				ENDIF 
			CASE lnCuentaSpacio=2
				IF lnPosicion=4
					lcNombreApe=""
				ENDIF 
				IF lnPosicion=3
					lnInicial=AT(' ',lcNombreCompleto,lnCuentaSpacio)+1
					lnLargo=LEN(lcNombreCompleto)-lnInicial+1
					lcNombreApe=SUBSTR(lcNombreCompleto,lnInicial,lnLargo)
				ENDIF 
				IF lnPosicion=2
					lnInicial=AT(' ',lcNombreCompleto,lnCuentaSpacio-1)+1
					lnLargo=AT(' ',lcNombreCompleto,lnCuentaSpacio)-(AT(' ',lcNombreCompleto,lnCuentaSpacio-1)+1)
					lcNombreApe=SUBSTR(lcNombreCompleto,lnInicial,lnLargo)
				ENDIF 
				IF lnPosicion=1
					lnInicial=1
					lnLargo=AT(' ',lcNombreCompleto,lnCuentaSpacio-1)
					lcNombreApe=SUBSTR(lcNombreCompleto,lnInicial,lnLargo)
				ENDIF 
			CASE lnCuentaSpacio=1
				IF lnPosicion=4
					lcNombreApe=""
				ENDIF 
				IF lnPosicion=3
					lnInicial=AT(' ',lcNombreCompleto,lnCuentaSpacio)+1
					lnLargo=LEN(lcNombreCompleto)-lnInicial+1
					lcNombreApe=SUBSTR(lcNombreCompleto,lnInicial,lnLargo)
				ENDIF 
				IF lnPosicion=2
					lcNombreApe=""
				ENDIF 
				IF lnPosicion=1
					lnInicial=1
					lnLargo=AT(' ',lcNombreCompleto,lnCuentaSpacio)
					lcNombreApe=SUBSTR(lcNombreCompleto,lnInicial,lnLargo)
				ENDIF 
			CASE lnCuentaSpacio=3
				IF lnPosicion=4
					lcNombreApe=""
				ENDIF 
				IF lnPosicion=3
					lcNombreApe=""
				ENDIF 
				IF lnPosicion=2
					lcNombreApe=""
				ENDIF 
				IF lnPosicion=1
					lcNombreApe=ALLTRIM(lcNombreCompleto)
				ENDIF 
			OTHERWISE
				lcNombreApe=ALLTRIM(lcNombreCompleto)
		ENDCASE 
	ENDIF 
	RETURN lcNombreApe+SPACE(50)
ENDFUNC 


FUNCTION enteroAHora(lnValor)
	lchora=SUBSTR(TTOC(DTOT(DATE(1900,1,1)+lnValor)),12,8)
	lcAmPm=SUBSTR(TTOC(DTOT(DATE(1900,1,1)+lnValor)),21,2)
	IF lcAmPm='PM'
		lnhora=VAL(SUBSTR(lchora,1,2))+12
		lchora=PADL(ALLTRIM(STR(lnhora)),2,"0")+SUBSTR(lchora,3,6)
	ENDIF 
	RETURN lcHora
ENDFUNC 




FUNCTION _CalcularVentaDistribuida(ldFechaFiltro)
	lcAliasdist=ALIAS()
	Select  IIF(t0.idcajban=pnDistribuirCaja1,1,2) as llave,SUM(t0.totaldocto) as totalventa ;
	from cyvventas t0 ;
	where  t0.origen='VTA' AND t0.condipago=0  and  t0.status=1 and t0.fechadocto=ldFechaFiltro  ;
		AND INLIST(t0.idcajban,pnDistribuirCaja1,pnDistribuirCaja2) ;
	ORDER BY t0.idcajban GROUP BY t0.idcajban INTO CURSOR c_Distri READWRITE 

	SUM ALL TotalVenta TO lnTotDis
	SUM ALL TotalVenta FOR llave=1 TO lnTotDis1
	SUM ALL TotalVenta FOR llave=2 TO lnTotDis2

	USE IN c_Distri
	
	lnPorVenta=ROUND(lnTotDis*pnDistribuirVenta,2)
	IF lnTotDis2<lnPorVenta
		llCambiarCaja=.t.
	ELSE
		llCambiarCaja=.f.
	ENDIF 
	
	IF !EMPTY(lcAliasdist)
		SELECT (lcAliasdist)
	ENDIF 
	
	RETURN llCambiarCaja
	
ENDFUNC  



