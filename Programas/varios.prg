***** Reportes de Impresion en Matricial
FUNCTION ReImprimirAportaciones(lnIdReg,lnLinImp)
	LOCAL lcAlias,lnidSQL,lcRegMin
	lnidSQL=0
	lcRegMin="0"
	lcAlias=ALIAS()
	lnidSQL=_conecta(pcDB)

	IF lnidSQL>0
		lcComando="SELECT Max(idaportacion) as regmax FROM fin_aportaciones where idsocionegocio="+ALLTRIM(STR(lnIdReg))+" and linea="+ALLTRIM(STR(lnLinImp))+";"
		lnCtrlSql=miSQLEXEC(lnidSQL,lcComando,'c_reporte_max')

		IF lnCtrlSql>0
			lcRegMin=ALLTRIM(STR(c_reporte_max.regmax))
			USE IN c_reporte_max
		ENDIF 
		IF VAL(lcRegMin)>0
			lcComando0="set @RNUM =0;"
			lcComando1="select d.*,@RNUM := @RNUM+d.saldotmp as saldo from (select b.linea,b.idaportacion,b.codsocionegocio,b.socionegocio,b.dui,b.fecha,b.depositos,b.retiros,case when b.linea="+ALLTRIM(STR(lnLinImp))+" then b.inicial else 0 end+b.depositos-b.retiros as saldotmp,c.cajero from (select a.linea,a.idcajero,"
			lcComando2="a.idaportacion,saldos.*,a.fecha,case when a.sumaresta=1 then a.monto else 0 end as depositos,case when a.sumaresta=2 then a.monto else 0 end as retiros from (select idsocionegocio,codsocionegocio,socionegocio,dui,aportaciones "
			lcComando3="-(select sum(case when sumaresta=1 then monto else  -monto end) as movimi from fin_aportaciones where idsocionegocio="+ALLTRIM(STR(lnIdReg))+" and linea>="+ALLTRIM(STR(lnLinImp))+" and idaportacion>="+lcRegMin+" ) as inicial from adm_socionegocios where idsocionegocio="+ALLTRIM(STR(lnIdReg))+") "
			lcComando4=" as saldos inner join fin_aportaciones a on saldos.idsocionegocio=a.idsocionegocio where a.linea>="+ALLTRIM(STR(lnLinImp))+" and a.idaportacion>="+lcRegMin+" order by a.linea) as b inner join com_cajeros c on b.idcajero=c.idcajero order by b.linea) as d;  "

			lnCtrlSql=miSQLEXEC(lnidSQL,lcComando0)
			lnCtrlSql=miSQLEXEC(lnidSQL,lcComando1+lcComando2+lcComando3+lcComando4,'c_reporte')

			IF lnCtrlSql>0
				if !EOF()
					WAIT WINDOW "Imprimiendo...." NOWAIT 
					SELECT c_reporte
					GO top
					IF linea<>1
						lnRellena=linea-1
					ELSE
						lnRellena=0
					ENDIF 
					FOR i=1 TO lnRellena
						APPEND BLANK IN c_reporte
					ENDFOR 
					INDEX on idaportacion TAG llave
					SET ORDER TO llave
					GO top
					
					STORE SET("Printer",3) TO lcPrinOld
	*				IF !EMPTY(lcImpresorBoucher)
	*					lcPrinter1=ALLTRIM(lcImpresorBoucher)
	*				ELSE
						lcPrinter1=lcPrinOld
	*				ENDIF 
			
					SET PRINTER TO NAME (lcPrinter1)
					
					REPORT FORM (pcSysDir+pcdb+"\formatos\libreta_aport1.frx") NOCONSOLE TO PRINTER 
	*				REPORT FORM (pcSysDir+pcdb+"\formatos\libreta_aport1.frx") NOCONSOLE TO PRINTER PROMPT PREVIEW 

					SET PRINTER  TO NAME (lcPrinOld)

					sn=MESSAGEBOX("Se imprimieron corectamente los registros...? ",32+256+4,"Mensaje del Sistema")
					IF sn=6
						lnCtrlSql=miSQLEXEC(lnidSQL,"update fin_aportaciones set impreso=1 where idsocionegocio="+ALLTRIM(STR(lnIdReg))+";")
						IF lnCtrlSql<=0
							_MostrarErroresSQL(lnidSQL)
						ENDIF 
					ENDIF 
				ELSE
					WAIT WINDOW "No hay Movimientos Pendientes de Imprimir..."
				ENDIF 
				USE IN c_reporte
			ELSE
				_MostrarErroresSQL(lnidSQL)
			ENDIF 
		ELSE
			MESSAGEBOX("El numero de la Linea no es Correcta ",16,'Mensaje de Error...')
		ENDIF 
		
		=miSQLDISCONNECT(lnidSQL)
	ELSE
		MESSAGEBOX("Imposible conectarse con el Servidor... Intente más tarde...",16,'Error de Conección...')
	ENDIF 
	IF !EMPTY(lcAlias)
		SELECT (lcAlias)
	ENDIF 
ENDFUNC 


