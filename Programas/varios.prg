				FOR ctrolcomvta<>IIF(origen='VTA',IIF(ctrolinv=1,2,1),ctrolinv) AND INLIST(ctrolinv,1,2) AND status=1 AND INLIST(origen,'VTA','COM') AND nodo=pcnodo
