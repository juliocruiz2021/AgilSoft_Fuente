	lnIdTipoCtaPadre=_ObtenerPadreCta(lnIdSqlParaConta,lcCodCta,lnNivelTipoCtaB)
	lcaliasParaConta=ALIAS()
	lcCodCta=ALLTRIM(lcCodCta)
	lcCodCtaTitulo=SUBSTR(lcCodCta,1,1)+" "
