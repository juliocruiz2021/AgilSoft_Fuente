	IF lnIdSqlParaConta>0 AND LEN(lcCodCta)>1	&&&& Coneccion Establecida
		IF lnIdTipoCtaPadre<>0
			lcComandoBuscarCta="SELECT idtipocuenta FROM ctbcuentas where idcuenta="+ALLTRIM(STR(lnIdTipoCtaPadre))
			lnCtrlSqlCtaBus=miSQLEXEC(lnIdSqlParaConta,lcComandoBuscarCta,"c_BusTipoCta")
		ELSE
			lcComandoBuscarCta="SELECT idtipocuenta FROM ctbcuentas where codcta='"+lcCodCtaTitulo+"'"
			lnCtrlSqlCtaBus=miSQLEXEC(lnIdSqlParaConta,lcComandoBuscarCta,"c_BusTipoCta")
		ENDIF 
		IF _tallY>0
			IF type("c_BusTipoCta.idtipocuenta")<>"N"
				lnRetTipo=VAL(c_BusTipoCta.idtipocuenta)
			ELSE
				lnRetTipo=c_BusTipoCta.idtipocuenta
			ENDIF 
		ENDIF 
		USE IN c_BusTipoCta
	ENDIF 

	IF !EMPTY(lcaliasParaConta)
		SELECT (lcaliasParaConta)
	ENDIF 
	RETURN lnRetTipo
ENDFUNC 


FUNCTION _ObtenerSiguienteCta(lnIdSqlctaAnte,lcCodCta)
