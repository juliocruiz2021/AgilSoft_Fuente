FUNCTION _esPassCar(lcpass,lccarrn,lcootr)
	lcRetornaTipo=''

	IF !EMPTY(lcpass)
		lcRetornaTipo='03'
	ENDIF 
	IF !EMPTY(lccarrn) AND EMPTY(lcRetornaTipo)
		lcRetornaTipo='02'
	ENDIF 
	IF !EMPTY(lcootr) AND EMPTY(lcRetornaTipo)
		lcRetornaTipo='37'
	ENDIF 

	RETURN lcRetornaTipo
ENDFUNC 


FUNCTION _DigaPassCar(lcpass,lccarrn,lcootr)
	lcRetornaTipo=''
	
	IF !EMPTY(lcpass)
		lcRetornaTipo=SoloNumeros(lcpass)
	ENDIF 
	IF !EMPTY(lccarrn) AND EMPTY(lcRetornaTipo)
		lcRetornaTipo=SoloNumeros(lccarrn)
	ENDIF 
	IF !EMPTY(lcootr) AND EMPTY(lcRetornaTipo)
		lcRetornaTipo=SoloNumeros(lcootr)
	ENDIF 

	RETURN lcRetornaTipo
ENDFUNC 





