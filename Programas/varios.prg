				WITH xlsheet.Range("A5:B5")
					.Font.Bold = 'True'
					.WrapText = 'False'
					.Interior.ColorIndex = 11
					.Font.ColorIndex =2
					.HorizontalAlignment = xlCenter
					
					FOR iii=1 TO lnCol+lnColSumar
						xlsheet.Cells(lnFila-1,iii).Interior.ColorIndex = 11
						xlsheet.Cells(lnFila-1,iii).Font.Bold = 'True'
						xlsheet.Cells(lnFila-1,iii).Font.ColorIndex =2
						xlsheet.Cells(lnFila-1,iii).WrapText = 'False'
						xlsheet.Cells(lnFila-1,iii).HorizontalAlignment = xlCenter
					ENDFOR 

				ENDWITH
			
		ENDCASE 

		SELECT (lcCurEstFin)
		GO top
		lnpar=0
		IF lnTipoEstFin=7
			lnTipoFlu=1
		ELSE
			lnTipoFlu=0
		ENDIF
		 
		LNTOTFIL=ALLTRIM(STR(RECCOUNT()))
		
		IF lnTipoEstFin=3 AND sndata=6
			sndatacc=MESSAGEBOX("Desea solo Data Cruda ? ",+256+64+4,'Guardar data cruda')
			IF sndatacc=6
				lcfile=GETFILE('csv','Archivo','Guardar',0,'Nombre Archivo Data Cruda')
				*lcfile='***'
				IF !EMPTY(lcfile)
					WAIT WINDOW 'Exportando data cruda....' NOWAIT 
					llgenerexls=.f.
					SELECT SPACE(10),SPACE(10),SPACE(10),SPACE(10),SPACE(10),SPACE(10),SPACE(10),SPACE(10),SPACE(10),;
						codcta,cuenta,origen+SPACE(5) as origen,DTOC(fechapartida) as fecha,;
						DTOs(fechapartida)+SPACE(5) as fecha_texto,codtpar as tipo,;
						numeropartida as numero,concepto,;
						STR(debe,16,2) as debe,STR(haber,16,2) as haber,PRESUPUESTO as PRESU ;
					 FROM &lcCurEstFin INTO CURSOR c_datacruda1 READWRITE WHERE RECNO()=0
					APPEND BLANK
					REPLACE codcta WITH 'COD.CTA.',cuenta WITH 'CUENTA',origen WITH 'ORIGEN',FECHA WITH 'FECHA',;
						fecha_texto WITH 'FECHA TEXTO',tipo WITH 'TIPO',numero WITH 'NUMERO',concepto WITH 'CONCEPTO',;
						debe WITH 'DEBE',haber WITH 'HABER', presu WITH 'PRESU' NEXT 1

					SELECT SPACE(10),SPACE(10),SPACE(10),SPACE(10),SPACE(10),SPACE(10),SPACE(10),SPACE(10),SPACE(10),;
						codcta,cuenta,origen+SPACE(5) as origen,DTOC(fechapartida) as fecha,;
						DTOs(fechapartida)+SPACE(5) as fecha_texto,codtpar as tipo,;
						numeropartida as numero,concepto,;
						STR(debe,16,2) as debe,STR(haber,16,2) as haber,PRESUPUESTO as PRESU ;
					 FROM &lcCurEstFin INTO CURSOR c_datacruda2 READWRITE 
					 
					SELECT * FROM c_datacruda1 UNION ALL SELECT * FROM c_datacruda2 INTO CURSOR c_datacruda3
					COPY TO &lcfile  DELIMITED WITH CHARACTER ';' 
					
					WAIT WINDOW "Data exportada..." NOWAIT 
					
					USE IN c_datacruda1
					USE IN c_datacruda2
					USE IN c_datacruda3
					SELECT (lcCurEstFin)
				ELSE 
					llgenerexls=.t.
				ENDIF 
			ELSE 
				llgenerexls=.t.
			ENDIF 
		ELSE
			llgenerexls=.t.
		ENDIF 
		
		
		SCAN FOR llgenerexls AND idcuenta<>0 
			lnFila= lnFila+ 1
			WAIT WINDOW STR(lnFila)+'/'+LNTOTFIL NOWAIT 
			DO CASE
				CASE lnTipoEstFin=1		&&&& Balance General
					xlsheet.Cells(lnFila,1).Value = codcta
					IF nivel<=pnnivelmayor
						xlsheet.Cells(lnFila,1).Font.Bold = 'True'
						xlsheet.Cells(lnFila,2).Font.Bold = 'True'
					ENDIF 
					xlsheet.Cells(lnFila,2).Value = SPACE(IIF(nivel=0,1,(nivel-1)*4))+ALLTRIM(cuenta)
					
					IF TYPE("saldofin")="N"
						xlsheet.Cells(lnFila,3).Value = IIF(naturaleza=2,saldofin*-1,saldofin)
					ELSE 
						FOR i=1 to lnCol
							lcCampoValor="IIF(naturaleza=2,"+laCol(i+lnColRestar-4,1)+"*-1,"+laCol(i+lnColRestar-4,1)+"*1)"
							
							xlsheet.Cells(lnFila,i+lnColSumar).Value =  &lcCampoValor
						ENDFOR
					ENDIF  
				*	xlsheet.Cells(lnFila,2).Value = ALLTRIM(saldo)
					
					IF lnpar=1
						lnpar=0
						FOR iii=1 TO lnCol+lnColSumar
							xlsheet.Cells(lnFila,iii).Interior.Color= 15527148
						ENDFOR 
					ELSE
						lnpar=1
					ENDIF 
					
				CASE lnTipoEstFin=2		&&&& Balanza
					xlsheet.Cells(lnFila,1).Value = codcta
					IF nivel<=pnnivelmayor
						xlsheet.Cells(lnFila,1).Font.Bold = 'True'
						xlsheet.Cells(lnFila,2).Font.Bold = 'True'
					ENDIF 
					xlsheet.Cells(lnFila,2).Value = SPACE(IIF(nivel=0,1,(nivel-1)*4))+ALLTRIM(cuenta)
					xlsheet.Cells(lnFila,3).Value = IIF(naturaleza=2,saldoini*-1,saldoini)
					xlsheet.Cells(lnFila,4).Value = deBe
					xlsheet.Cells(lnFila,5).Value = haBer
					xlsheet.Cells(lnFila,6).Value = IIF(naturaleza=2,saldofin*-1,saldofin)
					

					IF lnpar=1
						lnpar=0
						FOR iii=1 TO 6
							xlsheet.Cells(lnFila,iii).Interior.Color= 15527148
						ENDFOR 
					ELSE
						lnpar=1

					ENDIF 
				CASE lnTipoEstFin=3		&&&& Libro Auxiliar
					xlsheet.Cells(lnFila,1).Value = iif(detalle=1 and tip=2,'',codcta)
					IF nivel<=pnnivelmayor
						xlsheet.Cells(lnFila,1).Font.Bold = 'True'
						xlsheet.Cells(lnFila,2).Font.Bold = 'True'
					ENDIF 
					xlsheet.Cells(lnFila,2).Value = iif(tip=1,SPACE(IIF(nivel=0,1,(nivel-1)*3))++ALLTRIM(cuenta),;
														IIF(tip=2,SPACE(22)+origen+' '+PADR(DTOC(fechapartida)+SPACE(2)+ALLTRIM(codtpar)+' - '+ALLTRIM(numeropartida),25,' ')+ALLTRIM(concepto),;
														SPACE(70)+'Saldo Final Cta. '+ALLTRIM(codcta)))
					xlsheet.Cells(lnFila,3).Value = iif(tip=2,"",iif(naturaleza=1,saldoIni,saldoIni*-1))
					xlsheet.Cells(lnFila,4).Value = IIF((tip=1 or (tip=2 and debe<>0)),NVL(debe,0),"")
					xlsheet.Cells(lnFila,5).Value = IIF((tip=1 or (tip=2 and haber<>0)),NVL(haber,0),"")
					xlsheet.Cells(lnFila,6).Value = iif(naturaleza=1,saldofin,saldofin*-1)
					xlsheet.Cells(lnFila,7).Value = ALLTRIM(numch)
					IF 'GANO'$pcnomempresa 
						xlsheet.Cells(lnFila,8).Value =ALLTRIM(presupuesto)
					ENDIF 
					IF sndata=6
						xlsheet.Cells(lnFila,10).Value = ALLTRIM(codcta)
						xlsheet.Cells(lnFila,11).Value = ALLTRIM(cuenta)
						xlsheet.Cells(lnFila,12).Value = ALLTRIM(origen)
						xlsheet.Cells(lnFila,13).Value = DTOC(fechapartida)
						xlsheet.Cells(lnFila,14).Value = DTOs(fechapartida)
						xlsheet.Cells(lnFila,15).Value = ALLTRIM(codtpar)
						xlsheet.Cells(lnFila,16).Value = ALLTRIM(numeropartida)
						xlsheet.Cells(lnFila,17).Value = ALLTRIM(concepto)
						xlsheet.Cells(lnFila,18).Value = debe
						xlsheet.Cells(lnFila,19).Value = haber
						xlsheet.Cells(lnFila,20).Value = ALLTRIM(PRESUPUESTO)
					ENDIF 
					IF lnpar=1
						lnpar=0
						FOR iii=1 TO 8
							xlsheet.Cells(lnFila,iii).Interior.Color= 15527148
						ENDFOR 
					ELSE
						lnpar=1
					ENDIF 
				CASE lnTipoEstFin=4		&&&& Diario Mayor
					IF nivel<=pnnivelmayor
						xlsheet.Cells(lnFila,1).Font.Bold = 'True'
						xlsheet.Cells(lnFila,2).Font.Bold = 'True'
						xlsheet.Cells(lnFila,3).Font.Bold = 'True'
						xlsheet.Cells(lnFila,4).Font.Bold = 'True'
						xlsheet.Cells(lnFila,5).Font.Bold = 'True'
						
					ENDIF 
					xlsheet.Cells(lnFila,1).Value = IIF(tip=1,SPACE(IIF(nivel=0,1,(nivel-1)*3))+ALLTRIM(codcta)+" - "+ALLTRIM(cuenta),SPACE(30)+SUBSTR(origen,1,3)+" "+DTOC(fechapartida)+"  "+ALLTRIM(codpar)+"-"+ALLTRIM(numeropartida)+"  "+SUBSTR(concepto,1,150))
					xlsheet.Cells(lnFila,2).Value = iif(tip=1,iif(naturaleza=1,saldoIni,saldoIni*-1),' ')
					xlsheet.Cells(lnFila,3).Value = iif(detalle=1 and tip=2,IIF(debe<>0,debe,''),debe)
					xlsheet.Cells(lnFila,4).Value = iif(detalle=1 and tip=2,IIF(haber<>0,haber,''),haber)
					xlsheet.Cells(lnFila,5).Value = iif(naturaleza=1,saldoFin,saldoFin*-1)
					
					IF lnpar=1
						lnpar=0
						FOR iii=1 TO 5
							xlsheet.Cells(lnFila,iii).Interior.Color= 15527148
						ENDFOR 
					ELSE
						lnpar=1
					ENDIF 
				
				CASE lnTipoEstFin=5		&&&& Razones Financieras
					
					xlsheet.Cells(lnFila,1).Value = ALLTRIM(nom)
					xlsheet.Cells(lnFila,2).Value = ALLTRIM(RazonFin)
					xlsheet.Cells(lnFila,3).Value = valorfinal
					
					IF lnpar=1
						lnpar=0
						FOR iii=1 TO 3
							xlsheet.Cells(lnFila,iii).Interior.Color= 15527148
						ENDFOR 
					ELSE
						lnpar=1
					ENDIF 
					
				CASE lnTipoEstFin=6		&&&& Cambios en el Patrimonio 
					xlsheet.Cells(lnFila,1).Value = RTRIM(Concepto)
					xlsheet.Cells(lnFila,2).Value = capital
					xlsheet.Cells(lnFila,3).Value = reserva
					xlsheet.Cells(lnFila,4).Value = acumulado
					xlsheet.Cells(lnFila,5).Value = total
					
					IF tipocPatri<>0
						xlsheet.Cells(lnFila,1).Font.Bold = 'True'
						xlsheet.Cells(lnFila,2).Font.Bold = 'True'
						xlsheet.Cells(lnFila,3).Font.Bold = 'True'
						xlsheet.Cells(lnFila,4).Font.Bold = 'True'
						xlsheet.Cells(lnFila,5).Font.Bold = 'True'
					ENDIF 
					IF lnpar=1
						lnpar=0
						FOR iii=1 TO 5
							xlsheet.Cells(lnFila,iii).Interior.Color= 15527148
						ENDFOR 
						
					ELSE
						lnpar=1
					ENDIF 
				
				CASE lnTipoEstFin=7		&&&& Flujo de Efectivo
					IF lnTipoFlu=tipofEfvo
					ELSE 
						lnTipoFlu=tipofEfvo
						lnFila=lnFila+1
					ENDIF 
					xlsheet.Cells(lnFila,1).Value = RTRIM(cuenta)
					FOR i=1 to lnCol
						lcCampoValor=laCol(i+lnColRestar-1,1)
						IF tipofEfvo=1 OR (tipofEfvo>1 AND idcuenta>1) 
							xlsheet.Cells(lnFila,i+lnColSumar).Value =  &lcCampoValor
						ENDIF 
					ENDFOR 
				*	xlsheet.Cells(lnFila,2).Value = ALLTRIM(saldo)
					
					IF lnpar=1
						lnpar=0
						FOR iii=1 TO lnCol+lnColSumar
							xlsheet.Cells(lnFila,iii).Interior.Color= 15527148
						ENDFOR 
					ELSE
						lnpar=1
					ENDIF 
					
					IF ano=0
						xlsheet.Cells(lnFila,1).Font.Bold = 'True'	
						FOR iii=1 TO lnCol+lnColSumar
							xlsheet.Cells(lnFila,iii).Font.Bold = 'True'	
						ENDFOR 
					ENDIF 
			ENDCASE 
		endscan		

		lcRutaGuardarArchivo=pcsysdir+"DocumentosXLS"
		IF !DIRECTORY(lcRutaGuardarArchivo)
			mkdir(lcRutaGuardarArchivo) 
		ENDIF 
		DO CASE
			CASE lnTipoEstFin=2		&&&& Balance general
				lcNombreFileCliente=STRTRAN(ALLTRIM("Balance General")," ","_")
			CASE lnTipoEstFin=2		&&&& Balanza
				lcNombreFileCliente=STRTRAN(ALLTRIM("Balanza de Comprobacion")," ","_")
			CASE lnTipoEstFin=3		&&&& Auxiliar Contable
				lcNombreFileCliente=STRTRAN(ALLTRIM("Auxiliar Contable")," ","_")
			CASE lnTipoEstFin=4		&&&& Diario Mayor
				lcNombreFileCliente=STRTRAN(ALLTRIM("Diario Mayor")," ","_")
			CASE lnTipoEstFin=5		&&&& Razones financieras
				lcNombreFileCliente=STRTRAN(ALLTRIM("Razones Financieras")," ","_")
			CASE lnTipoEstFin=6		&&&& CAmbios en el Patrimonio
				lcNombreFileCliente=STRTRAN(ALLTRIM("Cambios en el Patrimonio")," ","_")
			CASE lnTipoEstFin=6		&&&& CAmbios en el Patrimonio
				lcNombreFileCliente=STRTRAN(ALLTRIM("Flujo de Efectivo")," ","_")
			OTHERWISE 
				lcNombreFileCliente=STRTRAN(ALLTRIM("No Definido")," ","_")
		ENDCASE 
		
		IF llgenerexls=.t.
			lcNombreFileCliente=STRTRAN(lcNombreFileCliente,":","")
			lcNombreFileCliente=STRTRAN(lcNombreFileCliente,".","")
			lcNombreFileCliente=STRTRAN(lcNombreFileCliente,",","")
			lcNombreFileCliente=STRTRAN(lcNombreFileCliente,"/","")
			lcNombreFileCliente=STRTRAN(lcNombreFileCliente,"\","")
			lcNombreFileCliente=STRTRAN(lcNombreFileCliente,"*","")

			lcFechaHoraFile=STRTRAN(TTOC(DATETIME())," ","_")
			lcFechaHoraFile=STRTRAN(lcFechaHoraFile,":","")
			lcFechaHoraFile=STRTRAN(lcFechaHoraFile,".","")
			lcFechaHoraFile=STRTRAN(lcFechaHoraFile,",","")
			lcFechaHoraFile=STRTRAN(lcFechaHoraFile,"/","")
			lcFechaHoraFile=STRTRAN(lcFechaHoraFile,"\","")
			lcFechaHoraFile=STRTRAN(lcFechaHoraFile,"*","")
			
			lcRutaAchivo=lcRutaGuardarArchivo+"\"+lcNombreFileCliente+" - "+lcFechaHoraFile
			.ActiveWorkbook.SaveAs(lcRutaAchivo)&& Guarda el libro. 
		ENDIF 
		.Visible = .T.
	ENDWITH
	WAIT WINDOW 'Terminado' NOWAIT 
	RETURN .t.
ENDFUNC 





FUNCTION EnviarAnexosConta(lnTipoEstFin,lcCurEstFin,lnNumColum,lcTitFechaEstFin)
	**** lnTipoEstFin  1 Balance General, 2 = Balanza de Comprobacion, 5 Razones Financieras 6 cambios en el patrimonio
	**** lnNumColum    (numero de Columnas del Select)
	**** lcCurEstFin    (Cursor de donde se tomaran los Datos)
	**** lcTitFechaEstFin (titulo para la Fecha del Reporte Eje. del 1 al 31 de Agosto de 2018)
	sndata=0
	
	WAIT WINDOW "Procesando...." NOWAIT 
	Local oExcel
	oExcel = Createobject("Excel.Application")

	GO top
	
*	_VFP.DataToClip(lcCursor,lnreg,3)

	#DEFINE xlCenter -4108
	#UNDEFINE xlTop
	#DEFINE xlTop -4160	
	#DEFINE xlRight -4152
	lnColRestar=0
	lnColSumar=0
	With oExcel
		.WorkBooks.Add
		xlsheet = .ActiveSheet

		***** ANCHO DE LAS COLUMNAS

		WITH xlsheet
			.COLUMNS("A:A").ColumnWidth = 15.00
			.COLUMNS("B:B").ColumnWidth = 70.00
			.COLUMNS("C:C").ColumnWidth = 20.00
			.COLUMNS("A:A").NumberFormat = "@"
			.COLUMNS("B:B").NumberFormat = "@"
			.COLUMNS("C:C").NumberFormat = "#,##0.00"
		ENDWITH
	
		lnFila= 1


		***** ENCABEZADO DEL ARCHIVO
		xlsheet.Cells(lnFila,2).Value = ALLTRIM(pcNomEmpresa)
		WITH xlsheet.Range("A1:C1")
			.Font.Bold = 'True'
			.Font.ColorIndex = 11
			.Font.Size = '18'
			.WrapText = 'False'
			.Merge
			.HorizontalAlignment = xlCenter
			.VerticalAlignment = xlTop
		ENDWITH

		lnFila= lnFila+ 1
		xlsheet.Cells(lnFila,1).Value = IIF(lnTipoEstFin=1,"ANEXOS AL ESTADO DE SITUACION FINANCIERA","ANEXOS AL ESTADO DE RESULTADO")
		WITH xlsheet.Range("A2:C2")
			.Font.Bold = 'True'
			.Font.Size = '14'
			.WrapText = 'False'
			.Merge     
			.HorizontalAlignment = xlCenter
			.VerticalAlignment = xlCenter
		ENDWITH
		lnFila= lnFila+ 1
		**xlsheet.Cells(lnFila,2).Value = ALLTRIM(lcTitFechaEstFin)
		xlsheet.Cells(lnFila,2).Value =lcTitFechaEstFin
		WITH xlsheet.Range("A3:C3")
			.Font.Bold = 'True'
			.Font.Size = '11'
			.WrapText = 'False'
			.Merge     
			.HorizontalAlignment = xlCenter
			.VerticalAlignment = xlCenter
		ENDWITH
			
		lnFila= lnFila+ 1

	
		lcCod="*****"
		lntotal=0
		llresumen=.f.


		lnFila= lnFila+ 1
		****** TITULO DE LAS COLUMANAS
		xlsheet.Cells(lnFila,1).Value = "CUENTA"
		xlsheet.Cells(lnFila,2).Value = "DESCRIPCION"
		xlsheet.Cells(lnFila,3).Value = "SALDO FINAL"

		WITH xlsheet.Range("A5:C5")
			.Font.Bold = 'True'
			.WrapText = 'True'
			.HorizontalAlignment = xlCenter
			.VerticalAlignment = xlCenter
		ENDWITH
			

		lnFila= lnFila+ 1
		WITH xlsheet.Range("A5:C5")
			.Font.Bold = 'True'
			.WrapText = 'False'
			.Interior.ColorIndex = 11
			.Font.ColorIndex =2
			.HorizontalAlignment = xlCenter
*			.Borders(1).LineStyle=1
*			.Borders(2).LineStyle=1
*			.Borders(3).LineStyle=1
*			.Borders(4).LineStyle=1
		ENDWITH

		SELECT (lcCurEstFin)
		GO top
		lnpar=0
		IF lnTipoEstFin=7
			lnTipoFlu=1
		ELSE
			lnTipoFlu=0
		ENDIF
		 
		SCAN FOR idcuenta<>0 
			lnFila= lnFila+ 1
			xlsheet.Cells(lnFila,1).Value = codcta
			IF nivel<=pnnivelmayor
				xlsheet.Cells(lnFila,1).Font.Bold = 'True'
				xlsheet.Cells(lnFila,2).Font.Bold = 'True'
			ENDIF 
			xlsheet.Cells(lnFila,2).Value = SPACE(IIF(nivel=0,1,(nivel-1)*4))+ALLTRIM(cuenta)
			xlsheet.Cells(lnFila,3).Value = saldoFIN*IIF(naturaleza=2,-1,1)
			

			IF lnpar=1
				lnpar=0
				FOR iii=1 TO 3
					xlsheet.Cells(lnFila,iii).Interior.Color= 15527148
				ENDFOR 
			ELSE
				lnpar=1

			ENDIF 
				
		endscan		

		lcRutaGuardarArchivo=pcsysdir+"DocumentosXLS"
		IF !DIRECTORY(lcRutaGuardarArchivo)
			mkdir(lcRutaGuardarArchivo) 
		ENDIF 
		DO CASE
			
			CASE lnTipoEstFin=1		&&&& Balanza
				lcNombreFileCliente=STRTRAN(ALLTRIM("Anexos_Estado_Situacion_Financiera")," ","_")
			CASE lnTipoEstFin=2		&&&& Auxiliar Contable
				lcNombreFileCliente=STRTRAN(ALLTRIM("Anexos_Estado_de_Resultados")," ","_")
		ENDCASE 
		
		lcNombreFileCliente=STRTRAN(lcNombreFileCliente,":","")
		lcNombreFileCliente=STRTRAN(lcNombreFileCliente,".","")
		lcNombreFileCliente=STRTRAN(lcNombreFileCliente,",","")
		lcNombreFileCliente=STRTRAN(lcNombreFileCliente,"/","")
		lcNombreFileCliente=STRTRAN(lcNombreFileCliente,"\","")
		lcNombreFileCliente=STRTRAN(lcNombreFileCliente,"*","")

		lcFechaHoraFile=STRTRAN(TTOC(DATETIME())," ","_")
		lcFechaHoraFile=STRTRAN(lcFechaHoraFile,":","")
		lcFechaHoraFile=STRTRAN(lcFechaHoraFile,".","")
		lcFechaHoraFile=STRTRAN(lcFechaHoraFile,",","")
		lcFechaHoraFile=STRTRAN(lcFechaHoraFile,"/","")
		lcFechaHoraFile=STRTRAN(lcFechaHoraFile,"\","")
		lcFechaHoraFile=STRTRAN(lcFechaHoraFile,"*","")
		
		lcRutaAchivo=lcRutaGuardarArchivo+"\"+lcNombreFileCliente+" - "+lcFechaHoraFile
		.ActiveWorkbook.SaveAs(lcRutaAchivo)&& Guarda el libro. 
		
		.Visible = .T.
	ENDWITH
	WAIT WINDOW 'Terminado' NOWAIT 
	RETURN .t.
ENDFUNC 



FUNCTION EnviarCatalogoaExcel(lnTipoEstFin,lcCurEstFin)
	**** lnTipoEstFin  		1 productos, 2 antiguedad de Saldo,3 catalogo de clientes,4 catalogo de proveedores
