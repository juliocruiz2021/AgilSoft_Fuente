	IF EMPTY(lcWhere)
		lcWhere=' where id'+lcCampos+'='+ALLTRIM(STR(lnIdBuscar ))+' '
	ELSE
		lcWhere=' where id'+lcCampos+'='+ALLTRIM(STR(lnIdBuscar ))+' and '+lcWhere+' '
	ENDIF 
*!*		
*!*		IF USED(lcCursor)
*!*			TABLEREVERT(.t.,lcCursor)
*!*		ENDIF 

	lcNombre=lcCampos
	DO case
		CASE lcCampos="usuario"
			lcNombre="nombre"
	ENDCASE

	lcMasCampos=""
	DO case
		CASE lcTabla="tipodocumentos"
			lcMasCampos=",ventas as ctrol, lineas,tipofac,cxc,cxp,inventarios"

		CASE lcTabla="sucursales"
			lcMasCampos=",(select MIN(b.idbodega) from bodegas b where b.idsucursal=sucursales.idsucursal) as idbodega "
	endcase
		
	lnCtrlSql=miSQLEXEC(lnIdCon,'select COUNT(0) as cuenta, '+lcNombre+' as nom '+lcMasCampos+' from '+lcTabla+' '+lcWhere+' '+' limit 0,1;','c_Buscar_'+lcCampos)

	IF VAL(cuenta)=0
		lnRetorna=''
	ELSE
		lnRetorna=ALLTRIM(nom)
	ENDIF 
	
	DO case
		CASE lcTabla="tipodocumentos"
			IF VAL(cuenta)=0
				pnTipoCtrol=0
				pnTipoLineas=0
				pnTipoFac=0
				pnTipoCtrolCXC=0
				pnTipoCtrolCXP=0
				pnTipoCtrolInv=0
			ELSE
				pnTipoCtrol=Ctrol
				pnTipoLineas=Lineas
				pnTipoFac=tipofac
				pnTipoCtrolCXC=cxc
				pnTipoCtrolCXP=cxp
				pnTipoCtrolInv=inventarios
			ENDIF 
		CASE lcTabla="sucursales"
			PUBLIC lnbuscaridbodega
			lnbuscaridbodega=idbodega
	endcase
	
	USE IN ('c_Buscar_'+lcCampos)
	
	IF !EMPTY(lcfalias)
		SELECT (lcfalias)
	ENDIF 
		
	RETURN lnRetorna
ENDFUNC 


