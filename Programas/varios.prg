	lccomansqlBus='select MAX(a.idusuario) as idusuario from '+lctabla1+' a inner join '+lctabla2+' b on a.idusuario=b.idusuario '+;
					'where a.usuario="'+lcUsuAutoRemoto+'" and b.idmodulo='+ALLTRIM(STR(lnModuloAutoRemoto))+' and permiso=5  ' 
	
	lnCtrlSql=miSQLEXEC(lnIdCon,lccomansqlBus,'c_Buscar_UsuarioAutorizaRemoto')

	**** si es producto se deja la base de datos abierta para pasar los datos al grid
	
	resultadoretorna=c_Buscar_UsuarioAutorizaRemoto.idusuario
	
	IF TYPE('resultadoretorna')<>'N'
		lnRetorna=VAL(resultadoretorna)
	ELSE
		lnRetorna=NVL(resultadoretorna,0)
	ENDIF 
	
	IF !EMPTY(lcfalias)
		SELECT (lcfalias)
	ENDIF 
	
	IF used('c_sisU')=.t.
		USE IN c_sisU
		USE IN c_sisP
	ENDIF 
	
	USE IN c_Buscar_UsuarioAutorizaRemoto
	
	RETURN lnRetorna
ENDFUNC 


