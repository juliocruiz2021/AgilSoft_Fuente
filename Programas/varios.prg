FUNCTION _CalucularTimpo(ldtini,dltfin)
	lctiempototal=''
	lnTiempoTotal=(dltfin-ldtini)/60.000
	IF lnTiempoTotal>1
		lnmin=INT(lnTiempoTotal)
		lnseg=(lnTiempoTotal-lnmin)*60
	
		IF lnmin>60
			lnHrs=INT(lnmin/60)
			lnmin=INT(((lnmin/60)-lnHrs)*60)
		ELSE
			lnHrs=0
		ENDIF 
		lcSeg=PADL(ALLTRIM(STR(lnseg)),2,"0")
		lcmin=PADL(ALLTRIM(STR(lnmin)),2,"0")
		lchrs=PADL(ALLTRIM(STR(lnhrs)),2,"0")
		lctiempototal=lchrs+':'+lcmin+':'+lcSeg
	ELSE
		lcRotuloTiempo='Seg: '
		lnseg=lnTiempoTotal*60
		lcSeg=PADL(ALLTRIM(STR(lnseg)),2,"0")
		lctiempototal="00:00:"+lcSeg
	ENDIF 

	RETURN lctiempototal
ENDFUNC 





FUNCTION _PromedioConsumoSemestral(lnidcliprov,lnMesesProm)
	IF PCOUNT()=1
		lnMesesProm=3
	ENDIF 
	lcaliaspro=ALIAS()
	ldfec1g=ObtenerDatosdeMes(DATE(),4,lnMesesProm)+1
	
	ldfec2g=DATE()
	
	USE pcSysDir+pcDB+"\cyvlecturas" IN 0 ALIAS c_data SHARED AGAIN 
	
	SELECT AVG(cc.consumo) as promedio ;
			FROM (SELECT MAX(SUBSTR(DTOS(a.fecha),1,6)) as periodo,;
						SUM(ROUND(a.consumo,2)) as consumo,MONTH(a.fecha) as mes,YEAR(a.fecha) as ano ;
					from c_data a ;
					WHERE a.eliminado=0 AND a.status=1 AND a.idclipro=lnidcliprov AND ;
							BETWEEN(a.fecha,ldfec1g,ldfec2g)  GROUP BY ano,mes) as cc ;
		INTO ARRAY laPromedio
	USE IN c_data

	
	IF !EMPTY(lcaliaspro)
		SELECT (lcaliaspro)
	ENDIF 
	
	RETURN laPromedio
	
ENDFUNC 



FUNCTION NombreTipoPago(lntippp)
	
	DO case
		CASE lntippp=1
			lcTipPPPP="Diarias    "
		CASE lntippp=2
			lcTipPPPP="Semanal    "
		CASE lntippp=3
			lcTipPPPP="Quincenal  "
		CASE lntippp=4
			lcTipPPPP="Mensual    "
		OTHERWISE 
			lcTipPPPP="           "
	ENDCASE
	
	RETURN lcTipPPPP
ENDFUNC 



FUNCTION obtenerCantidadCuotasdeMeses(lnMesesCuota,lntipoPagoCuota)
	DO case
		CASE lntipoPagoCuota=1
			lnDivisor=30
		CASE lntipoPagoCuota=2
			lnDivisor=4
		CASE lntipoPagoCuota=3
			lnDivisor=2
		CASE lntipoPagoCuota=4
			lnDivisor=1
		OTHERWISE 
			lnDivisor=1
	ENDCASE 
	
	RETURN lnMesesCuota*lnDivisor
ENDFUNC 



FUNCTION _CalcularDebeSer(lnMon,lnTipPag,lnIntMens,lnCuot,ldFecPresta,lcCursorMacamor,lnidptmo,lccli,lctip,lnpla,llRetorInt)
						  
	lcAliasMaca=ALIAS()
	
	lnMiCPres=_CalcularcuotaPrestamo(lnMon,lnTipPag,lnIntMens,lnCuot)
	
	IF EMPTY(NVL(lcCursorMacamor,""))
		lcCursorMacamor="c_Macamor"
	ENDIF 
	
	IF EMPTY(ldFecPresta)
		ldFecPresta=DATE()
	ENDIF 
	
	CREATE CURSOR (lcCursorMacamor) (Monto n(16,2),cuota i,fechaCuota d,dias i,IntDiario n(16,8),Interes n(16,2),capital n(16,2),;
					cuotaPago n(16,2), saldo n(16,2), id i, cli c(250),tip c(200),pla n(16,2),fecini d)
	lnSaldo=lnMon
	ldFecIni=ldFecPresta
	FOR i=1 TO lnCuot
		ldFecFin=ObtenerDatosdeMes(ldFecIni,lnTipPag+4,0)
		lnNewInt=_CalcularInteresCuota(lnSaldo,lnTipPag,lnIntMens)
		*lnNewInt=_CalcularInteresExacto(lnSaldo,lnIntMens,ldFecIni,ldFecFin)
		
		INSERT INTO (lcCursorMacamor) ;
			VALUES (lnMon,i,ldFecFin,ldFecFin-ldFecIni,;
					ROUND((lnNewInt+0.00000000)/(ldFecFin-ldFecIni),8),lnNewInt,lnMiCPres-lnNewInt,;
					lnMiCPres,lnMon-(lnMiCPres-lnNewInt),lnIdPtmo,lccli,lctip,lnpla,ldfecpresta)
		
		lnSaldo=ROUND(lnMon-(lnMiCPres-lnNewInt),2)
		lnMon=lnSaldo
		ldFecIni=ldFecFin
		
	ENDFOR 
	
	IF saldo<>0
		lnNewCuota=monto+Interes
		lnNewcap=monto
	
		REPLACE capital WITH lnNewcap, cuotapago WITH lnNewCuota, saldo WITH 0 NEXT 1
	ENDIF 
	SUM ALL Interes  TO lnTotInteres
	IF !EMPTY(lcAliasMaca)
		SELECT (lcAliasMaca)
	ENDIF 
	IF llRetorInt=.t.
		USE IN (lcCursorMacamor)
	ENDIF 
	RETURN lnTotInteres
ENDFUNC 



