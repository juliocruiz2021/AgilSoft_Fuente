FUNCTION ImprimirInventarios(lnIdDocto as Integer,lnCtrl as Integer ,lnIdConec as integer,lnTipoConec as integer)
	**** se paso como parametro el numero de documento a imprimir
	**** lnCtrl 1=Imprimir Directo al Impresor ;
				2=Imprimir con Previsualizacion y ;
				3=Mostrar Formulario para Editar

	LOCAL lcAlias,lnidSQL
	lnidSQL=0
	lcAlias=ALIAS()
	lnidSQL=_conecta(pcDB)

	USE pcSysDir+pcdb+"\invinventarios" SHARED AGAIN ORDER iddocto IN 0 ALIAS impvta
	USE pcSysDir+pcdb+"\invinventariosdeta" SHARED AGAIN ORDER iddoctod IN 0 ALIAS impvtad
	USE pcSysDir+pcdb+"\siscata" SHARED AGAIN ORDER id IN 0 ALIAS impcata
	USE pcSysDir+pcdb+"\sistipodoctos" SHARED AGAIN ORDER idtipodocto IN 0 ALIAS imptdoc
	USE pcSysDir+pcdb+"\sisseries" SHARED AGAIN ORDER idserie IN 0 ALIAS impser
	USE pcSysDir+pcdb+"\cybcajabancos" SHARED AGAIN ORDER idcajban IN 0 ALIAS impcaj
	USE pcSysDir+pcdb+"\invproductos" SHARED AGAIN ORDER idproducto IN 0 ALIAS impprod
	USE pcSysDir+pcdb+"\cyvclipro" SHARED AGAIN ORDER idclipro IN 0 ALIAS impcp

	lcPrintActual=SET("PRINTER", 3)


	IF lnidSQL>0
		lcPrintActual=SET("PRINTER", 3)
		lcComando0="SELECT t1.*,NVL(t12.codclipro,SPACE(50)) as codclipro,NVL(t12.clipro,SPACE(200)) as clipro,t4.TipoDocto,t4.clave,t5.serie,"+;
						"t9.cod as codSucursal,t9.nombre as sucursal,t9.notas as direccionsuc,"+;
						"t10.cod as codSucursaltras,t10.nombre as sucursaltras,t10.notas as direccionsuctras,t4.tipoicv,"+;
						"t11.unidadmedida,pcnomempresa as nomempresa,pcgiro as giroempresa,pcnit as nitempresa,pcnrc as nrcempresa "+;
						"FROM impvta t1 "+;
							"inner join impvtad t2 on t1.iddocto=t2.iddocto "+;
							"inner join imptdoc t4 on t1.idtipodocto=t4.idtipodocto "+;
							"inner join impser t5 on t1.idserie=t5.idserie "+;
							"left join impcata t9 on t1.idsucursal=t9.id and t9.origen='SUC' "+;
							"left join impcata t10 on t1.idsucursaltras=t10.id and t10.origen='SUC' "+;
							"left join impprod t11 on t2.idproducto=t11.idproducto "+;
							"left join impcp t12 on t1.idclipro=t12.idclipro "+;
							"where t1.iddocto="+ALLTRIM(STR(lnIdDocto))+" "

		lnCtrlSql=miSQLEXEC(lnidSQL,lcComando0,'c_imp')
		lcidsucpre=ALLTRIM(STR(IIF(NVL(c_imp.idsucursaltras,0)=0,c_imp.idsucursal,c_imp.idsucursaltras)))
		
		lnTipoICVPrn=c_imp.tipoicv
		
		IF lnCtrlSql>0
			lcComando0="SELECT t2.*,t4.TipoDocto,t4.clave,"+;
							"t5.serie,t6.idimpuestoiva, "+;
							"pcnomempresa as empresa,pcgiro as giro,pcnit as nit,pcnrc as nrc,t11.unidadmedida,"+;
							"IIF(t6.idagrupador=0,t6.idproducto,t6.idagrupador) as idagrupador, t6.codprod, "+;
							"nvl(t7.cod,t6.codprod) as codagrupador,NVL(t7.nombre,t2.producto) as agrupador, "+;
							"t6.precioconiva,t6.preciosiniva,t99.lote "+;
							"FROM impvta t1 "+;
								"inner join impvtad t2 on t1.iddocto=t2.iddocto "+;
								"inner join imptdoc t4 on t1.idtipodocto=t4.idtipodocto "+;
								"inner join impser t5 on t1.idserie=t5.idserie "+;
								"inner join impprod t6 on t2.idproducto=t6.idproducto "+;
								"left join invlotes t99 on t2.llavelote=t99.idlote "+;
								"left join impcata t7 on t6.idagrupador=t7.id and t7.origen='AGR' "+;
								"left join impprod t11 on t2.idproducto=t11.idproducto "+;
								"order by codagrupador,t6.codprod "+;
								"where (t2.esmaterial=1 or (t2.esmaterial=0 and t2.esfabricado=0)) and t2.eliminado=0 and t1.iddocto="+ALLTRIM(STR(lnIdDocto))+" "

			lnCtrlSql=miSQLEXEC(lnidSQL,lcComando0,'c_impdetatmp')
			
			if !EOF()
				***** cambiando precios de los movimientos
				SELECT a.idproducto,a.precioconiva,a.preciosiniva FROM invprodprecios a ;
							INNER JOIN invprodlistaspre b on a.idlistapre=b.idlistapre AND b.status=1 and b.tipolista=1 and b.idsucursal=VAL(lcidsucpre) ;
							WHERE a.idproducto in (SELECT idproducto FROM c_impdetatmp) ;
							ORDER BY a.idproducto,a.precioconiva INTO CURSOR cc_pre READWRITE 
				SELECT c_imp
				UPDATE c_impdetatmp SET c_impdetatmp.precioconiva=a.precioconiva,c_impdetatmp.preciosiniva=a.preciosiniva from cc_pre a WHERE c_impdetatmp.idproducto=a.idproducto 
				USE IN cc_pre
				GO top		
				
				lnidtd=idtipodocto
				lnidse=idserie
				lnidsu=idsucursal
				lcComando0="SELECT TOP 1 * FROM (SELECT 0 as llave,*,SPACE(250) as print2 FROM sisformatos WHERE idtipodocto="+ALLTRIM(STR(lnidtd))+" AND idserie="+ALLTRIM(STR(lnidse))+" AND idsucursal="+ALLTRIM(STR(lnidsu))+" "+;
								"UNION ALL "+;
								"SELECT 1 as llave,*,SPACE(250) as print2 FROM sisformatos WHERE idtipodocto="+ALLTRIM(STR(lnidtd))+" AND idserie="+ALLTRIM(STR(lnidse))+" AND idsucursal=="+ALLTRIM(STR(lnidsu))+" "+;
								"UNION ALL "+;
								"SELECT 2 as llave,*,SPACE(250) as print2 FROM sisformatos WHERE idtipodocto="+ALLTRIM(STR(lnidtd))+" AND idserie="+ALLTRIM(STR(lnidse))+") as t0 "+;
							"ORDER BY t0.llave,t0.idtipodocto" 
				lnCtrlSql2=miSQLEXEC(lnidSQL,lcComando0,'c_formatosTmp')
				lnImpresor2Prn=c_formatosTmp.impresor2
				
				IF lnCtrlSql2>0
					lntipprint=1
					IF impresor2<>0
						lntipprint=impresor2
						lcimpresortmp=ObtieneImpresores(lnidSQL,lntipprint)
						REPLACE print2 WITH lcimpresortmp NEXT 1
					ENDIF
					GO top
					lcArchivo=ALLTRIM(archivo)
					lcPrinter=ALLTRIM(impresor1)
					lcPrinter2=ALLTRIM(print2)
					lnTipoImpresion=tipoimpresion
					lnTipoDetalle=tipodetalle
					lnCopiasPrint=IIF(copias=0,1,copias)
	
					SELECT c_imp					
					IF !EMPTY(lcArchivo) and FILE(pcSysDir+pcdb+"\formatos\"+lcArchivo)

						STORE SET("Printer",3) TO lcPrinOld
						IF !EMPTY(lcPrinter)
							APRINTERS(lcImipresores)
							llimpresorExiste=.f.
							FOR i=1 TO ALEN(lcImipresores)/2
								IF ALLTRIM(UPPER(lcImipresores(i,1)))=ALLTRIM(UPPER(lcPrinter))
									llimpresorExiste=.t.
									EXIT 
								ENDIF 
							ENDFOR 
							
							IF llimpresorExiste=.t.
								SET PRINTER TO NAME (lcPrinter)
							ENDIF 
							*************************
							IF pnUsaRedirec=1		&&&& usandoa impresor redireccionado
								lcPrinter=ImpresorRedireccionado(lnTipoICVPrn,lnImpresor2Prn)
								SET PRINTER TO NAME (lcPrinter)
							ENDIF 

						ELSE
							IF !EMPTY(lcPrinter2)
								APRINTERS(lcImipresores)
								llimpresorExiste=.f.
								FOR i=1 TO LEN(lcImipresores)-1
									IF ALLTRIM(UPPER(lcImipresores(i,1)))=ALLTRIM(UPPER(lcPrinter2))
										llimpresorExiste=.t.
										EXIT 
									ENDIF 
								ENDFOR 
								
								IF llimpresorExiste=.t.
									lcPrinter=lcPrinter2
									SET PRINTER TO NAME (lcPrinter2)
								ENDIF 
							ENDIF 
						ENDIF 
						
						llseimprimio=0
						CREATE CURSOR c_memo (bultos m)
						SELECT c_impdetaTmp
						
						IF lnTipoDetalle=3		&&&& impresion agrupada
							SELECT t0.*,cc.*,(SELECT bultos FROM c_memo) as bultos FROM c_impdetaTmp t0 INNER JOIN ;
									(SELECT  MIN(iddoctod) as iddoctodg,SUM(cantiunimed) as cantidadG ,codagrupador as codagrupadorg,;
											MAX(agrupador) as agrupadorg,SUM(costototal) as costototalg,SUM(precioconiva) as precioconiva,SUM(preciosiniva) as preciosiniva ;
										FROM c_impdetaTmp ORDER BY codagrupador GROUP BY codagrupador) as cc on t0.iddoctod=cc.iddoctodg ;
								INTO CURSOR c_impdeta READWRITE ORDER BY t0.codprod
						ELSE
							IF lnTipoDetalle=4	&&&& impresion por Bulto
								SELECT t0.*,cc.*,(SELECT bultos FROM c_memo) as bultos FROM c_impdetaTmp t0 INNER JOIN ;
										(SELECT  MIN(a.iddoctod) as iddoctodg,SUM(a.cantiunimed) as cantidadG ,MAX(a.codprod) as codagrupadorg,;
												MAX(a.producto) as agrupadorg,SUM(a.costototal) as costototalg,SUM(precioconiva) as precioconiva,SUM(preciosiniva) as preciosiniva  ;
											FROM c_impdetaTmp a ORDER BY a.idproducto GROUP BY a.idproducto) as cc on t0.iddoctod=cc.iddoctodg ;
									INTO CURSOR c_impdeta READWRITE ORDER BY t0.codprod
								SELECT codprod,cantiunimed FROM c_impdetaTmp ORDER BY codprod INTO CURSOR c_bultostmp
								SELECT c_bultostmp
								lccodigo='***'
								lcbulto=''
								lccomabulto=', '
								lncuentabul=1
								lnCuentaBultos=0
								SCAN 
									lnCuentaBultos=lnCuentaBultos+1
									IF lccodigo==codprod
										lncuentabul=lncuentabul+1
										lcbulto=lcbulto+lccomabulto+" [B:"+ALLTRIM(STR(lnCuentaBultos))+"- "+ALLTRIM(STR(cantiunimed))+"]"
										
										UPDATE c_impdeta SET bultos='(Bultos: '+ALLTRIM(STR(lncuentabul,12,0))+') '+lcbulto WHERE codprod==lccodigo
									ELSE
										lccodigo=codprod
										lncuentabul=1
										lcbulto=" [B:"+ALLTRIM(STR(lnCuentaBultos))+"- "+ALLTRIM(STR(cantiunimed))+"]"
										UPDATE c_impdeta SET bultos='(Bultos: '+ALLTRIM(STR(lncuentabul,12,0))+') '+lcbulto WHERE codprod==lccodigo
									ENDIF 
								ENDSCAN 
								USE IN c_bultostmp
								SELECT c_impdeta
							ELSE 
								SELECT t0.*,cc.*,(SELECT bultos FROM c_memo) as bultos FROM c_impdetaTmp t0 INNER JOIN ;
										(SELECT  iddoctod as iddoctodg,sum(cantiunimed) as cantidadG ,MAX(codagrupador) as codagrupadorg,;
												MAX(agrupador) as agrupadorg,SUM(costototal) as costototalg  ;
											FROM c_impdetaTmp ORDER BY iddoctod GROUP BY iddoctod) as cc on t0.iddoctod=cc.iddoctodg ;
									INTO CURSOR c_impdeta READWRITE ORDER BY t0.codprod
							ENDIF 
						ENDIF 
						USE IN c_impdetaTmp
						USE IN c_memo
						SELECT c_impdeta
						
						IF lnCtrl=2	OR	lnCtrl=1
							lcPrintActual=SET("PRINTER", 3)
							lcPrintActual2=SET("PRINTER", 3)
							_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)
	
							IF lnCtrl=2
								MODIFY REPORT pcSysDir+pcdb+"\formatos\"+lcArchivo
							ELSE 
								*lcPrintActual2=lcPrintActual
								REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER  NOCONSOLE  NAME lcPrintActual
								lcPrintActual=lcPrintActual2
								llseimprimio=1
							ENDIF 	
						ELSE 
							lcPrintActual=SET("PRINTER", 3)
							lcPrintActual2=SET("PRINTER", 3)
							_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)

							DO case
								CASE lnTipoImpresion=1
										lnsn=MESSAGEBOX("Desea Ver el Documento ?",4+32+256,"Imprimir...")
										IF lnsn=6
											WAIT WINDOW 'Imprimiendo Documento... ' NOWAIT 
											REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER PROMPT PREVIEW NOCONSOLE 
											llseimprimio=1
										ENDIF 
								CASE lnTipoImpresion=2
										lnsn=MESSAGEBOX("Desea Imprimir el Documento ?",4+32+256,"Imprimir...")
										IF lnsn=6
											WAIT WINDOW 'Imprimiendo Documento... ' NOWAIT 
											FOR iprin=1 TO lnCopiasPrint
												*lcPrintActual=lcPrintActual2
												REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER NOCONSOLE NAME lcPrintActual
												lcPrintActual2=lcPrintActual
											ENDFOR 
											llseimprimio=1
										ENDIF 
								CASE lnTipoImpresion=3
										REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER PREVIEW NOCONSOLE 
										llseimprimio=1
								CASE lnTipoImpresion=4
										FOR iprin=1 TO lnCopiasPrint
											*lcPrintActual=lcPrintActual2
											REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER NOCONSOLE NAME lcPrintActual
											lcPrintActual2=lcPrintActual
										ENDFOR 
										llseimprimio=1
							ENDCASE
						ENDIF 
						GO TOP IN c_impdeta
						
						IF !EMPTY(lcPrinOld)
							SET PRINTER TO NAME (lcPrinOld)
						ENDIF 
						GO TOP IN c_imp
						IF c_imp.impreso=0 AND llseimprimio=1		&&& cambiando status de Impreso
							=miSQLEXEC(lnidSQL,"update impvta set impreso=1 where impreso=0 and iddocto="+ALLTRIM(STR(lnIdDocto))+" ")
						ENDIF
					ELSE 
					 MESSAGEBOX('No se encontro el Archivo del Formato de impresion....  '+lcArchivo,16,'Error al Imprimir...')
					ENDIF 
				ELSE
					MESSAGEBOX('No se Encontro el Formato de Impresion para este Documento....',16,'Error al Imprimir...')
				ENDIF 
			ELSE
				MESSAGEBOX('No se Encontro el Documento....',16,'Error al Imprimir...')
			ENDIF 
		ELSE
			_MostrarErroresSQL(lnidSQL)
		ENDIF 
		*USE in c_imp
		IF USED("c_impdeta")
		*	USE IN c_impdeta
		ENDIF 
		=miSQLDISCONNECT(lnidSQL)
	ELSE
		MESSAGEBOX("Imposible conectarse con el Servidor... Intente más tarde...",16,'Error de Conección...')
	ENDIF 
	USE IN impvta
	USE IN impvtad
	USE IN impcata
	USE IN imptdoc
	USE IN impser
	USE IN impcaj
	USE IN impprod
	USE IN impcp
	
	IF !EMPTY(lcAlias)
		SELECT (lcAlias)
	ENDIF 
ENDFUNC 



FUNCTION ActualizarStatusPartidaImpresa(lnIdSqlDocImp,lnidparDocImp,lcOrigenDocto)
	lcaliasDocImp=ALIAS()
	lcDocImpSig=""

	IF lnidparDocImp<>0 AND lnIdSqlDocImp>0 	&&&& Coneccion lstablecida
		IF pnTipoConeccion=1
			IF lcOrigenDocto="CTB"
				IF !USED("ctbPartidas")
					USE pcSysDir+pcdb+"\ctbPartidas" SHARED AGAIN ORDER idPartida IN 0 
					UPDATE ctbPartidas SET impreso=1,nodo=pcnodo,fecmod=DATETIME() where idPartida=lnidparDocImp AND impreso=0 
					USE IN ctbPartidas
				ELSE
					UPDATE ctbPartidas SET impreso=1,nodo=pcnodo,fecmod=DATETIME() where idPartida=lnidparDocImp AND impreso=0 
				ENDIF 
			ELSE
				IF !USED("cybmovimientos")
					USE pcSysDir+pcdb+"\cybmovimientos" SHARED AGAIN ORDER iddocto IN 0 
					***** jrjrjrjrj
					UPDATE cybmovimientos SET impreso=1,nodo=pcnodo,fecmod=DATETIME() where iddocto=lnidparDocImp AND impreso=0 
					USE IN cybmovimientos
				ELSE
					UPDATE cybmovimientos SET impreso=1,nodo=pcnodo,fecmod=DATETIME() where iddocto=lnidparDocImp AND impreso=0 
				ENDIF 
			ENDIF 
		ELSE 
			IF lcOrigenDocto="CTB"
				lcComandosiguienteNumSerie="UPDATE ctbpartidas SET impreso=1,nodo='"+pcnodo+"',fecmod ='"+_ConvertirToFechaHoraSQL(DATETIME())+"' where idPartida="+;
						ALLTRIM(STR(lnidparDocImp))+"  AND impreso=0 "
				lnCtrlSqlCtaBus=miSQLEXEC(lnIdSqlDocImp,lcComandosiguienteNumSerie,"")
			ELSE
				lcComandosiguienteNumSerie="UPDATE cybmovimientos SET impreso=1,nodo='"+pcnodo+"',fecmod ='"+_ConvertirToFechaHoraSQL(DATETIME())+"' where iddocto="+;
						ALLTRIM(STR(lnidparDocImp))+"  AND impreso=0 "
				lnCtrlSqlCtaBus=miSQLEXEC(lnIdSqlDocImp,lcComandosiguienteNumSerie,"")
			ENDIF 
		ENDIF 
	ENDIF 
	
	IF !EMPTY(lcaliasDocImp)
		SELECT (lcaliasDocImp)
	ENDIF
	 
	RETURN .t.
ENDFUNC 



FUNCTION ActualizarFechaContaIVA(lcOrigenCTBIVA,ldfecCTBIVA)
	lcaliasDo=ALIAS()
	ldRetornaFecha=CTOD(' ')
	
	IF !EMPTY(lcOrigenCTBIVA) AND !EMPTY(ldfecCTBIVA)

		IF pnTipoConeccion=1
			USE pcSysDir+pcdb+"\sisempresas" SHARED AGAIN IN 0 ALIAS sisemp

			IF lcOrigenCTBIVA="CTB"
				UPDATE sisemp SET FechaConta=ldfecCTBIVA where idempresa>0
				
			ELSE
				UPDATE sisemp SET FechaIVA=ldfecCTBIVA where idempresa>0
			ENDIF
			
			IF _tally>0	&&&& la fecha se Actualizo
				IF lcOrigenCTBIVA="CTB"
					pdFechaConta=ldfecCTBIVA
				ELSE
					pdFechaIva=ldfecCTBIVA
				ENDIF
			ENDIF 
			IF lcOrigenCTBIVA="CTB"
				ldRetornaFecha=pdFechaConta
			ELSE
				ldRetornaFecha=pdFechaIva
			ENDIF 				
			 
			USE IN sisemp

		ELSE 
			lnidSQL=_conecta(pcDB)
			IF lnidSQL>0
				IF lcOrigenCTBIVA="CTB"
					lcComandoCTBIVA="UPDATE sisemp SET FechaConta='"+_ConvertirToFechaSQL((ldfecCTBIVA))+"' where idempresa>0 ;"
					lnCtrlSqlCCTBIIVA=miSQLEXEC(lnidSQL,lcComandoCTBIVA,"")
				ELSE
					lcComandoCTBIVA="UPDATE sisemp SET FechaConta='"+_ConvertirToFechaSQL((ldfecCTBIVA))+"' where idempresa>0 ;"
					lnCtrlSqlCCTBIIVA=miSQLEXEC(lnidSQL,lcComandoCTBIVA,"")
				ENDIF 
				
				IF lnCtrlSqlCCTBIIVA>0	&&&& la Fecha se Actualizo
					IF lcOrigenCTBIVA="CTB"
						pdFechaConta=ldfecCTBIVA
					ELSE
						pdFechaIva=ldfecCTBIVA
					ENDIF 
				ENDIF 

				IF lcOrigenCTBIVA="CTB"
					ldRetornaFecha=pdFechaConta
				ELSE
					ldRetornaFecha=pdFechaIva
				ENDIF 	
				
				=miSQLDISCONNECT(lnidSQL)
			ENDIF 
		ENDIF 
	ENDIF 
	
	
	IF !EMPTY(lcaliasDo)
		SELECT (lcaliasDo)
	ENDIF
	 
	RETURN ldRetornaFecha
ENDFUNC 




