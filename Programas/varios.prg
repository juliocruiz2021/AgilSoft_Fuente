	lnDeciPrec=CuantosDecimales(pcmasprecio)
	IF lnidProduc<>0
		USE pcSysDir+pcdb+"\invprodlistaspre" 	IN 0 SHARED AGAIN  ALIAS t_lisPreSug
		USE pcSysDir+pcdb+"\invproductos" 	IN 0 SHARED AGAIN  ALIAS t_prodPreSug
		USE pcSysDir+pcdb+"\invprodprecios" 		IN 0 SHARED AGAIN  ALIAS t_prePrecioSug

		IF .t.
			lcfaliasCtaBus=ALIAS()
			IF lnIdSqlCtaBuscar>0	&&&& Coneccion Establecida
					SELECT TOP 1 ROUND(NVL(b.preciosiniva,0),lnDeciPrec) as precio,a.preciosiniva as precioProd ;
							FROM t_prodPreSug a ;
								LEFT JOIN t_prePrecioSug b ON a.idproducto=b.idproducto ;
								left JOIN t_lisPreSug c  ON b.idlistapre=c.idlistapre AND c.tipolista=3 AND c.status=1 AND c.eliminado=0 AND IIF(EMPTY(ldFecPrec),.t.,c.fechaini<=ldFecPrec) ;
							WHERE a.idproducto=lnidProduc;
					ORDER BY fechaini DESC INTO CURSOR c_presugeprov READWRITE 
					REPLACE precio WITH NVL(precio,0), precioProd WITH NVL(precioProd,0) all
					GO top
				lnpreretornsa=ROUND(IIF(c_presugeprov.precio=0,c_presugeprov.precioProd,c_presugeprov.precio),lnDeciPrec)
				USE IN t_lisPreSug
				USE IN t_prePrecioSug
				USE IN t_prodPreSug
				USE IN c_presugeprov
			ENDIF 

			IF !EMPTY(lcfaliasCtaBus)
				SELECT (lcfaliasCtaBus)
			ENDIF 
		ENDIF 
	ENDIF 
	RETURN lnpreretornsa
ENDFUNC 


