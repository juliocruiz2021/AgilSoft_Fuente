		ELSE
			lcComandoBuscarCta="SELECT * FROM siscata where cod='EXPORTPRODWEB' and origen='PAU' "
		ENDIF 
		lnCtrlSqlCtaBus=miSQLEXEC(lnIdSqlConecPA,lcComandoBuscarCta,"c_BuscaParametrosAutorizacion")

		IF _tallY=0
			IF .t.
				lnidreg=_SiguienteIdTabla(pcNodo,"MAS")
				lccodunico=UPPER(PC_USER(2))+SYS(3)
				ldfecmod=DATETIME()
				INSERT INTO c_sisParaAuto (id,origen,cod,nombre,tipo,notas,status,fecalta,fecmod,nodo,iduser,pcuser) ;
							VALUES (lnidreg,'PAU','EXPORTPRODWEB','',0,'',1,ldfecmod,ldfecmod,pcnodo,pnidusuario,SYS(0))
			ENDIF 		
		ELSE
			pcExporProdWeb=ALLTRIM(c_BuscaParametrosAutorizacion.nombre)
