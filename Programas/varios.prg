FUNCTION EnviarCatalogoaExcelBodegas()

	Local oExcel, xlsheet, lcCurEstFin
	Local lnFila, lnPar, lnColBodIni, lnColFinal, lnCol
	Local lcRutaGuardarArchivo, lcNombreFileCliente, lcFechaHoraFile, lcRutaAchivo
	Local lnIdProducto, lcCodBodega, lnExistBodega
	Local lnBodegaCount, iii

	oExcel = Createobject("Excel.Application")

	WAIT WINDOW 'Procesando ....' NOWAIT 

	#DEFINE xlCenter -4108
	#UNDEFINE xlTop
	#DEFINE xlTop -4160

	lcCurEstFin = "c_exp_prod"

	SELECT codprod, codoriginal, producto, unidadmedida, familia, marca, existencia, ;
		costoinicial, costopromedio, ultcostocompra, preciosiniva, precioconiva, idproducto ;
		FROM c_invproductos ;
		INTO CURSOR c_exp_prod READWRITE 

	SELECT b.idproducto, ;
		a.id AS idbodega, ;
		PADR(ALLTRIM(a.cod), 30) AS codbodega, ;
		b.existencia ;
		FROM invexisbodega b ;
		INNER JOIN siscata a ON a.id = b.idbodega AND a.origen = 'BOD' ;
		INNER JOIN c_exp_prod c ON b.idproducto = c.idproducto ;
		INTO CURSOR c_exiBodd READWRITE 

	SELECT DISTINCT codbodega ;
		FROM c_exiBodd ;
		WHERE !EMPTY(ALLTRIM(codbodega)) ;
		ORDER BY codbodega ;
		INTO CURSOR c_bodegas READWRITE 

	SELECT c_bodegas
	COUNT TO lnBodegaCount

	WITH oExcel

		.WorkBooks.Add
		xlsheet = .ActiveSheet

		WITH xlsheet
			.COLUMNS(1).ColumnWidth = 15.00
			.COLUMNS(2).ColumnWidth = 30.00
			.COLUMNS(3).ColumnWidth = 10.00
			.COLUMNS(4).ColumnWidth = 20.00
			.COLUMNS(5).ColumnWidth = 20.00
			.COLUMNS(6).ColumnWidth = 9.00
			.COLUMNS(7).ColumnWidth = IIF(pnOcultaCostos = 1, 0, 15.00)
			.COLUMNS(8).ColumnWidth = IIF(pnOcultaCostos = 1, 0, 15.00)
			.COLUMNS(9).ColumnWidth = IIF(pnOcultaCostos = 1, 0, 15.00)
			.COLUMNS(10).ColumnWidth = 13.00
			.COLUMNS(11).ColumnWidth = 13.00
			.COLUMNS(12).ColumnWidth = 15.00

			.COLUMNS(1).NumberFormat = "@"
			.COLUMNS(2).NumberFormat = "@"
			.COLUMNS(3).NumberFormat = "@"
			.COLUMNS(4).NumberFormat = "@"
			.COLUMNS(5).NumberFormat = "@"
			.COLUMNS(6).NumberFormat = "#,##0.00"
			.COLUMNS(7).NumberFormat = "#,##0.00"
			.COLUMNS(8).NumberFormat = "#,##0.00"
			.COLUMNS(9).NumberFormat = "#,##0.00"
			.COLUMNS(10).NumberFormat = "#,##0.00"
			.COLUMNS(11).NumberFormat = "#,##0.00"
			.COLUMNS(12).NumberFormat = "@"
		ENDWITH

		lnFila = 1
		lnColBodIni = 13
		lnColFinal = 12 + lnBodegaCount

		xlsheet.Cells(lnFila, 2).Value = ALLTRIM(pcNomEmpresa)

		WITH xlsheet.Range(xlsheet.Cells(1, 2), xlsheet.Cells(1, MAX(12, lnColFinal)))
			.Font.Bold = .T.
			.Font.ColorIndex = 11
			.Font.Size = 18
			.WrapText = .F.
			.Merge
			.HorizontalAlignment = xlCenter
			.VerticalAlignment = xlTop
		ENDWITH

		lnFila = lnFila + 1

		xlsheet.Cells(lnFila, 2).Value = "CATALOGO DE PRODUCTOS"

		WITH xlsheet.Range(xlsheet.Cells(2, 2), xlsheet.Cells(2, MAX(12, lnColFinal)))
			.Font.Bold = .T.
			.Font.Size = 14
			.WrapText = .F.
			.Merge
			.HorizontalAlignment = xlCenter
			.VerticalAlignment = xlCenter
		ENDWITH

		lnFila = lnFila + 2

		xlsheet.Cells(lnFila, 1).Value = "CODIGO"
		xlsheet.Cells(lnFila, 2).Value = "PRODUCTO"
		xlsheet.Cells(lnFila, 3).Value = "UNI.MED."
		xlsheet.Cells(lnFila, 4).Value = "FAMILIA"
		xlsheet.Cells(lnFila, 5).Value = "MARCA"
		xlsheet.Cells(lnFila, 6).Value = "EXISTENCIA"
		xlsheet.Cells(lnFila, 7).Value = "COSTO INI."
		xlsheet.Cells(lnFila, 8).Value = "COSTO PROM."
		xlsheet.Cells(lnFila, 9).Value = "COST.UTL.COMP."
		xlsheet.Cells(lnFila, 10).Value = "PREC.S/IVA"
		xlsheet.Cells(lnFila, 11).Value = "PREC.C/IVA"
		xlsheet.Cells(lnFila, 12).Value = "COD.ORIGINAL"

		lnCol = lnColBodIni

		SELECT c_bodegas
		GO TOP
		SCAN
			xlsheet.Columns(lnCol).ColumnWidth = 12.00

			* Título de bodega como texto
			xlsheet.Cells(lnFila, lnCol).NumberFormat = "@"
			xlsheet.Cells(lnFila, lnCol).Value = "Bod. " + ALLTRIM(c_bodegas.codbodega)

			* Existencias de la bodega como número
			xlsheet.Range( ;
				xlsheet.Cells(lnFila + 1, lnCol), ;
				xlsheet.Cells(65536, lnCol) ;
			).NumberFormat = "#,##0.00"

			lnCol = lnCol + 1
		ENDSCAN

		WITH xlsheet.Range(xlsheet.Cells(lnFila, 1), xlsheet.Cells(lnFila, MAX(12, lnColFinal)))
			.Font.Bold = .T.
			.WrapText = .T.
			.Interior.ColorIndex = 11
			.Font.ColorIndex = 2
			.HorizontalAlignment = xlCenter
			.VerticalAlignment = xlCenter
		ENDWITH

		SELECT (lcCurEstFin)
		GO TOP
		lnPar = 0

		SCAN FOR idproducto <> 0

			lnFila = lnFila + 1
			lnIdProducto = c_exp_prod.idproducto

			xlsheet.Cells(lnFila, 1).Value = ALLTRIM(codprod)
			xlsheet.Cells(lnFila, 2).Value = ALLTRIM(producto)
			xlsheet.Cells(lnFila, 3).Value = ALLTRIM(unidadmedida)
			xlsheet.Cells(lnFila, 4).Value = ALLTRIM(familia)
			xlsheet.Cells(lnFila, 5).Value = ALLTRIM(marca)
			xlsheet.Cells(lnFila, 6).Value = existencia
			xlsheet.Cells(lnFila, 7).Value = IIF(pnOcultaCostos = 1, 0, costoinicial)
			xlsheet.Cells(lnFila, 8).Value = IIF(pnOcultaCostos = 1, 0, costopromedio)
			xlsheet.Cells(lnFila, 9).Value = IIF(pnOcultaCostos = 1, 0, ultcostocompra)
			xlsheet.Cells(lnFila, 10).Value = preciosiniva
			xlsheet.Cells(lnFila, 11).Value = precioconiva
			xlsheet.Cells(lnFila, 12).Value = ALLTRIM(codoriginal)

			lnCol = lnColBodIni

			SELECT c_bodegas
			GO TOP
			SCAN

				lcCodBodega = ALLTRIM(c_bodegas.codbodega)
				lnExistBodega = 0

				SELECT c_exiBodd
				LOCATE FOR idproducto = lnIdProducto ;
					AND ALLTRIM(codbodega) = lcCodBodega

				IF FOUND()
					lnExistBodega = c_exiBodd.existencia
				ENDIF

				xlsheet.Cells(lnFila, lnCol).Value = lnExistBodega

				lnCol = lnCol + 1

			ENDSCAN

			SELECT (lcCurEstFin)

			IF lnPar = 1
				lnPar = 0

				FOR iii = 1 TO MAX(12, lnColFinal)
					xlsheet.Cells(lnFila, iii).Interior.Color = 15527148
				ENDFOR
			ELSE
				lnPar = 1
			ENDIF

		ENDSCAN

		lcRutaGuardarArchivo = pcsysdir + "DocumentosXLS"

		IF !DIRECTORY(lcRutaGuardarArchivo)
			MKDIR (lcRutaGuardarArchivo)
		ENDIF

		lcNombreFileCliente = STRTRAN(ALLTRIM("Catalogo"), " ", "_")
		lcNombreFileCliente = STRTRAN(lcNombreFileCliente, ":", "")
		lcNombreFileCliente = STRTRAN(lcNombreFileCliente, ".", "")
		lcNombreFileCliente = STRTRAN(lcNombreFileCliente, ",", "")
		lcNombreFileCliente = STRTRAN(lcNombreFileCliente, "/", "")
		lcNombreFileCliente = STRTRAN(lcNombreFileCliente, "\", "")
		lcNombreFileCliente = STRTRAN(lcNombreFileCliente, "*", "")

		lcFechaHoraFile = STRTRAN(TTOC(DATETIME()), " ", "_")
		lcFechaHoraFile = STRTRAN(lcFechaHoraFile, ":", "")
		lcFechaHoraFile = STRTRAN(lcFechaHoraFile, ".", "")
		lcFechaHoraFile = STRTRAN(lcFechaHoraFile, ",", "")
		lcFechaHoraFile = STRTRAN(lcFechaHoraFile, "/", "")
		lcFechaHoraFile = STRTRAN(lcFechaHoraFile, "\", "")
		lcFechaHoraFile = STRTRAN(lcFechaHoraFile, "*", "")

		lcRutaAchivo = lcRutaGuardarArchivo + "\" + lcNombreFileCliente + " - " + lcFechaHoraFile

		xlsheet.Range("C5").Select
		oExcel.ActiveWindow.FreezePanes = .T.

		WITH xlsheet.PageSetup
			.Zoom = .F.
			.PrintTitleRows = "$1:$4"
			.FitToPagesWide = 1
			.FitToPagesTall = 32767
			.LeftMargin = 40
			.RightMargin = 40
			.TopMargin = 40
			.CenterHorizontally = .F.
		ENDWITH

		.ActiveWorkbook.SaveAs(lcRutaAchivo)
		.Visible = .T.

	ENDWITH

	WAIT WINDOW 'Terminado' NOWAIT

	IF USED("c_exp_prod")
		USE IN c_exp_prod
	ENDIF

	IF USED("c_exiBodd")
		USE IN c_exiBodd
	ENDIF

	IF USED("c_bodegas")
		USE IN c_bodegas
	ENDIF

	RETURN .T.

ENDFUNC




