FUNCTION ImprimirMovimiento(lnIdDocto as Integer,lnCtrl as Integer )
	**** se paso como parametro el numero de documento a imprimir
	**** lnCtrl 1=Imprimir Directo al Impresor ;
				2=Imprimir con Previsualizacion y ;
				3=Mostrar Formulario para Editar

	LOCAL lcAlias,lnidSQL
	lnidSQL=0
	lcAlias=ALIAS()
	lnidSQL=_conecta(pcDB)

	lcPrintActual=SET("PRINTER", 3)


	IF lnidSQL>0
		lcPrintActual=SET("PRINTER", 3)
		lcComando0="SELECT a.*,b.*,d.vendedor,e.tipodocumento,f.serie,g.formato,g.impresor,"+;
						"z.empresa,z.direccion as direccionempre,z.departamento as departamentoempre,z.telefono as telefonoempre,z.correo as correoempre,z.giro as giroempre,z.nit as nitempre,z.rfc as rfcempre,z.propietario as propietarioempre "+;
						"FROM movimientos a "+;
							"inner join movimientosdetalle b on a.idventa=b.idventa "+;
							"left join movimientosdetalleserie c on a.idventa=c.idventa and b.iddetalleserie=c.iddetalleserie "+;
							"inner join tipodocumentos e on a.idtipodocumento=e.idtipodocumento "+;
							"inner join series f on a.idserie=f.idserie "+;
							"inner join seriescajas g on a.idserie=g.idserie and a.idtipodocumento=g.idtipodocumento and a.idsucursal=g.idsucursal and a.idcaja=g.idcaja "+;
							"inner join empresa z on z.idempresa=1 "+;
							"where a.idventa="+ALLTRIM(STR(lnIdDocto))+";"

		lnCtrlSql=miSQLEXEC(lnidSQL,lcComando0,'c_reporte')

		IF lnCtrlSql>0
		
			if !EOF()
				SELECT c_reporte
				GO top
				lcArchivo=ALLTRIM(formato)
				lcPrinter=ALLTRIM(impresor)
				IF !EMPTY(formato) and FILE(pcSysDir+pcdb+"\formatos\"+lcArchivo)

					STORE SET("Printer",3) TO lcPrinOld
					IF !EMPTY(lcPrinter)
						SET PRINTER TO NAME (lcPrinter)
					ENDIF 
					*************************
					IF pnUsaRedirec=1		&&&& usandoa impresor redireccionado
						lcPrinter=ImpresorRedireccionado(0,3)
						SET PRINTER TO NAME (lcPrinter)
					ENDIF
					
					DO case
						CASE lnCtrl=1
								WAIT WINDOW 'Imprimiendo Documento... ' NOWAIT 
								lcPrintActual=SET("PRINTER", 3)
								lcPrintActual2=SET("PRINTER", 3)
								_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)
								*lcPrintActual2=lcPrintActual
								REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER NOCONSOLE NAME lcPrintActual
								
						CASE lnCtrl=2
								lcPrintActual=SET("PRINTER", 3)
								lcPrintActual2=SET("PRINTER", 3)
								_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)
								*lcPrintActual=lcPrintActual2
								REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER PROMPT PREVIEW NOCONSOLE 
						CASE lnCtrl=3
								MODIFY REPORT pcSysDir+pcdb+"\formatos\"+lcArchivo
					ENDCASE
					IF !EMPTY(lcPrinOld)
						SET PRINTER TO NAME (lcPrinOld)
					ENDIF 
					

					IF c_reporte.Status=1		&&& cambiando status de Impreso
						=miSQLEXEC(lnidSQL,"update ventas set status=2 where idventa="+ALLTRIM(STR(lnIdDocto))+";")
					ENDIF
					
				ELSE
					MESSAGEBOX('No se Encontro el Formato de Impresion para este Documento....',16,'Error al Imprimir...')
				ENDIF 
			ELSE
				MESSAGEBOX('No se Encontro el Documento....',16,'Error al Imprimir...')
			ENDIF 
			USE IN c_reporte
		ELSE
			_MostrarErroresSQL(lnidSQL)
		ENDIF 
		=miSQLDISCONNECT(lnidSQL)
	ELSE
		MESSAGEBOX("Imposible conectarse con el Servidor... Intente más tarde...",16,'Error de Conección...')
	ENDIF 
	IF !EMPTY(lcAlias)
		SELECT (lcAlias)
	ENDIF 
ENDFUNC 



