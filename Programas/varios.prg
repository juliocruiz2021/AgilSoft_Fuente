									INSERT INTO c_impdeta (iddocto,codagrupadorg,agrupadorg) SELECT lniddoc,cod,nombre FROM siscata WHERE origen="AGR" AND COD NOT IN (SELECT CODAGRUPADORG FROM c_impdeta)
									REPLACE ordenAgrupador WITH "1" all IN  c_impdeta
									UPDATE c_impdeta  SET ordenagrupador="" WHERE codagrupadorg in (SELECT cod FROM siscata WHERE origen="AGR" AND status=1)
									REPLACE agrupador WITH "" FOR EMPTY(ordenagrupador) IN c_impdeta
									GO TOP IN c_impdeta
									INDEX ON STR(iddocto)+ordenAgrupador+codagrupadorg TAG llave
									*REPLACE agrupadorg WITH "",producto WITH "",agrupador WITH "" FOR EMPTY(ordenAgrupador)
									SET ORDER TO llave
								ENDIF 
							ENDIF 
						ELSE
							IF lnTipoDetalle=4	&&&& impresion por Bulto
								SELECT 000000000 as lineas,t0.*,cc.*,(SELECT bultos FROM c_memo) as bultos FROM c_impdetaTmp t0 INNER JOIN ;
										(SELECT  MIN(a.iddoctod) as iddoctodg,SUM(a.cantiunimed) as cantidadG ,max(a.codagrupadorg) as codagrupadorg,;
												MAX(a.producto) as agrupadorg,SUM(a.totaliva) as totalivag,SUM(a.totalventaconiva) as totalventaconivag,;
												SUM(a.totalventasiniva) as totalventasinivag,SUM(a.totalgravado) as totalgravadog,SUM(a.totalexento) as totalexentog,;
												SUM(a.totalnosujeto) as totalnosujetog,SUM(venta_bruta_siniva) as venta_bruta_sinivaG,;
											SUM(venta_bruta_coniva) as venta_bruta_conivaG,SUM(total_descuento_siniva) as total_descuento_sinivaG,;
											SUM(total_descuento_coniva) as total_descuento_conivaG ;
											FROM c_impdetaTmp a ORDER BY a.iddocto,a.idproducto,a.factor GROUP BY a.iddocto,a.idproducto,a.factor) as cc on t0.iddoctod=cc.iddoctodg ;
									INTO CURSOR c_impdeta READWRITE ORDER BY t0.codprod
								SELECT codprod,cantiunimed FROM c_impdetaTmp ORDER BY codprod INTO CURSOR c_bultostmp
								SELECT c_bultostmp
								lccodigo='***'
								lcbulto=''
								lccomabulto=', '
								lncuentabul=1
								lnCuentaBultos=0
								SCAN 
									lnCuentaBultos=lnCuentaBultos+1 
									IF lccodigo==codprod
										lncuentabul=lncuentabul+1
										lcbulto=lcbulto+lccomabulto+" [B:"+ALLTRIM(STR(lnCuentaBultos))+"- "+ALLTRIM(STR(cantiunimed))+"]"
										
										UPDATE c_impdeta SET bultos='(Bultos: '+ALLTRIM(STR(lncuentabul,12,0))+') '+lcbulto WHERE codprod==lccodigo
									ELSE
										lccodigo=codprod
										lncuentabul=1
										lcbulto=" [B:"+ALLTRIM(STR(lnCuentaBultos))+"- "+ALLTRIM(STR(cantiunimed))+"]"
										UPDATE c_impdeta SET bultos='(Bultos: '+ALLTRIM(STR(lncuentabul,12,0))+') '+lcbulto WHERE codprod==lccodigo
									ENDIF 
								ENDSCAN 
								USE IN c_bultostmp
								SELECT c_impdeta
							ELSE 
								SELECT 000000000 as lineas,t0.*,cc.*,(SELECT bultos FROM c_memo) as bultos FROM c_impdetaTmp t0 INNER JOIN ;
										(SELECT  iddoctod as iddoctodg,sum(cantiunimed) as cantidadG ,MAX(codagrupadorg) as codagrupadorg,;
												MAX(producto) as agrupadorg,SUM(totaliva) as totalivag,SUM(totalventaconiva) as totalventaconivag,;
												SUM(totalventasiniva) as totalventasinivag,SUM(totalgravado) as totalgravadog,SUM(totalexento) as totalexentog,;
												SUM(totalnosujeto) as totalnosujetog  ;
											FROM c_impdetaTmp ORDER BY iddocto,iddoctod GROUP BY iddocto,iddoctod) as cc on t0.iddoctod=cc.iddoctodg ;
									INTO CURSOR c_impdeta READWRITE ORDER BY t0.iddoctod
							ENDIF 
						ENDIF 
						
						USE IN c_memo
						SELECT c_impdeta
						REPLACE lineas WITH RECNO() all
						REPLACE descripcionnota WITH agrupador FOR EMPTY(NVL(ALLTRIM(descripcionnota),''))
						GO top
						lnlintotal=RECCOUNT()
						lniddoc=iddocto
						lnagregarlineas=lnLineasMaximas-lnlintotal
						
						
						****** varias copias
						SELECT * FROM c_impdeta INTO CURSOR c_impdetaTmp READWRITE 
						SELECT 000000000 as copia,* FROM c_impdeta WHERE lineas<0 INTO CURSOR c_impdeta READWRITE 
						
						FOR i=1 TO lnCopiasRepetir
							INSERT INTO c_impdeta SELECT i,* FROM c_impdetaTmp order by lineas 
							IF lnagregarlineas>0 AND lnCopiasContinuas=1
								FOR II=1 TO lnagregarlineas
									INSERT INTO c_impdeta (copia,iddocto) VALUES (i,lniddoc)
								ENDFOR 
							ENDIF 
						ENDFOR 
						REPLACE lineas WITH RECNO() all
						SELECT c_impdeta
		
						GO top
						GO TOP IN c_imp
						
						USE IN c_impdetaTmp
			
						IF lnCopiasContinuas>0
							lnCopiasPrint=1
						ENDIF 
 						
						******varios impresores
						STORE SET("Printer",3) TO lcPrintCocina 
						REPLACE impresorfamilia WITH lcPrintCocina FOR impresorfamilia='* ' OR EMPTY(impresorfamilia)
						SELECT impresorfamilia FROM c_impdeta GROUP BY impresorfamilia INTO CURSOR c_porImpresor READWRITE 
						lnvariosImpresores=_tally 
					
						IF ALLTRIM(impresorfamilia)<>lcPrintCocina AND (lnCtrl<>5 and lnCtrl<>6 and lnCtrl<>7)
							lnvariosImpresores=2
							IF INLIST(lnTipoImpresion,2,4)
								lnCtrl=1
							ENDIF 
						ENDIF 
						SELECT c_impdeta
						
						****** agrupando impresiones si fuera una impresion de facturas por lote
						*pnmiiddocini=pnmiiddocini+1
						pnImprimeLote=0
						
						IF pnImprimeLote=1
							*pnmiiddocini,pnmiiddocFin
							IF pnmiiddocini=1
								SELECT * FROM c_imp INTO CURSOR c_ImpLote READWRITE 
								SELECT * FROM c_impdeta INTO CURSOR c_impdetaLote READWRITE 
							ELSE
								INSERT INTO c_ImpLote SELECT * FROM c_imp 
								INSERT INTO c_impdetaLote SELECT * FROM c_impdeta 
							ENDIF 
						ENDIF 
						GO TOP IN c_imp
						SELECT c_impdeta
						
						GO top
						IF lnCtrl=3
							lcPrintActual=SET("PRINTER", 3)
							_vfp.ActiveForm.cntDiga.diga("Imprimiendo en...  "+lcPrintActual,4,3)
							MODIFY REPORT pcSysDir+pcdb+"\formatos\"+lcArchivo
						ENDIF 		
						lcorigendoc=c_impdeta.origen


						IF INLIST(lnCtrl,0,1,2,5,6,7)
							IF c_impdeta.origen='VTP' AND pnEsRestaurante=1	&&&& se imprime por impresor (cocina,bar, etc)
								SELECT c_porImpresor
								IF INLIST(lnTipoImpresion,3,4)		&&& pregunta si quiere impimir
									lnsn=6
								ELSE
									IF lnTipoImpresion=1
										lnsn=MESSAGEBOX("Desea Ver el Documento ?",4+32+256,"Imprimir...")
									ENDIF 
									IF lnTipoImpresion=2
										lnsn=MESSAGEBOX("Desea Imprimir el Documento ?",4+32+256,"Imprimir...")
									ENDIF 
									IF lnTipoImpresion=0
										lnsn=0
									ENDIF 
								ENDIF 
								IF lnsn=6
									IF lnvariosImpresores>1
										lcPrintActual=SET("PRINTER", 3)
										lcPrintActual2=SET("PRINTER", 3)
										_vfp.ActiveForm.cntDiga.diga("Imprimiendo en...  "+lcPrintActual,4,3)
										GO TOP IN c_imp
										SCAN all
											lcprinfami=ALLTRIM(c_porImpresor.impresorfamilia)
											SELECT c_impdeta
										
											SET PRINTER TO NAME (lcprinfami)
											
											SET filter to impresorfamilia=lcprinfami+'     '}
											WAIT WINDOW 'Imprimiendo en ...  '+lcprinfami NOWAIT 
											IF pnImprimeLote=1 
											else
												IF INLIST(lnTipoImpresion,1,3) &&& ver doc.
													REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER PROMPT PREVIEW NOCONSOLE 
												ELSE
													*lcPrintActual2=lcPrintActual
													REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER NOCONSOLE  NAME lcPrintActual
													lcPrintActual=lcPrintActual2
												ENDIF 
											ENDIF 
											SET FILTER TO 
											
											SELECT c_porImpresor 
										ENDSCAN 
									ELSE 
										
										SELECT c_impdeta
										lcPrintActual=SET("PRINTER", 3)
										lcPrintActual2=SET("PRINTER", 3)
										_vfp.ActiveForm.cntDiga.diga("Imprimiendo en...  "+lcPrintActual,4,3)
										GO TOP IN c_imp
										
										IF pnImprimeLote=1 
										else
											IF INLIST(lnTipoImpresion,1,3) &&& ver doc.
												REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER PROMPT PREVIEW NOCONSOLE 
											ELSE
												*lcPrintActual2=lcPrintActual
												REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER NOCONSOLE  NAME lcPrintActual
												lcPrintActual=lcPrintActual2
											ENDIF
										ENDIF  
									ENDIF 
									
									****** enviar por whasapp
								*	=GenerarArchivoPDF_DTE(pcSysDir+pcdb+"\formatos\"+IIF(EMPTY(lcFormatoPDF),lcArchivo,lcFormatoPDF),;
														lcNombreArchivoPdF)
									
									llseimprimio=1
								ENDIF 
								
							ENDIF 
							IF !EMPTY(lcListComandas)		&&& lista de Comandas
								SELECT c_impdeta
								IF !EMPTY(lcListComandas)		&&& hay lista de comandas... vamos  resumir a un solo id de documento
									lcArchivo=STRTRAN(lcArchivo,'.FRX','')+'_PRE.FRX'
								ENDIF
								SELECT c_impdeta
								GO top
								lcPrintActual=SET("PRINTER", 3)
								lcPrintActual2=SET("PRINTER", 3)
								_vfp.ActiveForm.cntDiga.diga("5Imprimiendo en...  "+lcPrintActual,4,3)
								 GO TOP IN c_imp
								 
								FOR iprin=1 TO lnCopiasPrint
									IF pnImprimeLote=1 
									else
										IF lnCtrl=1
											*lcPrintActual2=lcPrintActual
											REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER NOCONSOLE NAME lcPrintActual
											lcPrintActual=lcPrintActual2
										ELSE
											REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER PROMPT PREVIEW NOCONSOLE 
										ENDIF 
									ENDIF 
								ENDFOR 
								****** enviar por whasapp
							*	=GenerarArchivoPDF_DTE(pcSysDir+pcdb+"\formatos\"+IIF(EMPTY(lcFormatoPDF),lcArchivo,lcFormatoPDF),;
														lcNombreArchivoPdF)
								llseimprimio=1
							ENDIF 
							GO TOP IN c_imp
							IF c_impdeta.origen='VTA' OR (c_impdeta.origen='VTP' AND pnEsRestaurante=0)
								DO case
									CASE lnTipoImpresion=1 AND lnCtrl=0
								
											lnsn=MESSAGEBOX("Desea Ver el Documento ?",4+32+256,"Imprimir...")
											IF lnsn=6
												lcPrintActual=SET("PRINTER", 3)
												_vfp.ActiveForm.cntDiga.diga("Imprimiendo en...  "+lcPrintActual,4,3)
												IF pnImprimeLote=1 
												else
													WAIT WINDOW "Imprimiendo Documento en .. "+lcPrintActual NOWAIT 
													REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER PROMPT PREVIEW NOCONSOLE 
												endif
												llseimprimio=1
												****** enviar por whasapp
												=GenerarArchivoPDF_DTE(pcSysDir+pcdb+"\formatos\"+IIF(EMPTY(lcFormatoPDF),lcArchivo,lcFormatoPDF),;
																lcNombreArchivoPdF)
												EnviarPorWhatsApp(lcNombreArchivoPdF,lcNumeroCelularPDF,lnEnviarWA,lcAsuntoWS,lcMensajeWS)
											ENDIF 
									CASE lnTipoImpresion=2 AND lnCtrl=0
									
											lnsn=MESSAGEBOX("Desea Imprimir el Documento ?",4+32+256,"Imprimir...")
											IF lnsn=6
												lcPrintActual=SET("PRINTER", 3)
												lcPrintActual2=SET("PRINTER", 3)
												_vfp.ActiveForm.cntDiga.diga("Imprimiendo en...  "+lcPrintActual,4,3)
												WAIT WINDOW "Imprimiendo Documento en.... "+lcPrintActual NOWAIT 
 
												FOR iprin=1 TO lnCopiasPrint
													*lcPrintActual2=lcPrintActual
													IF pnImprimeLote=1 
													else
														REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER NOCONSOLE NAME lcPrintActual
													ENDIF 
													lcPrintActual=lcPrintActual2
												ENDFOR 
												****** enviar por whasapp
												=GenerarArchivoPDF_DTE(pcSysDir+pcdb+"\formatos\"+IIF(EMPTY(lcFormatoPDF),lcArchivo,lcFormatoPDF),;
																lcNombreArchivoPdF)
												EnviarPorWhatsApp(lcNombreArchivoPdF,lcNumeroCelularPDF,lnEnviarWA,lcAsuntoWS,lcMensajeWS)
												
												**** si hay un formato de impresion de documento adicional de credito y si el doc es de credito y si se esta imprimiendo un ticket
												IF !EMPTY(pcFormatoVtaCredito) AND lnCondipago=1 AND lnImprimirCopiaCredito=1
													GO TOP 
													lcSucCod=ALLTRIM(c_imp.codSucursal)
													IF FILE(pcSysDir+pcdb+"\formatos\"+lcSucCod+pcFormatoVtaCredito)
														lcPrintActual=SET("PRINTER", 3)
														lcPrintActual2=SET("PRINTER", 3)
														_vfp.ActiveForm.cntDiga.diga("Imprimiendo en...  "+lcPrintActual,4,3)
														WAIT WINDOW "Imprimiendo Documento en..... "+lcPrintActual NOWAIT 
														 
														*lcPrintActual2=lcPrintActual
														IF pnImprimeLote=1 
														else
															REPORT FORM pcSysDir+pcdb+"\formatos\"+lcSucCod+pcFormatoVtaCredito TO PRINTER NOCONSOLE NAME lcPrintActual 
														ENDIF 
														lcPrintActual=lcPrintActual2
													ENDIF 
												ENDIF 
												llseimprimio=1
											ENDIF 
									CASE (lnTipoImpresion=3 OR lnCtrl=2) AND (lnCtrl<>5 and lnCtrl<>6 AND lnCtrl<>7)
									
											lcPrintActual=SET("PRINTER", 3)
											IF TYPE("_vfp.ActiveForm")='O'
												_vfp.ActiveForm.cntDiga.diga("Imprimiendo en...  "+lcPrintActual,4,3)
											ENDIF 
											WAIT WINDOW "Imprimiendo Documento en....... "+lcPrintActual NOWAIT 
							 				IF pnImprimeLote=1 
											else
												REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER PROMPT PREVIEW NOCONSOLE 
											ENDIF 
											****** enviar por whasapp
										
											=GenerarArchivoPDF_DTE(pcSysDir+pcdb+"\formatos\"+IIF(EMPTY(lcFormatoPDF),lcArchivo,lcFormatoPDF),;
																lcNombreArchivoPdF)
											EnviarPorWhatsApp(lcNombreArchivoPdF,lcNumeroCelularPDF,lnEnviarWA,lcAsuntoWS,lcMensajeWS)
											llseimprimio=1
									CASE ((lnTipoImpresion=4 AND lnCtrl=0) OR lnCtrl=1)	AND lnCtrl<>7	&&&&aa si no es pdf dte
									 
											lcPrintActual=SET("PRINTER", 3)
											lcPrintActual2=SET("PRINTER", 3)
											_vfp.ActiveForm.cntDiga.diga("Imprimiendo en...  "+lcPrintActual,4,3)
											
											FOR iprin=1 TO lnCopiasPrint
												WAIT WINDOW "Imprimiendo Documento en......... "+lcPrintActual NOWAIT 
												 
												*lcPrintActual2=lcPrintActual
												IF pnImprimeLote=1 
												ELSE
								
													REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER NOCONSOLE NAME lcPrintActual
												ENDIF 
												lcPrintActual=lcPrintActual2
											ENDFOR 
											****** enviar por whasapp
									
											IF LEN(ALLTRIM(c_imp.numero))>20	OR lnEnviarWA<>0	&&& es electronica
												=GenerarArchivoPDF_DTE(pcSysDir+pcdb+"\formatos\"+IIF(EMPTY(lcFormatoPDF),lcArchivo,lcFormatoPDF),;
																lcNombreArchivoPdF)
											ENDIF 
											EnviarPorWhatsApp(lcNombreArchivoPdF,lcNumeroCelularPDF,lnEnviarWA,lcAsuntoWS,lcMensajeWS)
											
											**** si hay un formato de impresion de documento adicional de credito y si el doc es de credito y si se esta imprimiendo un ticket
											IF !EMPTY(pcFormatoVtaCredito) AND lnCondipago=1 AND lnImprimirCopiaCredito=1
												GO TOP 
												lcSucCod=ALLTRIM(c_imp.codSucursal)
													IF FILE(pcSysDir+pcdb+"\formatos\"+lcSucCod+pcFormatoVtaCredito)
													lcPrintActual=SET("PRINTER", 3)
													lcPrintActual2=lcPrintActual
													_vfp.ActiveForm.cntDiga.diga("Imprimiendo en...  "+lcPrintActual2,4,3)
													WAIT WINDOW "Imprimiendo Documento en   ....... "+lcPrintActual NOWAIT 
													*lcPrintActual2=lcPrintActual
										
													IF pnImprimeLote=1 
													else
														REPORT FORM pcSysDir+pcdb+"\formatos\"+lcSucCod+pcFormatoVtaCredito TO PRINTER NOCONSOLE NAME lcPrintActual
													ENDIF 
													lcPrintActual=lcPrintActual2
												ENDIF 
											ENDIF 
											llseimprimio=1
									
									CASE lnCtrl=5 OR lnCtrl=6 OR lnCtrl=7		&&&& enviar por whasapp
								
										****** enviar por whasapp
										
										IF !EMPTY(pcCelularTMP)
											lcNumeroCelularPDF=pcCelularTMP
										ENDIF 
										
										lcCelNum=solonumeros(lcNumeroCelularPDF)
										IF (EMPTY(lcCelNum) OR '70000000'$lcCelNum) AND INLIST(lnCtrl,5,6)
											IF INLIST(lnCtrl,5,6)   &&&&& se genera pero no se envia
												=GenerarArchivoPDF_DTE(pcSysDir+pcdb+"\formatos\"+IIF(EMPTY(lcFormatoPDF),lcArchivo,lcFormatoPDF),;
																lcNombreArchivoPdF)
											ENDIF 
											WAIT WINDOW 'Envio de Whasapp desactivado.... ' TIMEOUT 1
										ELSE 

											=GenerarArchivoPDF_DTE(pcSysDir+pcdb+"\formatos\"+IIF(EMPTY(lcFormatoPDF),lcArchivo,lcFormatoPDF),;
																lcNombreArchivoPdF)

											IF lnCtrl=6
												EnviarPorWhatsApp(lcNombreArchivoPdF,lcNumeroCelularPDF,3,lcAsuntoWS,lcMensajeWS)
											ELSE
												IF lnCtrl=5
													EnviarPorWhatsApp(lcNombreArchivoPdF,lcNumeroCelularPDF,lnEnviarWA,lcAsuntoWS,lcMensajeWS)
												ELSE 
													**** 7 no envia por whasap
												ENDIF 
											ENDIF 
										ENDIF 
										
								ENDCASE

								**** si hay que abrir la caja (si hay un impresor de caja y si es diferente al actual
								STORE SET("Printer", 3) TO lcprintactual	&&& impresor actual
								pcabircajap=ObtieneImpresores(0,2)	&&& impresor de ticket
				                IF  .NOT. EMPTY(pcabircajaprinter) AND pcabircajap<>lcprintactual AND (lnCtrl=0 OR lnCtrl=1) AND lcorigendoc='VTA'
									_abrirCajaEfectivo(ALIAS())
								ENDIF 
							ENDIF 
						ENDIF 
						
						GO TOP IN c_impdeta
					
						* FoxyPreviewer puede cerrar el alias privado c_imp al generar el PDF.
						* No continuar sobre un cursor inexistente: causaba error 13 y cierre de VFP.
						IF llseimprimio=1		&&& cambiando status de Impreso
							=miSQLEXEC(lnidSQL,"update cyvventas set impreso=1 where impreso=0 and iddocto="+ALLTRIM(STR(lnIdDocto))+" ")
						ENDIF
						******** imprimendo el lote
						IF pnImprimeLote=1 AND pnmiiddocini=pnmiiddocfin
							SELECT * FROM c_ImpLote INTO CURSOR c_Imp READWRITE 
							SELECT c_imp
							INDEX on iddocto TAG iddocto
							SET ORDER TO iddocto
							
							SELECT * FROM c_impdetaLote INTO CURSOR c_impdeta READWRITE 
							SELECT  c_impdeta
							SET RELATION TO iddocto INTO c_imp
							*MODIFY REPORT pcSysDir+pcdb+"\formatos\"+lcArchivo
							REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo PREVIEW NOCONSOLE 
						ENDIF 
						IF USED("c_impdeta")
							GO TOP IN c_impdeta
						ENDIF
						IF USED("c_imp")
							GO TOP IN c_imp
						ENDIF
						
						* SIGA Documentos: generar y encolar el soporte de la venta.
						IF TYPE("pnUsaSigaDocumentos") = "N"
							IF pnUsaSigaDocumentos = 1 AND ;
									TYPE("lcNombreArchivoPDF") = "C" AND ;
									!EMPTY(ALLTRIM(lcNombreArchivoPDF))
								IF !FILE(lcNombreArchivoPDF) AND ;
										TYPE("lcArchivo") = "C" AND ;
										FILE(pcSysDir+pcdb+"\formatos\"+;
										IIF(EMPTY(lcFormatoPDF),lcArchivo,lcFormatoPDF))
									=GenerarArchivoPDF_DTE(pcSysDir+pcdb+"\formatos\"+;
										IIF(EMPTY(lcFormatoPDF),lcArchivo,lcFormatoPDF),;
										lcNombreArchivoPDF)
								ENDIF
								IF FILE(lcNombreArchivoPDF)
									=PublicarVentaSigaDocumentos(lnIdDocto, ;
										lcNombreArchivoPDF)
								ENDIF
							ENDIF
						ENDIF
						
						IF !EMPTY(lcPrinOld)
							SET PRINTER TO NAME (lcPrinOld)
						ENDIF 
						
					ELSE 
						 MESSAGEBOX('No se encontro el Archivo del Formato de impresion....  '+lcArchivo,16,'Error al Imprimir...')
					ENDIF 
				ELSE
					MESSAGEBOX('No se Encontro el Formato de Impresion para este Documento....',16,'Error al Imprimir...')
				ENDIF 
			ELSE
				MESSAGEBOX('No se Encontro el Documento....',16,'Error al Imprimir...')
			ENDIF 
		ELSE
			_MostrarErroresSQL(lnidSQL)
		ENDIF 
		IF USED("c_imp")
			USE IN c_imp
		ENDIF
		IF USED("c_impdeta")
			USE IN c_impdeta
		ENDIF 
		=miSQLDISCONNECT(lnidSQL)
	ELSE
		MESSAGEBOX("Imposible conectarse con el Servidor... Intente más tarde...",16,'Error de Conección...')
	ENDIF 
