FUNCTION BuscaSerieFormato(lnIdSqlNumPar,lnidtipdBSF,lnidsucBSF,lnidbodeBSF,lnidcbanBSF,ldFechaDoc)
	IF PCOUNT()=5
		ldFechaDoc=DATE()
	ENDIF 
	lcEjercicioDoc=ALLTRIM(STR(YEAR(ldFechaDoc)))
	
	lcAliasBSF=ALIAS()

	IF NVL(lnIdSqlNumPar,0)<>0
		lnidSqlBSF=lnIdSqlNumPar
	ELSE
		lnidSqlBSF=_conecta(pcDB)
	ENDIF 
	
	lcComandoBSF=""
	lcComanAndBSF=""
	lcComandoBSF2=""
	lcComanAndBSF2=""
	lnRetoridSerBSF=0
	
	IF lnidSqlBSF<>0
		IF lnidtipdBSF<>0
			lcComandoBSF=lcComandoBSF+lcComanAndBSF+"idtipodocto="+ALLTRIM(STR(lnidtipdBSF))
			lcComanAndBSF=" and "
			lcComandoBSF2=lcComandoBSF2+lcComanAndBSF2+"idtipodocto="+ALLTRIM(STR(lnidtipdBSF))
			lcComanAndBSF2=" and "
		ENDIF 
		IF lnidsucBSF<>0
			lcComandoBSF=lcComandoBSF+lcComanAndBSF+"idsucursal="+ALLTRIM(STR(lnidsucBSF))
			lcComanAndBSF=" and "
			lcComandoBSF2=lcComandoBSF2+lcComanAndBSF2+"idsucursal="+ALLTRIM(STR(lnidsucBSF))
			lcComanAndBSF2=" and "
		ENDIF 
		IF lnidbodeBSF<>0
			lcComandoBSF=lcComandoBSF+lcComanAndBSF+"idbodega="+ALLTRIM(STR(lnidbodeBSF))
			lcComanAndBSF=" and "
		ENDIF 
		IF lnidcbanBSF<>0
			lcComandoBSF=lcComandoBSF+lcComanAndBSF+"idcajban="+ALLTRIM(STR(lnidcbanBSF))
			lcComanAndBSF=" and "
		ENDIF 
		lcComandoBSF2=lcComandoBSF2+lcComanAndBSF2+"idcajban=0"
		lcComanAndBSF2=" and "

		*** filtrar por ejercidio para facturacion electronica
		lcComandoBSF2=lcComandoBSF2+lcComanAndBSF2+"((b.electronica=1 and b.ejercicio='"+lcEjercicioDoc+"') or b.electronica=0)"
		lcComanAndBSF2=" and "

		lcComandoBSF=lcComandoBSF+lcComanAndBSF+"((b.electronica=1 and b.ejercicio='"+lcEjercicioDoc+"') or b.electronica=0)"
		lcComanAndBSF=" and "


		IF !EMPTY(lcComandoBSF)
			lcComandoBSF="where a.status=1 and b.status=1 and "+lcComandoBSF	
		ELSE
			lcComandoBSF="where a.status=1 and b.status=1 "
		ENDIF 
		IF !EMPTY(lcComandoBSF2)
			lcComandoBSF2="where a.status=1 and b.status=1 and "+lcComandoBSF2	
		ELSE
			lcComandoBSF2="where a.status=1 and b.status=1 "
		ENDIF 

		

		
		IF pnTipoconeccion<>1
			lcComandoBSF3="Select a.idserie from sisformatos a inner join sisseries b on a.idserie=b.idserie "+lcComandoBSF+" order by a.idserie limit 0,1 "
		ELSE
			lcComandoBSF3="select  top 1 cc.idserie,cc.tipodetalle,cc.lineas from ("+;
						"Select 1 as llave, a.idserie,a.tipodetalle,a.lineas from sisformatos a inner join sisseries b on a.idserie=b.idserie "+lcComandoBSF+" "+;
						"union all "+;
						"Select 2 as llave,a.idserie,a.tipodetalle,a.lineas from sisformatos a inner join sisseries b on a.idserie=b.idserie "+lcComandoBSF2+") as cc order by cc.llave,cc.idserie "
		ENDIF 

***** en lugar de guardar en el portapapeles
m.SQlComando1=lcComandoBSF3
				
		lnCtrlSqlBSF=miSQLEXEC(lnidSqlBSF,lcComandoBSF3,"c_idserieformato")
		IF lnCtrlSqlBSF>0
			IF !EOF("c_idserieformato")
				IF TYPE("c_idserieformato.idserie")="N"
					lnRetoridSerBSF=c_idserieformato.idserie
				ELSE
					lnRetoridSerBSF=VAL(c_idserieformato.idserie)
				ENDIF 
			ENDIF 
			USE IN c_idserieformato
		ENDIF 

	ENDIF 
	
	IF lnIdSqlNumPar=0
		=miSQLDISCONNECT(lnIdSqlNumPar)
	ENDIF 

	RETURN lnRetoridSerBSF
ENDFUNC 



FUNCTION BuscaIdFormato(lnIdSqlNumPar,lnidtipdBSF,lnidsucBSF,lnidbodeBSF,lnidcbanBSF,lnidserBSF)
	lcAliasBSF=ALIAS()
	IF NVL(lnIdSqlNumPar,0)<>0
		lnidSqlBSF=lnIdSqlNumPar
	ELSE
		lnidSqlBSF=_conecta(pcDB)
	ENDIF 
	
	lcComandoBSF=""
	lcComanAndBSF=""
	lcComandoBSF2=""
	lcComanAndBSF2=""
	lnRetoridSerBSF=0
	
	IF lnidSqlBSF<>0
		IF lnidtipdBSF<>0
			lcComandoBSF=lcComandoBSF+lcComanAndBSF+"idtipodocto="+ALLTRIM(STR(lnidtipdBSF))
			lcComanAndBSF=" and "
			lcComandoBSF2=lcComandoBSF2+lcComanAndBSF2+"idtipodocto="+ALLTRIM(STR(lnidtipdBSF))
			lcComanAndBSF2=" and "
		ENDIF 
		IF lnidsucBSF<>0
