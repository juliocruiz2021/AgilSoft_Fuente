FUNCTION ValidarCorregirTablaRetencionPercepcion()
	IF pntipoconeccion=1
		lcaliasvalida=ALIAS()
		USE pcSysDir+pcdb+"\cyvguiaretper" share again IN 0
		SELECT cyvguiaretper
		llexiste=.f.
		LOCATE FOR tipoempresa=1 AND tiposocionegocio=2 AND tipocontribuyente=1 AND tiporetper<>0
		IF !EOF()
			REPLACE tiporetper WITH 0,editable WITH 0 FOR tipocontribuyente=1 AND tipoempresa=1
			REPLACE tiporetper WITH 0,editable WITH 0 FOR tipocontribuyente=0 
			REPLACE tiporetper WITH 0,editable WITH 0 FOR tipocontribuyente=1 AND tipoempresa=0
			REPLACE tiporetper WITH 1,editable WITH 0 FOR tipocontribuyente=3 AND tipoempresa=1 AND tiposocionegocio=1
			REPLACE tiporetper WITH 2,editable WITH 0 FOR tipocontribuyente=3 AND tipoempresa=1 AND tiposocionegocio=2
			REPLACE tiporetper WITH 1,editable WITH 0 FOR tipocontribuyente=3 AND tipoempresa=2 AND tiposocionegocio=1
			REPLACE tiporetper WITH 2,editable WITH 0 FOR tipocontribuyente=3 AND tipoempresa=2 AND tiposocionegocio=2
		ENDIF 
		USE IN cyvguiaretper

		IF !EMPTY(lcaliasvalida)
			SELECT (lcaliasvalida)
		ENDIF 
	ENDIF 
	RETURN .t.
ENDFUNC 



FUNCTION ValidarFormatosOrigen()
	IF pntipoconeccion=1
		lcaliasvalida=ALIAS()
		USE pcSysDir+pcdb+"\sisformatos" share again IN 0
		SELECT sisformatos
		llexiste=.f.
		FOR gnCount = 1 TO FCOUNT( )  && Loop for number of fields
		   IF ALLTRIM(FIELD(gnCount))=="ORIGEN"  && Display each field
				llexiste=.T.
		   ENDIF 
		NEXT
		IF !llexiste
			USE 
			USE pcSysDir+pcdb+"\sisformatos" EXCLUSIVE IN 0
			ALTER table sisformatos ADD COLUMN origen C(3)
			ALTER table sisformatos ADD COLUMN tipoimpresion i 
			ALTER table sisformatos alter COLUMN impresor2 i
			ALTER table sisformatos ADD COLUMN pcuser c(100)
			INDEX on origen+codfor TAG llave UNIQUE 
		ENDIF 
		USE IN sisformatos

		IF !EMPTY(lcaliasvalida)
			SELECT (lcaliasvalida)
		ENDIF 
	ENDIF 
	RETURN .t.
ENDFUNC 



