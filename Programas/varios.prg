			ENDIF 
			pdFechaPTV=ldfecptvatmp3
			
		ELSE
			IF pnTipoConeccion=1
				IF pnEsgasolinera=1
					lcComandoBuscarCta="update c_sisParaAuto2 set nombre ='"+DTOC(ldfecptvatmp3)+"',fecmod=DATETIME(),tipo="+ALLTRIM(STR(lnTurnoPtva))+", nodo=pcnodo,iduser="+;
								ALLTRIM(STR(pnidusuario))+",pcuser=SYS(0) where origen='FEC' and COD='"+lcnodotmp2+"' and idpadre="+ALLTRIM(STR(lnPtvtaActivo))
				ELSE
					lcComandoBuscarCta="update c_sisParaAuto2 set nombre ='"+DTOC(ldfecptvatmp3)+"',fecmod=DATETIME(),tipo="+ALLTRIM(STR(lnTurnoPtva))+", nodo =pcnodo,iduser="+ALLTRIM(STR(pnidusuario))+",pcuser=SYS(0) where origen='FEC' and COD='"+lcnodotmp2+" '"
				ENDIF 
				&lcComandoBuscarCta
			ELSE
				lcComandoBuscarCta = "UPDATE siscata SET " + ;
				    "nombre  = '" + DTOS(ldfecptvatmp3)          + "'," + ;
				    "fecmod  = NOW(),"                                  + ;
				    "tipo    = "  + ALLTRIM(STR(lnTurnoPtva))     + "," + ;
				    "nodo    = '" + pcnodo                        + "'," + ;
				    "iduser  = "  + ALLTRIM(STR(pnidusuario))     + "," + ;
				    "pcuser  = '" + TRIM(SYS(0))                  + "' " + ;
				    "WHERE origen = 'FEC' " + ;
				    "AND cod    = '" + lcnodotmp2                  + "' " + ;
				    "AND idpadre = "  + ALLTRIM(STR(lnPtvtaActivo))
				    
				=miSQLEXEC(lnidsqlidconec2,	lcComandoBuscarCta)
			
			ENDIF 
			
			pdFechaPTV=ldfecptvatmp3
		ENDIF 
				
		USE IN c_BuscaParametrosAutorizacion2
		IF USED("c_sisParaAuto2")
			USE IN c_sisParaAuto2
		ENDIF  
				
	ENDIF 
	

	IF !EMPTY(lcaliasparaautoriza2)
		IF USED(lcaliasparaautoriza2)
			SELECT (lcaliasparaautoriza2)
		ENDIF 
	ENDIF 

	RETURN pdFechaPTV
ENDFUNC 


