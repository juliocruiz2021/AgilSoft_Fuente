	IF USED(lcOut)
	    USE IN (lcOut)
	ENDIF

	*-- Crear cursor con el registro más cercano (<=) para el id exacto
	SELECT TOP 1 * ;
	  FROM micyvCCombus ;
	 WHERE idclipro = tnIdCliPro ;
	   AND periodo <= lcPer ;
	 ORDER BY periodo DESC ;
	 INTO CURSOR (lcOut) READWRITE

	*-- Si no encontró, dejar cursor vacío pero con estructura igual
	IF RECCOUNT(lcOut) = 0
	    IF USED(lcOut)
		    USE IN (lcOut)
		ENDIF
	    SELECT * FROM micyvCCombus WHERE .F. INTO CURSOR (lcOut) READWRITE
	    llOk = .F.
	ELSE
	    llOk = .T.
	ENDIF
	USE IN micyvCCombus
	
	IF !EMPTY(lccali)
		SELECT (lccali)
	ENDIF 

	RETURN llOk
ENDFUNC




FUNCTION CCombus_UpsertPorPeriodo
	LPARAMETERS ;
	    tnIdCliPro, tcPeriodo, ;
	    tnRron, tnSron, tnDron, ;
	    tnRapi, tnSapi, tnDapi, ;
	    tnValDescc, tnValFletc, tnValSegc, ;
	    tcNomTrans, tnCodTTrans

	LOCAL lcPer, lcNom, lcCali, lcRes, llChanged

	*-- Evitar choque de alias si quedó abierto por error previo
	IF USED("micyvCCombus")
	    USE IN micyvCCombus
	ENDIF

	lcCali = ALIAS()
	USE (pcsysdir+pcdb+"\cyvCCombus") IN 0 ALIAS micyvCCombus SHARED AGAIN 

	*-- Normalizar periodo a C(6) yyyymm
	lcPer = ALLTRIM(TRANSFORM(tcPeriodo))
	IF LEN(lcPer) < 6
	    lcPer = PADL(lcPer, 6, "0")
	ENDIF
	lcPer = LEFT(lcPer, 6)

	*-- Normalizar nombre transporte
	lcNom = LEFT(TRANSFORM(tcNomTrans), 250)

	*-- Traer el registro si existe
	SELECT TOP 1 * ;
	  FROM micyvCCombus ;
	 WHERE idclipro = tnIdCliPro ;
	   AND periodo  = lcPer ;
	 ORDER BY idccomb ;
	 INTO CURSOR curExiste READWRITE


	IF RECCOUNT("curExiste") = 0
	    *-- No existe: INSERT
	    INSERT INTO micyvCCombus ;
	        (idclipro, periodo, rron, sron, dron, rapi, sapi, dapi, valdescc, valfletc, valsegc, nomTrans, codTTrans) ;
	    VALUES ;
	        (tnIdCliPro, lcPer, tnRron, tnSron, tnDron, tnRapi, tnSapi, tnDapi, tnValDescc, tnValFletc, tnValSegc, lcNom, tnCodTTrans)

	    lcRes = "I"
	ELSE
	    *-- Existe: comparar campos para ver si cambia algo
	    llChanged = .F.

	    IF curExiste.rron <> tnRron
	        llChanged = .T.
	    ENDIF
	    IF curExiste.sron <> tnSron
	        llChanged = .T.
	    ENDIF
	    IF curExiste.dron <> tnDron
	        llChanged = .T.
	    ENDIF

	    IF curExiste.rapi <> tnRapi
	        llChanged = .T.
	    ENDIF
	    IF curExiste.sapi <> tnSapi
	        llChanged = .T.
	    ENDIF
	    IF curExiste.dapi <> tnDapi
	        llChanged = .T.
	    ENDIF

	    IF curExiste.valdescc <> tnValDescc
	        llChanged = .T.
	    ENDIF
	    IF curExiste.valfletc <> tnValFletc
	        llChanged = .T.
	    ENDIF
	    IF curExiste.valsegc <> tnValSegc
	        llChanged = .T.
	    ENDIF

	    IF ALLTRIM(curExiste.nomTrans) <> ALLTRIM(lcNom)
	        llChanged = .T.
	    ENDIF

	    IF curExiste.codTTrans <> tnCodTTrans
	        llChanged = .T.
	    ENDIF

	    IF llChanged
	        *-- UPDATE solo si hubo cambios
	        UPDATE micyvCCombus SET ;
	            rron     = tnRron, ;
	            sron     = tnSron, ;
	            dron     = tnDron, ;
	            rapi     = tnRapi, ;
	            sapi     = tnSapi, ;
	            dapi     = tnDapi, ;
	            valdescc = tnValDescc, ;
	            valfletc = tnValFletc, ;
	            valsegc  = tnValSegc, ;
	            nomTrans = lcNom, ;
	            codTTrans= tnCodTTrans ;
	        WHERE idclipro = tnIdCliPro ;
	          AND periodo  = lcPer

	        lcRes = "U"
	    ELSE
	        lcRes = "N"
	    ENDIF
	ENDIF

	USE IN curExiste
	USE IN micyvCCombus

	IF !EMPTY(lcCali)
	    SELECT (lcCali)
	ENDIF

	RETURN lcRes
ENDFUNC




FUNCTION ObtenerFechaActualizacion()
	WAIT WINDOW "Obteniendo ultima fecha de Actualizacion...." NOWAIT 
	ltUltimaActu=CTOD(' ')
	
	LOCAL xhr
	xhr = CREATEOBJECT("Microsoft.XMLHTTP")
	xhr.Open("GET", pclink1, .f.)
	
	xhr.setRequestHeader('Content-Type', 'application/json')
	xhr.setRequestHeader('x-inventory-key', pclink0)
	xhr.send()


	LOCAL lcResultText
	lcResultText = xhr.responseText
	oJsonToken = CREATEOBJECT("json2")
	
*		_cliptext=lcResultText
	
	obToken=oJsonToken.Parse(lcResultText)
	lctockenAPI=''

	IF TYPE("obToken.ok")='L' 
		llStatusOK=obToken.ok
		IF llStatusOK=.t.
			ltUltimaActu=obToken.last_sync
		ELSE 
			ltUltimaActu=CTOD(' ')
		ENDIF 
	ELSE
		MESSAGEBOX('No hay Comunicacion con el Servidor Web',64,"Error .... ",3000) 
	ENDIF 
	
	RELEASE oJsonToken
	
	
	WAIT CLEAR 
	
	RETURN ltUltimaActu
ENDFUNC 




