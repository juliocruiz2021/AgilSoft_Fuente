FUNCTION _GerarTablaParaGraficoImpreso(lnidclip,ldmifecha,lcmicurbar)
	ldfec1g=ObtenerDatosdeMes(ldmifecha,4,6)+1
	ldfec2g=ldmifecha


	CREATE CURSOR (lcmicurbar) (idclip i,barmes1 c(4),barmes2 c(4),barmes3 c(4),barmes4 c(4),barmes5 c(4),barmes6 c(4),;
									valmes1 n(12,0),valmes2 n(12,0),valmes3 n(12,0),valmes4 n(12,0),valmes5 n(12,0),valmes6 n(12,0),;
									barval1 n(12,2),barval2 n(12,2),barval3 n(12,2),barval4 n(12,2),barval5 n(12,2),barval6 n(12,2),;
									monmes1 n(12,2),monmes2 n(12,2),monmes3 n(12,2),monmes4 n(12,2),monmes5 n(12,2),monmes6 n(12,2))

		
	IF !USED("cyvlecturas")
		USE pcsysdir+pcDB+"\cyvlecturas" IN 0 SHARED AGAIN
		llAbriolecturas=.t.
	ELSE
		llAbriolecturas=.f.
	ENDIF 
	select cc.idclipro as idclip,cc.mes,cc.ano,min(VAL(ALLTRIM(STR(cc.ano))+PADL(ALLTRIM(STR(cc.mes)),2,"0"))) as llavemin,;
			VAL(ALLTRIM(STR(cc.ano))+PADL(ALLTRIM(STR(cc.mes)),2,"0")) as llave,MAX(periodo) as periodo,;
			SUM(consumo) as consumo ,MAX(idtarifa) as mitarifa,000000000.00 as montoval ;
		FROM (select MAX(fecha) as fecha,YEAR(fecha) ano,;
					MONTH(fecha) as mes,MAX(NombreMesCorto(MONTH(fecha),YEAR(fecha))+SPACE(4)) as periodo,;
					SUM(consumo) as consumo,idclipro,MAX(idtarifa) as idtarifa ;
				FROM cyvLecturas group by idclipro,ano,mes ) as cc  ;
		WHERE cc.idclipro=lnidclip AND BETWEEN(cc.fecha,ldfec1g,ldfec2g)   ;
	order by cc.idclipro,cc.ano,cc.mes group by cc.idclipro,cc.ano,cc.mes INTO CURSOR c_datosgrafico READWRITE 
	
	ldmifectmp= ObtenerDatosdeMes(ldfec1g,4,2)+1
	lnidclitmp=idclip
	lnllmin=llavemin
	
	FOR imes=1 TO 6
		ldfecimes=ObtenerDatosdeMes(ldmifecha,4,imes)+1
		lnmesn=MONTH(ldfecimes)
		lnanon=YEAR(ldfecimes)
		lntar=mitarifa
		lnvalconsumo=_mitarifa(lntar,consumo)
		lcmiper=NombreMesCorto(MONTH(ldfecimes),YEAR(ldfecimes))+SPACE(4)
		lnllaven=VAL(ALLTRIM(STR(lnanon))+PADL(ALLTRIM(STR(lnmesn)),2,"0"))
		LOCATE FOR ano=lnanon AND mes=lnmesn
		IF EOF()
			INSERT INTO  c_datosgrafico VALUES (lnidclitmp,lnmesn,lnanon,lnllaven,lnllaven,lcmiper,0,0,lnvalconsumo)
		ENDIF 
	ENDFOR 
	INDEX on llave TAG llave
	SET ORDER TO llave

	select idclip,;
			MAX(consumo) as maximo,;
			MIN(consumo) as minimo,;
			AVG(consumo) as promedio,  ;
			000000000.00 as monto ;
		FROM c_datosgrafico order by idclip group by idclip INTO CURSOR cc READWRITE 
		
	select a.*,maximo,minimo,promedio,monto ;
		from c_datosgrafico a LEFT JOIN cc b ON a.idclip=b.idclip ORDER BY a.idclip,a.llave INTO CURSOR c_datosg READWRITE 
	REPLACE monto WITH _mitarifa(mitarifa,consumo) all
	GO top


	lnidclibar=-1
	lnminllave=-1
	lnmaximo=-1.00
	

	SCAN all
		IF lnidclibar<>idclip
			lnidclibar=idclip
			lnminllave=llavemin
			INSERT INTO (lcmicurbar) (idclip) VALUES (lnidclibar )
		ENDIF 
		*lnmesbarra=llave-lnminllave+1
		lnmesbarra=RECNO()
		lnvalorbar=IIF(NVL(maximo,0)=0,0,(consumo/maximo)*100)
		lnvalmes=consumo
		lnmonto=monto
		lcperbar=periodo
		DO case
			CASE lnmesbarra=1
				REPLACE barmes1 WITH lcperbar,barval1 WITH lnvalorbar,valmes1 WITH lnvalmes,monmes1 with lnmonto IN (lcmicurbar)
			CASE lnmesbarra=2
				REPLACE barmes2 WITH lcperbar,barval2 WITH lnvalorbar,valmes2 WITH lnvalmes,monmes2 with lnmonto IN (lcmicurbar)
			CASE lnmesbarra=3
				REPLACE barmes3 WITH lcperbar,barval3 WITH lnvalorbar,valmes3 WITH lnvalmes,monmes3 with lnmonto IN (lcmicurbar)
			CASE lnmesbarra=4
				REPLACE barmes4 WITH lcperbar,barval4 WITH lnvalorbar,valmes4 WITH lnvalmes,monmes4 with lnmonto IN (lcmicurbar)
			CASE lnmesbarra=5
				REPLACE barmes5 WITH lcperbar,barval5 WITH lnvalorbar,valmes5 WITH lnvalmes,monmes5 with lnmonto IN (lcmicurbar)
			CASE lnmesbarra=6
				REPLACE barmes6 WITH lcperbar,barval6 WITH lnvalorbar,valmes6 WITH lnvalmes,monmes6 with lnmonto IN (lcmicurbar)
		ENDCASE 
	ENDSCAN 
	
	IF llAbriolecturas=.t.
		USE IN cyvlecturas
	ENDIF 
	USE IN cc
	USE IN c_datosg
	*USE IN c_datosgrafico
ENDFUNC 



FUNCTION _PrecioCombustible(ldfeccomb,lnptovtacomb,lnturnocomb,lnIdprodcomb)
	lcAliasComb=ALIAS() 
	lnPrecioconIvaComb=0
	IF !USED("invProdPreComb")
		USE pcsysdir+pcDB+"\invProdPreComb" IN 0 SHARED AGAIN
	ENDIF
	IF !USED("invProdPreCombDeta")
		USE pcsysdir+pcDB+"\invProdPreCombDeta" IN 0 SHARED AGAIN
	ENDIF

	SELECT  DTOS(b.fecha)+STR(b.turno,3) as mifecha,a.*,b.* ;
		FROM invProdPreCombDeta a ;
			INNER JOIN invProdPreComb b ON a.idPreComb=b.idPreComb ;
			where (b.turno<=lnturnocomb and b.fecha=ldfeccomb and a.idproducto=lnIdprodcomb AND b.idpuntovta=lnptovtacomb ) OR ;
					(b.fecha<ldfeccomb and a.idproducto=lnIdprodcomb AND b.idpuntovta=lnptovtacomb )  ;
			order by mifecha DESC INTO CURSOR c_miPrecio
	lnPrecioconIvaComb=NVL(c_miPrecio.precioconiva,0.00)

	USE IN c_miPrecio
	
	IF !EMPTY(lcAliasComb)
		SELECT (lcAliasComb)
	ENDIF 

	RETURN lnPrecioconIvaComb
ENDFUNC 



