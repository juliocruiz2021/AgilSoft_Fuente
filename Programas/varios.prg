FUNCTION NombreStatus(lcIdStat)
	IF TYPE("lcIdStat")="C"
		lnIdStat=VAL(lcIdStat)
	ELSE
		lnIdStat=lcIdStat
	ENDIF  
	DO case
		CASE lnIdStat=1
			lcRetorStat="Abierta"
		CASE lnIdStat=2
			lcRetorStat="Diseñandose"
		CASE lnIdStat=3
			lcRetorStat="Para Impresión"
		CASE lnIdStat=4
			lcRetorStat="Imprimiendose"
		CASE lnIdStat=5
			lcRetorStat="Incompleta"
		CASE lnIdStat=6
			lcRetorStat="Terminada"
		CASE lnIdStat=7
			lcRetorStat="En Despacho"
		CASE lnIdStat=8
			lcRetorStat="Entregada"
		OTHERWISE 
			lcRetorStat=""
	ENDCASE 
	RETURN lcRetorStat
ENDFUNC 


