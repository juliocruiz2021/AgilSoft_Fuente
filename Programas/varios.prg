		USE IN cyvcompras

		USE pcSysDir+pcdb+'\cybmovimientos' EXCLUSIVE IN 0
		ALTER table cybmovimientos ADD COLUMN idPtoVta i DEFAULT  0
		USE IN cybmovimientos

		USE pcSysDir+pcdb+'\siskardexdoc' EXCLUSIVE IN 0
		ALTER table siskardexdoc ADD COLUMN idPtoVta i DEFAULT  0
		USE IN siskardexdoc

		USE pcSysDir+pcdb+'\cyvturnos' EXCLUSIVE IN 0
		ALTER table cyvturnos ADD COLUMN idPtoVta i DEFAULT  0
		USE IN cyvturnos
		
