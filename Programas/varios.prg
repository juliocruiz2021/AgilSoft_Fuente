FUNCTION _subeComparacionRegistros(lcTabla)
	lcaliascompara=ALIAS()
	
	lncntComp=_conectaRemoto(pcDBR,pnTipoconeccionR,pcDriverR,pcServerR,pcRootR,pcClaveR,pcPortR)

	IF lncntComp>0
		******** Comparando ventas
		lcCursor="jrcompara"
		WAIT WINDOW "Iniciando la descarga de Registros de la Nube..." TIMEOUT 1
		WAIT WINDOW "Iniciando la descarga de Registros de la Nube..." NOWAIT 

		SELECT 0
		DO CASE 
			CASE lcTabla='cyvventas'
				lcComandoCompara="select *,0 as modificado from jrcompara where tabla in ('"+lcTabla+" ','"+lcTabla+"deta ') ;"
				_select(lncntComp,lcComandoCompara,lcCursor,lcCursor)
				lncuenta=ALLTRIM(STR(RECCOUNT()))

				USE pcsysdir+pcDB+"\cyvventas" SHARED AGAIN IN 0 ALIAS uno
				USE pcsysdir+pcDB+"\cyvventasdeta" SHARED AGAIN  IN 0 ALIAS dos
				
			CASE lcTabla='cyvcompras'
				lcComandoCompara="select *,0 as modificado from jrcompara where tabla in ('"+lcTabla+" ','"+lcTabla+"deta ') ;"
				_select(lncntComp,lcComandoCompara,lcCursor,lcCursor)
				lncuenta=ALLTRIM(STR(RECCOUNT()))

				USE pcsysdir+pcDB+"\cyvcompras" SHARED AGAIN IN 0 ALIAS uno
				USE pcsysdir+pcDB+"\cyvcomprasdeta" SHARED AGAIN  IN 0 ALIAS dos
				
			CASE lcTabla='cybmovimientos'
				lcComandoCompara="select *,0 as modificado from jrcompara where tabla in ('cybmovimientos','ctbpartidasdeta','siskardexapli');"
				_select(lncntComp,lcComandoCompara,lcCursor,lcCursor)
				lncuenta=ALLTRIM(STR(RECCOUNT()))

				USE pcsysdir+pcDB+"\cybmovimientos" SHARED AGAIN IN 0 ALIAS uno
				USE pcsysdir+pcDB+"\ctbpartidasdeta" SHARED AGAIN IN 0 ALIAS dos
				USE pcsysdir+pcDB+"\siskardexapli" SHARED AGAIN IN 0 ALIAS tres
				
			CASE lcTabla='invinventarios'
				lcComandoCompara="select *,0 as modificado from jrcompara where tabla in ('"+lcTabla+" ','"+lcTabla+"deta ') ;"
				_select(lncntComp,lcComandoCompara,lcCursor,lcCursor)
				lncuenta=ALLTRIM(STR(RECCOUNT()))

				USE pcsysdir+pcDB+"\invinventarios" SHARED AGAIN IN 0 ALIAS uno
				USE pcsysdir+pcDB+"\invinventariosdeta" SHARED AGAIN  IN 0 ALIAS dos
		ENDCASE 

		WAIT WINDOW lncuenta+' Reg. Listos para Auditarse.... ' TIMEOUT 1
		WAIT WINDOW lncuenta+' Reg. Listos para Auditarse.... ' NOWAIT 
			***** actualizando registros antiguos
			IF lcTabla='cybmovimientos'
				SELECT cc.iddocto,MAX(cc.fecmod) as fecmod,cc.tabla ;
					FROM (SELECT a.iddocto,TTOC(a.fecmod) as fecmod,"cybmovimientos" as tabla ;
							FROM uno a INNER JOIN &lcCursor b ON a.iddocto=b.llave AND "cybmovimientos"=b.tabla AND pcnodo=b.nodo AND a.fecmod>b.fecmod;
						UNION ALL ;
						SELECT a.idpartida as iddocto,TTOC(a.fecmod) as fecmod,"ctbpartidasdeta" as tabla ;
							FROM dos a INNER JOIN &lcCursor b ON a.idpartida=b.llave AND "ctbpartidasdeta" =b.tabla AND pcnodo=b.nodo AND a.fecmod>b.fecmod;
						UNION ALL ;
						SELECT a.iddocto,TTOC(a.fecmod) as fecmod,"siskardexapli" as tabla ;
							FROM tres a INNER JOIN &lcCursor b ON a.iddocto=b.llave AND "siskardexapli"=b.tabla AND pcnodo=b.nodo AND a.fecmod>b.fecmod) as CC;
					ORDER BY cc.iddocto,cc.tabla GROUP BY cc.iddocto,cc.tabla INTO CURSOR c_refrescar READWRITE 
			ELSE 
				SELECT cc.iddocto,MAX(cc.fecmod) as fecmod,cc.tabla;
					FROM (SELECT a.iddocto,TTOC(a.fecmod) as fecmod,lcTabla as tabla ;
							FROM uno a INNER JOIN &lcCursor b ON a.iddocto=b.llave AND lcTabla=b.tabla AND pcnodo=b.nodo AND a.fecmod>b.fecmod ;
						UNION ALL ;
						SELECT a.iddocto,TTOC(a.fecmod) as fecmod,lcTabla+'deta' as tabla ;
							FROM dos a INNER JOIN &lcCursor b ON a.iddocto=b.llave AND lcTabla+'deta'=b.tabla AND pcnodo=b.nodo AND a.fecmod>b.fecmod) as CC ;
					ORDER BY cc.iddocto,cc.tabla GROUP BY cc.iddocto,cc.tabla INTO CURSOR c_refrescar READWRITE 
			ENDIF 
*			SELECT a.iddocto,MAX(a.fecmod) as fecmod ;
				FROM &lctabla a INNER JOIN &lcCursor b ON a.iddocto=b.llave AND lcTablaNodo=b.tabla ;
				WHERE a.fecmod>b.fecmod  ORDER BY a.iddocto GROUP BY a.iddocto INTO CURSOR c_refrescar READWRITE 
		lncuenta=ALLTRIM(STR(RECCOUNT()))
		WAIT WINDOW lncuenta+' Reg. Modificados en el nodo  '+pcnodo TIMEOUT 1
		WAIT WINDOW lncuenta+' Reg. Modificados en el nodo  '+pcnodo NOWAIT 

			UPDATE &lcCursor SET &lcCursor..fecmod=c_refrescar.fecmod ;
				from c_refrescar WHERE &lcCursor..llave=c_refrescar.iddocto AND &lcCursor..tabla=c_refrescar.tabla AND  &lcCursor..nodo=pcnodo

		lncuenta=ALLTRIM(STR(_tally))
		WAIT WINDOW lncuenta+' Reg. Actualizados con Cambios en el Nodo '+pcnodo TIMEOUT 1
		WAIT WINDOW lncuenta+' Reg. Actualizados con Cambios en el Nodo '+pcnodo NOWAIT 

	
		****** insertando regisros nuevos
		IF lcTabla='cybmovimientos'
			INSERT INTO &lcCursor (llave,tabla,nodo,refrescar,fecmod) ;
				SELECT cc.iddocto,MAX(cc.tabla) as tabla,MAX(cc.nodo) as nodo,MAX(cc.refrescar) as refrescar,MAX(TTOC(cc.fecmod)) as fecmod ;
					FROM (SELECT iddocto,lcTabla as tabla,pcnodo as nodo,0 as refrescar,fecmod as fecmod ;
							FROM uno ;
							WHERE origen='BCO' AND iddocto<>0 AND STR(iddocto)+'siskardexapli' NOT in (select STR(llave)+tabla FROM &lcCursor WHERE tabla='cybmovimientos' AND nodo=pcnodo) ;
					union all ;
					SELECT idpartida as iddocto,'ctbpartidasdeta' as tabla,pcnodo as nodo,0 as refrescar,fecmod as fecmod ;
							FROM dos ;
							WHERE idpartida in (select iddocto FROM uno) AND origen='BCO' AND idpartida<>0 AND STR(idpartida)+'siskardexapli' NOT in (select STR(llave)+'ctbpartidasdeta' FROM &lcCursor WHERE tabla='ctbpartidasdeta' AND nodo=pcnodo ) ;
					union all ;
					SELECT iddocto,'siskardexapli' as tabla,pcnodo as nodo,0 as refrescar,fecmod as fecmod ;
							FROM tres ;
							WHERE iddocto<>0 AND iddocto in (select iddocto FROM uno) AND STR(iddocto)+'siskardexapli' NOT in (select STR(llave)+'siskardexapli' FROM &lcCursor WHERE tabla='siskardexapli' AND nodo=pcnodo )) as CC ;
				order by cc.iddocto,cc.tabla group by cc.iddocto,cc.tabla WHERE STR(cc.iddocto)+cc.tabla NOT in  ;
						(select STR(llave)+tabla FROM &lcCursor WHERE INLIST(tabla,lcTabla,'ctbpartidasdeta','siskardexapli') AND nodo=pcnodo)	
		ELSE 
			IF lcTabla='invinventarios'
				INSERT INTO &lcCursor (llave,tabla,nodo,refrescar,fecmod) ;
					SELECT cc.iddocto as llave,MAX(cc.tabla) as tabla,MAX(cc.nodo) as nodo,MAX(cc.refrescar) as refrescar,MAX(TTOC(cc.fecmod)) as fecmod ;
						FROM (SELECT iddocto,lcTabla as tabla,pcnodo as nodo,0 as refrescar,fecmod as fecmod ;
								FROM uno ;
								WHERE origen='INV' AND iddocto<>0 AND STR(iddocto)+lcTabla NOT in (select STR(llave)+tabla FROM &lcCursor WHERE tabla=lcTabla AND nodo=pcnodo) ;
						union all ;
						SELECT iddocto,lcTabla+'deta' as  tabla,pcnodo as nodo,0 as refrescar,fecmod as fecmod ;
								FROM dos ;
								WHERE iddocto in (select iddocto FROM uno) AND origen='INV' AND iddocto<>0 AND STR(iddocto)+lcTabla NOT in (select STR(llave)+tabla+'deta' FROM &lcCursor WHERE tabla=lcTabla+'deta' AND nodo=pcnodo)) as CC ;
					order by cc.iddocto,cc.tabla group by cc.iddocto,cc.tabla WHERE STR(cc.iddocto)+cc.tabla NOT in  ;
							(select STR(llave)+tabla FROM &lcCursor WHERE INLIST(tabla,lcTabla,lcTabla+'deta') AND nodo=pcnodo)
			ELSE
				INSERT INTO &lcCursor (llave,tabla,nodo,refrescar,fecmod) ;
					SELECT cc.iddocto as llave,MAX(cc.tabla) as tabla,MAX(cc.nodo) as nodo,MAX(cc.refrescar) as refrescar,MAX(TTOC(cc.fecmod)) as fecmod ;
						FROM (SELECT iddocto,lcTabla as tabla,pcnodo as nodo,0 as refrescar,fecmod as fecmod ;
								FROM uno ;
								WHERE iddocto<>0 AND STR(iddocto)+lcTabla NOT in (select STR(llave)+tabla FROM &lcCursor WHERE tabla=lcTabla AND nodo=pcnodo) ;
						union all ;
						SELECT iddocto,lcTabla+'deta' as  tabla,pcnodo as nodo,0 as refrescar,fecmod as fecmod ;
								FROM dos ;
								WHERE iddocto in (select iddocto FROM uno) AND iddocto<>0 AND STR(iddocto)+lcTabla NOT in (select STR(llave)+tabla+'deta' FROM &lcCursor WHERE tabla=lcTabla+'deta' AND nodo=pcnodo)) as CC ;
					order by cc.iddocto,cc.tabla group by cc.iddocto,cc.tabla WHERE STR(cc.iddocto)+cc.tabla NOT in  ;
							(select STR(llave)+tabla FROM &lcCursor WHERE INLIST(tabla,lcTabla,lcTabla+'deta') AND nodo=pcnodo)
			ENDIF 
		ENDIF 
		
		SELECT (lcCursor)
		lncuenta=ALLTRIM(STR(_tally))
		WAIT WINDOW lncuenta+' Reg. Nuevos para Ser Auditados en el nodo  '+pcnodo TIMEOUT 1
		WAIT WINDOW lncuenta+' Reg. Nuevos para Ser Auditados en el nodo  '+pcnodo NOWAIT 


		***** Guardando Regisros
		BEGIN TRANSACTION
		WAIT WINDOW "Inicando la Sincronizacion de Auditoria de Registros de "+lcTabla TIMEOUT 1
		WAIT WINDOW "Inicando la Sincronizacion de Auditoria de Registros de "+lcTabla NOWAIT 
		llRet=TABLEUPDATE(1,.t.,lcCursor)


		IF llRet
			WAIT WINDOW 'Registro Actualizados de '+lcTabla nowait
			END TRANSACTION 
		ELSE
			ROLLBACK 
			_MostrarErroresSQLAutomatico(lncntComp)
		ENDIF 

		USE IN c_refrescar
		USE IN (lcCursor)
		USE IN uno
		USE IN dos
		IF lcTabla='cybmovimientos'
			USE IN tres
		ENDIF 
		
		SQLDISCONNECT(lncntComp)
	ELSE
		WAIT WINDOW 'Error, Imposible Conectarse al Servidor...'
	ENDIF 
	

	IF !EMPTY(lcAliasCompara)
		SELECT (lcAliasCompara)
	ENDIF 
ENDFUNC 



FUNCTION _RecuperaResgistrosCompara()
	lcaliascompara=ALIAS()
	
	lncntComp=_conectaRemoto(pcDBR,pnTipoconeccionR,pcDriverR,pcServerR,pcRootR,pcClaveR,pcPortR)

	IF lncntComp>0
		******** Comparando ventas
		lcCursor="jrcompara"
		lcComandoCompara="update jrcompara set refrescar =0 where 1;"
		lnmisnod=SQLEXEC(lncntComp,lcComandoCompara)
		lcComandoCompara="select nodo from jrcompara group by nodo order by nodo ;"
		lnmisnod=SQLEXEC(lncntComp,lcComandoCompara,'misNodos')
		IF lnmisnod>0
			SELECT misNodos
			lccomandofaltan=''
			lcunionall=''
			SCAN all
				lcmin=nodo
				lccomandofaltan=lccomandofaltan+lcunionall+;
					"select * from jrcompara where nodo<>'"+lcmin+"'  and  CONCAT(llave,tabla) "+;
							"not in (select CONCAT(llave,tabla) from jrcompara where nodo='"+pcnodo+"' ) "
				lcunionall=' Union All '
			ENDSCAN 
			lcComandoCompara="select cc.llave,cc.tabla,cc.nodo,MIN(refrescar) as refrescar,cc.fecmod from ("+lccomandofaltan+") as cc group by  cc.llave,cc.tabla,cc.nodo order by cc.llave,cc.tabla,cc.nodo "
*			lcComandoCompara="select * from jrcompara where nodo='"+pcnodo+"'  and  CONCAT(llave,tabla) not in (select CONCAT(llave,tabla) from jrcompara where nodo='"+pcnodo+"' ) ;"

			_select(lncntComp,lcComandoCompara,lcCursor,lcCursor)
			USE IN misNodos
		ENDIF 
	ELSE
		WAIT WINDOW 'Error, Imposible Conectarse al Servidor...'
	ENDIF 
	
	IF !EMPTY(lcAliasCompara)
		SELECT (lcAliasCompara)
	ENDIF 
	RETURN lncntComp
ENDFUNC 




FUNCTION _RefrescaResgistrosCompara(lnConec)
	lcAliasCompara=ALIAS()
	llretornaok=.f.
	IF lnConec>0
		lcCursor="jrcompara"
		SELECT (lcCursor)
		
		***** Guardando Regisros
		BEGIN TRANSACTION
		WAIT WINDOW "Actualizando Registros " NOWAIT 
		llRet=TABLEUPDATE(1,.t.,lcCursor)
		
		IF llRet
			WAIT WINDOW 'Registro Actualizados ' nowait
			END TRANSACTION 
		ELSE
			ROLLBACK 
			_MostrarErroresSQLAutomatico(lnConec)
		ENDIF 

		USE IN (lcCursor)
		
		=SQLDISCONNECT(lnConec)
		llretornaok=.t.
	ELSE
		WAIT WINDOW 'Error, Imposible Conectarse al Servidor...'
	ENDIF 
	

	IF !EMPTY(lcAliasCompara) AND UPPER(lcAliasCompara)<>UPPER('jrcompara')
		SELECT (lcAliasCompara)
	ENDIF 
	RETURN llretornaok
ENDFUNC 



