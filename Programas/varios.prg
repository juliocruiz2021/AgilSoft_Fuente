FUNCTION ValidaCorreo(tcCorreo)
    LOCAL lcCorreo, loRegex, lbResultado

    lcCorreo = QuitarTildes(ALLTRIM(tcCorreo))
    
    * Crear una instancia de la clase Regex
    loRegex = CREATEOBJECT("VBScript.RegExp")
    
    * Establecer el patrón para validar el correo electrónico
    loRegex.Pattern = "^[A-Z0-9._%+-ñáéíóúüÁÉÍÓÚÜ]+@[A-Z0-9.-]+\.[A-Z]{2,}$"
    loRegex.IgnoreCase = .T.
    loRegex.Global = .T.
    
    * Validar el correo electrónico
    lbResultado = loRegex.Test(lcCorreo)
    IF lbResultado=.t.
    	lcRetornaCorreo=lcCorreo
    ELSE 
    	lcRetornaCorreo=''
    ENDIF 
    
    RETURN lcRetornaCorreo
ENDFUNC


* Función para validar direcciones de correo electrónico
FUNCTION ValidarVariosCorreos(tcEmails,lnRetornar)
    LOCAL lcEmails,  lnCount, i, lcEmail, lcPattern, llValid,lcMensaje,lcCorreosValidos
    tcEmails=QuitarTildes(ALLTRIM(_sinEnterNiTAb(tcEmails)))
    IF RIGHT(tcEmails,1)<>";"
    	tcEmails=tcEmails+";" 		&&& agreagmos un punto y coma al final para que no borre el ultimo correo
    ENDIF 
    **** lnRetornar    0 retorna todos,1 retorna el principal 2 retorna del segundo en adelante
    lcCorreosValidos=''
    lcComaValidos=''
	lcMensajes='Correos Invalidos: '
	lcComaCorreos=''
    * Inicializar variables
    lcEmails = ALLTRIM(tcEmails)
    *laEmails = ""
    lcPattern = "^[A-Z0-9._%+-ñáéíóúüÁÉÍÓÚÜ]+@[A-Z0-9.-]+\.[A-Z]{2,}$"
    llValid = .T.

    * Dividir las direcciones de correo por ";"
    
    lnCount = ALINES(laEmails, lcEmails, ";")

    * Recorrer cada dirección de correo
    FOR i = 1 TO lnCount
        lcEmail = ALLTRIM(laEmails[i])
        * Validar el formato de la dirección de correo
        micorreo=ValidaCorreo(lcEmail)
        IF EMPTY(micorreo)
        	lcMensajes=lcMensajes+lcComaCorreos+" "+lcEmail
        	lcComaCorreos=','
            llValid = .F.
  *          EXIT
 		ELSE
	 		IF INLIST(lnRetornar,0,2)		&&& retorna todos  o  todos menos el principal
	 			IF lnRetornar=2
	 				IF i=1
	 				ELSE 
		 				lcCorreosValidos=lcCorreosValidos+lcComaValidos+micorreo
			 			lcComaValidos='; '	
	 				ENDIF 
	 			ELSE
					lcCorreosValidos=lcCorreosValidos+lcComaValidos+micorreo
	 				lcComaValidos='; '	
	 			ENDIF 
	 		ELSE
	 			IF lnRetornar=1
	 				lcCorreosValidos=lcCorreosValidos+lcComaValidos+micorreo
	 				lcComaValidos='; '
	 			ENDIF 	
	 		ENDIF 
 			IF lnRetornar=1		&&& retorna el principal
	 			IF i=1
	 				EXIT 
	 			ENDIF 
 			ENDIF 
 			
        ENDIF
    NEXT
   
   	IF lnRetornar=0
		IF ALLTRIM(lcMensajes)=='Correos Invalidos:'
		ELSE 
			tcEmails=''
			IF !EMPTY(lcCorreosValidos)
