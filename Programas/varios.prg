*****************************************************************
********** crea un cursor con todas las combinaciones de cuentas padres
********** uso: _CtasPadre(	idcuenta si se quiere filtar solo una cuenta,
********** 					lctabla nombre de la tabla de cuentas contables abierta,
**********					nombre del cursor que se creara
**********************************************************************
FUNCTION _CtasPadre (lnidctaa as Integer,lcTablaCuentas as String,lcCursorCtaPadree as String)
	lcaliasmicuentas=ALIAS()
	
	IF lnidctaa=0
		lcfilctaa=''
	ELSE
		lcfilctaa='where idcuenta1='+ALLTRIM(STR(lnidctaa))
	ENDIF 
	
	IF EMPTY(lcTablaCuentas)
		lcTablaCuentas='miCtbCuentas'
		USE pcsysdir+pcDB+"\ctbcuentas" IN 0 SHARED AGAIN ORDER idcuenta ALIAS miCtbCuentas
		llcerrartabla=.t.
	ELSE
		llcerrartabla=.f.
	ENDIF 
	
	IF !EMPTY(lcCursorCtaPadree)
		lcmicurpadre=lcCursorCtaPadree
	ELSE
		lcmicurpadre='c_Padres'
	ENDIF 
	
	
	SELECT idcuenta1 as idcuenta,idcuenta2 as idcuentarelacion,nivel FROM (;
		SELECT idcuenta as idcuenta1,idcuenta as idcuenta2,idpadre,nivel ;
			FROM &lcTablaCuentas WHERE detalle=1 ;
	union ALL ;
		SELECT aa.idcuenta1,a.idcuenta as idcuenta2,a.idpadre,a.nivel ;
			FROM &lcTablaCuentas a ;
				INNER JOIN (SELECT idcuenta as idcuenta1,idcuenta as idcuenta2,idpadre ;
								FROM &lcTablaCuentas WHERE detalle=1) as aa ON a.idcuenta=aa.idpadre ;
	union ALL ;
		SELECT bb.idcuenta1,b.idcuenta as idcuenta2,b.idpadre,b.nivel ;
			FROM &lcTablaCuentas b ;
				INNER JOIN (SELECT aa.idcuenta1,a.idcuenta as idcuenta2,a.idpadre,a.nivel ;
			FROM &lcTablaCuentas a ;
				INNER JOIN (SELECT idcuenta as idcuenta1,idcuenta as idcuenta2,idpadre ;
								FROM &lcTablaCuentas WHERE detalle=1) as aa ON a.idcuenta=aa.idpadre) as bb ;
					ON b.idcuenta=bb.idpadre ;
	UNION ALL ;
		SELECT cc.idcuenta1,c.idcuenta as idcuenta2,c.idpadre,c.nivel ;
			FROM &lcTablaCuentas c ;
				INNER JOIN (SELECT bb.idcuenta1,b.idcuenta as idcuenta2,b.idpadre,b.nivel ;
			FROM &lcTablaCuentas b ;
				INNER JOIN (SELECT aa.idcuenta1,a.idcuenta as idcuenta2,a.idpadre,a.nivel ;
			FROM &lcTablaCuentas a ;
				INNER JOIN (SELECT idcuenta as idcuenta1,idcuenta as idcuenta2,idpadre ;
								FROM &lcTablaCuentas WHERE detalle=1) as aa ON a.idcuenta=aa.idpadre) as bb ;
					ON b.idcuenta=bb.idpadre) as cc ON c.idcuenta=cc.idpadre ; 
	UNION ALL ;
		SELECT dd.idcuenta1,d.idcuenta as idcuenta2,d.idpadre,d.nivel ;
			FROM &lcTablaCuentas d ;
				INNER JOIN  (SELECT cc.idcuenta1,c.idcuenta as idcuenta2,c.idpadre,c.nivel ;
			FROM &lcTablaCuentas c ;
				INNER JOIN (SELECT bb.idcuenta1,b.idcuenta as idcuenta2,b.idpadre,b.nivel ;
			FROM &lcTablaCuentas b ;
				INNER JOIN (SELECT aa.idcuenta1,a.idcuenta as idcuenta2,a.idpadre,a.nivel ;
			FROM &lcTablaCuentas a ;
				INNER JOIN (SELECT idcuenta as idcuenta1,idcuenta as idcuenta2,idpadre ;
								FROM &lcTablaCuentas WHERE detalle=1) as aa ON a.idcuenta=aa.idpadre) as bb ;
					ON b.idcuenta=bb.idpadre) as cc ON c.idcuenta=cc.idpadre ) as dd ON d.idcuenta=dd.idpadre ;
	UNION ALL ;
		SELECT ee.idcuenta1,e.idcuenta as idcuenta2,e.idpadre,e.nivel ;
			FROM &lcTablaCuentas e ;
				INNER JOIN  (SELECT dd.idcuenta1,d.idcuenta as idcuenta2,d.idpadre,d.nivel ;
			FROM &lcTablaCuentas d ;
				INNER JOIN  (SELECT cc.idcuenta1,c.idcuenta as idcuenta2,c.idpadre,c.nivel ;
			FROM &lcTablaCuentas c ;
				INNER JOIN (SELECT bb.idcuenta1,b.idcuenta as idcuenta2,b.idpadre,b.nivel ;
			FROM &lcTablaCuentas b ;
				INNER JOIN (SELECT aa.idcuenta1,a.idcuenta as idcuenta2,a.idpadre,a.nivel ;
			FROM &lcTablaCuentas a ;
				INNER JOIN (SELECT idcuenta as idcuenta1,idcuenta as idcuenta2,idpadre ;
								FROM &lcTablaCuentas WHERE detalle=1) as aa ON a.idcuenta=aa.idpadre) as bb ;
					ON b.idcuenta=bb.idpadre) as cc ON c.idcuenta=cc.idpadre ) as dd ON d.idcuenta=dd.idpadre ) as ee ;
					ON e.idcuenta=ee.idpadre;
	UNION ALL ;
		SELECT ff.idcuenta1,f.idcuenta as idcuenta2,f.idpadre,f.nivel ;
			FROM &lcTablaCuentas f ;
				INNER JOIN  (SELECT ee.idcuenta1,e.idcuenta as idcuenta2,e.idpadre,e.nivel ;
			FROM &lcTablaCuentas e ;
				INNER JOIN  (SELECT dd.idcuenta1,d.idcuenta as idcuenta2,d.idpadre,d.nivel ;
			FROM &lcTablaCuentas d ;
				INNER JOIN  (SELECT cc.idcuenta1,c.idcuenta as idcuenta2,c.idpadre,c.nivel ;
			FROM &lcTablaCuentas c ;
				INNER JOIN (SELECT bb.idcuenta1,b.idcuenta as idcuenta2,b.idpadre,b.nivel ;
			FROM &lcTablaCuentas b ;
				INNER JOIN (SELECT aa.idcuenta1,a.idcuenta as idcuenta2,a.idpadre,a.nivel ;
			FROM &lcTablaCuentas a ;
				INNER JOIN (SELECT idcuenta as idcuenta1,idcuenta as idcuenta2,idpadre ;
								FROM &lcTablaCuentas WHERE detalle=1) as aa ON a.idcuenta=aa.idpadre) as bb ;
					ON b.idcuenta=bb.idpadre) as cc ON c.idcuenta=cc.idpadre ) as dd ON d.idcuenta=dd.idpadre ) as ee ;
					ON e.idcuenta=ee.idpadre) as ff ON f.idcuenta=ff.idpadre ;
	UNION ALL ;
		SELECT gg.idcuenta1,g.idcuenta as idcuenta2,g.idpadre,g.nivel ;
			FROM &lcTablaCuentas g ;
				INNER JOIN  (SELECT ff.idcuenta1,f.idcuenta as idcuenta2,f.idpadre,f.nivel ;
			FROM &lcTablaCuentas f ;
				INNER JOIN  (SELECT ee.idcuenta1,e.idcuenta as idcuenta2,e.idpadre,e.nivel ;
			FROM &lcTablaCuentas e ;
				INNER JOIN  (SELECT dd.idcuenta1,d.idcuenta as idcuenta2,d.idpadre,d.nivel ;
			FROM &lcTablaCuentas d ;
				INNER JOIN  (SELECT cc.idcuenta1,c.idcuenta as idcuenta2,c.idpadre,c.nivel ;
			FROM &lcTablaCuentas c ;
				INNER JOIN (SELECT bb.idcuenta1,b.idcuenta as idcuenta2,b.idpadre,b.nivel ;
			FROM &lcTablaCuentas b ;
				INNER JOIN (SELECT aa.idcuenta1,a.idcuenta as idcuenta2,a.idpadre,a.nivel ;
			FROM &lcTablaCuentas a ;
				INNER JOIN (SELECT idcuenta as idcuenta1,idcuenta as idcuenta2,idpadre ;
								FROM &lcTablaCuentas WHERE detalle=1) as aa ON a.idcuenta=aa.idpadre) as bb ;
					ON b.idcuenta=bb.idpadre) as cc ON c.idcuenta=cc.idpadre ) as dd ON d.idcuenta=dd.idpadre ) as ee ;
					ON e.idcuenta=ee.idpadre) as ff ON f.idcuenta=ff.idpadre) as gg ON g.idcuenta=gg.idpadre ;
	) as zz ;
	ORDER BY idcuenta1,idcuenta2 ;
	INTO CURSOR &lcmicurpadre READWRITE &lcfilctaa
	SELECT (lcmicurpadre)
	INDEX on idcuenta TAG idcuenta 
	SET ORDER TO idcuenta
	
	IF llcerrartabla=.t.
		USE IN miCtbCuentas
	ENDIF 
	
	IF !EMPTY(lcaliasmicuentas)
		SELECT (lcaliasmicuentas)
	ENDIF 
	
ENDFUNC 


