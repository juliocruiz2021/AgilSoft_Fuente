* Función DecodeUnicode
FUNCTION DecodeUnicode(unicodeStr)
    LOCAL i, decodedStr, charCode    
    decodedStr = unicodeStr    
    
    * Buscar todas las ocurrencias de \uXXXX    
    FOR i = 1 TO LEN(unicodeStr) - 5
    	IF SUBSTR(unicodeStr, i, 2) = "\u"
    		charCode = VAL("0x" + SUBSTR(unicodeStr, i + 2, 4))
    		decodedStr = STRTRAN(decodedStr, SUBSTR(unicodeStr, i, 6), CHR(charCode))
    	ENDIF
    ENDFOR
	RETURN decodedStr
ENDFUNC


    
