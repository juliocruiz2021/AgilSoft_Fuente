																									'AND status=1 AND eliminado=0)) as cc '+;
																								'ORDER BY precioconiva) as precioconiva2, '
			lcComandoBuscarCta="SELECT * FROM(SELECT t0.*,"+lcComandoPrecioMinimo+lcComandoPreciosiniva2+lcComandoPrecioconiva2+" "+;
										"t0.codprod as codprod4,t0.producto as descripcionUniMed,t0.unidadmedida as unimed,000000000 as idmedida,0000000001.0000000000 as factorunimed,"+;
										"t0.precioconiva as precioconivaunimed,t0.preciosiniva as preciosinivaunimed,t99.cod as codfami "+;
									"FROM invproductos t0 "+;
										"left join siscata t99 on t0.idfamilia=t99.id and t99.origen='LIN' "+;
									"where "+IIF(!EMPTY(lcTipoProdFil),lcTipoProdFil+" and ","")+" t0.status=1 and t0.eliminado<>1 and (t0.codprod='"+lcCodProBus+"' or t0.codoriginal='"+lcCodProBus+"') "+;
