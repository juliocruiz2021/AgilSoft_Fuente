FUNCTION ImprimirCuentasporCobrarPagar(lnIdDocto as Integer,lnCtrl as Integer ,lnIdConec as integer)
	**** se paso como parametro el numero de documento a imprimir
	**** lnCtrl 1=Imprimir Directo al Impresor ;
				2=Imprimir con Previsualizacion y ;
				3=Mostrar Formulario para Editar

	LOCAL lcAlias,lnidSQL
	lnidSQL=0
	lcAlias=ALIAS()
	lnidSQL=_conecta(pcDB)

	lcPrintActual=SET("PRINTER", 3)


	IF pnTipoConeccion=1
		USE pcsysdir+pcDB+"\siskardexdoc" IN 0 SHARED AGAIN ALIAS siskardexdocCCP ORDER iddocto
		USE pcsysdir+pcDB+"\cyvclipro" IN 0 SHARED AGAIN ALIAS cyvcliproCCP ORDER idclipro
		
		USE pcsysdir+pcDB+"\sisformatos" IN 0 SHARED AGAIN ORDER idformato ALIAS sisformatosCCP
		USE pcsysdir+pcDB+"\sisseries" IN 0 SHARED AGAIN ORDER idserie ALIAS sisseriesCCP
		USE pcsysdir+pcDB+"\siscata" IN 0 SHARED AGAIN ORDER id ALIAS siscataCCP
		USE pcsysdir+pcDB+"\sistipodoctos" IN 0 SHARED AGAIN ORDER idtipodocto ALIAS sistipodoctosCCP
		USE pcsysdir+pcDB+"\cyvcuentasxcp" IN 0 SHARED AGAIN ORDER iddocto	ALIAS cyvcuentasxcpCCP
		USE pcsysdir+pcDB+"\siskardexapli" IN 0 SHARED AGAIN ORDER idaplica ALIAS siskardexapliCCP
	ENDIF 


	IF lnidSQL>0
		lcComando0="SELECT CXCImp.*,ALLTRIM(b.CodCliPro) as CodCliPro,b.clipro,d.codser as codserie,d.serie as serie,"+;
					"c.codtipo,c.tipodocto,c.clave,iif(c.ctrolCXC=0,c.ctrolcxp,c.ctrolcxc) as sumaresta,"+;
					"f.carabo,f.monto,f.iddoctoaplicar,h.codtipo as codtipo2,h.tipodocto as tipodocto2,h.clave as clave2,"+;
					"i.codser as codserie2,i.serie as serie2,g.numero as numero2,"+;
					"g.fechadocto as fechadocto2,g.fechavenci as fecvenci2,g.totaldocto as totaldocto2,"+;
					"g.totaldocto-g.cargoabono as saldodocto2,b.saldo as saldoclipro,"+;
					"pcnomempresa as nomempresa,pcgiro as giroempresa,pcnit as nitempresa,pcnrc as nrcempresa,c.tipoicv "+;
					"FROM cyvcuentasxcpCCP CXCImp INNER JOIN cyvcliproCCP b ON CXCImp.IdCliPro=b.IdCliPro "+;
								   "INNER JOIN sistipodoctosCCP c ON CXCImp.IdTipoDocto=c.IdTipoDocto "+;
								   "LEFT JOIN sisseriesCCP d ON CXCImp.idserie=d.idserie "+;
								   "LEFT JOIN siskardexapliCCP f ON CXCImp.iddocto=f.iddocto "+;
								   "LEFT JOIN siskardexdocCCP g ON f.iddoctoaplicar=g.iddocto "+;
								   "left JOIN sistipodoctosCCP h ON g.IdTipoDocto=h.IdTipoDocto "+;
								   "LEFT JOIN sisseriesCCP i ON CXCImp.idserie=i.idserie "+;						   
					" where CXCImp.iddocto="+ALLTRIM(STR(lnIdDocto))+" "

		lnCtrlSql=miSQLEXEC(lnidSQL,lcComando0,'c_imp')
		
		lnTipoICVPrn=c_imp.tipoicv
		
		IF lnCtrlSql>0
			if !EOF()
				SELECT c_imp
				IF NVL(idclipro,0)=0
					REPLACE monto WITH totaldocto NEXT 1
				ENDIF 
				lnidtd=idtipodocto
				lnidse=idserie
				lnidsu=idsucursal
				*lnCondipago=condipago
				lcComando0="SELECT TOP 1 * FROM (SELECT 0 as llave,*,SPACE(250) as print2,codfor FROM sisformatosCCP WHERE idtipodocto="+ALLTRIM(STR(lnidtd))+" AND idserie="+ALLTRIM(STR(lnidse))+" AND idsucursal="+ALLTRIM(STR(lnidsu))+" "+;
								"UNION ALL "+;
								"SELECT 1 as llave,*,SPACE(250) as print2,codfor FROM sisformatosCCP WHERE idtipodocto="+ALLTRIM(STR(lnidtd))+" AND idserie="+ALLTRIM(STR(lnidse))+" AND idsucursal=="+ALLTRIM(STR(lnidsu))+" "+;
								"UNION ALL "+;
								"SELECT 2 as llave,*,SPACE(250) as print2,codfor FROM sisformatosCCP WHERE idtipodocto="+ALLTRIM(STR(lnidtd))+" AND idserie="+ALLTRIM(STR(lnidse))+") as t0 "+;
							"ORDER BY t0.llave,t0.idtipodocto" 
				lnCtrlSql2=miSQLEXEC(lnidSQL,lcComando0,'c_formatosTmp')
		
				lnImpresor2Prn=c_formatosTmp.impresor2
		
				IF lnCtrlSql2>0
					lntipprint=1
					IF impresor2<>0
						lntipprint=impresor2
						lcimpresortmp=ObtieneImpresores(lnidSQL,lntipprint)
						REPLACE print2 WITH lcimpresortmp NEXT 1
					ENDIF
					GO top
					lcArchivo=ALLTRIM(archivo)
					lcPrinter=ALLTRIM(impresor1)
					lcPrinter2=ALLTRIM(print2)
					lnTipoImpresion=tipoimpresion
					lnTipoDetalle=tipodetalle
					lnCopiasPrint=IIF(copias=0,1,copias)
					
					lcmensajeimpresor='Impresor :'+SET("Printer",3)
					SELECT c_imp					
					IF !EMPTY(lcArchivo) and FILE(pcSysDir+pcdb+"\formatos\"+lcArchivo)

						STORE SET("Printer",3) TO lcPrinOld
						IF !EMPTY(lcPrinter)
							APRINTERS(lcImipresores)
							llimpresorExiste=.f.
							FOR i=1 TO ALEN(lcImipresores)/2
								IF ALLTRIM(UPPER(lcImipresores(i,1)))=ALLTRIM(UPPER(lcPrinter))
									llimpresorExiste=.t.
										EXIT 
								ENDIF 
							ENDFOR 
							
							*************************
							IF pnUsaRedirec=1		&&&& usandoa impresor redireccionado
								lcPrinter=ImpresorRedireccionado(lnTipoICVPrn,lnImpresor2Prn)
							ENDIF
							
							IF llimpresorExiste=.t.
								SET PRINTER TO NAME (lcPrinter)
								lcmensajeimpresor='Impresor: '+ALLTRIM(lcPrinter)+'  Tipo: '+ALLTRIM(STR(lntipprint))
							ENDIF 
						ELSE
							IF !EMPTY(lcPrinter2)
								APRINTERS(lcImipresores)
								llimpresorExiste=.f.
								FOR i=1 TO LEN(lcImipresores)-1
									IF ALLTRIM(UPPER(lcImipresores(i,1)))=ALLTRIM(UPPER(lcPrinter2))
										llimpresorExiste=.t.
										EXIT 
									ENDIF 
								ENDFOR 
								
								IF llimpresorExiste=.t.
									SET PRINTER TO NAME (lcPrinter2)
									lcmensajeimpresor='Impresor: '+ALLTRIM(lcPrinter2)+'  Tipo: '+ALLTRIM(STR(lntipprint))
								ENDIF 
							ENDIF 
						ENDIF 
						
*!*							IF TYPE('_screen.ActiveForm')='O'
*!*								_screen.ActiveForm.cntDiga.diga(lcmensajeimpresor,3,3)
*!*							ENDIF 
						
						llseimprimio=0
						SELECT c_imp
						
						IF lnCtrl=2	OR	lnCtrl=1	

							lcPrintActual=SET("PRINTER", 3)
							lcPrintActual2=SET("PRINTER", 3)
							_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)


							IF lnCtrl=2
								MODIFY REPORT pcSysDir+pcdb+"\formatos\"+lcArchivo
							ELSE 
								lcPrintActual=SET("PRINTER", 3)
								lcPrintActual2=SET("PRINTER", 3)
								WAIT WINDOW 'Imprimiendo Documento... ' NOWAIT 
								_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)
											
								REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER NOCONSOLE NAME lcPrintActual
								lcPrintActual=lcPrintActual2
								llseimprimio=1
							ENDIF 	
						ELSE 
							DO case
								CASE lnTipoImpresion=1
										lnsn=MESSAGEBOX("Desea ver el Documento ?",4+32+256,"Imprimir...")
										IF lnsn=6
											WAIT WINDOW 'Imprimiendo Documento... ' NOWAIT 
											lcPrintActual=SET("PRINTER", 3)
											_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)
											REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER PROMPT PREVIEW NOCONSOLE 
											llseimprimio=1
										ENDIF 
								CASE lnTipoImpresion=2
										lnsn=MESSAGEBOX("Desea Imprimir el Documento ?",4+32+256,"Imprimir...")
										IF lnsn=6
											WAIT WINDOW 'Imprimiendo Documento... ' NOWAIT 
											lcPrintActual=SET("PRINTER", 3)
											lcPrintActual2=SET("PRINTER", 3)
											_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)
											FOR iprin=1 TO lnCopiasPrint
												*lcPrintActual=lcPrintActual2
												REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER NOCONSOLE NAME lcPrintActual
												lcPrintActual2=lcPrintActual
											ENDFOR 
											llseimprimio=1
										ENDIF 
								CASE lnTipoImpresion=3
										lcPrintActual=SET("PRINTER", 3)
										_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)
										REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER PREVIEW NOCONSOLE 
										llseimprimio=1
								CASE lnTipoImpresion=4
										lcPrintActual=SET("PRINTER", 3)
										lcPrintActual2=SET("PRINTER", 3)
										_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)
										FOR iprin=1 TO lnCopiasPrint
											*lcPrintActual=lcPrintActual2
											REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER NOCONSOLE NAME lcPrintActual
											lcPrintActual2=lcPrintActual
										ENDFOR 
										llseimprimio=1
							ENDCASE
						ENDIF 
						GO TOP IN c_imp
						
						IF !EMPTY(lcPrinOld)
							SET PRINTER TO NAME (lcPrinOld)
						ENDIF 
						GO TOP IN c_imp
						IF c_imp.impreso=0 AND llseimprimio=1		&&& cambiando status de Impreso
							=miSQLEXEC(lnidSQL,"update cyvcuentasxcpCCP set impreso=1 where impreso=0 and iddocto="+ALLTRIM(STR(lnIdDocto))+" ")
						ENDIF
						USE IN c_formatostmp
					ELSE 
					 MESSAGEBOX('No se encontro el Archivo del Formato de impresion....  '+lcArchivo,16,'Error al Imprimir...')
					ENDIF 
				ELSE
					MESSAGEBOX('No se Encontro el Formato de Impresion para este Documento....',16,'Error al Imprimir...')
				ENDIF 
			ELSE
				MESSAGEBOX('No se Encontro el Documento....',16,'Error al Imprimir...')
			ENDIF 
		ELSE
			_MostrarErroresSQL(lnidSQL)
		ENDIF 
		USE in c_imp
		=miSQLDISCONNECT(lnidSQL)
	ELSE
		MESSAGEBOX("Imposible conectarse con el Servidor... Intente más tarde...",16,'Error de Conección...')
	ENDIF 
	
	USE IN siskardexdocCCP
	USE IN cyvcliproCCP
	USE IN sisformatosCCP
	USE IN sisseriesCCP
	USE IN siscataCCP
	USE IN sistipodoctosCCP
	USE IN cyvcuentasxcpCCP
	USE IN siskardexapliCCP

	
	IF !EMPTY(lcAlias)
		SELECT (lcAlias)
	ENDIF 
ENDFUNC 



