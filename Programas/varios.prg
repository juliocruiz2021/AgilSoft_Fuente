	ENDIF 
	
	***********************************
	******* sisTipodoctos (t_tipos_documentos) tipos de documentos tipo1=venta,2=compras,3=venta y compra
	IF lcmoduloacargar=8
		lnConid=_conectaSAP()
		IF lnConid>0
			WAIT WINDOW "Sincronizando TIPOS DE DOCUMENTO DE VENTAS Y COMPRAS ..." NOWAIT 
			lnCtrlSap=SQLEXEC(lnConid,'SELECT * from NNM1 where Objectcode in (13,14)','t_TIP')
			
			USE pcsysdir+pcDB+"\sistipodoctos" IN 0 SHARED AGAIN 

			SELECT series as id,ALLTRIM(Seriesname)+'_V' as tdc_codigo,NVL(Remark,' ') as tdc_descripcion,'' as tdc_tipo,1 as cyv,' ' as tipo,'VTA' AS ORIGEN,0 as ctrl FROM t_TIP ;
					WHERE series NOT in ;
						(SELECT idtipodocto  FROM sistipodoctos ) ;
			UNION ALL ;
				SELECT series as id,ALLTRIM(Seriesname)+'_V' as tdc_codigo,Remark as tdc_descripcion,'' as tdc_tipo,1 as cyv,' ' as tipo,'VTA' AS ORIGEN,1 as ctrl FROM t_TIP ;
					WHERE series in ;
						(SELECT idtipodocto  FROM sistipodoctos );
			INTO CURSOR c_TIP READWRITE 
			REPLACE tdc_descripcion WITH 'no definido' FOR EMPTY(tdc_descripcion) OR ISNULL(tdc_descripcion)
			
			*REPLACE id WITH _SiguienteIdTabla(pcNodo,"MAS") FOR id=0  
			
			UPDATE sistipodoctos SET sistipodoctos.tipodocto=c_TIP.tdc_descripcion ,;
								sistipodoctos.origen=c_TIP.ORIGEN, ;
								sistipodoctos.fecmod=ldfec, ;
								sistipodoctos.nodo=pcnodo, ;
								sistipodoctos.iduser=pnIdUsuario, ;
								sistipodoctos.pcuser=SYS(0), ;
								sistipodoctos.codtipo=c_TIP.tdc_codigo;
				from c_TIP WHERE sistipodoctos.idtipodocto=c_TIP.id AND ctrl=1
			
			INSERT INTO sistipodoctos (idtipodocto,codtipo,tipodocto,clave,tipoicv,;
						origen,eliminado,status,fecalta,fecmod,nodo,iduser,pcuser) ;
				SELECT id,tdc_codigo,tdc_descripcion,'',0,ORIGEN,0,1,ldfec,ldfec,;
					pcnodo,pnIdUsuario,SYS(0) ;
				FROM c_TIP WHERE ctrl=0 
			
			USE IN c_TIP
			USE IN sistipodoctos
			USE IN t_TIP
			SQLDISCONNECT(lnCtrlSap)
		ELSE
			WAIT WINDOW 'Imposible conectarse a la base de datos de SAP'	
		ENDIF 	
	ENDIF 
	
ENDFUNC 


FUNCTION _SincronizaCatalogosSAP(lnmimodcargar)
	IF TYPE("ldfec")="U"
		ldfec=DATE()
	ENDIF 
	***********************************
	******* Productos
	IF lnmimodcargar=1
		lnConid=_conectaSAP()
		IF lnConid>0
			WAIT WINDOW "Sincronizando Productos " NOWAIT 
*			DO case
*				CASE pcnodo='11'
*					lnlistaprecioSAP="1"
*!*					CASE pcnodo='12'
*!*						lnlistaprecioSAP="5"
*!*					CASE pcnodo='13'
*!*						lnlistaprecioSAP="4"
*!*					CASE pcnodo='14'
*!*						lnlistaprecioSAP="1"
*!*					CASE pcnodo='15'
*!*						lnlistaprecioSAP="3"
*!*						
*				OTHERWISE 
					lnlistaprecioSAP="1"
*			ENDCASE 

			lnCtrlSap=SQLEXEC(lnConid,"SELECT t0.ItemCode,t0.ItemName,t0.CodeBars,t1.Price as price,t0.AvgPrice,t0.ItmsGrpCod "+;
											"from OITM t0 left join ITM1 t1 on t0.ItemCode=t1.ItemCode and Pricelist="+lnlistaprecioSAP+" order by t0.ItemCode ",'t_PRO')
			REPLACE price WITH NVL(price,0) ALL IN t_pro 
			
			lnCtrlSap=SQLEXEC(lnConid,"SELECT ItemCode,SUM(Onhand) as existencia FROM OITW GROUP BY ItemCode order by ItemCode ",'t_exi')
			lnCtrlSap=SQLEXEC(lnConid,"SELECT ItemCode as CodProd,WhsCode as codBodega,Onhand as existencia FROM OITW ",'t_exi2')
			
			lnCtrlSap=SQLEXEC(lnConid,"SELECT U_iddocto as iddocto,createDate as fecactu,DocTotal,U_Cod_Sucursal "+;
												"FROM OINV where DocDate between '"+_ConvertirToFechaSQL(DATE()-300)+"' and '"+_ConvertirToFechaSQL(DATE())+;
																"' and ISNULL(U_iddocto,0)>0 ",'t_Doctos')

			lnCtrlSap=SQLEXEC(lnConid,'select * from OPLN WHERE listnum in (2,6)  ','t_listas')
			lnCtrlSap= SQLEXEC(lnConid,'select 000000000 as idprecio,000000000 as idproducto,* from ITM1 '+;
									'where pricelist in (2,6) ','t_precios')


			**** actualizando que registro ya esta importado en sap						
			USE pcsysdir+pcDB+"\cyvVentas" IN 0 SHARED AGAIN 
			USE pcsysdir+pcDB+"\siskardex" IN 0 SHARED AGAIN 
			USE pcsysdir+pcDB+"\cyvVentasdeta" IN 0 SHARED AGAIN
			
			WAIT WINDOW "Sincronizando Ventas no ya importadas " NOWAIT 
			UPDATE cyvVentas SET cyvVentas.fecactu = t_Doctos.fecactu ;
				FROM cyvVentas INNER JOIN t_Doctos ON cyvventas.iddocto=t_Doctos.iddocto AND EMPTY(NVL(cyvventas.fecactu,CTOD(' '))) 
			
			WAIT WINDOW "Sincronizando Ventas ya importadas .." NOWAIT 
			UPDATE siskardex SET siskardex.fecactu = t_Doctos.fecactu ;
				FROM siskardex INNER JOIN t_Doctos ON siskardex.iddocto=t_Doctos.iddocto AND EMPTY(NVL(siskardex.fecactu,CTOD(' '))) 
				    
			USE pcsysdir+pcDB+"\invProductos" IN 0 SHARED AGAIN 
			USE pcsysdir+pcDB+"\siscata" IN 0 SHARED AGAIN 
			USE pcsysdir+pcDB+"\invexisbodega" IN 0 SHARED AGAIN
			USE pcsysdir+pcDB+"\invProdlistaspre" IN 0 SHARED AGAIN  
			USE pcsysdir+pcDB+"\invProdprecios" IN 0 SHARED AGAIN
			
			SELECT 000000000 as id,t_PRO.ItemCode as PRO_codigo,t_PRO.ItemName as pro_nombre,;
					t_PRO.ItemName as descripcion,1 as tipoprod,NVL(t_PRO.Codebars,SPACE(50)) as pro_barra,;
					181 as iddivision,191 as idsistema,NVL(c_lin.id,0000000000) as idfamilia,201 as idrubro,0 as idagrupador,;
					'Unidad' as unidadmedida,221 as idmarca,1 as gravado,0 as concesc,0 as conretencion,;
					1 as idimpuestoiva,0 as idimpuestorenta,0 as idimpuestofovial,0 as idimpuestocotrans,0 idimpuestocesc,;
					0 pordescuento,50 as factorganancia,0 as esprodcontrolado,0 as esprodregulado,0 as escombustible,;
					0 as esfabricado,0 as fabautomatica,0 as connegativos,0 as conarea,0 as conserielote,;
					0 as enliquidacion,0 as costoinicial,0 as costototal,1 as juegocompra,;
					0 as pedidosrecibir,0 as pedidossurtir,NVL(t_PRO.price*1.13,000000000.000000) as precioconiva, NVL(t_PRO.Price,000000000.000000) as preciosiniva,;
					1 as juegoventa,1 as factorpresenta,0 as idctainggasto,NVL(t_EXI.existencia,000000000.000000) as existencia,NVL(t_PRO.AvgPrice,000000000.00) as costopromedio ;
					FROM t_PRO ;
							LEFT JOIN siscata as c_lin ON ALLTRIM(STR(t_pro.ItmsGrpCod))=c_lin.cod AND c_lin.origen='LIN' ;
							LEFT JOIN t_EXI ON t_pro.ItemCode=t_EXI.Itemcode ;
					WHERE !EMPTY(NVL(t_PRO.ItemName,'')) AND t_PRO.ItemCode NOT in ;
						(SELECT codprod FROM invProductos) ;
			UNION ALL ;
				SELECT 000000001 as id,t_PRO.ItemCode as PRO_codigo,t_PRO.ItemName as pro_nombre,;
					t_PRO.ItemName as descripcion,1 as tipoprod,NVL(t_PRO.Codebars,SPACE(50)) as pro_barra,;
					181 as iddivision,191 as idsistema,NVL(c_lin.id,0000000000) as idfamilia,201 as idrubro,0 as idagrupador,;
					'Unidad' as unidadmedida,221 as idmarca,1 as gravado,0 as concesc,0 as conretencion,;
					1 as idimpuestoiva,0 as idimpuestorenta,0 as idimpuestofovial,0 as idimpuestocotrans,0 idimpuestocesc,;
					0 pordescuento,50 as factorganancia,0 as esprodcontrolado,0 as esprodregulado,0 as escombustible,;
					0 as esfabricado,0 as fabautomatica,0 as connegativos,0 as conarea,0 as conserielote,;
					0 as enliquidacion,0 as costoinicial,0 as costototal,1 as juegocompra,;
					0 as pedidosrecibir,0 as pedidossurtir,NVL(t_PRO.price*1.13,000000000.000000) as precioconiva, NVL(t_PRO.Price,000000000.000000) as preciosiniva,;
					1 as juegoventa,1 as factorpresenta,0 as idctainggasto,NVL(t_EXI.existencia,000000000.000000) as existencia,NVL(t_PRO.AvgPrice,000000000.00) as costopromedio ;
					FROM t_PRO ;
							LEFT JOIN siscata as c_lin ON ALLTRIM(STR(t_pro.ItmsGrpCod))=c_lin.cod AND c_lin.origen='LIN' ;
							LEFT JOIN t_EXI ON t_pro.ItemCode=t_EXI.Itemcode ;
					WHERE !EMPTY(NVL(t_PRO.ItemName,'')) AND t_PRO.ItemCode in ;
						(SELECT codprod FROM invProductos) ;
			INTO CURSOR c_PRO READWRITE 
			WAIT WINDOW "Sincronizando Ventas no ya importadas ...." NOWAIT 
			REPLACE id WITH _SiguienteIdTabla(pcNodo,"MAS") FOR id=0  
			REPLACE idfamilia WITH 211 FOR idfamilia=0
			
			WAIT WINDOW "Actualizando Catalogo de Productos " NOWAIT 
			UPDATE invproductos SET invproductos.producto=c_PRO.PRO_nombre ,;
								invproductos.descripcion=c_pro.descripcion ,;
								invproductos.codoriginal=c_pro.pro_barra,;
								invproductos.idrubro=c_pro.idrubro,;
								invproductos.idfamilia=c_pro.idfamilia,;
								invproductos.precioconiva=c_pro.precioconiva,;
								invproductos.preciosiniva=c_pro.preciosiniva,;
								invproductos.existencia=c_pro.existencia,;
								invproductos.fecmod=ldfec,;
								invproductos.nodo=pcnodo,;
								invproductos.iduser=pnIdUsuario, ;
								invproductos.pcuser=SYS(0) ;
				from c_PRO WHERE invproductos.codprod=c_PRO.PRO_codigo 
			
			WAIT WINDOW "Insertando nuevos Productos " NOWAIT 
			INSERT INTO invproductos (idproducto,codprod,producto,descripcion,tipoprod,codoriginal,;
					iddivision,idsistema,idfamilia,idrubro,idagrupador,;
					unidadmedida,idmarca,gravado,concesc,conretencion,;
					idimpuestoiva,idimpuestorenta,idimpuestofovial,idimpuestocotrans,idimpuestocesc,;
					pordescuento,factorganancia,esprodcontrolado,esprodregulado,escombustible,;
					esfabricado,fabautomatica,connegativos,conarea,conserielote,;
					enliquidacion,costoinicial,costopromedio,costototal,juegocompra,;
					existencia,pedidosrecibir,pedidossurtir,precioconiva,preciosiniva,;
					juegoventa,factorpresenta,idctainggasto,eliminado,status,fecalta,fecmod,nodo,iduser,pcuser) ;
				SELECT id,PRO_codigo,pro_nombre,descripcion,tipoprod,pro_barra,;
					iddivision,idsistema,idfamilia,idrubro,idagrupador,;
					unidadmedida,idmarca,gravado,concesc,conretencion,;
					idimpuestoiva,idimpuestorenta,idimpuestofovial,idimpuestocotrans,idimpuestocesc,;
					pordescuento,factorganancia,esprodcontrolado,esprodregulado,escombustible,;
					esfabricado,fabautomatica,connegativos,conarea,conserielote,;
					enliquidacion,costoinicial,costopromedio,costototal,juegocompra,;
					existencia,pedidosrecibir,pedidossurtir,precioconiva,preciosiniva,;
					juegoventa,factorpresenta,idctainggasto,0,1,ldfec,ldfec,;
					pcnodo,pnIdUsuario,SYS(0) ;
				FROM c_PRO WHERE id<>1 
			
			WAIT WINDOW "Sincronizando Existencias " NOWAIT 
			******* existencias por  bodega
			SELECT 000000000 as id,t0.codprod,t0.codbodega,t0.existencia,t1.idproducto,t2.id as idbodega,;
							t1.costopromedio,NVL(t1.costopromedio*t0.existencia,0000000000.000000) as costototal ;
				FROM t_EXI2	t0 INNER JOIN invProductos t1 ON t0.codprod=t1.codprod ;
								INNER JOIN siscata t2 ON t0.codbodega=t2.cod AND origen='BOD' ;
					WHERE STR(idproducto)+STR(id) NOT in ;
						(SELECT STR(idproducto)+STR(idbodega) FROM invexisbodega  ) ;
			UNION ALL ;
				SELECT 000000001 as id,t0.codprod,t0.codbodega,t0.existencia,t1.idproducto,t2.id as idbodega,;
							t1.costopromedio,NVL(t1.costopromedio*t0.existencia,0000000000.000000) as costototal ;
				FROM t_EXI2	t0 INNER JOIN invProductos t1 ON t0.codprod=t1.codprod ;
								INNER JOIN siscata t2 ON t0.codbodega=t2.cod AND origen='BOD' ;
					WHERE STR(idproducto)+STR(id) in ;
						(SELECT STR(idproducto)+STR(idbodega) FROM invexisbodega )   ;
			INTO CURSOR c_EXI READWRITE 
			REPLACE id WITH _SiguienteIdTabla(pcNodo,"MAS") FOR id=0  
			
			WAIT WINDOW "Sincronizando Existencias ." NOWAIT 
			UPDATE invexisbodega SET invexisbodega.existencia=c_EXI.existencia ,;
								invexisbodega.costo=c_EXI.costopromedio,;
								invexisbodega.costototal=c_EXI.costototal ,;
								invexisbodega.fecmod=ldfec, ;
								invexisbodega.nodo=pcnodo, ;
								invexisbodega.iduser=pnIdUsuario, ;
								invexisbodega.pcuser=SYS(0) ;
				from c_EXI WHERE invexisbodega.idbodega=c_EXI.idbodega AND invexisbodega.idproducto=c_EXI.idproducto
			
			WAIT WINDOW "Sincronizando Existencias .." NOWAIT 
			INSERT INTO invexisbodega (idexisbode,idproducto,idbodega,ubicacion,existencia,costo,costototal,fecalta,fecmod,nodo,iduser,pcuser) ;
				SELECT id,idproducto,idbodega,'',existencia,costopromedio,costototal,ldfec,ldfec,;
					pcnodo,pnIdUsuario,SYS(0) ;
				FROM c_EXI WHERE id<>1 

			***** restando venta no importada en sap
			WAIT WINDOW "Sincronizando Ventas no Importadas " NOWAIT 
			SELECT idproducto,idbodega,SUM(cantidad) as cantidad ;
						FROM (SELECT a.idproducto,IIF(a.entsal=1,-a.cantidad,a.cantidad) as cantidad,a.idbodega ;
									FROM cyvventasdeta a INNER JOIN cyvventas b ON a.iddocto=b.iddocto AND ;
											a.status=1 AND a.eliminado=0  AND b.anulado=0 AND b.eliminado=0 AND b.status=1 ;
									WHERE EMPTY(b.fecactu) AND b.origen='VTA' AND BETWEEN(a.entsal,1,2)) as cc ;
				ORDER BY cc.idproducto,cc.idbodega GROUP BY cc.idproducto,cc.idbodega INTO CURSOR c_restando 
			UPDATE invexisbodega ;
					SET invexisbodega.existencia=NVL(invexisbodega.existencia,0)-NVL(c_restando.cantidad,0), ;
						invexisbodega.costototal=NVL(invexisbodega.costototal,0)-(NVL(c_restando.cantidad,0)*NVL(invexisbodega.costo,0)) ;
				from c_restando WHERE invexisbodega.idbodega=c_restando.idbodega AND invexisbodega.idproducto=c_restando.idproducto
			
			WAIT WINDOW "Sincronizando Listas de Precio" NOWAIT 
			*** insertando nuevas listas de precio
			INSERT INTO invprodlistaspre (idlistapre,codlis,listaprecio,idsucursal,porcentaje,;
											tipolista,automatica,eliminado,status,fecalta,fecmod,nodo,iduser,pcuser) ;
							SELECT listnum,SUBSTR(listname,1,2)+ALLTRIM(STR(listnum)),listname,0,0,2,0,0,1,;
									DATETIME(),DATETIME(),pcnodo,pnidusuario,SYS(0) ;
					FROM t_listas WHERE listnum NOT in (select idlistapre FROM invprodlistaspre)
			UPDATE invprodlistaspre SET codlis=SUBSTR(a.listname,1,2)+ALLTRIM(STR(a.listnum)),listaprecio = listname from t_listas a WHERE a.listnum=idlistapre
			USE IN t_listas
				
			
			UPDATE t_precios SET idproducto =a.idproducto from invProductos a WHERE t_precios.itemcode=a.codprod
			DELETE ALL FOR idproducto=0 IN t_precios
			****** actualizando detalle de precios
			UPDATE t_precios SET idprecio=a.idprecio from invprodprecios a WHERE t_precios.idproducto=a.idproducto AND t_precios.pricelist=a.idlistapre
			UPDATE t_precios SET idprecio =_SiguienteIdTabla(pcNodo,"DET") WHERE idprecio=0
			*** actualizando precios antiguos
			UPDATE invprodprecios SET precioconiva =a.price*1.13,preciosiniva=a.price,fecmod=DATETIME() ;
					from t_precios a WHERE invprodprecios.idprecio=a.idprecio AND invprodprecios.preciosiniva<>a.price
			**** agregando nuevos precios
			INSERT INTO invprodprecios (idprecio,idlistapre,idproducto,idunimed,precioconiva,preciosiniva,fecalta,fecmod,nodo,iduser,pcuser) ;
					SELECT idprecio,pricelist,idproducto,0,price*1.13,price,DATETIME(),DATETIME(),pcnodo,pnidusuario,SYS(0) ;
							FROM t_precios WHERE idprecio NOT in (select idprecio FROM invprodprecios)
			USE IN t_precios
			
			
			******* actualizando productos web
*!*				IF .t.
*!*					enviarDatosProducto()
*!*					enviarDatosProductoPrecios()
*!*					enviarDatosProductoExistencia()
*!*				ENDIF 			
			
			USE IN invprodprecios
			USE IN invProdlistaspre	
			USE IN c_PRO
			USE IN siscata
			USE IN invProductos
			USE IN t_PRO	
			USE IN t_EXI
			USE IN t_EXI2
			USE IN c_EXI
			USE IN cyvVentas
			USE IN cyvVentasdeta
			USE IN t_Doctos
			USE IN siskardex
			SQLDISCONNECT(lnCtrlSap)
		ELSE
			WAIT WINDOW 'Imposible conectarse a la base de datos de SAP'	
		ENDIF 	
	ENDIF 
	
	
	***********************************
	******* CLIENTES
	IF lnmimodcargar=2
		lnConid=_conectaSAP()
		IF lnConid>0
			WAIT WINDOW "Sincronizando Clientes " NOWAIT 
			lcomando1="SELECT t0.CardCode,t0.CardName,t0.SlpCode,t0.City,t0.Country,t0.CardFName,"+;
						"t0.U_DUI,t0.U_NIT,t0.U_NRC,t0.U_GIRO,t0.U_TipoCont,t1.AdresType,t1.Address2,t1.Address3,t0.frozenFor,t0.CardType,t2.extradays as diascredito,0 as condipago FROM OCRD t0 "
			lcomando2="left join (select c.* from (select rank() OVER (ORDER BY a.CardCode,a.AdresType,a.LineNum) as reg,a.* "+;
									"from  CRD1 a where a.AdresType='B') as c where c.reg in (select min(b.reg) as reg "
			lcomando3="from (select  rank() OVER (ORDER BY a.CardCode,a.AdresType,a.LineNum) as reg,a.* "+;
							"from  CRD1 a where a.AdresType='B') as b group by b.CardCode)) as t1 on t0.CardCode=t1.CardCode "+;
							"left join OCTG t2 on t0.GroupNum=t2.Groupnum "

			lnCtrlSap=SQLEXEC(lnConid,lcomando1+lcomando2+lcomando3,'t_CLI')
			
			IF lnCtrlSap>0
				REPLACE diascredito WITH NVL(diascredito,0),condipago WITH IIF(NVL(diascredito,0)>0,1,0) ALL IN t_CLI
			ENDIF 
		
			USE pcsysdir+pcDB+"\cyvCliPro" IN 0 SHARED AGAIN 

			SELECT 000000000 as id,CardCode as cli_codigo,IIF(EMPTY(NVL(CardName,SPACE(150))),NVL(CardFName,''),CardName) as cli_nombre,IIF(EMPTY(NVL(CardFName,'')),NVL(CardName,SPACE(150)),CardFName) as cli_razon,;
					IIF(SUBSTR(CardCode,1,1)='P' OR CardType='S',2,1) as tipoclipro,151 as idsucursal,261 as idgrupo,ALLTRIM(NVL(Address2,SPACE(50)))+RTRIM(NVL(Address3,SPACE(50)))  as cli_direccion, ;
					1102 as iddepto, 10510 as idmuni,'' as cli_email,'' as cli_telefono,'' as celular,NVL(U_giro,SPACE(50)) as cli_giro,;
					NVL(u_nit,SPACE(50)) as cli_nit,NVL(u_nrc,SPACE(50)) as cli_registro,NVL(u_dui,SPACE(50)) as cli_dui, ;
					0 mesespedidos,0 mesestransito,IIF(VAL(u_tipoCont)=1,2,1) tipocontri,1 tipoiva,10 porrenta,condipago,diascredito, ;
					0 limitecredito,0 sobregiro,0 saldo,0 pordescuento,0 idlista,0 variosnombres,0 extranjero,0 idagente,0 as facturacondicion, ;
					0 sincomision, 0 exportaexento,0 ventaminima,0 ventamaxima,frozenFor ;
				FROM t_CLI ;
				WHERE CardCode NOT in ;
						(SELECT codclipro FROM cyvclipro) ;
			UNION ALL ;
				SELECT 000000001 as id,CardCode as cli_codigo,IIF(EMPTY(NVL(CardName,SPACE(150))),NVL(CardFName,''),CardName) as cli_nombre,;
					IIF(EMPTY(NVL(CardFName,'')),NVL(CardName,SPACE(150)),CardFName) as cli_razon,;
					IIF(SUBSTR(CardCode,1,1)='P' OR CardType='S',2,1) as tipoclipro,151 as idsucursal,261 as idgrupo,ALLTRIM(NVL(Address2,SPACE(50)))+RTRIM(NVL(Address3,SPACE(50)))  as cli_direccion, ;
					1102 as iddepto, 10510 as idmuni,'' as cli_email,'' as cli_telefono,'' as celular,NVL(U_giro,SPACE(50)) as cli_giro,;
					NVL(u_nit,SPACE(50)) as cli_nit,NVL(u_nrc,SPACE(50)) as cli_registro,NVL(u_dui,SPACE(50)) as cli_dui, ;
					0 mesespedidos,0 mesestransito,IIF(VAL(u_tipoCont)=1,2,1) tipocontri,1 tipoiva,10 porrenta,condipago,diascredito, ;
					0 limitecredito,0 sobregiro,0 saldo,0 pordescuento,0 idlista,0 variosnombres,0 extranjero,0 idagente,0 as facturacondicion, ;
					0 sincomision, 0 exportaexento,0 ventaminima,0 ventamaxima,frozenFor ;
				FROM t_CLI ;
				WHERE CardCode in ;
						(SELECT codclipro FROM cyvclipro) ;
			INTO CURSOR c_CLI READWRITE 
			DELETE ALL FOR EMPTY(cli_codigo) OR EMPTY(cli_nombre+cli_razon)
			REPLACE id WITH _SiguienteIdTabla(pcNodo,"MAS") FOR id=0  

			UPDATE cyvclipro SET cyvclipro.clipro=c_CLI.cli_nombre ,;
								cyvclipro.nombre=c_CLI.cli_razon,;
								cyvclipro.tipoclipro=c_CLI.tipoclipro,;
								cyvclipro.giro=c_CLI.cli_giro,;
								cyvclipro.nit=c_CLI.cli_nit,;
								cyvclipro.nrc=c_CLI.cli_registro,;
								cyvclipro.dui=c_CLI.cli_dui,;
								cyvclipro.correo=c_CLI.cli_email,;
								cyvclipro.telefono=c_CLI.cli_telefono,;
								cyvclipro.celular=c_CLI.celular,;
								cyvclipro.direccion=c_CLI.cli_direccion,;
								cyvclipro.fecmod=ldfec, ;
								cyvclipro.nodo=pcnodo, ;
								cyvclipro.condipago=c_CLI.condipago, ;
								cyvclipro.diascredito=c_CLI.diascredito, ;
								cyvclipro.iduser=pnIdUsuario, ;
								cyvclipro.status=IIF(c_CLI.frozenFor='Y',0,1), ;
								cyvclipro.pcuser=SYS(0) ;
				from c_cli WHERE cyvclipro.codclipro=c_CLI.cli_codigo
			
			INSERT INTO cyvclipro (idclipro,codclipro,clipro,nombre,tipoclipro,idsucursal,idgrupo,direccion, ;
					iddepto,idmuni,correo,telefono,celular,giro,nit,nrc,dui, ;
					mesespedidos,mesestransito,tipocontri,tipoiva,porrenta,condipago,diascredito, ;
					limitecredito,sobregiro,saldo,pordescuento,idlista,variosnombres,extranjero,idagente,facturacondicion, ;
					sincomision,exportaexento,ventaminima,ventamaxima,eliminado,status,fecalta,fecmod,nodo,iduser,pcuser) ;
				SELECT id,cli_codigo,cli_nombre,cli_razon,tipoclipro,idsucursal,idgrupo,cli_direccion, ;
					iddepto,idmuni,cli_email,cli_telefono,celular,cli_giro,cli_nit,cli_registro,cli_dui, ;
					mesespedidos,mesestransito,tipocontri,1 tipoiva,porrenta,condipago,diascredito, ;
					limitecredito,sobregiro,saldo,pordescuento,idlista,variosnombres,extranjero,idagente,facturacondicion, ;
					sincomision,exportaexento,ventaminima,ventamaxima,0,IIF(c_CLI.frozenFor='Y',0,1),ldfec,ldfec,;
					pcnodo,pnIdUsuario,SYS(0) ;
				FROM c_cli WHERE id<>1 
			
			USE IN c_CLI
			USE IN cyvCliPro
			USE IN t_CLI
			SQLDISCONNECT(lnCtrlSap)
		ELSE
			WAIT WINDOW 'Imposible conectarse a la base de datos de SAP'	
		ENDIF 	
	ENDIF
ENDFUNC 




FUNCTION _SincronizaCatalogosSIGA(lnmimodcargar)
	IF TYPE("ldfec")="U"
		ldfec=DATE()
	ENDIF 
	***********************************
	******* Productos
	IF lnmimodcargar=1
		lnConid=_conectaSIGA()
		IF lnConid>0
			WAIT WINDOW "Sincronizando Productos " NOWAIT 

			USE PCPTVDISALRUTA+'productos' IN 0 ALIAS oitm share AGAIN 
			USE PCPTVDISALRUTA+'existencias' IN 0 ALIAS oitw share AGAIN 
			
			lnCtrlSap="SELECT t0.idproducto,t0.codprod as ItemCode,t0.producto as ItemName,t0.codprod2 as CodeBars,t0.precio as price,t0.costoprom as AvgPrice,t0.idfamilia as ItmsGrpCod,t0.existencia "+;
											"from OITM t0 order by t0.codprod into cursor t_PRO READWRITE"
			&lnCtrlSap
			lnCtrlSap=SQLEXEC(lnConid,"SELECT idproducto,ItemCode as CodProd,WhsCode as codBodega,Onhand as existencia FROM OITW inner join ",'t_exi2')
			
			lnCtrlSap=SQLEXEC(lnConid,"SELECT U_iddocto as iddocto,createDate as fecactu,DocTotal,U_Cod_Sucursal "+;
												"FROM OINV where DocDate between '"+_ConvertirToFechaSQL(DATE()-300)+"' and '"+_ConvertirToFechaSQL(DATE())+;
																"' and ISNULL(U_iddocto,0)>0 ",'t_Doctos')

			lnCtrlSap=SQLEXEC(lnConid,'select * from OPLN WHERE listnum in (2,6)  ','t_listas')
			lnCtrlSap= SQLEXEC(lnConid,'select 000000000 as idprecio,000000000 as idproducto,* from ITM1 '+;
									'where pricelist in (2,6) ','t_precios')


			**** actualizando que registro ya esta importado en sap						
			USE pcsysdir+pcDB+"\cyvVentas" IN 0 SHARED AGAIN 
			USE pcsysdir+pcDB+"\siskardex" IN 0 SHARED AGAIN 
			USE pcsysdir+pcDB+"\cyvVentasdeta" IN 0 SHARED AGAIN
			
			WAIT WINDOW "Sincronizando Ventas no ya importadas " NOWAIT 
			UPDATE cyvVentas SET cyvVentas.fecactu = t_Doctos.fecactu ;
				FROM cyvVentas INNER JOIN t_Doctos ON cyvventas.iddocto=t_Doctos.iddocto AND EMPTY(NVL(cyvventas.fecactu,CTOD(' '))) 
			
			WAIT WINDOW "Sincronizando Ventas ya importadas .." NOWAIT 
			UPDATE siskardex SET siskardex.fecactu = t_Doctos.fecactu ;
				FROM siskardex INNER JOIN t_Doctos ON siskardex.iddocto=t_Doctos.iddocto AND EMPTY(NVL(siskardex.fecactu,CTOD(' '))) 
				    
			USE pcsysdir+pcDB+"\invProductos" IN 0 SHARED AGAIN 
			USE pcsysdir+pcDB+"\siscata" IN 0 SHARED AGAIN 
			USE pcsysdir+pcDB+"\invexisbodega" IN 0 SHARED AGAIN
			USE pcsysdir+pcDB+"\invProdlistaspre" IN 0 SHARED AGAIN  
			USE pcsysdir+pcDB+"\invProdprecios" IN 0 SHARED AGAIN
			
			SELECT 000000000 as id,t_PRO.ItemCode as PRO_codigo,t_PRO.ItemName as pro_nombre,;
					t_PRO.ItemName as descripcion,1 as tipoprod,NVL(t_PRO.Codebars,SPACE(50)) as pro_barra,;
					181 as iddivision,191 as idsistema,NVL(c_lin.id,0000000000) as idfamilia,201 as idrubro,0 as idagrupador,;
					'Unidad' as unidadmedida,221 as idmarca,1 as gravado,0 as concesc,0 as conretencion,;
					1 as idimpuestoiva,0 as idimpuestorenta,0 as idimpuestofovial,0 as idimpuestocotrans,0 idimpuestocesc,;
					0 pordescuento,50 as factorganancia,0 as esprodcontrolado,0 as esprodregulado,0 as escombustible,;
					0 as esfabricado,0 as fabautomatica,0 as connegativos,0 as conarea,0 as conserielote,;
					0 as enliquidacion,0 as costoinicial,0 as costototal,1 as juegocompra,;
					0 as pedidosrecibir,0 as pedidossurtir,NVL(t_PRO.price*1.13,000000000.000000) as precioconiva, NVL(t_PRO.Price,000000000.000000) as preciosiniva,;
					1 as juegoventa,1 as factorpresenta,0 as idctainggasto,NVL(t_EXI.existencia,000000000.000000) as existencia,NVL(t_PRO.AvgPrice,000000000.00) as costopromedio ;
					FROM t_PRO ;
							LEFT JOIN siscata as c_lin ON ALLTRIM(STR(t_pro.ItmsGrpCod))=c_lin.cod AND c_lin.origen='LIN' ;
							LEFT JOIN t_EXI ON t_pro.ItemCode=t_EXI.Itemcode ;
					WHERE !EMPTY(NVL(t_PRO.ItemName,'')) AND t_PRO.ItemCode NOT in ;
						(SELECT codprod FROM invProductos) ;
			UNION ALL ;
				SELECT 000000001 as id,t_PRO.ItemCode as PRO_codigo,t_PRO.ItemName as pro_nombre,;
					t_PRO.ItemName as descripcion,1 as tipoprod,NVL(t_PRO.Codebars,SPACE(50)) as pro_barra,;
					181 as iddivision,191 as idsistema,NVL(c_lin.id,0000000000) as idfamilia,201 as idrubro,0 as idagrupador,;
					'Unidad' as unidadmedida,221 as idmarca,1 as gravado,0 as concesc,0 as conretencion,;
					1 as idimpuestoiva,0 as idimpuestorenta,0 as idimpuestofovial,0 as idimpuestocotrans,0 idimpuestocesc,;
					0 pordescuento,50 as factorganancia,0 as esprodcontrolado,0 as esprodregulado,0 as escombustible,;
					0 as esfabricado,0 as fabautomatica,0 as connegativos,0 as conarea,0 as conserielote,;
					0 as enliquidacion,0 as costoinicial,0 as costototal,1 as juegocompra,;
					0 as pedidosrecibir,0 as pedidossurtir,NVL(t_PRO.price*1.13,000000000.000000) as precioconiva, NVL(t_PRO.Price,000000000.000000) as preciosiniva,;
					1 as juegoventa,1 as factorpresenta,0 as idctainggasto,NVL(t_EXI.existencia,000000000.000000) as existencia,NVL(t_PRO.AvgPrice,000000000.00) as costopromedio ;
					FROM t_PRO ;
							LEFT JOIN siscata as c_lin ON ALLTRIM(STR(t_pro.ItmsGrpCod))=c_lin.cod AND c_lin.origen='LIN' ;
							LEFT JOIN t_EXI ON t_pro.ItemCode=t_EXI.Itemcode ;
					WHERE !EMPTY(NVL(t_PRO.ItemName,'')) AND t_PRO.ItemCode in ;
						(SELECT codprod FROM invProductos) ;
			INTO CURSOR c_PRO READWRITE 
			WAIT WINDOW "Sincronizando Ventas no ya importadas ...." NOWAIT 
			REPLACE id WITH _SiguienteIdTabla(pcNodo,"MAS") FOR id=0  
			REPLACE idfamilia WITH 211 FOR idfamilia=0
			
			WAIT WINDOW "Actualizando Catalogo de Productos " NOWAIT 
			UPDATE invproductos SET invproductos.producto=c_PRO.PRO_nombre ,;
								invproductos.descripcion=c_pro.descripcion ,;
								invproductos.codoriginal=c_pro.pro_barra,;
								invproductos.idrubro=c_pro.idrubro,;
								invproductos.idfamilia=c_pro.idfamilia,;
								invproductos.precioconiva=c_pro.precioconiva,;
								invproductos.preciosiniva=c_pro.preciosiniva,;
								invproductos.existencia=c_pro.existencia,;
								invproductos.fecmod=ldfec,;
								invproductos.nodo=pcnodo,;
								invproductos.iduser=pnIdUsuario, ;
								invproductos.pcuser=SYS(0) ;
				from c_PRO WHERE invproductos.codprod=c_PRO.PRO_codigo 
			
			WAIT WINDOW "Insertando nuevos Productos " NOWAIT 
			INSERT INTO invproductos (idproducto,codprod,producto,descripcion,tipoprod,codoriginal,;
					iddivision,idsistema,idfamilia,idrubro,idagrupador,;
					unidadmedida,idmarca,gravado,concesc,conretencion,;
					idimpuestoiva,idimpuestorenta,idimpuestofovial,idimpuestocotrans,idimpuestocesc,;
					pordescuento,factorganancia,esprodcontrolado,esprodregulado,escombustible,;
					esfabricado,fabautomatica,connegativos,conarea,conserielote,;
					enliquidacion,costoinicial,costopromedio,costototal,juegocompra,;
					existencia,pedidosrecibir,pedidossurtir,precioconiva,preciosiniva,;
					juegoventa,factorpresenta,idctainggasto,eliminado,status,fecalta,fecmod,nodo,iduser,pcuser) ;
				SELECT id,PRO_codigo,pro_nombre,descripcion,tipoprod,pro_barra,;
					iddivision,idsistema,idfamilia,idrubro,idagrupador,;
					unidadmedida,idmarca,gravado,concesc,conretencion,;
					idimpuestoiva,idimpuestorenta,idimpuestofovial,idimpuestocotrans,idimpuestocesc,;
					pordescuento,factorganancia,esprodcontrolado,esprodregulado,escombustible,;
					esfabricado,fabautomatica,connegativos,conarea,conserielote,;
					enliquidacion,costoinicial,costopromedio,costototal,juegocompra,;
					existencia,pedidosrecibir,pedidossurtir,precioconiva,preciosiniva,;
					juegoventa,factorpresenta,idctainggasto,0,1,ldfec,ldfec,;
					pcnodo,pnIdUsuario,SYS(0) ;
				FROM c_PRO WHERE id<>1 
			
			WAIT WINDOW "Sincronizando Existencias " NOWAIT 
			******* existencias por  bodega
			SELECT 000000000 as id,t0.codprod,t0.codbodega,t0.existencia,t1.idproducto,t2.id as idbodega,;
							t1.costopromedio,NVL(t1.costopromedio*t0.existencia,0000000000.000000) as costototal ;
				FROM t_EXI2	t0 INNER JOIN invProductos t1 ON t0.codprod=t1.codprod ;
								INNER JOIN siscata t2 ON t0.codbodega=t2.cod AND origen='BOD' ;
					WHERE STR(idproducto)+STR(id) NOT in ;
						(SELECT STR(idproducto)+STR(idbodega) FROM invexisbodega  ) ;
			UNION ALL ;
				SELECT 000000001 as id,t0.codprod,t0.codbodega,t0.existencia,t1.idproducto,t2.id as idbodega,;
							t1.costopromedio,NVL(t1.costopromedio*t0.existencia,0000000000.000000) as costototal ;
				FROM t_EXI2	t0 INNER JOIN invProductos t1 ON t0.codprod=t1.codprod ;
								INNER JOIN siscata t2 ON t0.codbodega=t2.cod AND origen='BOD' ;
					WHERE STR(idproducto)+STR(id) in ;
						(SELECT STR(idproducto)+STR(idbodega) FROM invexisbodega )   ;
			INTO CURSOR c_EXI READWRITE 
			REPLACE id WITH _SiguienteIdTabla(pcNodo,"MAS") FOR id=0  
			
			WAIT WINDOW "Sincronizando Existencias ." NOWAIT 
			UPDATE invexisbodega SET invexisbodega.existencia=c_EXI.existencia ,;
								invexisbodega.costo=c_EXI.costopromedio,;
								invexisbodega.costototal=c_EXI.costototal ,;
								invexisbodega.fecmod=ldfec, ;
								invexisbodega.nodo=pcnodo, ;
								invexisbodega.iduser=pnIdUsuario, ;
								invexisbodega.pcuser=SYS(0) ;
				from c_EXI WHERE invexisbodega.idbodega=c_EXI.idbodega AND invexisbodega.idproducto=c_EXI.idproducto
			
			WAIT WINDOW "Sincronizando Existencias .." NOWAIT 
			INSERT INTO invexisbodega (idexisbode,idproducto,idbodega,ubicacion,existencia,costo,costototal,fecalta,fecmod,nodo,iduser,pcuser) ;
				SELECT id,idproducto,idbodega,'',existencia,costopromedio,costototal,ldfec,ldfec,;
					pcnodo,pnIdUsuario,SYS(0) ;
				FROM c_EXI WHERE id<>1 

			***** restando venta no importada en sap
			WAIT WINDOW "Sincronizando Ventas no Importadas " NOWAIT 
			SELECT idproducto,idbodega,SUM(cantidad) as cantidad ;
						FROM (SELECT a.idproducto,IIF(a.entsal=1,-a.cantidad,a.cantidad) as cantidad,a.idbodega ;
									FROM cyvventasdeta a INNER JOIN cyvventas b ON a.iddocto=b.iddocto AND ;
											a.status=1 AND a.eliminado=0  AND b.anulado=0 AND b.eliminado=0 AND b.status=1 ;
									WHERE EMPTY(b.fecactu) AND b.origen='VTA' AND BETWEEN(a.entsal,1,2)) as cc ;
				ORDER BY cc.idproducto,cc.idbodega GROUP BY cc.idproducto,cc.idbodega INTO CURSOR c_restando 
			UPDATE invexisbodega ;
					SET invexisbodega.existencia=NVL(invexisbodega.existencia,0)-NVL(c_restando.cantidad,0), ;
						invexisbodega.costototal=NVL(invexisbodega.costototal,0)-(NVL(c_restando.cantidad,0)*NVL(invexisbodega.costo,0)) ;
				from c_restando WHERE invexisbodega.idbodega=c_restando.idbodega AND invexisbodega.idproducto=c_restando.idproducto
			
			WAIT WINDOW "Sincronizando Listas de Precio" NOWAIT 
			*** insertando nuevas listas de precio
			INSERT INTO invprodlistaspre (idlistapre,codlis,listaprecio,idsucursal,porcentaje,;
											tipolista,automatica,eliminado,status,fecalta,fecmod,nodo,iduser,pcuser) ;
							SELECT listnum,SUBSTR(listname,1,2)+ALLTRIM(STR(listnum)),listname,0,0,2,0,0,1,;
									DATETIME(),DATETIME(),pcnodo,pnidusuario,SYS(0) ;
					FROM t_listas WHERE listnum NOT in (select idlistapre FROM invprodlistaspre)
			UPDATE invprodlistaspre SET codlis=SUBSTR(a.listname,1,2)+ALLTRIM(STR(a.listnum)),listaprecio = listname from t_listas a WHERE a.listnum=idlistapre
			USE IN t_listas
				
			
			UPDATE t_precios SET idproducto =a.idproducto from invProductos a WHERE t_precios.itemcode=a.codprod
			DELETE ALL FOR idproducto=0 IN t_precios
			****** actualizando detalle de precios
			UPDATE t_precios SET idprecio=a.idprecio from invprodprecios a WHERE t_precios.idproducto=a.idproducto AND t_precios.pricelist=a.idlistapre
			UPDATE t_precios SET idprecio =_SiguienteIdTabla(pcNodo,"DET") WHERE idprecio=0
			*** actualizando precios antiguos
			UPDATE invprodprecios SET precioconiva =a.price*1.13,preciosiniva=a.price,fecmod=DATETIME() ;
					from t_precios a WHERE invprodprecios.idprecio=a.idprecio AND invprodprecios.preciosiniva<>a.price
			**** agregando nuevos precios
			INSERT INTO invprodprecios (idprecio,idlistapre,idproducto,idunimed,precioconiva,preciosiniva,fecalta,fecmod,nodo,iduser,pcuser) ;
					SELECT idprecio,pricelist,idproducto,0,price*1.13,price,DATETIME(),DATETIME(),pcnodo,pnidusuario,SYS(0) ;
							FROM t_precios WHERE idprecio NOT in (select idprecio FROM invprodprecios)
			USE IN t_precios
			
			
			******* actualizando productos web
*!*				IF .t.
*!*					enviarDatosProducto()
*!*					enviarDatosProductoPrecios()
*!*					enviarDatosProductoExistencia()
*!*				ENDIF 			
			
			USE IN invprodprecios
			USE IN invProdlistaspre	
			USE IN c_PRO
			USE IN siscata
			USE IN invProductos
			USE IN t_PRO	
			USE IN t_EXI
			USE IN t_EXI2
			USE IN c_EXI
			USE IN cyvVentas
			USE IN cyvVentasdeta
			USE IN t_Doctos
			USE IN siskardex
			SQLDISCONNECT(lnCtrlSap)
		ELSE
			WAIT WINDOW 'Imposible conectarse a la base de datos de SAP'	
		ENDIF 	
	ENDIF 
	
	
	***********************************
	******* CLIENTES
	IF lnmimodcargar=2
		lnConid=_conectaSAP()
		IF lnConid>0
			WAIT WINDOW "Sincronizando Clientes " NOWAIT 
			lcomando1="SELECT t0.CardCode,t0.CardName,t0.SlpCode,t0.City,t0.Country,t0.CardFName,"+;
						"t0.U_DUI,t0.U_NIT,t0.U_NRC,t0.U_GIRO,t0.U_TipoCont,t1.AdresType,t1.Address2,t1.Address3,t0.frozenFor,t0.CardType,t2.extradays as diascredito,0 as condipago FROM OCRD t0 "
			lcomando2="left join (select c.* from (select rank() OVER (ORDER BY a.CardCode,a.AdresType,a.LineNum) as reg,a.* "+;
									"from  CRD1 a where a.AdresType='B') as c where c.reg in (select min(b.reg) as reg "
			lcomando3="from (select  rank() OVER (ORDER BY a.CardCode,a.AdresType,a.LineNum) as reg,a.* "+;
							"from  CRD1 a where a.AdresType='B') as b group by b.CardCode)) as t1 on t0.CardCode=t1.CardCode "+;
							"left join OCTG t2 on t0.GroupNum=t2.Groupnum "

			lnCtrlSap=SQLEXEC(lnConid,lcomando1+lcomando2+lcomando3,'t_CLI')
			
			IF lnCtrlSap>0
				REPLACE diascredito WITH NVL(diascredito,0),condipago WITH IIF(NVL(diascredito,0)>0,1,0) ALL IN t_CLI
			ENDIF 
		
			USE pcsysdir+pcDB+"\cyvCliPro" IN 0 SHARED AGAIN 

			SELECT 000000000 as id,CardCode as cli_codigo,IIF(EMPTY(NVL(CardName,SPACE(150))),NVL(CardFName,''),CardName) as cli_nombre,IIF(EMPTY(NVL(CardFName,'')),NVL(CardName,SPACE(150)),CardFName) as cli_razon,;
					IIF(SUBSTR(CardCode,1,1)='P' OR CardType='S',2,1) as tipoclipro,151 as idsucursal,261 as idgrupo,ALLTRIM(NVL(Address2,SPACE(50)))+RTRIM(NVL(Address3,SPACE(50)))  as cli_direccion, ;
					1102 as iddepto, 10510 as idmuni,'' as cli_email,'' as cli_telefono,'' as celular,NVL(U_giro,SPACE(50)) as cli_giro,;
					NVL(u_nit,SPACE(50)) as cli_nit,NVL(u_nrc,SPACE(50)) as cli_registro,NVL(u_dui,SPACE(50)) as cli_dui, ;
					0 mesespedidos,0 mesestransito,IIF(VAL(u_tipoCont)=1,2,1) tipocontri,1 tipoiva,10 porrenta,condipago,diascredito, ;
					0 limitecredito,0 sobregiro,0 saldo,0 pordescuento,0 idlista,0 variosnombres,0 extranjero,0 idagente,0 as facturacondicion, ;
					0 sincomision, 0 exportaexento,0 ventaminima,0 ventamaxima,frozenFor ;
				FROM t_CLI ;
				WHERE CardCode NOT in ;
						(SELECT codclipro FROM cyvclipro) ;
			UNION ALL ;
				SELECT 000000001 as id,CardCode as cli_codigo,IIF(EMPTY(NVL(CardName,SPACE(150))),NVL(CardFName,''),CardName) as cli_nombre,;
					IIF(EMPTY(NVL(CardFName,'')),NVL(CardName,SPACE(150)),CardFName) as cli_razon,;
					IIF(SUBSTR(CardCode,1,1)='P' OR CardType='S',2,1) as tipoclipro,151 as idsucursal,261 as idgrupo,ALLTRIM(NVL(Address2,SPACE(50)))+RTRIM(NVL(Address3,SPACE(50)))  as cli_direccion, ;
					1102 as iddepto, 10510 as idmuni,'' as cli_email,'' as cli_telefono,'' as celular,NVL(U_giro,SPACE(50)) as cli_giro,;
					NVL(u_nit,SPACE(50)) as cli_nit,NVL(u_nrc,SPACE(50)) as cli_registro,NVL(u_dui,SPACE(50)) as cli_dui, ;
					0 mesespedidos,0 mesestransito,IIF(VAL(u_tipoCont)=1,2,1) tipocontri,1 tipoiva,10 porrenta,condipago,diascredito, ;
					0 limitecredito,0 sobregiro,0 saldo,0 pordescuento,0 idlista,0 variosnombres,0 extranjero,0 idagente,0 as facturacondicion, ;
					0 sincomision, 0 exportaexento,0 ventaminima,0 ventamaxima,frozenFor ;
				FROM t_CLI ;
				WHERE CardCode in ;
						(SELECT codclipro FROM cyvclipro) ;
			INTO CURSOR c_CLI READWRITE 
			DELETE ALL FOR EMPTY(cli_codigo) OR EMPTY(cli_nombre+cli_razon)
			REPLACE id WITH _SiguienteIdTabla(pcNodo,"MAS") FOR id=0  

			UPDATE cyvclipro SET cyvclipro.clipro=c_CLI.cli_nombre ,;
								cyvclipro.nombre=c_CLI.cli_razon,;
								cyvclipro.tipoclipro=c_CLI.tipoclipro,;
								cyvclipro.giro=c_CLI.cli_giro,;
								cyvclipro.nit=c_CLI.cli_nit,;
								cyvclipro.nrc=c_CLI.cli_registro,;
								cyvclipro.dui=c_CLI.cli_dui,;
								cyvclipro.correo=c_CLI.cli_email,;
								cyvclipro.telefono=c_CLI.cli_telefono,;
								cyvclipro.celular=c_CLI.celular,;
								cyvclipro.direccion=c_CLI.cli_direccion,;
								cyvclipro.fecmod=ldfec, ;
								cyvclipro.nodo=pcnodo, ;
								cyvclipro.condipago=c_CLI.condipago, ;
								cyvclipro.diascredito=c_CLI.diascredito, ;
								cyvclipro.iduser=pnIdUsuario, ;
								cyvclipro.status=IIF(c_CLI.frozenFor='Y',0,1), ;
								cyvclipro.pcuser=SYS(0) ;
				from c_cli WHERE cyvclipro.codclipro=c_CLI.cli_codigo
			
			INSERT INTO cyvclipro (idclipro,codclipro,clipro,nombre,tipoclipro,idsucursal,idgrupo,direccion, ;
					iddepto,idmuni,correo,telefono,celular,giro,nit,nrc,dui, ;
					mesespedidos,mesestransito,tipocontri,tipoiva,porrenta,condipago,diascredito, ;
					limitecredito,sobregiro,saldo,pordescuento,idlista,variosnombres,extranjero,idagente,facturacondicion, ;
					sincomision,exportaexento,ventaminima,ventamaxima,eliminado,status,fecalta,fecmod,nodo,iduser,pcuser) ;
				SELECT id,cli_codigo,cli_nombre,cli_razon,tipoclipro,idsucursal,idgrupo,cli_direccion, ;
					iddepto,idmuni,cli_email,cli_telefono,celular,cli_giro,cli_nit,cli_registro,cli_dui, ;
					mesespedidos,mesestransito,tipocontri,1 tipoiva,porrenta,condipago,diascredito, ;
					limitecredito,sobregiro,saldo,pordescuento,idlista,variosnombres,extranjero,idagente,facturacondicion, ;
					sincomision,exportaexento,ventaminima,ventamaxima,0,IIF(c_CLI.frozenFor='Y',0,1),ldfec,ldfec,;
					pcnodo,pnIdUsuario,SYS(0) ;
				FROM c_cli WHERE id<>1 
			
			USE IN c_CLI
			USE IN cyvCliPro
			USE IN t_CLI
			SQLDISCONNECT(lnCtrlSap)
		ELSE
			WAIT WINDOW 'Imposible conectarse a la base de datos de SAP'	
		ENDIF 	
	ENDIF
ENDFUNC 




