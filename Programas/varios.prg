			DO case
				CASE lnTipoImpresor2=1
					lcRetornaPrn=pcprnfinal
				CASE lnTipoImpresor2=2
					lcRetornaPrn=pcprnticket
				CASE lnTipoImpresor2=3
					lcRetornaPrn=pcprnreportes
				OTHERWISE 
					lcRetornaPrn=pcprnpdf
			ENDCASE 
		ENDIF 
	ELSE
