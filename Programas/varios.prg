FUNCTION _SiguienteIdPartidaDetaDisponible(lcNodoSIT)
	LOCAL lnIdDisponible, lnIdCandidato, llExisteId, lcAliasAnterior, llDeletedActivo, lnRegistroAnterior, lcOrdenAnterior
	lnIdDisponible=0
	lcAliasAnterior=ALIAS()
	llDeletedActivo=SET("DELETED")=="ON"
	lnRegistroAnterior=0
	lcOrdenAnterior=""

	IF !USED("ctbpartidasdeta")
		ERROR "La tabla ctbpartidasdeta no esta abierta para asignar el ID de la partida."
	ENDIF

	lnRegistroAnterior=RECNO("ctbpartidasdeta")
	lcOrdenAnterior=ORDER("ctbpartidasdeta")
	SET DELETED OFF
	DO WHILE lnIdDisponible=0
		lnIdCandidato=_SiguienteIdTabla(lcNodoSIT,"DET")
		llExisteId=SEEK(STR(lnIdCandidato),"ctbpartidasdeta","idpartidad")
		IF !llExisteId
			lnIdDisponible=lnIdCandidato
		ENDIF
	ENDDO

	IF EMPTY(lcOrdenAnterior)
		SET ORDER TO 0 IN ctbpartidasdeta
	ELSE
		SET ORDER TO (lcOrdenAnterior) IN ctbpartidasdeta
	ENDIF
	IF BETWEEN(lnRegistroAnterior,1,RECCOUNT("ctbpartidasdeta"))
		GO lnRegistroAnterior IN ctbpartidasdeta
	ENDIF
	IF llDeletedActivo
		SET DELETED ON
	ENDIF
	IF !EMPTY(lcAliasAnterior) AND USED(lcAliasAnterior)
		SELECT (lcAliasAnterior)
	ENDIF

	RETURN lnIdDisponible
ENDFUNC


FUNCTION _SiguienteIdTablaCambiar(lcNodoSIT,lcTablaSIT,lnnewvalor)
	lnSigIdTab=0
	lcBusSIT=lcNodoSIT+lcTablaSIT
	lcAliasSIT=ALIAS()
	lnidConSIT=_conecta(pcDB)
	lnnewvalor=NVL(lnnewvalor,1)
	lddfecm=DATETIME()
	
	IF !EMPTY(lcBusSIT)
		***** buscando siguiente ID
		IF pnTipoconeccion=1		&&& Nativa
			USE pcSysDir+pcdb+"\SisIdTablas" ALIAS idTabTSIT IN 0 share AGAIN ORDER idtabla
			BEGIN TRANSACTION 
			IF SEEK(lcBusSIT,"idTabTSIT")
				lnSigIdTa=idTabTSIT.Siguiente
				IF lnSigIdTa<lnnewvalor 
					UPDATE idTabTSIT SET siguiente=lnnewvalor,fecmod=lddfecm,iduser=pnidusuario,pcuser=SYS(0) where idtabla=lcBusSIT
				ENDIF 
			ELSE
				INSERT INTO idTabTSIT (idtabla,tabla,nodo,siguiente,fecalta,fecmod,iduser,pcuser) VALUES (lcBusSIT,lcTablaSIT,lcNodoSIT,lnnewvalor,lddfecm,lddfecm,pnidusuario,SYS(0))
				lnSigIdTa=1
			ENDIF 
			END TRANSACTION 
			USE IN idTabTSIT
		ELSE
			lnCtrlSql=miSQLEXEC(lnidConSIT,"select siguiente from sisIdTablas where idtabla='"+lcBusSIT+"'","idTabTSIT")
			IF lnCtrlSql>0
				IF pnTipoConeccion=2	&&& mysql
					lnSigIdTa=idTabTSIT.siguiente
				ELSE
					lnSigIdTa=idTabTSIT.siguiente
				ENDIF 
				lnCtrlSql=SQLEXEC(lnidConSIT,'BEGIN')
				IF lnSigIdTa=0
					lnSigIdTa=1
					lnCtrlSql=miSQLEXEC(lnidConSIT,"Insert into sisIdTablas (idtabla,tabla,nodo,siguiente) "+;
						"value ('"+lcBusSIT+"','"+lcTablaSIT+"','"+lcNodoSIT+"',"+ALLTRIM(STR(lnnewvalor))+")","idTabTSIT")
				ELSE
					IF lnSigIdTa<lnnewvalor 
						lnCtrlSql=miSQLEXEC(lnidConSIT,"update sisIdTablas set siguiente="+ALLTRIM(STR(lnnewvalor))+" where idtabla='"+lcBusSIT+"'","idTabTSIT")
					ENDIF 
				ENDIF 
				lnCtrlSql=SQLEXEC(lnidConSIT,'COMMIT')
				USE IN idTabTSIT
			ENDIF 
		ENDIF 
	ENDIF 

	miSQLDISCONNECT(lnidConSIT)

	IF !EMPTY(lcAliasSIT)
		SELECT (lcAliasSIT)
	ENDIF 
	RETURN VAL(lcNodoSIT+PADL(ALLTRIM(STR(lnSigIdTa)),7,"0"))
ENDFUNC 



