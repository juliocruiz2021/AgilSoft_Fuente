FUNCTION _idCuentaUtilidadOperdidaEjercicio(lnIdSqlConec,ldFecEjer)			&&&& no se cambia por que se ha de usar en varios lados
	lcAliBusAyu=ALIAS()
	lnRetorCtaUtilPer=0
	
	IF pnTipoConeccion=1
		lcFiltroFecha=" and FechaPartida<=CTOD('"+DTOC(ldFecEjer)+"') "
	ELSE
		lcFiltroFecha=" and FechaPartida<='"+_ConvertirToFechaSQL(ldFecEjer)+"' "

	ENDIF 
	
	IF lnIdSqlConec>0	&&&& Coneccion Establecida
		lcComandoBuscarCta="SELECT SUM(debe-haber) as UtilidadPerdia "+;
								"FROM ctbpartidasdeta a "+;
										"inner join ctbpartidas b on a.idpartida=b.idpartida "+;
										"Inner join ctbcuentas c on a.idcuenta=c.idcuenta "+;
								"where c.idtipocuenta>=400 and c.idtipocuenta<=699 "+ lcFiltroFecha
		lnCtrlSqlCtaBus=miSQLEXEC(lnIdSqlConec,lcComandoBuscarCta,"c_UtilPer")
	ENDIF 

	IF _tally<>0
		
		IF TYPE("c_UtilPer.UtilidadPerdia")="N"
			lnVAlUtilPer=c_UtilPer.UtilidadPerdia
		ELSE
			lnVAlUtilPer=VAL(c_UtilPer.UtilidadPerdia)
		ENDIF 
		
		IF lnVAlUtilPer>0
			lnRetorCtaUtilPer=pnIdPEjer
		ELSE
			lnRetorCtaUtilPer=pnIdUEjer
		ENDIF 
		USE IN c_UtilPer
	ELSE
		lnRetorCtaUtilPer=pnIdUEjer
