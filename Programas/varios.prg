				WHERE CLI_empresa=pcPTVDisalEmpre AND CLI_codigo NOT in ;
						(SELECT codclipro FROM cyvclipro) ;
			UNION ALL ;
				SELECT 000000001 as id,cli_codigo,cli_nombre,IIF(EMPTY(cli_razon),cli_nombre,cli_razon) as cli_razon,1 as tipoclipro,151 as idsucursal,261 as idgrupo,cli_direccion, ;
					1102 as iddepto, 10510 as idmuni,cli_email,cli_telefono,'' as celular,cli_giro,cli_nit,cli_registro,cli_dui, ;
					0 mesespedidos,0 mesestransito,IIF(cli_tamaño='3',2,1) tipocontri,1 tipoiva,10 porrenta,0 condipago,0 diascredito, ;
					0 limitecredito,0 sobregiro,0 saldo,0 pordescuento,0 idlista,0 variosnombres,0 extranjero,0 idagente,0 as facturacondicion, ;
					0 sincomision, 0 exportaexento,0 ventaminima,0 ventamaxima ;
				FROM t_CLI ;
					WHERE CLI_empresa=pcPTVDisalEmpre AND CLI_codigo in ;
						(SELECT codclipro FROM cyvclipro ) ;
			INTO CURSOR c_CLI READWRITE 
			DELETE ALL FOR EMPTY(cli_codigo)
			REPLACE id WITH _SiguienteIdTabla(pcNodo,"MAS") FOR id=0  
			
			*UPDATE cyvclipro SET cyvclipro.clipro=c_CLI.cli_nombre ,;
								cyvclipro.nombre=c_CLI.cli_razon,;
