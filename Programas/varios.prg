																									'WHERE status=1 and (IIF(EMPTY(fechaini) AND '+;
																									'EMPTY(fechafin),.t.,IIF(!EMPTY(fechaini),fechaini<=ctod("'+DTOC(ldFecPrec)+'"),IIF(!EMPTY(fechafin),fechafin>=ctod("'+DTOC(ldFecPrec)+'"),.f.))) '+;
