FUNCTION FechaHoraServerVFP (tcPath)
	LOCAL ltFileTime
	tcPath = IIF(TYPE('tcPath') # 'C', SPACE(0),ADDBS(tcPath))
	lcFile = tcPath+SUBSTR(SYS(2015), 4) +".tmp"
	IF STRTOFILE("Getting Hour/Obteniendo la Hora",lcFile) > 0
	   ltFileTime = FDATE(lcFile,1)
	   ERASE (lcFile)
	   RETURN ltFileTime
	ENDIF 
	RETURN NULL
ENDFUNC 
