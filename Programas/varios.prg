FUNCTION _ArraytoCursor(lcNomArray,lcnomCur)

	lcAliasCursorArray=ALIAS()	
	CREATE CURSOR &lcnomCur (codprod c(20),producto c(250),marca c(100),existencia N(18,8),unidadmedida c(50),;
								precioconiva n(18,8),preciosiniva n(18,8),idequi i,idproducto i,factorpresenta n(18,8),;
								unidadpresenta c(20),canti n(18,8),costoimp n(18,8), ConSerieLote i)
								
	lnfilas=INT(alen(&lcNomArray)/13)				
	FOR iijr=1 TO lnfilas
	
		lcComandoArray="insert into "+lcnomCur+" values ("+lcNomArray+"("+ALLTRIM(STR(iijr))+",1),"+lcNomArray+"("+ALLTRIM(STR(iijr))+",2),"+lcNomArray+;
									"("+ALLTRIM(STR(iijr))+",3),"+lcNomArray+"("+ALLTRIM(STR(iijr))+",4),"+lcNomArray+"("+ALLTRIM(STR(iijr))+",5),"+lcNomArray+;
									"("+ALLTRIM(STR(iijr))+",6),"+lcNomArray+"("+ALLTRIM(STR(iijr))+",7),0,"+lcNomArray+"("+ALLTRIM(STR(iijr))+",8),"+lcNomArray+;
									"("+ALLTRIM(STR(iijr))+",9),"+lcNomArray+"("+ALLTRIM(STR(iijr))+",10),"+lcNomArray+"("+ALLTRIM(STR(iijr,18,8))+",11),"+lcNomArray+;
									"("+ALLTRIM(STR(iijr,18,8))+",12),"+lcNomArray+"("+ALLTRIM(STR(iijr,18,8))+",13))"
		&lcComandoArray
		m.SQLArraytoCursor=lcComandoArray		&&& en lugar de gudardar en portapapeles
		IF iijr=lnfilas
			IF !EMPTY(lcAliasCursorArray)
				SELECT (lcAliasCursorArray)
			ENDIF 
			
			RETURN .t.
		ENDIF 
	ENDFOR 
ENDFUNC 



