						"t12.codgiro as codactividadreceptor,t12.giro as actividadreceptor,t12.nombrenegocio as nombrecomercialreceptor,"+;
						"IIF(!EMPTY(ALLTRIM(t12.pasaporte)),'Pasaporte',IIF(!EMPTY(ALLTRIM(t12.otro)),'Otro',IIF(!EMPTY(ALLTRIM(t1.nit)),'NIT','DUI'))) as tipoDocumentoReceptor,"+;
						"IIF(!EMPTY(ALLTRIM(t12.pasaporte)),t12.pasaporte,IIF(!EMPTY(ALLTRIM(t12.otro)),t12.otro,IIF(!EMPTY(ALLTRIM(t1.nit)),t1.nit,t1.dui))) as numeroDocumentoReceptor,"+;
						"t7.cod as coddepartamento,t7.nombre as departamento,t8.cod as codmunicipio,t8.nombre as municipio,"+;
						"t9.cod as codSucursal,t9.nombre as sucursal,t9.notas as direccionsuc,t9.codDepartamento as codDepartamentoSuc,t9.codMunicipio as codMunicipioSuc,"+;
						"t9.telefono as telefonosuc,t9.correo as correosuc,"+;
						"t10.codcajban,t10.cajban,t10.cuenta,t10.tipocajban,t11.unidadmedida,t4.tipoicv,"+;
						"pcnomempresa as nomempresa,pcgiro as giroempresa,pcnit as nitempresa,pcnrc as nrcempresa,NVL(DTE.pdf_path,SPACE(250)) as pdf_path,Dte.versiondte,"+;
						"Dte.modelofacturacion,Dte.tipotransmision,Dte.fechahora as fechahoraDTE, "+;
						"t17.valor TipoEstablecimiento,space(250) as urlQR,t12.pasaporte,t12.otro,"+;
						"NVL((select IIF(ctrolcxcp=1,totaldocto+cargoabono,IIF(ctrolcxcp=2,totaldocto*-1+cargoabono,0)) "+;
									"from siskardexdoc where iddocto=t1.iddocto and status=1 and condipago=1),000000000.000000) as saldodoc,"+;
									"t11.esnota "+;
						"FROM impcmp t1 "+;
							"inner join impcmpd t2 on t1.iddocto=t2.iddocto "+;
							"left join impcata t3 on t1.idagente=t3.id and t3.origen='VEN' "+;
							"inner join imptdoc t4 on t1.idtipodocto=t4.idtipodocto "+;
							"left join impser t5 on t1.idserie=t5.idserie "+;
							"left join impcata t7 on t1.iddepto=t7.id and t7.origen='DEP' "+;
							"left join impcata t8 on t1.idmuni=t8.id and t8.origen='MUN' "+;
							"left join impcata t9 on t1.idsucursal=t9.id and t9.origen='SUC' "+;
							"left join impcaj t10 on t1.idcajban=t10.idcajban "+;
							"left join impprod t11 on t2.idproducto=t11.idproducto "+;
							"left join qrDTE Dte on t1.iddocto=DTE.iddocto and t1.origen=DTE.origen and DTE.status=1"+;
							"left join c_tipesta t17 on T9.tipoestablecimiento=t17.codigo "+;	
							"inner join impclipro t12 on t1.idclipro=t12.idclipro "+;
							"where t1.iddocto="+ALLTRIM(STR(lnIdDocto))+" "

		lnCtrlSql=miSQLEXEC(lnidSQL,lcComando0,'c_imp')
		
		lnTipoICVPrn=c_imp.tipoicv
		lcFecurl=DTOS(c_imp.fechadocto)
		SET DATE TO ymd
	
		lcFecarchivo=STRTRAN(TRANSFORM(c_imp.fechadocto),'/','-')
		lcUrlPdfHacienda="https://admin.factura.gob.sv/consultaPublica?ambiente="+;
							ALLTRIM(c_imp.AmbienteDTE)+"&codGen="+ALLTRIM(c_imp.codigoGeneracion)+;
							"&fechaEmi="+lcFecarchivo

		**** cambiando municipio distrito
		REPLACE urlQR WITH lcUrlPdfHacienda all IN c_imp
		GO top
		
		***** emision
		lceDistritotmp=buscaCodigoDTE(CodMunicipioSuc,'213','c_Distri',CodDepartamentoSuc)
		lcecodDistrito=SUBSTR(lceDistritotmp,1,2)
		lceNomDistrito=ALLTRIM(SUBSTR(lceDistritotmp,4,150))
		****receptor
		lcDistritotmp=buscaCodigoDTE(ALLTRIM(codmunicipio),'213','c_Distri',ALLTRIM(coddepartamento))
		lccodDistrito=SUBSTR(lcDistritotmp,1,2)
		lcNomDistrito=ALLTRIM(SUBSTR(lcDistritotmp,4,150))

		REPLACE direccionsuc WITH ALLTRIM(ALLTRIM(direccionsuc)+', '+lceNomDistrito) all
		REPLACE codmunicipio WITH lccodDistrito,direccion WITH ALLTRIM(ALLTRIM(Direccion)+', '+lcNomDistrito) all
		*********************************
		
	
		SET DATE TO dmy
		GO top
		
		
		IF !DIRECTORY(pcSysDir+pcdb+"\ArchivosPDF\")
			MKDIR pcSysDir+pcdb+"\ArchivosPDF\"
		ENDIF 
		lnidcligra=idclipro
		lnfecgra=fechadocto
		
		IF EMPTY(numerocontrol)
			lcnombrearchivonumerodoc=ALLTRIM(clave)+'-'+ALLTRIM(codsucursal)+'-'+ALLTRIM(numero)
		ELSE
*			IF pnUsarOtroNombreJson=1
*				lcnombrearchivonumerodoc=ALLTRIM(codigoGeneracion)
*			ELSE
				lcnombrearchivonumerodoc=ALLTRIM(numerocontrol)
*			ENDIF 
		ENDIF 
*		IF pnUsarOtroNombreJson=1
*			lcNombreArchivoPDF=LOWER(pcSysDir+pcdb+"\ArchivosPDF\"+ALLTRIM(lcnombrearchivonumerodoc)+'.pdf')
*		ELSE
			lcNombreArchivoPDF=LOWER(pcSysDir+pcdb+"\ArchivosPDF\"+SUBSTR(lcFecarchivo,1,4)+'-'+ALLTRIM(lcnombrearchivonumerodoc)+'.pdf')
*		ENDIF 
		lcNumeroCelularPDF=ALLTRIM(celular)
		

		IF lnCtrlSql>0
			lcComando0="SELECT t2.*,t3.cod as CodVendedor,t3.nombre as Vendedor,t4.TipoDocto,t4.clave,"+;
							"t5.serie,t5.prefijo,t5.tiraje,t5.resolucion,t5.autorizacion,t5.fecatuorizacion,t6.idimpuestoiva, "+;
							"pcnomempresa as empresa,pcgiro as giro,pcnit as nit,pcnrc as nrc,t11.unidadmedida,"+;
							"IIF(t6.idagrupador=0,t6.idproducto,t6.idagrupador) as idagrupador, t6.codprod, "+;
							"t2.total as totalventaconiva,t2.total-t2.totaliva as totalventasiniva,"+;
							"(t2.costounimed*t2.cantiunimed)+t2.totaliva as venta_bruta_coniva,t2.costounimed*t2.cantiunimed as venta_bruta_siniva,"+;
							"(t2.total)-((t2.costounimed*t2.cantiunimed)+t2.totaliva ) as total_descuento_coniva,"+;
							"(t2.total-t2.totaliva)-((t2.costounimed*t2.cantiunimed)) as total_descuento_siniva,"+;
							"nvl(t7.cod,t6.codprod) as codagrupador,NVL(t7.nombre,t2.producto) as agrupador,t11.descripcion,"+;
							"t11.esnota,IIF(t6.esnota=1,ALLTRIM(STR(iddoctod)),SPACE(10)) as llavenota  "+;
							"FROM impcmp t1 "+;
								"inner join impcmpd t2 on t1.iddocto=t2.iddocto "+;
								"left join impcata t3 on t1.idagente=t3.id and t3.origen='VEN' "+;
								"inner join imptdoc t4 on t1.idtipodocto=t4.idtipodocto "+;
								"left join impser t5 on t1.idserie=t5.idserie "+;
								"inner join impprod t6 on t2.idproducto=t6.idproducto "+;
								"left join impcata t7 on t6.idagrupador=t7.id and t7.origen='AGR' "+;
								"left join impprod t11 on t2.idproducto=t11.idproducto "+;
								"order by codagrupador,t6.codprod,t2.factor where t2.eliminado=0 and t1.iddocto="+ALLTRIM(STR(lnIdDocto))+" "

			lnCtrlSql=miSQLEXEC(lnidSQL,lcComando0,'c_impdetatmp')
			if !EOF()
				SELECT c_imp
				lnidtd=idtipodocto
				lnidse=idserie
				lnidca=idcajban
				lnidsu=idsucursal
				lnCondipago=condipago
				lcComando0="SELECT TOP 1 * FROM (SELECT 0 as llave,*,SPACE(250) as print2 FROM sisformatos WHERE idtipodocto="+ALLTRIM(STR(lnidtd))+" AND idserie="+ALLTRIM(STR(lnidse))+" AND idsucursal="+ALLTRIM(STR(lnidsu))+" and idcajban=="+ALLTRIM(STR(lnidca))+" "+;
								"UNION ALL "+;
								"SELECT 1 as llave,*,SPACE(250) as print2 FROM sisformatos WHERE idtipodocto="+ALLTRIM(STR(lnidtd))+" AND idserie="+ALLTRIM(STR(lnidse))+" AND idsucursal=="+ALLTRIM(STR(lnidsu))+" "+;
								"UNION ALL "+;
								"SELECT 2 as llave,*,SPACE(250) as print2 FROM sisformatos WHERE idtipodocto="+ALLTRIM(STR(lnidtd))+" AND idserie="+ALLTRIM(STR(lnidse))+") as t0 "+;
							"ORDER BY t0.llave,t0.idtipodocto" 
				lnCtrlSql2=miSQLEXEC(lnidSQL,lcComando0,'c_formatosTmp')
				
				lnImpresor2Prn=c_formatosTmp.impresor2

				**** envio de whasapp
				lnEnviarWaCompras=c_formatosTmp.enviarwa			&&& 0 no enviar, 1 solo generar, 2 preguntar si se envia, 4 enviar por whasap
				lcAsuntoWaCompras=ALLTRIM(c_formatosTmp.asunto)
				lcMensajeWaCompras=ALLTRIM(c_formatosTmp.mensaje)
				lcFormatoWaCompras=ALLTRIM(c_formatosTmp.formatopdf)
				lcAsuntoWS=lcAsuntoWaCompras
				lcMensajeWS=lcMensajeWaCompras
				
				IF lnCtrlSql2>0
					lntipprint=1
					lcimpresortmp=''
					IF impresor2<>0
						lntipprint=impresor2
						lcimpresortmp=ObtieneImpresores(lnidSQL,lntipprint)
						REPLACE print2 WITH lcimpresortmp NEXT 1
					ENDIF
					
					IF lnPrin=1			&&& selecciono otro impresor para imprimir
						lcimpresortmp3=lcimpresortmp
					ELSE
						lcimpresortmp3=ObtieneImpresores(lnidSQL,lnPrin-1)
					ENDIF 
					
					GO top
					lcArchivo=UPPER(ALLTRIM(archivo))
					
					IF !EMPTY(lcArchivo)						
						IF lnFto=1
							lcArchivo2=lcArchivo
							IF tipodetalle=0		&&& si el tipo de detalle esta a cero
								lnTipoDetalle=1
							ELSE 
								lnTipoDetalle=tipodetalle
							ENDIF 
						ELSE 
							DO CASE
								CASE  INLIST(lnFto,2,6)	&& por item
									lnTipoDetalle=1
								CASE  INLIST(lnFto,3,7)	&& por Kit
									lnTipoDetalle=2
								CASE  INLIST(lnFto,4,8)	&& por AGrupador
									lnTipoDetalle=3
								CASE  INLIST(lnFto,5,9)	&& por Bulto
									lnTipoDetalle=4
							ENDCASE 
							IF INLIST(lnFto,6,7,8,9)
								lcArchivo2=STRTRAN(lcArchivo,'.FRX','')+'_2.FRX'
							ELSE 
								lcArchivo2=lcArchivo
							ENDIF 
						ENDIF 
					ELSE
						lcArchivo2=''
						IF tipodetalle=0		&&& si el tipo de detalle esta a cero
							lnTipoDetalle=1
						ELSE 
							lnTipoDetalle=tipodetalle
						ENDIF 
					ENDIF 
					IF lnPrin=1		&&& selecciono otro impresor para imprimir
						lcPrinter=ALLTRIM(impresor1)
					ELSE
						IF lnPrin=3 AND lnFto>=6 AND !EMPTY(lcArchivo2)		&&& si se cambia a formato secundario y ticket
							lcArchivo2=STRTRAN(lcArchivo,'.FRX','')+'_T.FRX'
						ENDIF 
						lcPrinter=lcimpresortmp3
					ENDIF
					
					lcPrinter2=ALLTRIM(print2)
					lnTipoImpresion=tipoimpresion
					
					
					IF lnFto<>1 OR lnPrin<>1		&&& si cambio formato o impresor cambiamos la cantidad de copias
						lnCopiasPrint=lnCopy
					ELSE 
						lnCopiasPrint=IIF(copias=0,1,copias)+IIF(lntipprint=2,lnCondipago,0)
					ENDIF 
					SELECT c_imp	
								
					IF (lcArchivo=lcArchivo2)		&&& cambiamos archivo de impresor por que el usuario lo cambio antes de imprimir
						llExisteFile=FILE(pcSysDir+pcdb+"\formatos\"+lcArchivo)
					ELSE
						IF !EMPTY(lcArchivo2)
							IF FILE(pcSysDir+pcdb+"\formatos\"+lcArchivo)
								lcArchivo=lcArchivo2
							ENDIF 
						ENDIF 
					ENDIF 

					IF  !EMPTY(lcArchivo) and FILE(pcSysDir+pcdb+"\formatos\"+lcArchivo)
						STORE SET("Printer",3) TO lcPrinOld
						IF !EMPTY(lcPrinter)
							APRINTERS(lcImipresores)
							llimpresorExiste=.f.
							FOR i=1 TO ALEN(lcImipresores)/2
								IF ALLTRIM(UPPER(lcImipresores(i,1)))=ALLTRIM(UPPER(lcPrinter))
									llimpresorExiste=.t.
									EXIT 
								ENDIF 
							ENDFOR 
							
							
							IF llimpresorExiste=.t.
								SET PRINTER TO NAME (lcPrinter)
							ENDIF 
							*************************
							IF pnUsaRedirec=1		&&&& usandoa impresor redireccionado
								lcPrinter=ImpresorRedireccionado(lnTipoICVPrn,lnImpresor2Prn)
								SET PRINTER TO NAME (lcPrinter)
							ENDIF 
						ELSE
							IF !EMPTY(lcPrinter2)
								APRINTERS(lcImipresores)
								llimpresorExiste=.f.
								FOR i=1 TO LEN(lcImipresores)-1
									IF ALLTRIM(UPPER(lcImipresores(i,1)))=ALLTRIM(UPPER(lcPrinter2))
										llimpresorExiste=.t.
										EXIT 
									ENDIF 
								ENDFOR 
								
								IF llimpresorExiste=.t.
									SET PRINTER TO NAME (lcPrinter2)
								ENDIF 
							ENDIF 
						ENDIF 
						
						llseimprimio=0
						CREATE CURSOR c_memo (bultos m)
						SELECT c_impdetaTmp
						lnDecimalpre=CuantosDecimales(pcmasprecio)
						lnDecimaltot=CuantosDecimales(pcmastotal)


						IF lnTipoDetalle=3		&&&& impresion agrupada
							SELECT t0.*,cc.*,(SELECT bultos FROM c_memo) as bultos FROM c_impdetaTmp t0 INNER JOIN ;
									(SELECT  MIN(iddoctod) as iddoctodg,SUM(cantiunimed) as cantidadG ,codagrupador as codagrupadorg,;
											MAX(agrupador) as agrupadorg,SUM(totaliva) as totalivag,SUM(costototal+totaliva) as totalcostoconivag,;
											SUM(totalventaconiva) as totalventaconivag,SUM(totalventasiniva) as totalventasinivag,;
											SUM(costototal) as totalcostosinivag,SUM(totalgravado) as totalgravadog,SUM(totalexento) as totalexentog,;
											SUM(totalnosujeto) as totalnosujetog  ;
										FROM c_impdetaTmp ORDER BY codagrupador,factor GROUP BY codagrupador,factor) as cc on t0.iddoctod=cc.iddoctodg ;
								INTO CURSOR c_impdeta READWRITE ORDER BY t0.codprod
						ELSE
							IF lnTipoDetalle=4	&&&& impresion por Bulto
								SELECT t0.*,cc.*,(SELECT bultos FROM c_memo) as bultos FROM c_impdetaTmp t0 INNER JOIN ;
										(SELECT  MIN(a.iddoctod) as iddoctodg,SUM(a.cantiunimed) as cantidadG ,MIN(a.codprod) as codagrupadorg,;
											SUM(totalventaconiva) as totalventaconivag,SUM(totalventasiniva) as totalventasinivag,;
												MAX(a.producto) as agrupadorg,SUM(a.totaliva) as totalivag,SUM(a.costototal+a.totaliva) as totalcostoconivag,;
												SUM(a.costototal) as totalcostosinivag,SUM(a.totalgravado) as totalgravadog,SUM(a.totalexento) as totalexentog,;
												SUM(a.totalnosujeto) as totalnosujetog ;
											FROM c_impdetaTmp a ORDER BY a.idproducto,a.factor GROUP BY a.idproducto,a.factor) as cc on t0.iddoctod=cc.iddoctodg ;
									INTO CURSOR c_impdeta READWRITE ORDER BY t0.codprod
								SELECT codprod,cantiunimed FROM c_impdetaTmp ORDER BY codprod INTO CURSOR c_bultostmp
								SELECT c_bultostmp
								lccodigo='***'
								lcbulto=''
								lccomabulto=', '
								lncuentabul=1
								lnCuentaBultos=0
								SCAN 
									lnCuentaBultos=lnCuentaBultos+1 
									IF lccodigo==codprod
										lncuentabul=lncuentabul+1
										lcbulto=lcbulto+lccomabulto+" [B:"+ALLTRIM(STR(lnCuentaBultos))+"- "+ALLTRIM(STR(cantiunimed))+"]"
										
										UPDATE c_impdeta SET bultos='(Bultos: '+ALLTRIM(STR(lncuentabul,12,0))+') '+lcbulto WHERE codprod==lccodigo
									ELSE
										lccodigo=codprod
										lncuentabul=1
										lcbulto=" [B:"+ALLTRIM(STR(lnCuentaBultos))+"- "+ALLTRIM(STR(cantiunimed))+"]"
										UPDATE c_impdeta SET bultos='(Bultos: '+ALLTRIM(STR(lncuentabul,12,0))+') '+lcbulto WHERE codprod==lccodigo
									ENDIF 
								ENDSCAN 
								USE IN c_bultostmp
								SELECT c_impdeta
							ELSE 
								SELECT t0.*,cc.*,(SELECT bultos FROM c_memo) as bultos FROM c_impdetaTmp t0 INNER JOIN ;
										(SELECT  iddoctod as iddoctodg,sum(cantiunimed) as cantidadG ,MAX(codprod) as codagrupadorg,;
											SUM(totalventaconiva) as totalventaconivag,SUM(totalventasiniva) as totalventasinivag,;
												MAX(producto) as agrupadorg,SUM(totaliva) as totalivag,SUM(costototal+totaliva) as totalcostoconivag,;
												SUM(costototal) as totalcostosinivag,SUM(totalgravado) as totalgravadog,SUM(totalexento) as totalexentog,;
												SUM(totalnosujeto) as totalnosujetog  ;
											FROM c_impdetaTmp ORDER BY iddoctod GROUP BY iddoctod) as cc on t0.iddoctod=cc.iddoctodg ;
									INTO CURSOR c_impdeta READWRITE ORDER BY t0.iddoctod
							ENDIF 
						ENDIF 
						** correccion para imprimir el IVA retenido por renglon en el DTE CRET *****
						SELECT 000000000 as lineas,000000000.00 as ivaRetenidoCRET,* FROM c_impdeta INTO CURSOR c_impdetaTmp
						SELECT * FROM c_impdetaTmp INTO CURSOR c_impdeta READWRITE 
						
						USE IN c_impdetaTmp
						USE IN c_memo

						SELECT c_impdeta
						REPLACE lineas WITH RECNO() all
						** correccion para que la suma del detalle CRET coincida exactamente con la retencion del encabezado *****
						IF c_imp.tipoicv=6 AND c_imp.tipoiva=4
							lnIvaRetenidoAcumCRET=0
							COUNT FOR totalnosujetog>0 TO lnItemsCRET
							lnItemCRET=0
							SCAN FOR totalnosujetog>0
								lnItemCRET=lnItemCRET+1
								IF lnItemCRET=lnItemsCRET
									lnIvaRetenidoItemCRET=ROUND(c_imp.retperdocto-lnIvaRetenidoAcumCRET,2)
								ELSE
									lnIvaRetenidoItemCRET=ROUND(totalnosujetog*c_imp.porretper/100,2)
									lnIvaRetenidoAcumCRET=lnIvaRetenidoAcumCRET+lnIvaRetenidoItemCRET
								ENDIF
								REPLACE ivaRetenidoCRET WITH lnIvaRetenidoItemCRET
							ENDSCAN
						ENDIF
						GO top
						lnlintotal=RECCOUNT()
						lniddoc=iddocto
*						lnagregarlineas=lnLineasMaximas-lnlintotal
						
						IF lnCtrl=3	OR	lnCtrl=1	
							lcPrintActual=SET("PRINTER", 3)
							lcPrintActual2=SET("PRINTER", 3)
							_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)

							IF lnCtrl=3
								MODIFY REPORT pcSysDir+pcdb+"\formatos\"+lcArchivo
							ELSE 
								*lcPrintActual2=lcPrintActua
								REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER NOCONSOLE NAME lcPrintActual
								lcPrintActual=lcPrintActual2
								llseimprimio=1
							ENDIF 	
						ELSE 
							DO case
								CASE lnTipoImpresion=1 AND lnCtrl=0
										lnsn=MESSAGEBOX("Desea ver el Documento ?",4+32+256,"Imprimir...")
										IF lnsn=6
											WAIT WINDOW 'Imprimiendo Documento... ' NOWAIT 
											lcPrintActual=SET("PRINTER", 3)
											lcPrintActual2=SET("PRINTER", 3)
											_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)
											
											REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER PROMPT PREVIEW NOCONSOLE 
											llseimprimio=1
										ENDIF 
								CASE lnTipoImpresion=2 AND lnCtrl=0
										lnsn=MESSAGEBOX("Desea Imprimir el Documento ?",4+32+256,"Imprimir...")
										IF lnsn=6
											WAIT WINDOW 'Imprimiendo Documento.... ' NOWAIT 
											lcPrintActual=SET("PRINTER", 3)
											lcPrintActual2=SET("PRINTER", 3)
											_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)

											FOR iprin=1 TO lnCopiasPrint
												*lcPrintActual2=lcPrintActua
												REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER NOCONSOLE NAME lcPrintActual
												lcPrintActual=lcPrintActual2
											ENDFOR 
											
											llseimprimio=1
										ENDIF 
								CASE (lnTipoImpresion=3 AND lnCtrl=0) OR  lnCtrl=2
										lcPrintActual=SET("PRINTER", 3)
										lcPrintActual2=SET("PRINTER", 3)
										_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)

										REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER PREVIEW NOCONSOLE 
										llseimprimio=1
								CASE lnTipoImpresion=4 AND lnCtrl=0
										lcPrintActual=SET("PRINTER", 3)
										lcPrintActua2=SET("PRINTER", 3)
										lcPrintActua3=SET("PRINTER", 3)
										_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)

										FOR iprin=1 TO lnCopiasPrint
											*lcPrintActual2=lcPrintActual
											REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER NOCONSOLE NAME lcPrintActual
											lcPrintActual=lcPrintActua3
										ENDFOR 
										llseimprimio=1
								CASE lnCtrl=5 OR lnCtrl=6 or lnCtrl=7		&&& envio por correo		
										****** enviar por whasapp
										
										lcCelNum=solonumeros(lcNumeroCelularPDF)
										IF (EMPTY(lcCelNum) OR '70000000'$lcCelNum) AND INLIST(lnCtrl,5,6)
											WAIT WINDOW 'Envio de Whasapp desactivado.... ' TIMEOUT 1
										ELSE 

											=GenerarArchivoPDF_DTE(pcSysDir+pcdb+"\formatos\"+IIF(EMPTY(lcFormatoWaCompras),lcArchivo,lcFormatoWaCompras),;
																	lcNombreArchivoPdF)

											IF lnCtrl=6
												EnviarPorWhatsApp(lcNombreArchivoPdF,lcNumeroCelularPDF,3,lcAsuntoWS,lcMensajeWS)
											ELSE
												IF lnCtrl=5
													EnviarPorWhatsApp(lcNombreArchivoPdF,lcNumeroCelularPDF,lnEnviarWA,lcAsuntoWS,lcMensajeWS)
												ELSE 
													**** 7 no envia por whasap
												ENDIF 
											ENDIF 
										ENDIF 
							
							ENDCASE
						ENDIF 
						GO TOP IN c_impdeta
						
						IF !EMPTY(lcPrinOld)
							SET PRINTER TO NAME (lcPrinOld)
						ENDIF 
						GO TOP IN c_imp
						IF c_imp.impreso=0 AND llseimprimio=1		&&& cambiando status de Impreso
							=miSQLEXEC(lnidSQL,"update cyvcompras set impreso=1 where impreso=0 and iddocto="+ALLTRIM(STR(lnIdDocto))+" ")
						ENDIF
					ELSE 
						 MESSAGEBOX('No se encontro el Archivo del Formato de impresion....  '+lcArchivo,16,'Error al Imprimir...')
					ENDIF 
				ELSE
					MESSAGEBOX('No se Encontro el Formato de Impresion para este Documento....',16,'Error al Imprimir...')
				ENDIF 
			ELSE
				MESSAGEBOX('No se Encontro el Documento....',16,'Error al Imprimir...')
			ENDIF 
		ELSE
			_MostrarErroresSQL(lnidSQL)
		ENDIF 
		*USE in c_imp
		IF USED("c_impdeta")
			*USE IN c_impdeta
		ENDIF 
		=miSQLDISCONNECT(lnidSQL)
	ELSE
		MESSAGEBOX("Imposible conectarse con el Servidor... Intente más tarde...",16,'Error de Conección...')
	ENDIF 
	USE IN impcmp
	USE IN impcmpd
	USE IN impcata
	USE IN imptdoc
	USE IN impser
	USE IN impcaj
	USE IN impprod
	USE IN impclipro
	USE IN c_TipEsta
	USE IN qrDTE
	
	IF !EMPTY(lcAlias)
		SELECT (lcAlias)
	ENDIF 

ENDFUNC 







