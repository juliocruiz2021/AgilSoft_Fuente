FUNCTION _sincomillias2(lcCampoSinComilla)
	lcCampoSinComilla=STRTRAN(lcCampoSinComilla,"'","`")
	lcCampoSinComilla=STRTRAN(lcCampoSinComilla,'"',"``")
	RETURN lcCampoSinComilla
ENDFUNC 

FUNCTION _sincomilliasoTildes(lcCampoSinComilla)
	lcCampoSinComilla=STRTRAN(lcCampoSinComilla,"'"," ")
	lcCampoSinComilla=STRTRAN(lcCampoSinComilla,'"'," ")
	lcCampoSinComilla=STRTRAN(lcCampoSinComilla,'á',"a")
	lcCampoSinComilla=STRTRAN(lcCampoSinComilla,'é',"e")
	lcCampoSinComilla=STRTRAN(lcCampoSinComilla,'í',"i")
	lcCampoSinComilla=STRTRAN(lcCampoSinComilla,'ó',"o")
	lcCampoSinComilla=STRTRAN(lcCampoSinComilla,'ú',"u")
	lcCampoSinComilla=STRTRAN(lcCampoSinComilla,'Á',"A")
	lcCampoSinComilla=STRTRAN(lcCampoSinComilla,'É',"E")
	lcCampoSinComilla=STRTRAN(lcCampoSinComilla,'Í',"I")
	lcCampoSinComilla=STRTRAN(lcCampoSinComilla,'Ó',"O")
	lcCampoSinComilla=STRTRAN(lcCampoSinComilla,'Ú',"U")
	RETURN lcCampoSinComilla
ENDFUNC

FUNCTION miSQLEXEC(lnIdSqlCC,lcMicomandoCC,lcMiCursorCC)
	lcMiCursorCC=NVL(lcMiCursorCC,'')
	
	IF !EMPTY(ALLTRIM(lcMicomandoCC))
		IF pnTipoConeccion=1
			IF INLIST(lcMicomandoCC,"BEGIN","ROLLBACK","COMMIT")
				DO CASE
					CASE lcMicomandoCC="BEGIN"
						lcComandoVFP="BEGIN TRANSACTION"
					CASE lcMicomandoCC="ROLLBACK"
						lcComandoVFP="ROLLBACK"
					CASE lcMicomandoCC="COMMIT"
						lcComandoVFP="END TRANSACTION "
				ENDCASE 
			ELSE
				IF !EMPTY(lcMiCursorCC)
					lcComandoVFP=lcMicomandoCC+" into cursor "+lcMiCursorCC+" READWRITE "
				ELSE
					lcComandoVFP=lcMicomandoCC
				ENDIF 
			ENDIF 
			&lcComandoVFP
			lnRernaidSQl=VAL(SYS(3))
		ELSE
			IF INLIST(lcMicomandoCC,"BEGIN","ROLLBACK","COMMIT") OR TYPE("lcMiCursorCC")='L'
				lnRernaidSQl=SQLEXEC(lnIdSqlCC,lcMicomandoCC)
			ELSE
				lnRernaidSQl=SQLEXEC(lnIdSqlCC,lcMicomandoCC,lcMiCursorCC)
			ENDIF 
		ENDIF 
	ELSE
		lnRernaidSQl=0
	ENDIF 
	RETURN lnRernaidSQl
ENDFUNC 


FUNCTION pasarSegundosAMinutos(lnSegaPasar)
	lnMinp=0
	lcrespMin=""
lcrespSeg=""

IF TYPE("lnSegaPasar")<>"N"
	lnSegP=VAL(lnSegaPasar)
ELSE
	lnSegP=lnSegaPasar
ENDIF 

IF lnSegP>60
	lnMinp=INT(lnSegP/60)
	lcrespMin=ALLTRIM(STR(lnMinp))+" Min."
	lnsegtmp=(lnSegP/60)-lnMinp
	IF lnsegtmp>0
		lcrespSeg=IIF(lnMinp<>0," y "," ")+ALLTRIM(STR(lnsegtmp*60))+" Seg."
	ELSE
		lcrespSeg=""
	ENDIF
ELSE
	 lcrespSeg=ALLTRIM(STR(lnSegP))+" Seg."
ENDIF 
RETURN lcrespMin+lcrespSeg
ENDFUNC 

FUNCTION miSQLEXECREMOTO(lnIdSqlCC,lcMicomandoCC,lcMiCursorCC,lnTipConecRem)
IF lnTipConecRem=1
	IF INLIST(lcMicomandoCC,"BEGIN","ROLLBACK","COMMIT")
		DO CASE
			CASE lcMicomandoCC="BEGIN"
				lcComandoVFP="BEGIN TRANSACTION"
			CASE lcMicomandoCC="ROLLBACK"
				lcComandoVFP="ROLLBACK"
			CASE lcMicomandoCC="COMMIT"
				lcComandoVFP="END TRANSACTION "
		ENDCASE 
	ELSE
		IF !EMPTY(lcMiCursorCC)
			lcComandoVFP=lcMicomandoCC+" into cursor "+lcMiCursorCC+" READWRITE "
		ELSE
			lcComandoVFP=lcMicomandoCC
		ENDIF 
	ENDIF 

	&lcComandoVFP
	lnRernaidSQl=VAL(SYS(3))
ELSE
	IF INLIST(lcMicomandoCC,"BEGIN","ROLLBACK","COMMIT")
		lnRernaidSQl=SQLEXEC(lnIdSqlCC,lcMicomandoCC)
	ELSE
		lnRernaidSQl=SQLEXEC(lnIdSqlCC,lcMicomandoCC,lcMiCursorCC)
	ENDIF 
ENDIF 
RETURN lnRernaidSQl
ENDFUNC 

