FUNCTION _VerificarWhatsAppHabilitado()
	pnWhatsAppHabilitado=0
	lcWhatsApp = CREATEOBJECT("WhatsApp")

	IF VARTYPE(lcWhatsApp) == "O"

		*!* VERIFICAR SI EL SERVICIO ESTA INSTALADO
		IF lcWhatsApp.servicioInstalado(3) == 0
			RELEASE lcWhatsApp
			RETURN .F.
		ENDIF
		*!* FIN VERIFICAR SI EL SERVICIO ESTA INSTALADO

		*!* VERIFICAR SI EL DISPOSITIVO ESTA CONECTADO
		IF lcWhatsApp.conexionWhatsApp() == 0
			RELEASE lcWhatsApp
			RETURN .F.
		ENDIF
		RELEASE lcWhatsApp
		pnWhatsAppHabilitado=1
	ENDIF 

	RETURN .t.
ENDFUNC 



