				FROM c_SUB WHERE id<>1 
			
			USE IN c_SUB
			USE IN siscata
			USE IN t_SUB	
			SQLDISCONNECT(lnCtrlSap)
		ELSE
			WAIT WINDOW 'Imposible conectarse a la base de datos de SAP'	
		ENDIF 
	ENDIF 
		
	
	***********************************
	******* Rubros (grupos en disalcomb)
	IF lcmoduloacargar=5
*!*			WAIT WINDOW "Sincronizando RUBROS ..." NOWAIT 
