FUNCTION ImprimirPartidasCheques(lnCtrlConecc as integer,lcIds as String,lnsalida as integer,lnCtrl as Integer,lcOrigenPartida as string,lcNomCheque,lcnumerocheque,lnvalorcheque,lcCodBanco)
	
	**** lcids 		= se paso como parametro los numeros de partidas a imprimir
	**** lnsalida 	1=tamaño carta,2=media carta 3=resumida  4 consolidado por dia y tipo
	**** lnCtrl 	1=Imprimir Directo al Impresor ;
					2=Imprimir con Previsualizacion y ;
					3=Mostrar Formulario para Editar
	STORE ALIAS() TO lcAliasOld
	llSeImprimio=.f.
	lcids=lcids
	nombre=lcNomCheque
	USE pcSysDir+pcdb+"\ctbPartidas" SHARED AGAIN ORDER idPartida IN 0 ALIAS imppar
	USE pcSysDir+pcdb+"\cybmovimientos" SHARED AGAIN IN 0 ALIAS impmov
	USE pcSysDir+pcdb+"\sisformatos" SHARED AGAIN IN 0 ALIAS impsfor
	USE pcSysDir+pcdb+"\ctbPartidasDeta" SHARED AGAIN ORDER idPartidaD IN 0 alias imppard
	USE pcSysDir+pcdb+"\ctbCuentas" SHARED AGAIN ORDER idCuenta IN 0 ALIAS impparcta
	*USE pcSysDir+pcdb+"\ctbCuentaspadre" SHARED AGAIN ORDER idCuenta IN 0 ALIAS impparctap
	_CtasPadre (0,'','impparctap')
	USE pcSysDir+pcdb+"\siscata" SHARED AGAIN ORDER id IN 0 ALIAS imppartipo

	lcPrintActual=SET("PRINTER", 3)
	
	IF !EMPTY(lcIds)
		lnsalida=1	&&& Tamañao Carta
		STORE "partidas_cheque_"+lcCodBanco TO lcArchivo
		
		IF !FILE(pcSysDir+pcDB+"\formatos\"+lcArchivo+".frx")
			STORE "REP_CHEQUE_PARTIDAS" TO lcArchivo
		ENDIF 

*!*			DO case
*!*				CASE lnsalida=1	&&& Tamañao Carta
*!*					STORE "partidascarta" TO lcArchivo
*!*				CASE lnsalida=2	&&& Tamañao Media Carta
*!*					STORE "partidasmediacarta" TO lcArchivo
*!*				OTHERWISE 	&&& Tamañao Resumida
*!*					STORE "partidasresumen" TO lcArchivo
*!*			ENDCASE 
*!*			
	
		*lcDetalleCtaUnicaPadre="( select MAX(a.idcuenta) as idcuenta,a.idpartida FROM imppard a "+;
									"INNER JOIN imppar b ON a.idpartida=b.idpartida "};
								"where t0 .idpartida in ("+lcids+") order by idpartida,idcuenta "

		SELECT cc.*,bb.idtipodocto,bb.idserie,bb.idcajban from (SELECT lcnumerocheque as numero,lcNomCheque as nombrebeneficiario,tt0.numerodecheque2 as NumPar,lnvalorcheque as valorcheque,;
			tt0.*,tt1.tdebe,tt1.thaber,tt2.codcta,tt2.cuenta,tt2.nivel,tt2.naturaleza,tt2.detalle,;
			000000000 as registro,000000000 as registros,tt0.idpartida as idcheque,tt0.fechapartida as fecha,;
			NombreMes(MONTH(tt0.fechapartida)) as nombremes,ALLTRIM(STR(YEAR(tt0.fechapartida))) as ano,;
			ALLTRIM(STR(DAY(tt0.fechapartida),2,0)) as dia,SPACE(200) as fechalarga,Convertir(lnvalorcheque) as cantidad ;
			FROM ;
				(select t0.*,t1.idtipopar,t1.fechapartida,t1.numeropartida,lcnumerocheque as numerodecheque,t1.numeropartida as numerodecheque2,t1.concepto,t1.monto,t1.impreso,;
							t1.eliminado as partidaeliminada,t2.cod as tipopar,t2.nombre as nomtipopar,;
							SUBSTR(ALLTRIM(STR(IIF(t0.idorigen=0,IIF(t0.debe>0,1,2),t0.idorigen))),1,1) as cargoabono, ;
						NVL(t3.cod,SPACE(20)) as ctrocosto ;
						FROM imppard t0 ;
							INNER JOIN imppar t1 ON t0.idpartida=t1.idpartida ;
							INNER JOIN imppartipo t2 ON t1.idtipopar=t2.id ;
							LEFT  JOIN imppartipo t3 ON t1.idctrocosto=t3.id ; 
							ORDER BY t0.idpartida,cargoabono,t0.idcuenta ; 
						WHERE t0.idpartida in (&lcids)) tt0 ;
				INNER JOIN ;
					(SELECT t0.idpartida as tidpartida,SUM(t0.debe) as tdebe,SUM(t0.haber) thaber,;
							SUBSTR(ALLTRIM(STR(IIF(t0.idorigen=0,IIF(t0.debe>0,1,2),t0.idorigen))),1,1) as tcargoabono,MAX(t0.idcuenta) as tidcuenta,max(t3.idcuentarelacion) as tidcuentarelacion ;
						FROM imppard t0 ;
							INNER JOIN imppar t1 ON t0.idpartida=t1.idpartida ;
							INNER JOIN imppartipo t2 ON t1.idtipopar=t2.id ;
							INNER JOIN impparctap t3 ON t0.idcuenta=t3.idcuenta ;
							INNER JOIN impparcta t4 ON t3.idcuentarelacion=t4.idcuenta ;
							WHERE t0.idpartida in (&lcids) ;
						group BY t0.idpartida,tcargoabono,t4.codcta ;
						ORDER BY t0.idpartida,tcargoabono,t4.codcta) as tt1 ;
				ON tt0.idpartida=tt1.tidpartida AND tt0.cargoabono=tt1.tcargoabono AND tt0.idcuenta=tt1.tidcuenta ;
			INNER JOIN impparcta tt2 ON tt1.tidcuentarelacion=tt2.idcuenta ;
			ORDER BY tt0.fechapartida,tt0.tipopar,tt0.numeropartida,tt0.cargoabono,tt2.codcta ;
			WHERE tt2.nivel>=pnnivelmayor) as cc INNER JOIN impmov bb ON cc.idpartida=bb.iddocto ;
			INTO CURSOR c_resumen READWRITE
			REPLACE fechalarga WITH UPPER(ALLTRIM(dia)+" DE "+ALLTRIM(NOMBREMES)+" DE "+ANO) ALL
		
		lnidpartida=-199999
		lnregistro=0
		SCAN all
			IF lnidpartida<>idcheque
				lnidpartida=idcheque
				lnregistro=1
			ELSE
				lnregistro=lnregistro+1
			ENDIF 
			REPLACE registro WITH lnregistro NEXT 1
		ENDSCAN 
		SELECT MAX(registro) as registros,idcheque FROM c_resumen ORDER BY idcheque GROUP BY idcheque INTO CURSOR c_total READWRITE 
		UPDATE c_resumen SET registros =a.registros from c_resumen inner join c_total a on c_resumen.idcheque=a.idcheque
		USE IN c_total
				
		SELECT c_resumen
		SELECT MIN(idpartidad) FROM c_resumen INTO ARRAY lnidpard
		LOCATE FOR idpartidad=lnidpard
		lcconcepg=ALLTRIM(conceptod)
		IF !EMPTY(lcconcepg)
			REPLACE concepto WITH lcConcepg all
		ENDIF 
		GO top
		**** ACTUALIZANDO status de impreso
		IF lnsalida<>3
			SELECT idpartida FROM c_resumen INTO CURSOR cc_impresos READWRITE ORDER BY idpartida GROUP BY idpartida
			SELECT cc_impresos
			SCAN 
				lnidaimprimir=idpartida
				ActualizarStatusPartidaImpresa(lnCtrlConecc,lnidaimprimir,lcOrigenPartida)
			ENDSCAN 
			USE IN cc_impresos
		ENDIF 
		
		SELECT c_resumen
		*REPLACE concepto WITH ALLTRIM(nomtipopar)+" del dia "+DTOC(fechapartida),debe WITH 0,haber WITH 0 FOR detalle=0
		REPLACE debe WITH 0,haber WITH 0 FOR detalle=0

		SELECT * FROM c_resumen INTO CURSOR c_ttempo1 READWRITE 
		SELECT * FROM c_resumen WHERE detalle=1 INTO CURSOR c_ttempo2 READWRITE 
		SELECT c_ttempo2
		REPLACE tdebe WITH 0,thaber WITH 0,detalle WITH 2 all
		SELECT c_ttempo1
		*REPLACE debe WITH 0 haber WITH 0 all
		SELECT *,IIF(detalle=1,1,0) as impvaldeta FROM c_ttempo1 ;
			UNION ALL ;
		SELECT *,IIF(detalle=1,1,0) as impvaldeta FROM c_ttempo2 ;
			ORDER BY fechapartida,tipopar,numeropartida,cargoabono,codcta,detalle,conceptod INTO CURSOR c_resumen READWRITE 
	
		SELECT STR(idcuenta)+cargoabono as llave,SUM(1) as reg ;
				from c_resumen ;
				WHERE detalle=1 ;
				ORDER BY idcuenta,cargoabono ;
				GROUP BY idcuenta,cargoabono ;
				INTO CURSOR c_hay
		
		SELECT c_resumen
		UPDATE c_resumen SET impvaldeta=0 ;
			WHERE detalle=1 AND STR(idcuenta)+cargoabono in (selec llave from c_hay WHERE reg =1)
		GO top
		
		USE in c_ttempo1
		USE IN c_ttempo2
		SELECT c_resumen 

		lnidtd=idtipodocto
		lnidse=idserie
		lnidca=idcajban
		lnidsu=idsucursal
		*lnCondipago=condipago
		lcComando0="SELECT TOP 1 * FROM (SELECT 0 as llave,*,SPACE(250) as print2,codfor FROM impsfor WHERE origen='CYB' and idtipodocto="+ALLTRIM(STR(lnidtd))+" AND idserie="+ALLTRIM(STR(lnidse))+" AND idsucursal="+ALLTRIM(STR(lnidsu))+" and idcajban=="+ALLTRIM(STR(lnidca))+" "+;
						"UNION ALL "+;
						"SELECT 1 as llave,*,SPACE(250) as print2,codfor FROM impsfor WHERE origen='CYB' and idtipodocto="+ALLTRIM(STR(lnidtd))+" AND idserie="+ALLTRIM(STR(lnidse))+" AND idsucursal=="+ALLTRIM(STR(lnidsu))+" "+;
						"UNION ALL "+;
						"SELECT 2 as llave,*,SPACE(250) as print2,codfor FROM impsfor WHERE origen='CYB' and idtipodocto="+ALLTRIM(STR(lnidtd))+" AND idserie="+ALLTRIM(STR(lnidse))+") as t0 "+;
					"ORDER BY t0.llave,t0.idtipodocto" 
		lnCtrlSql2=miSQLEXEC(1,lcComando0,'c_formatosTmp')
		lnImpresor2Prn=c_formatosTmp.impresor2
		lcArchivo=ALLTRIM(IIF(EMPTY(archivoCTB),archivo,archivoCTB))
	
		SELECT c_resumen 

		IF FILE(pcSysDir+pcDB+"\formatos\"+lcArchivo)
			**** obteniendo el impresor de reportes
			lcPrinter=ObtieneImpresores(lnCtrlConecc,1)
			STORE SET("Printer",3) TO lcPrinOld
			
			*************************
			IF pnUsaRedirec=1		&&&& usandoa impresor redireccionado		lnTipoICVPrn
				lcPrinter=ImpresorRedireccionado(lnCtrl ,3)
			ENDIF 


			IF !EMPTY(lcPrinter)
				SET PRINTER TO NAME (lcPrinter)
			ENDIF 
			SELECT c_resumen
			**lnCtrl=2
			llSeImprimio=.t.
		
			DO case
				CASE lnCtrl=1
					WAIT WINDOW 'Imprimiendo Documento... ' NOWAIT 
*					FOR i=1 TO lnCopias
						lcPrintActual=SET("PRINTER", 3)
						_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)

						lcPrintActual=lcPrintActual2
						lcPrintActual2=SET("PRINTER", 3)
						REPORT FORM pcSysDir+pcDB+"\formatos\"+lcArchivo TO PRINTER NOCONSOLE NAME lcPrintActual
						*lcPrintActual2=lcPrintActual
*					ENDFOR 
				CASE lnCtrl=2
					lcPrintActual=SET("PRINTER", 3)
					lcPrintActual2=SET("PRINTER", 3)
					_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)

					REPORT FORM pcSysDir+pcDB+"\formatos\"+lcArchivo TO PRINTER PROMPT PREVIEW NOCONSOLE 
				CASE lnCtrl=3
					lcPrintActual=SET("PRINTER", 3)
					lcPrintActual2=SET("PRINTER", 3)
					_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)

					MODIFY REPORT pcSysDir+pcDB+"\formatos\"+lcArchivo
			ENDCASE
			IF !EMPTY(lcPrinOld)
				SET PRINTER TO NAME (lcPrinOld)
			ENDIF 
		ENDIF 
	*	USE IN C_resumen
	ELSE
		MESSAGEBOX('No se Encontro el Documento....',16,'Error al Imprimir...')
	ENDIF 

	USE IN imppar
	USE IN imppard
	USE IN impparcta
	USE IN impparctap
	USE IN imppartipo
	USE IN impmov
	USE IN impsfor
	
	
	IF !EMPTY(lcAliasOld)
		SELECT (lcAliasOld)
	ENDIF 
	RETURN llSeImprimio
ENDFUNC 





FUNCTION ImprimirPartidasChequesCompras(lnCtrlConecc as integer,lcIds as String,lnsalida as integer,lnCtrl as Integer,lcOrigenPartida as string,lcNomCheque,lcnumerocheque,lnvalorcheque,lcCodBanco)
	
	**** lcids 		= se paso como parametro los numeros de partidas a imprimir
	**** lnsalida 	1=tamaño carta,2=media carta 3=resumida  4 consolidado por dia y tipo
	**** lnCtrl 	1=Imprimir Directo al Impresor ;
					2=Imprimir con Previsualizacion y ;
					3=Mostrar Formulario para Editar
	STORE ALIAS() TO lcAliasOld
	llSeImprimio=.f.
	lcids=lcids
	nombre=lcNomCheque
	USE pcSysDir+pcdb+"\ctbPartidas" SHARED AGAIN ORDER idPartida IN 0 ALIAS imppar
	USE pcSysDir+pcdb+"\cyvcompras" SHARED AGAIN IN 0 ALIAS impmov
	USE pcSysDir+pcdb+"\sisformatos" SHARED AGAIN IN 0 ALIAS impsfor
	USE pcSysDir+pcdb+"\ctbPartidasDeta" SHARED AGAIN ORDER idPartidaD IN 0 alias imppard
	USE pcSysDir+pcdb+"\ctbCuentas" SHARED AGAIN ORDER idCuenta IN 0 ALIAS impparcta
	*USE pcSysDir+pcdb+"\ctbCuentaspadre" SHARED AGAIN ORDER idCuenta IN 0 ALIAS impparctap
	_CtasPadre (0,'','impparctap')
	USE pcSysDir+pcdb+"\siscata" SHARED AGAIN ORDER id IN 0 ALIAS imppartipo

	lcPrintActual=SET("PRINTER", 3)
	
	
	IF !EMPTY(lcIds)
		lnsalida=1	&&& Tamañao Carta

*!*			DO case
