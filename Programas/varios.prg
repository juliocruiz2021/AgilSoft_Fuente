FUNCTION _CuentaMayor(lnContesa,lcCodCta,lnNivCta)
	lnIdSqlCtaBuscar=lnContesa
	lnCuentaPadre=0
	IF lnNivCta>1
		lcfaliasCtaBus=ALIAS()
		lcCtaBuscar=SUBSTR(lcCodCta,1,pnTNivel(lnNivCta-1))
		IF lnIdSqlCtaBuscar>0	&&&& Coneccion Establecida
			IF pnTipoConeccion<>2
				lcLimBusMay=" "
				lcTopBusMay=" top 1 "
			ELSE 
				lcLimBusMay=" limit 0,1 "
				lcTopBusMay=" "
			ENDIF 
			lcComandoBuscarCta="SELECT "+lcTopBusMay+"idcuenta FROM ctbcuentas where codcta='"+lcCtaBuscar+"' "+lcLimBusMay+" order by codcta"
			lnCtrlSqlCtaBus=miSQLEXEC(lnIdSqlCtaBuscar,lcComandoBuscarCta,"c_BuscaCuenta")
			
			IF lnCtrlSqlCtaBus>0
				lnCuentaPadre=c_BuscaCuenta.idcuenta
			ENDIF 
			USE IN c_BuscaCuenta
		ENDIF 

		IF !EMPTY(lcfaliasCtaBus)
			SELECT (lcfaliasCtaBus)
		ENDIF 
	ENDIF 
	RETURN lnCuentaPadre
ENDFUNC 



FUNCTION _BuscaCuentaporID(lnConect,lnIdC as Integer)
	lnIdSqlCtaBuscar=lnConect
	lcidCtaBus=''
	IF lnIdC<>0
		lcfaliasCtaBus=ALIAS()
		IF lnIdSqlCtaBuscar>0	&&&& Coneccion Establecida
			lcComandoBuscarCta="SELECT a.idcuenta,a.codcta,a.cuenta,a.detalle,a.idpadre,b.codcta as codctapadre,"+;
					"b.cuenta as cuentapadre FROM ctbcuentas a left join ctbcuentas b on a.idpadre=b.idcuenta where a.idcuenta="+ALLTRIM(STR(lnIdC))+"  " 
			lnCtrlSqlCtaBus=miSQLEXEC(lnIdSqlCtaBuscar,lcComandoBuscarCta,"c_BuscaCuenta")
			
			IF lnCtrlSqlCtaBus>0
				lcidCtaBus=c_BuscaCuenta.codcta
			ENDIF 
			*USE IN c_BuscaCuenta
		ENDIF 

		IF !EMPTY(lcfaliasCtaBus)
			SELECT (lcfaliasCtaBus)
		ENDIF 
	ENDIF 
	RETURN lcidCtaBus
ENDFUNC 


