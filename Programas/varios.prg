			lcTabla2="INVPRODLISTASPRE"
			lcCobBusN="codlis"
			lcMasCampos=""
		CASE UPPER(lcTabla)="TIPOPTMO"
			lcMasCampos=",* "
			lcTabla2="finTipoPrestamos"
			lcCobBusN="codtipoptmo"
		CASE UPPER(lcTabla)="PRESTA"
			lcMasCampos='ALLTRIM(clipro)+" ("+ALLTRIM(fintipoprestamos.tipoptmo)+") "+SPACE(50) as nom,'+;
										'finPrestamos.*,cyvclipro.codclipro,finPrestamos.monto as montoprestamo '
			lcTabla2=' finPrestamos inner join cyvclipro on finPrestamos.idcliente=cyvclipro.idclipro '+;
							'inner join fintipoprestamos on finprestamos.idtipoptmo=finTipoPrestamos.idtipoptmo '
			lcCobBusN="codPtmo"
		CASE UPPER(lcTabla)="LOTES"
			lcMasCampos=""
			lcTabla2="INV"+lcTabla
			lcCobBusN="lote"
	endcase

	IF EMPTY(lcWhere)
		lcWhere=" where "+lcCobBusN+"='"+ALLTRIM(lnIdBuscar)+" ' "
	ELSE
		lcWhere=" where "+lcCobBusN+"='"+ALLTRIM(lnIdBuscar)+" ' and "+lcWhere+" "
	ENDIF 
*!*		
*!*		IF USED(lcCursor)
*!*			TABLEREVERT(.t.,lcCursor)
*!*		ENDIF 
	
	lctopbusn=IIF(pnTipoconeccion<>2,"top 1","")
	lclimbusn=IIF(pnTipoconeccion=2,"Limit 0,1","")

	IF UPPER(lcTabla)="INVPRODLISTASPRE"
		lnCtrlSql=miSQLEXEC(lnIdCon,'select '+lctopbusn+' idlistapre as id, '+lcCampos+' as nom '+;
							lcMasCampos+' from '+lcTabla2+' '+lcWhere+' '+' order by '+lcCobBusN+' '+lclimbusn,'c_Buscar_'+lcCampos)
	ELSE
							
		IF UPPER(lcTabla)="PRESTA"
			lccidd=' idptmo'
			lcCampos='ptmo'
			miComandosql='select '+lctopbusn+lccidd+' as id, '+;
							lcMasCampos+' from '+lcTabla2+' '+lcWhere+' '+' order by '+lcCobBusN+' '+lclimbusn
		ELSE
			IF UPPER(lcTabla)="CLIPRO"
				lccidd=' cyvclipro.id'
			ELSE
				lccidd=' id'
			ENDIF 
		
			miComandosql='select '+lctopbusn+lccidd+lcCampos+' as id, '+lcCampos+' as nom '+;
							lcMasCampos+' from '+lcTabla2+' '+lcWhere+' '+' order by '+lcCobBusN+' '+lclimbusn
		ENDIF 
		lnCtrlSql=miSQLEXEC(lnIdCon,micomandosql,'c_Buscar_'+lcCampos)
	ENDIF 

	IF _tallY=0
		buscarCodId=0
		buscarCodNombre=""
		DO case
			CASE UPPER(lcTabla)="SOCIONEGOCIOS"
				buscarClienteFinal=0
		endcase
	ELSE
		buscarCodId=id
		buscarCodNombre=ALLTRIM(nom)
		DO case
			CASE UPPER(lcTabla)="SOCIONEGOCIOS"
				buscarClienteFinal=clientefinal
		endcase
	ENDIF 
	
	**** si es producto se deja la base de datos abierta para pasar los datos al grid
	IF buscarCodId=0
		USE IN ('c_Buscar_'+lcCampos)
	ELSE
		IF UPPER(lcTabla)="SUCURSALES" or UPPER(lcTabla)="FAMILIAS" OR UPPER(lcTabla)="SOCIONEGOCIOS" OR ;
				UPPER(lcTabla)="CTROCOSTOS" OR UPPER(lcTabla)="MARCAS" OR UPPER(lcTabla)="DIVISIONES" OR ;
				UPPER(lcTabla)="RUBROS" OR UPPER(lcTabla)="SISTEMAS" OR UPPER(lcTabla)="AGRUPADORES" OR ;
				UPPER(lcTabla)="IMPTOSRETEN" OR UPPER(lcTabla)="SERIES" OR UPPER(lcTabla)="TIPODOCTOS" OR ;
				UPPER(lcTabla)="CLIPRO" OR UPPER(lcTabla)="BODEGAS" OR UPPER(lcTabla)="GRUPOS" OR UPPER(lcTabla)="PRESTA" OR;
				UPPER(lcTabla)="CAJABANCOS" OR UPPER(lcTabla)="AGENTES" OR UPPER(lcTabla)="INVPRODLISTASPRE" OR ;
				UPPER(lcTabla)="TIPOPTMO" OR UPPER(lcTabla)="LOTES"
			GO TOP IN ('c_Buscar_'+lcCampos)
		ELSE
			USE IN ('c_Buscar_'+lcCampos)
		ENDIF 
	ENDIF 
	
	IF !EMPTY(lcfalias)
		SELECT (lcfalias)
	ENDIF 
	RETURN buscarCodNombre
ENDFUNC 


