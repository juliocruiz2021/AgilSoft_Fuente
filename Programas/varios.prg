FUNCTION ValidarImpresor(lcPrint)
	llExiste=.f.
	IF !EMPTY(lcPrint)
		APRINTERS(laImpresores)
		FOR i=1 TO ALEN(laImpresores)/2
			IF laImpresores(i,1)=lcPrint
				llExiste=.t.
			ENDIF 
		ENDFOR

		IF  llExiste=.f.
			lcPrint=SET("Printer",3)
		ENDIF 
	ELSE 
		lcPrint=SET("Printer",3)
	ENDIF 
	RETURN lcPrint
ENDFUNC 



