FUNCTION _conecta(lcDB)
	pnNumeroConecciones=pnNumeroConecciones+1
	DO case
		CASE pnTipoconeccion=1	&&& FOX
			IF !EMPTY(lcDB)
				IF EMPTY(pcserver)
					OPEN DATABASE pcsysdir+lcDB+"\masterdb"
				ELSE
					OPEN DATABASE pcserver+lcDB+"\masterdb"
				ENDIF 
			ENDIF 
			llContinua=.t.
			lnHandle =VAL(SYS(3))		&&& genera numero al azar

		CASE pnTipoconeccion=2	&&& mysql
			miConec = +pcDriver+";";
			+"SERVER="+pcserver+";";
			+"DATABASE="+lcDB+";";
			+"UID="+pcroot+";";
			+"PWD="+pcclave+";";
			+"PORT="+pcport+";";
			+"OPTION=3;"
		    SQLSETPROP(0,"DispLogin" , 3 )
			lnHandle = SQLSTRINGCONNECT(miConec)
			IF lnHandle >0
				=SQLEXEC(lnHandle,"SET time_zone = 'America/El_Salvador';",'')
