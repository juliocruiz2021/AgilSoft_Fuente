FUNCTION ShowFileInExplorer
    LPARAMETERS tcFilePath
    DECLARE INTEGER ShellExecute IN SHELL32.DLL ;
        INTEGER hwnd, ;
        STRING lpOperation, ;
        STRING lpFile, ;
        STRING lpParameters, ;
        STRING lpDirectory, ;
        INTEGER nShowCmd

    LOCAL lcFilePath, lcFolderPath, lcParams, nResult

    * Verifica si el archivo existe
    IF FILE(tcFilePath)
        lcFilePath = FULLPATH(tcFilePath)
        lcFolderPath = JUSTPATH(lcFilePath)
        lcParams = '/select,"' + lcFilePath + '"'

        * Llama a ShellExecute para abrir la carpeta y seleccionar el archivo
        nResult = ShellExecute(0, "open", "explorer.exe", lcParams, lcFolderPath, 1)
        
