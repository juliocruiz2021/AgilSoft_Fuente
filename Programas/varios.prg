	SELECT TOP 1 * FROM (SELECT a.iddocto,a.fechadocto as fechaint,a.numero,DTOS(a.fechadocto)+a.numero as llaveorden ;
			FROM c_intvta a ;
					INNER JOIN c_intvtad b ON a.iddocto=b.iddocto AND a.status=1 ;
							AND b.eliminado=0 AND a.origen='VTA' AND b.producto<>'CAMBIO DE ACEITE' ;
			 		INNER JOIN c_intProd c ON c.idproducto=b.idproducto AND &lcIntFiltro  ;
			 WHERE a.idclipro=lnidcliproint AND a.fechadocto<=ldfecintcalcular ;
			) as cc ORDER BY llaveorden DESC INTO CURSOR c_intCal  READWRITE 
	
	IF _tally>0
		loRetornaIntereses.fechaInt=fechaint
		loRetornaIntereses.iddocto=iddocto
		loRetornaIntereses.numDocto=numero
		REPLACE ultimafecint WITH loRetornaIntereses.fechaInt FOR idclipro=lnidcliproint AND ultimafecint<>loRetornaIntereses.fechaInt IN c_CliProInt
	ENDIF 
	USE IN c_intprod
	USE IN c_intvta
	USE IN c_intvtaD
	USE IN c_intCal
	USE IN c_CliProInt
	
	IF !EMPTY(lcaliasInt)
		SELECT (lcaliasInt)
	ENDIF 
	RETURN loRetornaIntereses 
ENDFUNC 





FUNCTION _StatusTurnoCerrado(lnPtoVtaCierre,ldfeccierre,lnturnocierre)
	lcAliasCierreturno=ALIAS()
	*DIMENSION laAbiertoCerrado(1)=0
	
	USE pcSysDir+pcdb+"\cyvTurnos" SHARED AGAIN IN 0 ALIAS micierreturno

	SELECT MAX(status) as status,CNT(1) as cuenta FROM  micierreturno ;
		WHERE idptovta=lnPtoVtaCierre AND fecha=ldfeccierre AND turno=lnturnocierre ;
		INTO CURSOR c_tturno
	
	IF c_tturno.cuenta=1
		IF c_tturno.status=1
			lnTurnoCerrado=0
		ELSE 
			lnTurnoCerrado=1
		ENDIF 
	ELSE
		lnTurnoCerrado=0
	ENDIF 
	USE IN c_tturno
	
	USE IN 	micierreturno
	
	IF !EMPTY(lcAliasCierreturno)
		SELECT (lcAliasCierreturno)
	ENDIF 
	RETURN lnTurnoCerrado
ENDFUNC 



