FUNCTION QuitaTildes(tcTexto)
    LOCAL lcTexto, lcConTilde, lcSinTilde, lnI

    * Texto original
    lcTexto = ALLTRIM(tcTexto)

    * Definimos los caracteres con tilde
    lcConTilde = "áéíóúÁÉÍÓÚüÜñÑ"
    lcSinTilde = "aeiouAEIOUuUnN"

    * Recorremos cada caracter y lo reemplazamos
    FOR lnI = 1 TO LEN(lcConTilde)
        lcTexto = STRTRAN(lcTexto, SUBSTR(lcConTilde, lnI, 1), SUBSTR(lcSinTilde, lnI, 1))
    ENDFOR

    RETURN lcTexto
ENDFUNC



*------------------------------------------------------------
* Descarga un archivo desde una URL y lo guarda en disco.
* Devuelve .T. si descargó bien; .F. si falló.
*
* Uso:
*   lcUrl = "https://certificador.infile.com.sv/api/v1/reporte/reporte_documento?uuid=...&formato=pdf"
*   lcDestino = "C:\Temp\"   && carpeta (con \ al final o sin, da igual)
*   llOk = DownloadFileFromUrl(lcUrl, lcDestino, @lcSavedPath, @lcErr)
*------------------------------------------------------------
FUNCTION DownloadFileFromUrl(tcUrl, tcFolderDest, tcSavedPath, tcErrMsg)
    LOCAL loHttp, lcFolder, lcFileName, lcFullPath
    LOCAL lnStatus, lcHeader, lcCD, lcExt, lcBytes, loStream
	llretornapdf=.f.
    tcSavedPath = ""
    tcErrMsg    = ""

    IF VARTYPE(tcUrl) <> "C" OR EMPTY(ALLTRIM(tcUrl))
        tcErrMsg = "URL inválida."
        RETURN .F.
    ENDIF

    lcFolder = ALLTRIM(IIF(VARTYPE(tcFolderDest)="C", tcFolderDest, ""))
    IF EMPTY(lcFolder)
        lcFolder = ADDBS(SYS(2023))  && carpeta temporal
    ELSE
        lcFolder = ADDBS(lcFolder)
    ENDIF

    IF NOT DIRECTORY(lcFolder)
        tcErrMsg = "La carpeta destino no existe: " + lcFolder
        RETURN .F.
    ENDIF

    TRY
        loHttp = CREATEOBJECT("WinHttp.WinHttpRequest.5.1")
        loHttp.Open("GET", tcUrl, .F.)
        loHttp.SetRequestHeader("User-Agent", "VFP-WinHTTP")
        loHttp.Send()

        lnStatus = loHttp.Status
        IF lnStatus <> 200
            tcErrMsg = "HTTP " + TRANSFORM(lnStatus) + " - " + loHttp.StatusText
            RETURN .F.
        ENDIF

        *--- Detectar nombre por Content-Disposition (si viene)
        lcHeader = ""
        TRY
            lcHeader = loHttp.GetResponseHeader("Content-Disposition")
        CATCH
            lcHeader = ""
        ENDTRY

        lcFileName = ""
        IF NOT EMPTY(lcHeader)
            * ejemplo: attachment; filename="reporte.pdf"
            lcFileName = GetFileNameFromContentDisposition(lcHeader)
        ENDIF

        *--- Si no se pudo, generar uno por formato o por default
        IF EMPTY(lcFileName)
            lcExt = GuessExtFromUrl(tcUrl)
            lcFileName = "download_" + SYS(2015) + "." + lcExt
        ENDIF 
        lcFullPath = lcFolder + lcFileName

        *--- Guardar binario usando ADODB.Stream
        lcBytes = loHttp.ResponseBody  && VARIANT(byte[])
        loStream = CREATEOBJECT("ADODB.Stream")
        loStream.Type = 1  && adTypeBinary
        loStream.Open()
        loStream.Write(lcBytes)
        loStream.SaveToFile(lcFullPath, 2)  && 2 = adSaveCreateOverWrite
        loStream.Close()

        tcSavedPath = lcFullPath
        llretornapdf= .T.

    CATCH TO loEx
        tcErrMsg = "Error: " + TRANSFORM(loEx.Message)
       llretornapdf=.F.
    FINALLY
        loStream = .NULL.
        loHttp   = .NULL.
    ENDTRY
    RETURN llretornapdf
ENDFUNC


*------------------------------------------------------------
* Extrae filename= de Content-Disposition
*------------------------------------------------------------
FUNCTION GetFileNameFromContentDisposition(tcCD)
    LOCAL lc, lnPos, lcName
    lc = LOWER(tcCD)

    * Buscar filename=
    lnPos = AT("filename=", lc)
    IF lnPos = 0
        RETURN ""
    ENDIF

    lcName = SUBSTR(tcCD, lnPos + LEN("filename="))
    lcName = ALLTRIM(lcName)

    * Quitar ; si viene después
    IF AT(";", lcName) > 0
        lcName = LEFT(lcName, AT(";", lcName)-1)
        lcName = ALLTRIM(lcName)
    ENDIF

    * Quitar comillas
    lcName = STRTRAN(lcName, '"', "")
    lcName = STRTRAN(lcName, "'", "")
    lcName = ALLTRIM(lcName)

    RETURN lcName
ENDFUNC



