			lcComandoBuscarCta="SELECT t0.*,0 as preciominimo,t0.preciosiniva as preciosiniva2,t0.precioconiva as precioconiva2,t0.codprod as codprod4,t0.unidadmedida as unimed,0000000001.0000000000 as factorunimed,"+;
