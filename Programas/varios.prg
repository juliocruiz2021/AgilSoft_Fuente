FUNCTION _verificandoPartidasBcoCTB()
	lcaliascxc=ALIAS()
	WAIT WINDOW 'Verificando Partidas Bancos Vs Contabilidad' NOWAIT 
	llVta=.f.
	llKar=.f.
	llCom=.f.
	IF used('tacajban')
		llcerrar=.f.
	ELSE
		llcerrar=.t.
	ENDIF 
	
	USE pcSysDir+pcdb+"\cybmovimientos" IN 0 SHARE AGAIN 	
	USE pcSysDir+pcdb+"\ctbpartidas" IN 0 SHARE AGAIN 

	
	****  buscando encabezados duplicados
	SELECT a.iddocto,a.idtipopar,a.numeropartida as numero  ;
		FROM cybmovimientos a ;
			INNER JOIN ctbpartidas b ON a.iddocto=b.idpartida AND a.idtipopar=b.idtipopar AND b.origen='CYB' AND ;
						a.numeropartida<>b.numeropartida INTO CURSOR corregir	
						
	UPDATE ctbpartidas SET numeropartida=a.numero ;
		 from corregir a WHERE ctbpartidas.idpartida=a.iddocto AND ctbpartidas.idtipopar=a.idtipopar AND ctbpartidas.origen='CYB'

	USE IN corregir
	USE IN cybmovimientos
	USE IN ctbpartidas
	
	
	IF !EMPTY(lcaliascxc)
		SELECT (lcaliascxc)
	ENDIF 
	WAIT WINDOW "Bco. vs. Contabilidad Verificado...." NOWAIT 
ENDFUNC 




FUNCTION _ValidarExistenciasRecostear(lnidprorecostear as Integer)
	IF PCOUNT()<1
		lnidprorecostear=0
	ENDIF 
	IF pntipoconeccion=1
		WAIT WINDOW 'Corrigiendo tipo productos ....' NOWAIT 
		USE pcSysDir+pcdb+"\invproductos" 		IN 0 SHARED AGAIN  ALIAS c_invpro ORDER idproducto
		USE pcSysDir+pcdb+"\cyvventasdeta" 	IN 0 SHARED AGAIN 
		USE pcSysDir+pcdb+"\cyvcomprasdeta" 	IN 0 SHARED AGAIN 
		USE pcSysDir+pcdb+"\invInventariosdeta" 	IN 0 SHARED AGAIN 
		USE pcSysDir+pcdb+"\siskardex" 	IN 0 SHARED AGAIN 

	**** Eliminando lineas de kardex no eliminadas
		UPDATE siskardex SET eliminado=a.eliminado ;
			from cyvventasdeta a ;
				WHERE siskardex.iddoctod=a.iddoctod AND siskardex.origen=a.origen ;
				AND a.status=1 AND siskardex.eliminado=0 AND a.eliminado=1 AND siskardex.origen='VTA'				

		USE IN invInventariosdeta
		USE IN siskardex


		SELECT a.iddoctod,b.idproducto,b.tipoprod ;
			FROM cyvventasdeta a ;
			INNER JOIN c_invpro b ON a.idproducto=b.idproducto AND a.tipoprod<>b.tipoprod ;
			INTO CURSOR cc_tipoprodmalos READWRITE 
		IF _tally>0
			UPDATE cyvventasdeta SET tipoprod=a.tipoprod ;
				from cc_tipoprodmalos a ;
					WHERE cyvventasdeta.iddoctod=a.iddoctod AND cyvventasdeta.idproducto=a.idproducto
		ENDIF 
		USE IN cc_tipoprodmalos

		SELECT a.iddoctod,b.idproducto,b.tipoprod ;
			FROM cyvcomprasdeta a ;
			INNER JOIN c_invpro b ON a.idproducto=b.idproducto AND a.tipoprod<>b.tipoprod ;
			INTO CURSOR cc_tipoprodmalos READWRITE 
		IF _tally>0
			UPDATE cyvcomprasdeta SET tipoprod=a.tipoprod ;
				from cc_tipoprodmalos a ;
					WHERE cyvcomprasdeta.iddoctod=a.iddoctod AND cyvcomprasdeta.idproducto=a.idproducto
		ENDIF 
		USE IN cc_tipoprodmalos
		USE IN cyvventasdeta
		USE IN cyvcomprasdeta
		USE IN c_invpro
	
		WAIT WINDOW 'Iniciando la Validacion de Existencias.... y Recosteo' NOWAIT 
		plRecosteando=.t.
		plconExistenciasNegativasTMP=plconExistenciasNegativas
		plconExistenciasNegativas=.t.
		lcaliasvalida=ALIAS()
		pdFecIni=DATE()
	
		USE pcSysDir+pcdb+"\invinventarios" SHARED AGAIN IN 0
		USE pcSysDir+pcdb+"\invinventariosdeta" SHARED AGAIN IN 0
		REPLACE origen WITH 'INV' FOR ORIGEN='100' IN invinventariosdeta
		REPLACE origen WITH 'INV' FOR ORIGEN='100' IN invinventarios
		USE IN invinventariosdeta
		USE IN invinventarios
	
		
		IF NVL(lnidprorecostear,0)=0
			USE pcSysDir+pcdb+"\invinventarios" SHARED AGAIN IN 0
			USE pcSysDir+pcdb+"\invinventariosdeta" SHARED AGAIN IN 0
			SELECT invinventariosdeta
			REPLACE origen WITH 'INV' FOR ORIGEN='100'
			UPDATE invinventariosdeta SET costototal=costototal*-1 WHERE cantidad<0 AND costototal>0
			USE IN invinventariosdeta
			USE IN invinventarios
		ENDIF 
		USE pcSysDir+pcdb+"\siskardexdoc" 		IN 0 SHARED AGAIN  ALIAS c_cxcMov
		USE pcSysDir+pcdb+"\siskardex" 			IN 0 SHARED AGAIN  ALIAS c_kar
		USE pcSysDir+pcdb+"\invproductos" 		IN 0 SHARED AGAIN  ALIAS c_invpro ORDER idproducto
		USE pcSysDir+pcdb+"\sistipodoctos" 		IN 0 SHARED AGAIN  ALIAS c_tipdo ORDER IDTIPODOCT
		USE pcSysDir+pcdb+"\siscata" 			IN 0 SHARED AGAIN  ALIAS c_cat
		USE pcSysDir+pcdb+"\invexisbodega" 		IN 0 SHARED AGAIN  ALIAS c_exi  ORDER LLAVE   && STR(IDBODEGA)+STR(IDPRODUCTO)
		USE pcsysdir+pcDB+"\invexisbodegaLote" IN 0 SHARED AGAIN  ALIAS c_exiL ORDER llave		&&idbodega+idproducto+idlote
		
		**** corrigendo fechas modificadas en doc. origen
		UPDATE c_kar SET fechadocto=a.fechadocto ;
			from c_cxcMov a ;
				WHERE c_kar.iddocto=a.iddocto AND c_kar.origen=a.origen AND a.status=1 AND c_kar.fechadocto<>a.fechadocto
				
		
		IF lnidprorecostear<>0
			lcwhereFil=' and a.idproducto='+ALLTRIM(STR(lnidprorecostear))+' '
			lcwhereFil2=' where idproducto='+ALLTRIM(STR(lnidprorecostear))+' '
			lcwhereFil3=' for idproducto='+ALLTRIM(STR(lnidprorecostear))+' '
			lcwhereFil4=' where a.idproducto='+ALLTRIM(STR(lnidprorecostear))+' '
		ELSE
			lcwhereFil=''
			lcwhereFil2=''
			lcwhereFil3=''
			lcwhereFil4=''
		ENDIF 
		
		SELECT * FROM (SELECT a.idproducto,a.tipoprod,IIF(a.ctrolinv=1,a.cantidad,a.cantidad*-1) as cantidad,IIF(a.ctrolinv=1,a.cantiunimed,a.cantiunimed*-1) as cantiunimed,;
				a.factor,a.costounitario,a.costounimed,IIF(a.ctrolinv=1,a.costototal,a.costototal*-1) as costototal,;
				000000000.000000 as costounitarion,000000000.000000 as costounimedn,000000000.000000 as costototaln,000000000.000000 as existencia,000000000.000000 as costoacumulado,;
				a.idbodega,a.idbodegatras,a.origen,a.fechadocto,a.ctrolinv,a.iddocto,a.iddoctod,000000000 as llave,;
				IIF(INLIST(a.ctrolinv,2,3),2,1) as entsal,a.horadocto,e.afectaprom,a.llavelote ;
			FROM c_kar a ;
			left JOIN c_cxcMov b ON a.iddocto=b.iddocto ;
			INNER JOIN c_tipdo e ON a.idtipodocto=e.idtipodocto ;
			WHERE a.fechadocto<=pdFecIni AND INLIST(a.ctrolinv,1,2,3) AND a.status=1 AND a.eliminado=0 &lcwhereFil;
		UNION ALL ;
		SELECT a.idproducto,a.tipoprod,a.cantidad,a.cantiunimed,a.factor,a.costounitario,a.costounimed,a.costototal,;
				000000000.000000 as costounitarion,000000000.000000 as costounimedn,000000000.000000 as costototaln,000000000.000000 as existencia,000000000.000000 as costoacumulado,;
				a.idbodegatras,a.idbodegatras,a.origen,a.fechadocto,1 as ctrolinv,a.iddocto,a.iddoctod,000000000 as llave,;
				IIF(a.ctrolinv=2,2,1) as entsal,a.horadocto,e.afectaprom,a.llavelote ;
			FROM c_kar a ;
			LEFT JOIN c_cxcMov b ON a.iddocto=b.iddocto ;
			INNER JOIN c_tipdo e ON a.idtipodocto=e.idtipodocto ;
			WHERE a.fechadocto<=pdFecIni AND a.ctrolinv=3 AND a.status=1 AND a.eliminado=0 AND a.idbodegatras<>0 &lcwhereFil) as cc ;
		order by cc.idproducto,cc.fechadocto,cc.horadocto,cc.entsal,cc.idbodega;
		INTO CURSOR c_imptmp READWRITE  
		REPLACE llave WITH RECNO() all
	
		SELECT idproducto,tipoprod,costoinicial as costoinicial,;
					costopromedio as costopromedio,;
					costototal as costototal,;
					ultcostocompra as ultcostocompra, ;
					000000000.000000 as costoprom,000000000.000000 as costototaln,000000000.000000 as existencia ;
			FROM c_invpro &lcwhereFil2 INTO CURSOR c_prod READWRITE ORDER BY idproducto
		INDEX on idproducto TAG idproducto
		SET ORDER TO idproducto
		
		SELECT a.idproducto,a.costounitario as costounitario FROM c_imptmp a  ;
				INNER JOIN (SELECT idproducto,MIN(llave) as llave ;
								FROM c_imptmp  ;
								GROUP BY idproducto ;
								WHERE origen='COM' OR (origen='INV' AND CTROLINV=1)) as b ON a.idproducto=b.idproducto AND a.llave=b.llave  ;
			INTO CURSOR c_costo READWRITE
		
		UPDATE c_prod SET c_prod.costoinicial=b.costounitario ;
				from c_prod inner join c_costo b on c_prod.idproducto=b.idproducto AND b.costounitario<>0

		USE IN c_costo 
		
		SELECT c_imptmp
		SET RELATION TO idproducto INTO c_prod
		
		lnid=-9999
		lncp=0
		lncm=0
		lnct=0
		lnex=0
 
		SCAN all
*!*			IF IDDOCTOD=    110862527
*!*				SUSPEND 
*!*			ENDIF 
			IF lnid<>idproducto
				lnid=idproducto
				lnCp=ABS(IIF(c_prod.costoinicial=0,c_prod.costopromedio,c_prod.costoinicial))
				lncm=0
				lnex=0
				lnct=0
				lnCt=0
				lncu=ABS(lnCp)
			ENDIF 
			
					
			IF origen='COM' OR  (origen='INV' AND afectaprom=1)
				IF tipoprod=1
					lnEx=LnEx+cantidad
					*lnCt=lnCt+(ABS(costototal)*IIF(NVL(cantidad,0)>=0,1,IIF(costototal>0,-1,1)))
					lnCt=lnCt+costototal
					*lnCp=ABS(IIF(lnEx=0,IIF(costounitario=0,lncu,costounitario),ROUND(lnCt/lnEx,6)))
					IF cantidad<>0
						lnCp=ABS(IIF(lnEx=0,IIF(costounitario=0,lncu,costounitario),ROUND(lnCt/lnEx,6)))
					ELSE
						IF lnEx<>0 AND costototal<>0
							lnCp=ABS(ROUND(lnCt/lnEx,6))
						ELSE
							lnCp=IIF(lnCp<>0,lnCp,lncu)
						ENDIF
					ENDIF 
					lnCm=lnCp*factor
				ELSE
					IF origen='COM'
						lnEx=0
						lnCt=(ABS(costototal)*IIF(NVL(cantidad,0)>=0,1,IIF(costototal>0,-1,1)))			&&& AQUI TRATAMOS QUE SI LA CANTIDAD ES NEGATIVA HACER EL COSTO TOTAL TAMBIEN NEGATIVO
						lnCp=ABS(costounitario)
						lnCm=lnCp*factor
					ELSE
						lnCt=0
						lnCp=0
						lnCm=0
					ENDIF 
				ENDIF 
				REPLACE  costototaln WITH IIF(cantidad<0 AND costototal>0,-1,1)*costototal,costounimedn WITH costounimed,costounitarion WITH costounitario, ;
								existencia WITH lnEx, costoacumulado WITH lnct NEXT 1
				REPLACE c_prod.costoprom WITH lnCp,c_prod.existencia WITH lnEx,c_prod.costototaln WITH lnCt NEXT 1
			ELSE
				IF origen='VTA' OR origen='VTP'
					IF tipoprod=1
						lnEx=LnEx+cantidad
						*lnCtt=IIF(Ctrolinv=1,1,-1)*ROUND(IIF(cantidad=0,1,cantidad)*lnCp,6)
						lnCtt=ROUND(IIF(cantidad=0,IIF(entsal=1,1,-1),cantidad)*lnCp,6)	&&&& si no tiene cantidad valida si es entrada o salida para multiplicar por 1 o -1
						lnCt=lnCt+lnCtt
						lnCm=lnCp*factor
						IF cantidad=0 AND lnEx<>0		&&&& si la cantidad es cero y subio el costo o bajo, el promedio cambia aunque no sea un doc. que afecta costos
							lncp=ABS(lnct/lnEx)
						ENDIF 
					ELSE
						lnEx=0
						*lnCtt=IIF(Ctrolinv=1,1,-1)*ROUND(IIF(cantidad=0,1,cantidad)*lnCp,6)
						lnCtt=0
						lnCt=0
						lnCm=0
						lnCp=0
					ENDIF 
					*lnCpOld=lnCp
					*lnCp=ABS(IIF(lnEx=0,lnCp,ROUND(lnCt/lnEx,6)))
				ELSE
					IF tipoprod=1
						lnEx=LnEx+cantidad
						*lnCtt=IIF(Ctrolinv=1,1,-1)*ROUND(IIF(cantidad=0,1,cantidad)*lnCp,6)
						lnCtt=ROUND(IIF(cantidad=0,IIF(entsal=1,1,-1),cantidad)*lnCp,6)		&&&& si no tiene cantidad valida si es entrada o salida para multiplicar por 1 o -1
						lnCt=lnCt+lnCtt
						lnCm=lnCp*factor
						IF cantidad=0 AND lnEx<>0		&&&& si la cantidad es cero y subio el costo o bajo, el promedio cambia aunque no sea un doc. que afecta costos
							lncp=ABS(lnct/lnEx)
						ENDIF 
					ELSE 
						lnEx=0
						*lnCtt=IIF(Ctrolinv=1,1,-1)*ROUND(IIF(cantidad=0,1,cantidad)*lnCp,6)
						lnCtt=0
						lnCt=0
						lnCm=0
					ENDIF 
				ENDIF 			
				REPLACE  costototaln WITH lnCtt,costounimedn WITH lnCm,costounitarion WITH lnCp, existencia WITH lnEx , costoacumulado WITH lnct NEXT 1
				REPLACE c_prod.existencia WITH lnEx,c_prod.costototaln WITH lnCt,c_prod.costoprom WITH lncp  NEXT 1
				
				*lnCp=ABS(IIF(lnEx=0,lnCp,ROUND(lnCt/lnEx,6)))
				
			ENDIF 

		ENDSCAN

		SELECT cc.*,IIF(cc.cantidad=0,b.costoprom,ROUND(cc.costototal/cc.cantidad,6)) as costoprom ;
				FROM (SELECT idproducto,idbodega,tipoprod,SUM(cantidad) as cantidad,SUM(costototaln) as costototal ;
							FROM c_imptmp GROUP BY idproducto,tipoprod,idbodega) as cc ;
				INNER JOIN c_prod b ON cc.idproducto=b.idproducto INTO CURSOR c_newexis READWRITE
		
 	
		ldfecexi=DATETIME()
		
		
		****** corriguiendo existencias
		WAIT WINDOW "Actualizando bodegas !" NOWAIT 
		REPLACE existencia WITH 0,costo WITH 0,costototal WITH 0 ALL &lcwhereFil3 IN c_exi
		UPDATE c_exi SET c_exi.existencia=a.cantidad,c_exi.costo=a.costoprom,c_exi.costototal=a.costototal ;
			from c_exi inner join c_newexis a on c_exi.idproducto=a.idproducto AND c_exi.idbodega=a.idbodega &lcwhereFil4
		
		****** corrigiendo existencias lote
		SELECT cc.*,IIF(cc.cantidad=0,b.costoprom,ROUND(cc.costototal/cc.cantidad,6)) as costoprom ;
				FROM (SELECT idproducto,idbodega,tipoprod,SUM(cantidad) as cantidad,SUM(costototaln) as costototal,llavelote ;
							FROM c_imptmp GROUP BY idproducto,tipoprod,idbodega,llavelote) as cc ;
				INNER JOIN c_prod b ON cc.idproducto=b.idproducto INTO CURSOR c_newexis READWRITE

		WAIT WINDOW "Actualizando bodegas Lote !" NOWAIT 
		REPLACE existencia WITH 0,costo WITH 0,costototal WITH 0 ALL &lcwhereFil3 IN c_exiL
		UPDATE c_exiL SET c_exiL.existencia=a.cantidad,c_exiL.costo=a.costoprom,c_exiL.costototal=a.costototal ;
			from c_exiL inner join c_newexis a on c_exiL.idproducto=a.idproducto AND c_exiL.idlote=a.llavelote AND c_exiL.idbodega=a.idbodega &lcwhereFil4
		
		WAIT WINDOW "Actualizando productos !" NOWAIT 
		REPLACE costopromedio WITH 0,costototal WITH 0,existencia WITH 0 ALL &lcwhereFil3 IN c_invpro 
		UPDATE c_invpro SET c_invpro.costoinicial=IIF(c_invpro.costoinicial<>a.costoinicial,a.costoinicial,;
						c_invpro.costoinicial),c_invpro.costopromedio=a.costoprom,c_invpro.costototal=a.costototaln,c_invpro.existencia=a.existencia ;
				from c_invpro inner join c_prod a on c_invpro.idproducto=a.idproducto &lcwhereFil4
		
		
		WAIT WINDOW "Actualizando Ventas !" NOWAIT 
		
		**,cyvventasdeta.fecmod=ldfecexi
		USE pcSysDir+pcdb+"\cyvventasdeta" 	IN 0 SHARED AGAIN 
		UPDATE cyvventasdeta SET cyvventasdeta.costounitario=b.costounitarion,;
							cyvventasdeta.costounimed=b.costounimedn,;
							cyvventasdeta.costototal=ABS(b.costototaln), ;
							cyvventasdeta.nodo=pcNodo ,;
							cyvventasdeta.fecmod=ldfecexi,cyvventasdeta.fecactu=ldfecexi ;
			from cyvventasdeta inner join c_imptmp b on cyvventasdeta.iddoctod=b.iddoctod AND cyvventasdeta.origen=b.origen ;
				WHERE cyvventasdeta.costounitario<>b.costounitarion OR ABS(cyvventasdeta.costototal)<>ABS(b.costototaln)
		
		USE pcSysDir+pcdb+"\cyvventas" 	IN 0 SHARED AGAIN 
		UPDATE cyvventas SET cyvventas.fecmod=ldfecexi,cyvventas.fecactu=ldfecexi,cyvventas.nodo=pcnodo from cyvventas ;
			WHERE iddocto in (select iddocto from cyvventasdeta WHERE fecmod=ldfecexi)

		SELECT iddocto,fechadocto,numero FROM cyvventas WHERE fecmod=ldfecexi INTO CURSOR ccc READWRITE 
		
		SELECT ccc
		 
		 
		****** recontabilizando 
		CLEAR
		IF .t.
			SCAN all
				lnidid=iddocto
				lcnumd=numero
				lcfecd=fechadocto
				
				WAIT WINDOW  'Ventas Id:'+ALLTRIM(STR(lnidid))+"  No.:"+ALLTRIM(lcnumd)+"  Fec.:"+DTOC(lcfecd)+"  "+STR(RECNO())+'/'+STR(RECCOUNT()) NOWAIT 
				_generaPartidaventas(1,lnidid,1)
			ENDSCAN 
		ENDIF 
		
		USE IN cyvventasdeta
		USE IN cyvventas
		USE IN ccc
		
		
		WAIT WINDOW "Actualizando Inventarios !" NOWAIT 
		USE pcSysDir+pcdb+"\invinventariosdeta" 	IN 0 SHARED AGAIN  
		UPDATE invinventariosdeta SET invinventariosdeta.costounitario=b.costounitarion,;
									invinventariosdeta.costounimed=b.costounimedn,;
									invinventariosdeta.costototal=ABS(b.costototaln), ;
									invinventariosdeta.nodo=pcnodo,;
									invinventariosdeta.fecmod=ldfecexi,invinventariosdeta.fecactu=ldfecexi ;
			from invinventariosdeta ;
					inner join c_imptmp b on invinventariosdeta.origen=b.origen AND invinventariosdeta.iddoctod=b.iddoctod AND invinventariosdeta.entsal=b.ctrolinv ;
			WHERE invinventariosdeta.costounitario<>b.costounitarion OR ABS(invinventariosdeta.costototal)<>ABS(b.costototaln)
		
		SELECT iddocto,SUM(costototal) as totaldocto FROM c_imptmp WHERE origen='INV' ORDER BY iddocto GROUP BY iddocto INTO CURSOR ccc READWRITE 
		
		IF !USED("invinventarios")
			USE pcSysDir+pcdb+"\invinventarios" 	IN 0 SHARED AGAIN  ALIAS invinventarios
			lnInvInvseAbrio=1
		ELSE
			lnInvInvseAbrio=0
		ENDIF 
		SELECT iddocto,SUM(costototal) AS totaldocto FROM c_kar WHERE origen='INV' GROUP BY IDDOCTO INTO CURSOR c_totinv
		
		UPDATE invinventarios SET invinventarios.fecmod=ldfecexi,invinventarios.fecactu=ldfecexi,invinventarios.totaldocto=b.totaldocto,invinventarios.nodo=pcnodo ;
			from invinventarios inner join c_totinv b on invinventarios.iddocto=b.iddocto WHERE invinventarios.totaldocto<>b.totaldocto
		USE IN c_totinv
		
		SELECT iddocto,fechadocto,numero FROM invinventarios WHERE fecmod=ldfecexi INTO CURSOR ccc READWRITE 
	
		SELECT ccc
		
		CLEAR 
		IF .t.
			SCAN all
				lnidid=iddocto
				lcnumd=numero
				lcfecd=fechadocto
				WAIT WINDOW 'Inventarios Id:'+ALLTRIM(STR(lnidid))+"  No.:"+ALLTRIM(lcnumd)+"  Fec.:"+DTOC(lcfecd)+"  "+STR(RECNO())+'/'+STR(RECCOUNT()) NOWAIT 
				_generaPartidaInventarios(1,lnidid,1)
			ENDSCAN 
		ENDIF 
		
		IF lnInvInvseAbrio=1
			USE IN invinventarios
		ENDIF 

		USE IN invinventariosdeta
		USE IN ccc
		

		USE IN c_cxcMov
		USE IN c_invpro
		USE IN c_cat
		USE IN c_kar
		USE IN c_exi
		USE IN c_exiL
		USE IN c_prod
		USE IN c_tipdo
		
		USE IN c_imptmp
		USE IN c_newexis
		
		IF !EMPTY(lcaliasvalida)
			SELECT (lcaliasvalida)
		ENDIF 
	ENDIF 
	WAIT CLEAR 
	plconExistenciasNegativas=plconExistenciasNegativasTMP
	plRecosteando=.f.
	RETURN .t.
ENDFUNC 




