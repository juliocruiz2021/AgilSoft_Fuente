FUNCTION _VariableACursor(lcLlaves,lcNombreCursor)

	lcaliasanterior=ALIAS()
	
    CREATE CURSOR (lcNombreCursor) (idllave I)

    * Dividir la cadena de texto en una matriz
    LOCAL ARRAY laLlavesArray(1)
    lnLlavesArray = ALINES(laLlavesArray, STRTRAN(lcLlaves, ",", CHR(13)))

    * Recorrer la matriz e insertar los valores en el cursor
    FOR lnI = 1 TO ALEN(laLlavesArray, 1)
        INSERT INTO (lcNombreCursor) (idllave) VALUES (VAL(laLlavesArray[lnI]))
    ENDFOR

	IF EMPTY(lcaliasanterior)
		SELECT (lcaliasanterior)
	ENDIF 

ENDFUNC 




FUNCTION _NumeroColumna_a_Letra(tnColumnNumber)
    LOCAL lcColumnLetter
    lcColumnLetter = ""
    
    DO WHILE tnColumnNumber > 0
        tnColumnNumber = tnColumnNumber - 1
        lcColumnLetter = CHR(MOD(tnColumnNumber, 26) + 65) + lcColumnLetter
        tnColumnNumber = INT(tnColumnNumber / 26)
    ENDDO

    RETURN lcColumnLetter
ENDFUNC




