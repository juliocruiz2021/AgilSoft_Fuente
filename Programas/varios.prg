FUNCTION buscarSerieCliproF930(lnidclipro)
	lcAliasLote=ALIAS()
	USE pcSysDir+pcdb+'\cyvclipro' IN 0 SHARED AGAIN ALIAS c_buscliproF930
	SELECT a.serieCR,fecSerieCR,SerieCCF,FecSerieCCF,SerieCCL,FecSerieCCL ;
			FROM c_buscliproF930 a WHERE a.idclipro=lnidclipro INTO CURSOR c_SerieBuscar
	USE IN c_buscliproF930
	IF !EMPTY(lcAliasLote)
		SELECT (lcAliasLote)
	ENDIF 
ENDFUNC 


FUNCTION ActualizarSerieCliproF930(lnidclipro,lnOrigenSerie,lcnumeroserie,ldfechaserie)
	&&&&lnOrigenSerie   1=serieCR,2=SerieCCF,3=SerieCCL
	IF lnidclipro<>0 AND lnOrigenSerie<>0 AND !EMPTY(lcnumeroserie) AND !EMPTY(ldfechaserie)
		lcAliasLote=ALIAS()
		USE pcSysDir+pcdb+'\cyvclipro' IN 0 SHARED AGAIN ALIAS c_cliproF930
		DO case
			CASE lnOrigenSerie=1
				UPDATE c_cliproF930 SET serieCR=lcnumeroserie,fecSerieCR=ldfechaserie,fecmod=DATETIME() ;
						WHERE (fecSerieCR<=ldfechaserie OR EMPTY(fecSerieCR)) AND idclipro=lnidclipro
			CASE lnOrigenSerie=2
				UPDATE c_cliproF930 SET serieCCF=lcnumeroserie,fecSerieCCF=ldfechaserie,fecmod=DATETIME() ;
						WHERE (fecSerieCCF<=ldfechaserie OR EMPTY(fecSerieCCF)) AND idclipro=lnidclipro
			CASE lnOrigenSerie=3
				UPDATE c_cliproF930 SET serieCCL=lcnumeroserie,fecSerieCCL=ldfechaserie,fecmod=DATETIME() ;
						WHERE (fecSerieCCL<=ldfechaserie OR EMPTY(fecSerieCCL)) AND idclipro=lnidclipro
			
		ENDCASE 
		
		USE IN c_cliproF930
		IF !EMPTY(lcAliasLote)
			SELECT (lcAliasLote)
		ENDIF 
	ENDIF 
ENDFUNC 




FUNCTION BuscarIdUsuarioAutorizacionRemota(lnIdCon as Integer,lcUsuAutoRemoto, lnModuloAutoRemoto)
	LOCAL lcFalias,lnRetorna,lcCobBusN,lccomansqlBus

	lcFalias=ALIAS()
	
	IF pnTipoConeccion=1	&&& usando coneccion Nativa local
		USE pcSysDir+pcdb+"\sisusuarios" IN 0 SHARED AGAIN ALIAS c_sisU
		USE pcSysDir+pcdb+"\sispermisos" IN 0 SHARED AGAIN ALIAS c_sisp
		lctabla1='c_sisU'
		lctabla2='c_sisp'
	ELSE
		lctabla1='sisusuarios'
		lctabla2='sispermisos'
	ENDIF 
	
	lnRetorna=0
	
