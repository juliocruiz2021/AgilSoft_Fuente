*********
FUNCTION ImprimirCinta(ldfec1 as date,lncaj1 as Integer ,lnCtrl as Integer )
	**** (lnIdDocto as Integer,lnCtrl as Integer ,lnIdConec as integer,lnTipoConec as integer,lnFto,lnPrin,lnCopy)
	**** se paso como parametro el numero de documento a imprimir
	**** lnCtrl 1=Imprimir Directo al Impresor ;
				2=Imprimir con Previsualizacion y ;
				3=Mostrar Formulario para Editar
	lnCopy=1
	lnFto=3
	lnPrin=2
	lnTipoConec=1
	lnIdConec=1
	
	lcFec1=" CTOD('"+DTOC(ldfec1)+"') "
	lcCaj=ALLTRIM(lncaj1)+" "
	STORE ALLTRIM("cinta.frx") TO lcArchivo

	LOCAL lcAlias,lnidSQL
	lnidSQL=0
	lcAlias=ALIAS()
	lnidSQL=_conecta(pcDB)

	lcPrintActual=SET("PRINTER", 3)

	USE pcSysDir+pcdb+"\cyvventas" SHARED AGAIN ORDER iddocto IN 0 ALIAS impvta
	USE pcSysDir+pcdb+"\cyvventasdeta" SHARED AGAIN ORDER iddoctod IN 0 ALIAS impvtad
	USE pcSysDir+pcdb+"\siscata" SHARED AGAIN ORDER id IN 0 ALIAS impcata
	USE pcSysDir+pcdb+"\sistipodoctos" SHARED AGAIN ORDER idtipodocto IN 0 ALIAS imptdoc
	USE pcSysDir+pcdb+"\sisseries" SHARED AGAIN ORDER idserie IN 0 ALIAS impser
	USE pcSysDir+pcdb+"\cybcajabancos" SHARED AGAIN ORDER idcajban IN 0 ALIAS impcaj
	USE pcSysDir+pcdb+"\invproductos" SHARED AGAIN ORDER idproducto IN 0 ALIAS impprod
	USE pcSysDir+pcdb+"\cyvlecturas" SHARED AGAIN ORDER idlectura IN 0 
	USE pcSysDir+pcdb+"\cyvclipro" SHARED AGAIN ORDER idclipro IN 0 ALIAS impclippro

	lcPrintActual=SET("PRINTER", 3)


	IF lnidSQL>0
		lcComando0="SELECT t1.*,t3.cod as CodVendedor,t3.nombre as Vendedor,t4.TipoDocto,t4.clave,"+;
						"t5.serie,t5.prefijo,t5.tiraje,t5.resolucion,t5.autorizacion,t5.fecatuorizacion,"+;
						"t7.cod as coddepartamento,t7.nombre as departamento,t8.cod as codmunicipio,t8.nombre as municipio,"+;
						"t9.cod as codSucursal,t9.nombre as sucursal,t9.notas as direccionsuc,"+;
						"t10.codcajban,t10.cajban,t10.cuenta,t10.tipocajban,t13.codclipro,"+;
						"pcnomempresa as nomempresa,pcgiro as giroempresa,pcnit as nitempresa,pcnrc as nrcempresa, "+;
						"t12.fecultilectura,t12.ultimalectura,t12.fecha as fechalectura,t12.lectura,t12.consumo,t14.codtarifa,t13.saldo as saldoclipro, "+;
						"NVL((select IIF(ctrolcxcp=1,totaldocto+cargoabono,IIF(ctrolcxcp=2,totaldocto*-1+cargoabono,0)) from siskardexdoc where iddocto=t1.iddocto and status=1 and condipago=1),000000000.000000) as saldodoc "+;
						"FROM impvta t1 "+;
							"left join impcata t3 on t1.idagente=t3.id and t3.origen='VEN' "+;
							"inner join imptdoc t4 on t1.idtipodocto=t4.idtipodocto "+;
							"inner join impser t5 on t1.idserie=t5.idserie "+;
							"left join impcata t7 on t1.iddepto=t7.id and t7.origen='DEP' "+;
							"left join impcata t8 on t1.idmuni=t8.id and t8.origen='MUN' "+;
							"left join impcata t9 on t1.idsucursal=t9.id and t9.origen='SUC' "+;
							"left join impcaj t10 on t1.idcajban=t10.idcajban "+;
							"left join cyvlecturas t12 on t1.idlectura=t12.idlectura "+; 
							"inner join impclippro t13 on t1.idclipro=t13.idclipro "+; 
							"left join cyvtarifas t14 on t13.idtarifa=t14.idtarifa "+; 
							"where t1.fechadocto="+lcFec1+" and t1.idcajban="+lcCaj

		lnCtrlSql=miSQLEXEC(lnidSQL,lcComando0,'c_imp')

		IF lnCtrlSql>0
			lcComando0="SELECT t2.*,t3.cod as CodVendedor,t3.nombre as Vendedor,t4.TipoDocto,t4.clave,"+;
							"t5.serie,t5.prefijo,t5.tiraje,t5.resolucion,t5.autorizacion,t5.fecatuorizacion,t6.idimpuestoiva, "+;
							"pcnomempresa as empresa,pcgiro as giro,pcnit as nit,pcnrc as nrc,t11.unidadmedida,"+;
							"IIF(t6.idagrupador=0,t6.idproducto,t6.idagrupador) as idagrupador, t6.codprod, "+;
							"nvl(t7.cod,t6.codprod) as codagrupador,NVL(t7.nombre,t2.producto) as agrupador,  "+;
							"t2.precioconivaunidad*t2.cantiunimed as venta_bruta_coniva,t2.preciosinivaunidad*t2.cantiunimed as venta_bruta_siniva,"+;
							"(t2.precioconivaunidad*t2.cantiunimed)-t2.totalventaconiva as total_descuento_coniva,"+;
							"(t2.preciosinivaunidad*t2.cantiunimed)-t2.totalventasiniva as total_descuento_siniva,t6.descripcion "+;
							"FROM impvta t1 "+;
								"inner join impvtad t2 on t1.iddocto=t2.iddocto "+;
								"left join impcata t3 on t1.idagente=t3.id and t3.origen='VEN' "+;
								"inner join imptdoc t4 on t1.idtipodocto=t4.idtipodocto "+;
								"inner join impser t5 on t1.idserie=t5.idserie "+;
								"inner join impprod t6 on t2.idproducto=t6.idproducto "+;
								"left join impcata t7 on t6.idagrupador=t7.id and t7.origen='AGR' "+;
								"left join impprod t11 on t2.idproducto=t11.idproducto "+;
								"order by codagrupador,t6.codprod,t2.factor where t2.eliminado=0 and t1.fechadocto="+lcFec1+" and t1.idcajban="+lcCaj

			lnCtrlSql=miSQLEXEC(lnidSQL,lcComando0,'c_impdetatmp')
			if !EOF()
				SELECT c_imp
				IF .t.
					lntipprint=2
					lcimpresortmp=''
					lcimpresortmp=ObtieneImpresores(lnidSQL,2)
					lcimpresortmp3=lcimpresortmp
					
					GO top
					
					IF !EMPTY(lcArchivo)						
						IF lnFto=1
							lcArchivo2=lcArchivo
							IF tipodetalle=0		&&& si el tipo de detalle esta a cero
								lnTipoDetalle=1
							ELSE 
								lnTipoDetalle=1
							ENDIF 
						ELSE 
							DO CASE
								CASE  INLIST(lnFto,2,6)	&& por item
									lnTipoDetalle=1
								CASE  INLIST(lnFto,3,7)	&& por Kit
									lnTipoDetalle=2
								CASE  INLIST(lnFto,4,8)	&& por AGrupador
									lnTipoDetalle=3
								CASE  INLIST(lnFto,5,9)	&& por Bulto
									lnTipoDetalle=4
							ENDCASE 
							IF INLIST(lnFto,6,7,8,9)
								lcArchivo2=STRTRAN(lcArchivo,'.FRX','')+'_2.FRX'
							ELSE 
								lcArchivo2=lcArchivo
							ENDIF 
						ENDIF 
					ELSE
						lcArchivo2=''
						IF tipodetalle=0		&&& si el tipo de detalle esta a cero
							lnTipoDetalle=1
						ELSE 
							lnTipoDetalle=tipodetalle
						ENDIF 
					ENDIF 
					
*!*						IF lnPrin=1		&&& selecciono otro impresor para imprimir
*!*							lcPrinter=ALLTRIM(impresor1)
*!*						ELSE
*!*							IF lnPrin=3 AND lnFto>=6 AND !EMPTY(lcArchivo2)		&&& si se cambia a formato secundario y ticket
*!*								lcArchivo2=STRTRAN(lcArchivo,'.FRX','')+'_T.FRX'
*!*							ENDIF 
*!*							lcPrinter=lcimpresortmp3
*!*						ENDIF
					
					lcPrinter2=ALLTRIM(lcimpresortmp)
					lcPrinter=lcPrinter2
					lnCopiasPrint=1
					
					SELECT c_imp	
			
*!*						IF (lcArchivo=lcArchivo2)		&&& cambiamos archivo de impresor por que el usuario lo cambio antes de imprimir
*!*							llExisteFile=FILE(pcSysDir+pcdb+"\formatos\&lcArchivo")
*!*						ELSE
*!*							IF !EMPTY(lcArchivo2)
*!*								IF FILE(pcSysDir+pcdb+"\formatos\&lcArchivo2")
*!*									lcArchivo=lcArchivo2
*!*								ENDIF 
*!*							ENDIF 
*!*						ENDIF 
	
					IF  !EMPTY(lcArchivo) and FILE(pcSysDir+pcdb+"\formatos\"+lcArchivo)			&&&&&& "\formatos\&lcArchivo"
						STORE SET("Printer",3) TO lcPrinOld
						IF !EMPTY(lcPrinter)
							APRINTERS(lcImipresores)
							llimpresorExiste=.f.
							FOR i=1 TO ALEN(lcImipresores)/2
								IF ALLTRIM(UPPER(lcImipresores(i,1)))=ALLTRIM(UPPER(lcPrinter))
									llimpresorExiste=.t.
									EXIT 
								ENDIF 
							ENDFOR 
							
							IF llimpresorExiste=.t.
								SET PRINTER TO NAME (lcPrinter)
							ENDIF 
							
							*************************
							IF pnUsaRedirec=1		&&&& usandoa impresor redireccionado
								lcPrinter=ImpresorRedireccionado(lnTipoICVPrn,2)
								SET PRINTER TO NAME (lcPrinter)
							ENDIF 
						ELSE
							IF !EMPTY(lcPrinter2)
								APRINTERS(lcImipresores)
								llimpresorExiste=.f.
								FOR i=1 TO LEN(lcImipresores)-1
									IF ALLTRIM(UPPER(lcImipresores(i,1)))=ALLTRIM(UPPER(lcPrinter2))
										llimpresorExiste=.t.
										EXIT 
									ENDIF 
								ENDFOR 
								
								IF llimpresorExiste=.t.
									SET PRINTER TO NAME (lcPrinter2)
								ENDIF 
							ENDIF 
						ENDIF 
						
						llseimprimio=0
						CREATE CURSOR c_memo (bultos m)
						SELECT c_impdetaTmp
						lnDecimalpre=CuantosDecimales(pcmasprecio)
						lnDecimaltot=CuantosDecimales(pcmastotal)

						lnTipoDetalle=1
						IF lnTipoDetalle=3		&&&& impresion agrupada
							
							SELECT t0.*,cc.*,(SELECT bultos FROM c_memo) as bultos FROM c_impdetaTmp t0 INNER JOIN ;
									(SELECT  MIN(iddoctod) as iddoctodg,SUM(cantiunimed) as cantidadG ,codagrupador as codagrupadorg,;
											MAX(agrupador) as agrupadorg,SUM(totaliva) as totalivag,SUM(totalventaconiva) as totalventaconivag,;
											SUM(totalventasiniva) as totalventasinivag,SUM(totalgravado) as totalgravadog,SUM(totalexento) as totalexentog,;
											SUM(totalnosujeto) as totalnosujetog,SUM(venta_bruta_siniva) as venta_bruta_sinivaG,;
											SUM(venta_bruta_coniva) as venta_bruta_conivaG,SUM(total_descuento_siniva) as total_descuento_sinivaG,;
											SUM(total_descuento_coniva) as total_descuento_conivaG," " as ordenAgrupador  ;
										FROM c_impdetaTmp ORDER BY codagrupador,factor GROUP BY codagrupador,factor) as cc on t0.iddoctod=cc.iddoctodg ;
								INTO CURSOR c_impdeta READWRITE ORDER BY t0.codprod,t0.iddocto
							GO TOP IN c_imp
							lntipoprod=c_imp.idtipodocto
							lniddoc=iddocto
							IF !EMPTY(NVL(pcproductosfijos,"")) 
								IF INLIST(c_imp.idtipodocto,&pcproductosfijos)
									INSERT INTO c_impdeta (iddocto,codagrupadorg,agrupadorg) SELECT lniddoc,cod,nombre FROM siscata WHERE origen="AGR" AND COD NOT IN (SELECT CODAGRUPADORG FROM c_impdeta)
									REPLACE ordenAgrupador WITH "1" all IN  c_impdeta
									UPDATE c_impdeta  SET ordenagrupador="" WHERE codagrupadorg in (SELECT cod FROM siscata WHERE origen="AGR" AND status=1)
									REPLACE agrupador WITH "" FOR EMPTY(ordenagrupador) IN c_impdeta
									GO TOP IN c_impdeta
									INDEX ON STR(iddocto)+ordenAgrupador+codagrupadorg TAG llave
									*REPLACE agrupadorg WITH "",producto WITH "",agrupador WITH "" FOR EMPTY(ordenAgrupador)
									SET ORDER TO llave
								ENDIF 
							ENDIF 
						ELSE
							IF lnTipoDetalle=4	&&&& impresion por Bulto
								SELECT t0.*,cc.*,(SELECT bultos FROM c_memo) as bultos FROM c_impdetaTmp t0 INNER JOIN ;
										(SELECT  MIN(a.iddoctod) as iddoctodg,SUM(a.cantiunimed) as cantidadG ,MIN(a.codprod) as codagrupadorg,;
												MAX(a.producto) as agrupadorg,SUM(a.totaliva) as totalivag,SUM(a.totalventaconiva) as totalventaconivag,;
												SUM(a.totalventasiniva) as totalventasinivag,SUM(a.totalgravado) as totalgravadog,SUM(a.totalexento) as totalexentog,;
												SUM(a.totalnosujeto) as totalnosujetog,SUM(venta_bruta_siniva) as venta_bruta_sinivaG,;
											SUM(venta_bruta_coniva) as venta_bruta_conivaG,SUM(total_descuento_siniva) as total_descuento_sinivaG,;
											SUM(total_descuento_coniva) as total_descuento_conivaG ;
											FROM c_impdetaTmp a ORDER BY a.idproducto,a.factor GROUP BY a.idproducto,a.factor) as cc on t0.iddoctod=cc.iddoctodg ;
									INTO CURSOR c_impdeta READWRITE ORDER BY t0.codprod
								SELECT codprod,cantiunimed FROM c_impdetaTmp ORDER BY codprod INTO CURSOR c_bultostmp
								SELECT c_bultostmp
								lccodigo='***'
								lcbulto=''
								lccomabulto=', '
								lncuentabul=1
								lnCuentaBultos=0
								SCAN 
									lnCuentaBultos=lnCuentaBultos+1
									IF lccodigo==codprod
										lncuentabul=lncuentabul+1
										lcbulto=lcbulto+lccomabulto+" [B:"+ALLTRIM(STR(lnCuentaBultos))+"- "+ALLTRIM(STR(cantiunimed))+"]"
										
										UPDATE c_impdeta SET bultos='(Bultos: '+ALLTRIM(STR(lncuentabul,12,0))+') '+lcbulto WHERE codprod==lccodigo
									ELSE
										lccodigo=codprod
										lncuentabul=1
										lcbulto=" [B:"+ALLTRIM(STR(lnCuentaBultos))+"- "+ALLTRIM(STR(cantiunimed))+"]"
										UPDATE c_impdeta SET bultos='(Bultos: '+ALLTRIM(STR(lncuentabul,12,0))+') '+lcbulto WHERE codprod==lccodigo
									ENDIF 
								ENDSCAN 
								USE IN c_bultostmp
								SELECT c_impdeta
							ELSE 
								SELECT t0.*,cc.*,(SELECT bultos FROM c_memo) as bultos FROM c_impdetaTmp t0 INNER JOIN ;
										(SELECT  iddoctod as iddoctodg,sum(cantiunimed) as cantidadG ,MAX(codprod) as codagrupadorg,;
												MAX(producto) as agrupadorg,SUM(totaliva) as totalivag,SUM(totalventaconiva) as totalventaconivag,;
												SUM(totalventasiniva) as totalventasinivag,SUM(totalgravado) as totalgravadog,SUM(totalexento) as totalexentog,;
												SUM(totalnosujeto) as totalnosujetog  ;
											FROM c_impdetaTmp ORDER BY iddocto,iddoctod GROUP BY iddocto,iddoctod) as cc on t0.iddoctod=cc.iddoctodg ;
									INTO CURSOR c_impdeta READWRITE ORDER BY t0.iddocto,t0.iddoctod
							ENDIF 
						ENDIF 
						*USE IN c_impdetaTmp
						USE IN c_memo
						SELECT c_imp
						INDEX on iddocto TAG iddocto
						SET ORDER TO iddocto 
						SELECT c_impdeta
						
						SET RELATION TO iddocto INTO c_imp
						lnTipoImpresion=3
						
						IF .t.
							DO case
								CASE lnTipoImpresion=1
										lnsn=MESSAGEBOX("Desea Ver el Documento ?",4+32+256,"Imprimir...")
										IF lnsn=6
											WAIT WINDOW 'Imprimiendo Documento... ' NOWAIT 
											lcPrintActual=SET("PRINTER", 3)
											_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)

											REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER PROMPT PREVIEW NOCONSOLE 
											llseimprimio=1
										ENDIF 
								CASE lnTipoImpresion=2
										lnsn=MESSAGEBOX("Desea Imprimir el Documento ?",4+32+256,"Imprimir...")
										IF lnsn=6
											WAIT WINDOW 'Imprimiendo Documento... ' NOWAIT 
											lcPrintActual=SET("PRINTER", 3)
											lcPrintActual2=SET("PRINTER", 3)
											_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)

											FOR iprin=1 TO lnCopiasPrint
												*lcPrintActual2=lcPrintActual
												REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER NOCONSOLE NAME lcPrintActual
												lcPrintActual=lcPrintActual2
											ENDFOR 
											llseimprimio=1
										ENDIF 
								CASE lnTipoImpresion=3
										lcPrintActual=SET("PRINTER", 3)
										lcPrintActual2=SET("PRINTER", 3)
										_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)

										REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER PREVIEW NOCONSOLE 
										*MODIFY REPORT pcSysDir+pcdb+"\formatos\&lcArchivo"  
										llseimprimio=1
								CASE lnTipoImpresion=4
										lcPrintActual=SET("PRINTER", 3)
										lcPrintActual2=SET("PRINTER", 3)
										_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)

										FOR iprin=1 TO lnCopiasPrint
											*lcPrintActual2=lcPrintActual
											REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER NOCONSOLE NAME lcPrintActual
											lcPrintActual=lcPrintActual2
										ENDFOR 
										llseimprimio=1
							ENDCASE
						ENDIF 
						
						GO TOP IN c_impdeta
						
						IF !EMPTY(lcPrinOld)
							SET PRINTER TO NAME (lcPrinOld)
						ENDIF 
						GO TOP IN c_imp
						
					ELSE 
					 MESSAGEBOX('No se encontro el Archivo del Formato de impresion..  '+lcArchivo,16,'Error al Imprimir...')
					ENDIF 
				ELSE
					MESSAGEBOX('No se Encontro el Formato de Impresion para este Documento....',16,'Error al Imprimir...')
				ENDIF 
			ELSE
				MESSAGEBOX('No se Encontro el Documento....',16,'Error al Imprimir...')
			ENDIF 
			*USE IN c_impdeta
			*USE IN c_impdetatmp
			*USE IN c_imp
		ELSE
			_MostrarErroresSQL(lnidSQL)
		ENDIF 
		*USE in c_imp
		IF USED("c_impdeta")
			*USE IN c_impdeta
		ENDIF 
		=miSQLDISCONNECT(lnidSQL)
	ELSE
		MESSAGEBOX("Imposible conectarse con el Servidor... Intente más tarde...",16,'Error de Conección...')
	ENDIF 
	USE IN impvta
	USE IN impvtad
	USE IN impcata
	USE IN imptdoc
	USE IN impser
	USE IN impcaj
	USE IN impprod
	USE IN impclippro
	USE IN cyvlecturas
	
	IF !EMPTY(lcAlias)
		SELECT (lcAlias)
	ENDIF 
ENDFUNC 

