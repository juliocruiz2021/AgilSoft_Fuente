			CASE lnTipoImpresor2=3
				lcRetornaPrn=pcprnreportes
			OTHERWISE 
				lcRetornaPrn=pcprnpdf
		ENDCASE 
	ENDIF 
	
	RETURN lcRetornaPrn
ENDFUNC 


