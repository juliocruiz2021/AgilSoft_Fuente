		USE pcSysDir+pcdb+"\siskardexapli" again IN 0
		SELECT siskardexapli
		llexiste=.f.
		LOCATE FOR INlist (iddoctoaplicar,980000048,  980000170,  980000176,  980000209)
		llexiste=!EOF()
		
		USE IN siskardexapli
		
		IF llexiste	
			lnlisto=FOPEN(pcSysDir+pcdb+"\siskardexdoc.dbf",1)
			
			IF lnlisto>0		
				FCLOSE(lnlisto)
				WAIT WINDOW 'Validando CXP Dup...' NOWAIT 
				USE pcSysDir+pcdb+"\siskardexdoc" EXCLUSIVE IN 0
				USE pcSysDir+pcdb+"\cyvcuentasxcp" IN 0 SHARED AGAIN 
				USE pcSysDir+pcdb+"\siskardexapli" EXCLUSIVE IN 0
				
				SELECT siskardexdoc
				DELETE from siskardexdoc WHERE siskardexdoc.origen='CXP' AND siskardexdoc.idtipodocto=110057980 AND siskardexdoc.IDDOCTO NOT IN (select cyvcuentasxcp.iddocto from cyvcuentasxcp)
				PACK 
				
				SELECT siskardexapli
				REPLACE iddoctoaplicar WITH  iddoctoaplicar-979020000 FOR INlist (iddoctoaplicar,980000048,  980000170,  980000176,  980000209)
				PACK 
				
				USE IN siskardexdoc
				USE IN cyvcuentasxcp			
				USE IN siskardexapli
				
				WAIT CLEAR 
				_recalcularSaldosCXC()
			ENDIF
			
		ENDIF 
		
		IF !EMPTY(lcaliasvalida)
			IF USED(lcaliasvalida)
				SELECT (lcaliasvalida)
			ENDIF 
		ENDIF  
	ENDIF 
	RETURN .t.
ENDFUNC 



FUNCTION ValidarCorregirFechaAplica()
	IF pntipoconeccion=1 
		WAIT WINDOW 'Validando Fechas de Aplicacion ' NOWAIT 
		lcaliasvalida=ALIAS()
		USE pcSysDir+pcdb+"\siskardexapli" again IN 0 ALIAS cc1
		USE pcSysDir+pcdb+"\cybmovimientos" AGAIN IN 0 ORDER iddocto  ALIAS cc2 
		USE pcSysDir+pcdb+"\cyvventas" AGAIN IN 0 ORDER iddocto  ALIAS cc3
		USE pcSysDir+pcdb+"\cyvcompras" AGAIN IN 0 ORDER iddocto  ALIAS cc4
		USE pcSysDir+pcdb+"\cyvcuentasxcp" AGAIN IN 0 ORDER iddocto  ALIAS cc5
		lncuentareg=0
		
		UPDATE cc1 ;
			SET fechaaplicar = cc2.fechadocto ;
			from cc2 WHERE cc1.iddocto = cc2.iddocto AND cc1.fechaaplicar<>cc2.fechadocto AND  cc2.status=1
		lncuentareg=lncuentareg+_tally
		
		WAIT WINDOW 'Validando Aplicaciones de Caja y Bancos' NOWAIT 
		UPDATE cc1 ;
			SET status = cc2.status ;
			from cc2 WHERE cc1.iddocto = cc2.iddocto AND cc2.status<>cc1.status AND cc2.status=0
		lncuentareg=lncuentareg+_tally
		UPDATE cc1 ;
			SET status = cc2.status ;
			from cc2 WHERE cc1.iddoctoaplicar = cc2.iddocto AND cc2.status<>cc1.status AND cc2.status=0
		lncuentareg=lncuentareg+_tally
		
		
		WAIT WINDOW 'Validando Aplicaciones Ventras' NOWAIT 
		UPDATE cc1 ;
			SET status = cc3.status ;
			from cc3 WHERE cc1.iddoctoaplicar = cc3.iddocto AND cc3.status<>cc1.status AND cc3.status=0
		lncuentareg=lncuentareg+_tally
		DELETE From cc3 WHERE iddocto=0

		WAIT WINDOW 'Validando Aplicaciones compras' NOWAIT 
		UPDATE cc1 ;
			SET status = cc4.status ;
			from cc4 WHERE cc1.iddoctoaplicar = cc4.iddocto AND cc4.status<>cc1.status AND cc4.status=0
		lncuentareg=lncuentareg+_tally
		
		
		WAIT WINDOW 'Validando Aplicaciones CXCP' NOWAIT 
		UPDATE cc1 ;
			SET status = cc5.status ;
			from cc5 WHERE cc1.iddoctoaplicar = cc5.iddocto AND cc5.status<>cc1.status AND cc5.status=0
		lncuentareg=lncuentareg+_tally
		UPDATE cc1 ;
			SET status = cc5.status ;
			from cc5 WHERE cc1.iddocto = cc5.iddocto AND cc5.status<>cc1.status AND cc5.status=0
		lncuentareg=lncuentareg+_tally
		
		USE IN cc1
		USE IN cc2
		USE IN cc3
		USE IN cc4
		USE IN cc5
		
		IF lncuentareg<>0
			_recalcularSaldosCXC()
		ENDIF 
		
		IF !EMPTY(lcaliasvalida)
			SELECT (lcaliasvalida)
		ENDIF 
	ENDIF 
	WAIT CLEAR 
	RETURN .t.
ENDFUNC 



