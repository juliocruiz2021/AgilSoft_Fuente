FUNCTION _ObtenerFiltroValores(lcmicampofiltro,lcMifiltroVal)
	lcFiltroValorEncontrado=''
	lcSimbolos="..  >   >=  <   <=  <>  "
	TRY 
		DO case
			CASE AT("..",lcMifiltroVal)>0
	*			lcFiltroValorEncontrado=lcmicampofiltro+" between "+SUBSTR(lcMifiltroVal,1,AT("..",lcMifiltroVal)-1)+" and "+SUBSTR(lcMifiltroVal,AT("..",lcMifiltroVal)+2,LEN(lcMifiltroVal))+" "
				lcFiltroValorEncontrado=" BETWEEN("+lcmicampofiltro+","+SUBSTR(lcMifiltroVal,1,AT("..",lcMifiltroVal)-1)+","+SUBSTR(lcMifiltroVal,AT("..",lcMifiltroVal)+2,LEN(lcMifiltroVal))+") "
				IF RIGHT(lcFiltroValorEncontrado,3)=",) "
					lcFiltroValorEncontrado=STRTRAN(lcFiltroValorEncontrado,",) ",",0) ")
				ENDIF
			CASE AT("<>",lcMifiltroVal)>0
				lcFiltroValorEncontrado=lcmicampofiltro+" <>"+SUBSTR(lcMifiltroVal,AT("<>",lcMifiltroVal)+2,LEN(lcMifiltroVal))+" "
				IF RIGHT(lcFiltroValorEncontrado,3)="<> "
					lcFiltroValorEncontrado=lcFiltroValorEncontrado+"0 "
				ENDIF 
			CASE AT(">=",lcMifiltroVal)>0
				lcFiltroValorEncontrado=lcmicampofiltro+" >="+SUBSTR(lcMifiltroVal,AT(">=",lcMifiltroVal)+2,LEN(lcMifiltroVal))+" "
				IF RIGHT(lcFiltroValorEncontrado,3)=">= "
					lcFiltroValorEncontrado=lcFiltroValorEncontrado+"0 "
				ENDIF 
			CASE AT("<=",lcMifiltroVal)>0
				lcFiltroValorEncontrado=lcmicampofiltro+" <="+SUBSTR(lcMifiltroVal,AT("<=",lcMifiltroVal)+2,LEN(lcMifiltroVal))+" "
				IF RIGHT(lcFiltroValorEncontrado,3)="<= "
					lcFiltroValorEncontrado=lcFiltroValorEncontrado+"0 "
				ENDIF 
			CASE AT(">",lcMifiltroVal)>0
				lcFiltroValorEncontrado=lcmicampofiltro+" >"+SUBSTR(lcMifiltroVal,AT(">",lcMifiltroVal)+1,LEN(lcMifiltroVal))+" "
				IF RIGHT(lcFiltroValorEncontrado,2)="> "
					lcFiltroValorEncontrado=lcFiltroValorEncontrado+"0 "
				ENDIF 
			CASE AT("<",lcMifiltroVal)>0
				lcFiltroValorEncontrado=lcmicampofiltro+" <"+SUBSTR(lcMifiltroVal,AT("<",lcMifiltroVal)+1,LEN(lcMifiltroVal))+" "
				IF RIGHT(lcFiltroValorEncontrado,2)="< "
					lcFiltroValorEncontrado=lcFiltroValorEncontrado+"0 "
				ENDIF 
			OTHERWISE 
				lcFiltroValorEncontrado=lcmicampofiltro+" ="+lcMifiltroVal+" "
				IF RIGHT(lcFiltroValorEncontrado,2)="= "
					lcFiltroValorEncontrado=lcFiltroValorEncontrado+"0 "
				ENDIF 
		ENDCASE
		lcprueba=STRTRAN(lcFiltroValorEncontrado,lcmicampofiltro,"999")
	
		IF TYPE(lcprueba)="U"
			lcFiltroValorEncontrado=" .t. "
		ENDIF 
		
	CATCH 
		lcFiltroValorEncontrado=" .t. "
	ENDTRY
	
	RETURN lcFiltroValorEncontrado
ENDFUNC

FUNCTION _ObtenerFiltroFechas(lcmicampofiltro,lcMifiltroVal)
	lcMifiltroVal=ALLTRIM(STRTRAN(lcMifiltroVal,"/","-"))
	lcMifiltroVal=lcMifiltroVal
	lcFiltroValorEncontrado=''
	lcSimbolos="..  >   >=  <   <=  <>  "
	DO case
		CASE AT("..",lcMifiltroVal)>0
			lcFiltroValorEncontrado=lcmicampofiltro+" between '"+SUBSTR(lcMifiltroVal,1,AT("..",lcMifiltroVal)-1)+"' and '"+SUBSTR(lcMifiltroVal,AT("..",lcMifiltroVal)+2,LEN(lcMifiltroVal))+"' "
		CASE AT("<>",lcMifiltroVal)>0
			lcFiltroValorEncontrado=lcmicampofiltro+" <>'"+SUBSTR(lcMifiltroVal,AT("<>",lcMifiltroVal)+2,LEN(lcMifiltroVal))+"' "
		CASE AT(">=",lcMifiltroVal)>0
			lcFiltroValorEncontrado=lcmicampofiltro+" >='"+SUBSTR(lcMifiltroVal,AT(">=",lcMifiltroVal)+2,LEN(lcMifiltroVal))+"' "
		CASE AT("<=",lcMifiltroVal)>0
			lcFiltroValorEncontrado=lcmicampofiltro+" <='"+SUBSTR(lcMifiltroVal,AT("<=",lcMifiltroVal)+2,LEN(lcMifiltroVal))+"' "
		CASE AT(">",lcMifiltroVal)>0
			lcFiltroValorEncontrado=lcmicampofiltro+" >'"+SUBSTR(lcMifiltroVal,AT(">",lcMifiltroVal)+1,LEN(lcMifiltroVal))+"' "
		CASE AT("<",lcMifiltroVal)>0
			lcFiltroValorEncontrado=lcmicampofiltro+" <'"+SUBSTR(lcMifiltroVal,AT("<",lcMifiltroVal)+1,LEN(lcMifiltroVal))+"' "
		OTHERWISE 
			lcFiltroValorEncontrado=lcmicampofiltro+" ='"+lcMifiltroVal+"' "
	ENDCASE
	
	RETURN lcFiltroValorEncontrado
ENDFUNC



FUNCTION ObtenerPorcentajeImpuesto(lnConectPorImpto,lnIdPorcenimpuestoBus,lnMontoAplicar,ldFechaAplicar)
	lnRetorPorImpto=0
	ldFechaAplicar=IIF(EMPTY(ldFechaAplicar),DATE(),ldFechaAplicar)
	IF !USED("sisimptosporcen")
		USE pcsysdir+pcDB+"\sisimptosporcen" IN 0 SHARED AGAIN 
		llSeAbrioImpuestos=.t.
	ELSE
		llSeAbrioImpuestos=.f.
	ENDIF 
	
	IF lnIdPorcenimpuestoBus<>0
		lcfaliasPorImpto=ALIAS()

		IF lnConectPorImpto>0	&&&& Coneccion Establecida
			IF pnTipoConeccion<>2
				lcLimBusMay=" "
				lcTopBusMay=" top 1 "
			ELSE 
				lcLimBusMay=" limit 0,1 "
				lcTopBusMay=" "
			ENDIF 

			IF pnTipoConeccion=1
				lcFecFilBPor=" and BETWEEN(CTOD('"+DTOC(ldFechaAplicar)+"'),fecini,fecfin) "
			ELSE
				lcFecFilBPor=" and '"+_ConvertirToFechaSQL(ldFechaAplicar)+"' between  fecini and fecfin "
			ENDIF 

			lcComandoBuscarCta="SELECT "+lcTopBusMay+" porcentaje FROM sisimptosporcen where idimpuesto="+ALLTRIM(STR(lnIdPorcenimpuestoBus))+" "+;
											lcFecFilBPor+" and status=1 and "+ALLTRIM(STR(ABS(lnMontoAplicar),12,2))+"=>montoaplicar "+;
											lcLimBusMay+" order by idimpuesto "
			lnCtrlSqlCtaBus=miSQLEXEC(lnConectPorImpto,lcComandoBuscarCta,"c_BusPorImpuesto")

			IF _tally>0
				IF TYPE("c_BusPorImpuesto.porcentaje")="N"
					lnRetorPorImpto=c_BusPorImpuesto.porcentaje
				ELSE
					lnRetorPorImpto=VAL(c_BusPorImpuesto.porcentaje)
				ENDIF 
			ENDIF 
			USE IN c_BusPorImpuesto

		ENDIF 

		IF !EMPTY(lcfaliasPorImpto)
			SELECT (lcfaliasPorImpto)
		ENDIF 
	

	ENDIF 
	
	IF llSeAbrioImpuestos=.t.
		USE IN sisimptosporcen
	ENDIF 

	RETURN lnRetorPorImpto

ENDFUNC   






