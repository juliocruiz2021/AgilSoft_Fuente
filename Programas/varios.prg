**** Buscando Permisos del Usuario
FUNCTION _ValidaPermisoMenu(lnIdMod as Integer,lnIdUsr as Integer)
	LOCAL lcAliasPermiso,lcMensaje
	STORE ALIAS() TO lcAliasPermiso
	llAbriusuarios=.f.
	llAbriPermisos=.f.
	IF !USED('sisusuarios')
		USE pcsysdir+pcDB+"\sisusuarios" IN 0 SHARED AGAIN ORDER idusuario
		llAbriusuarios=.t.
	ENDIF 
	IF !USED('sispermisos')
		USE pcsysdir+pcDB+"\sispermisos" IN 0 SHARED AGAIN ORDER idpermiso
		llAbriPermisos=.t.
	ENDIF 
	
	WAIT WINDOW 'Validando permiso....' NOWAIT 
	***** Recuperando Registros
	lnIdSql=_conecta(pcDB)

	lcSqlComando='select a.permiso,b.status  '+;
						'from sispermisos a inner join sisusuarios b on a.idusuario=b.idusuario  '
	lcSqlWhere="a.idusuario="+ALLTRIM(STR(lnIdUsr))+" and a.idmodulo="+ALLTRIM(STR(lnIdMod))+" "
	lcSqlOrder=''

	IF lnIdSql>0
		lnCtrlSql=miSQLEXEC(lnIdSql,lcSqlComando+' where '+lcSqlWhere+' '+lcSqlOrder,'c_PermisosM')
		IF lnCtrlSql>0
			IF status==1
				IF permiso>=1
					lcMensaje=''
				ELSE 
					lcMensaje='Permiso Denegado...!'
				ENDIF 
			ELSE
				lcMensaje='El Usuario esta Suspendido ...!'
			ENDIF 
			USE IN c_PermisosM
		ELSE
			lcMensaje='El Usuario no Tinene Permiso...!'
		ENDIF 
		=miSQLDISCONNECT(lnIdSql)
	ENDIF 
	
	IF llAbriusuarios=.t.
		USE IN sisusuarios
	ENDIF 
	IF llAbriPermisos=.t.
		USE IN sispermisos
	ENDIF
	
	
	IF !EMPTY(lcAliasPermiso)
		SELECT (lcAliasPermiso)
	ENDIF 

	WAIT clear
	RETURN lcMensaje
ENDFUNC 

