        .Item("http://schemas.microsoft.com/cdo/configuration/sendpassword") = "Dte1203Car1203"
        .Update
    ENDWITH

    * Crear el mensaje
    loMessage = CREATEOBJECT("CDO.Message")
    loMessage.Configuration = loConfig

