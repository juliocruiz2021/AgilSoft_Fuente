FUNCTION QuitarTildes(tcTexto)
    LOCAL lcTexto, lcConTildes, lcSinTildes, lnLongitud, lnIndice, lcCaracter
    
    lcTexto = ALLTRIM(tcTexto) && Elimina espacios adicionales
    lcConTildes = "ÁÉÍÓÚáéíóúÑñÜü"
    lcSinTildes = "AEIOUaeiounnUu"
    
    lnLongitud = LEN(lcTexto)
    
    FOR lnIndice = 1 TO lnLongitud
        lcCaracter = SUBSTR(lcTexto, lnIndice, 1)
        lnPos = AT(lcCaracter, lcConTildes)
        IF lnPos > 0
            lcCaracter = SUBSTR(lcSinTildes, lnPos, 1)
            lcTexto = STUFF(lcTexto, lnIndice, 1, lcCaracter)
        ENDIF
    NEXT
    
    RETURN lcTexto
ENDFUNC


