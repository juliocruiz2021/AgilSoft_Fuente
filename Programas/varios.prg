FUNCTION BodegaPrincipal(lnIdConec,lnidSucursal)
	lnIdSqlCtaElimi=lnIdConec
	lcidsuc=ALLTRIM(STR(lnidSucursal))
	IF lnIdSqlCtaElimi>0
		lcfaliasCtaBus=ALIAS()
		IF lnIdSqlCtaElimi>0	&&&& Coneccion Establecida
			lcComandoBuscarCta="select min(a.idbodega) as idbodega from bodegas a where a.idsucursal="+;
						+lcidsuc+" limit 0,1;"
			lnCtrlSqlCtaBus=miSQLEXEC(lnIdSqlCtaElimi,lcComandoBuscarCta,"c_BodegaPrincipal")
			IF lnCtrlSqlCtaBus>0
				IF TYPE("c_BodegaPrincipal.idbodega")="C"
					lnretornaIdBodega=VAL(c_BodegaPrincipal.idbodega)
				ELSE
					lnretornaIdBodega=c_BodegaPrincipal.idbodega
				ENDIF 
				USE IN c_BodegaPrincipal
			ELSE
				lnretornaIdBodega=0
			ENDIF 
		ENDIF 

		IF !EMPTY(lcfaliasCtaBus)
			SELECT (lcfaliasCtaBus)
		ENDIF 
	ENDIF 
		RETURN lnretornaIdBodega
ENDFUNC 


FUNCTION ValidarCredito(lnIdConec,lnIdSocionegocio,lnTotalDoc)
	lnIdSqlValCre=lnIdConec
	lcidsocio=ALLTRIM(STR(lnIdSocionegocio))
	lcRetornamensaje=""

	lcfaliasCtaBus=ALIAS()
	IF lnIdSqlValCre>0	&&&& Coneccion Establecida
		lcComandoBuscarCta="select a.limitecredito-a.saldo as saldo,count(cuenta.id) total "+;
					 		"from  (SELECT b.idcuentacobrar as id,b.fechavencimiento "+;
					 					"FROM cuentascobrar b where b.idsocionegocio='"+lcidsocio+"' "+;
					 				"union all "+;
					 				"select c.idcuentapagar as id,c.fechavencimiento "+;
					 			 	"FROM cuentaspagar c where c.idsocionegocio='"+lcidsocio+"' ) as cuenta "+;
			 				 "inner join socionegocios a  "+;
			 				 "where cuenta.fechavencimiento<now() and a.idsocionegocio='"+lcidsocio+"' limit 0,1;"
		lnCtrlSqlBusCre=miSQLEXEC(lnIdSqlValCre,lcComandoBuscarCta,"c_CursorValidaCredito")
		IF lnCtrlSqlBusCre>0
			IF TYPE("c_CursorValidaCredito.total")="C"
				lnTotalVenci=VAL(c_CursorValidaCredito.total)
			ELSE
				lnTotalVenci=c_CursorValidaCredito.total
			ENDIF 
			
			IF lnTotalVenci<>0
				lcRetornamensaje="Existen documentos Vencidos !"
			ENDIF 

****c_CursorValidaCredito.saldo<lnTotalDoc AND pnSincronizandoTablas=.f.
			IF c_CursorValidaCredito.saldo<lnTotalDoc 
				lcRetornamensaje=lcRetornamensaje+CHR(13)+"Limite de Credito Superado !"+CHR(13)
			ENDIF 
			
			USE IN c_CursorValidaCredito
		
		ENDIF 
	ENDIF 

	IF !EMPTY(lcfaliasCtaBus)
		SELECT (lcfaliasCtaBus)
	ENDIF 
	RETURN lcRetornamensaje
ENDFUNC 


FUNCTION _NombreCortoBanco(lcNomBanco)
	LOCAL lcNomCorto
	lcNomCorto=SUBSTR(lcNomBanco,1,3)
	lnATini=AT(' ',lcNomBanco,1)
	IF lnATini>0
		lcNomCorto=lcNomCorto+ALLTRIM(SUBSTR(lcNomBanco,lnATini+1,3))
	ENDIF 
	lnATini=AT(' ',lcNomBanco,2)
	IF lnATini>0
		lcNomCorto=lcNomCorto+ALLTRIM(SUBSTR(lcNomBanco,lnATini+1,3))
	ENDIF 
	RETURN UPPER(lcNomCorto)
ENDFUNC 


FUNCTION ObtenerAutorizacion(lnIdConec,lcusuario,lcclave,lnidsucursal)
	lnIdSqlCtaElimi=lnIdConec
	pnIdAuto=0
	IF lnIdSqlCtaElimi>0
		lcfaliasCtaBus=ALIAS()
		IF lnIdSqlCtaElimi>0	&&&& Coneccion Establecida
			lcComandoBuscarCta="select count(*) as cuenta,a.idusuario,a.nombre,a.creditoautorizado,a.descuentoautorizado "+; 
									"FROM usuarios a where usuario='"+lcusuario+"' and a.clave='"+LOWER(STRCONV(Hash(lcclave,1), 15))+"' "+;
									"and  a.status=1 and (a.idsucursal=0 or a.idsucursal="+ALLTRIM(STR(lnidsucursal))+") "+;
									" limit 0,1;"

			lnCtrlSqlCtaBus=miSQLEXEC(lnIdSqlCtaElimi,lcComandoBuscarCta,"c_BuscarAutorizacion")
			IF lnCtrlSqlCtaBus>0
				IF VAL(c_BuscarAutorizacion.cuenta)<>0
					pcNomAuto=c_BuscarAutorizacion.nombre
					pnCredAuto=c_BuscarAutorizacion.creditoautorizado
					pnDescuAuto=c_BuscarAutorizacion.descuentoautorizado
					pnIdAuto=c_BuscarAutorizacion.idusuario
				ENDIF 
				USE IN c_BuscarAutorizacion
			ENDIF 
		ENDIF 

		IF !EMPTY(lcfaliasCtaBus)
			SELECT (lcfaliasCtaBus)
		ENDIF 
	ENDIF 
	RETURN pnIdAuto
ENDFUNC 




