*!*					UPDATE cyvcomprasdeta SET fecmod=a.fecmod from ccfaltan a WHERE cyvcomprasdeta.iddoctod=a.iddoctod
*!*				ENDIF
*!*				SELECT b.iddoctod,ldfecmodifjr as fecmod  FROM siskardex a INNER JOIN cyvcomprasdeta b ON a.iddoctod=b.iddoctod AND b.status=1 ;
