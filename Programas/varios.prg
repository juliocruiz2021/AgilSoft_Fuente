FUNCTION _SincronizaSistemaSAP(lcmoduloacargar as Integer)

		***********************************
		******* Sucursal (punto de venta en disalcomb)
	IF lcmoduloacargar=1
		lnConid=_conectaSAP()
		IF lnConid>0
			WAIT WINDOW "Sincronizando SUCURSALES ..." NOWAIT 
			lnCtrlSap=SQLEXEC(lnConid,"SELECT * from UFD1 where tableid='OINV' and fieldid=12 order by Fldvalue",'t_PVT')
			USE pcsysdir+pcDB+"\siscata" IN 0 SHARED AGAIN  

			SELECT 000000000 as id,Fldvalue as pvt_codigo,Descr as pvt_descripcion FROM t_PVT ;
					WHERE Fldvalue NOT in ;
						(SELECT cod FROM siscata WHERE origen='SUC' ) ;
			UNION ALL ;
				SELECT 000000001 as id,Fldvalue as pvt_codigo,Descr as pvt_descripcion FROM t_PVT ;
					WHERE Fldvalue in ;
						(SELECT cod FROM siscata WHERE origen='SUC' ) ;
			INTO CURSOR c_PVT READWRITE 
			REPLACE id WITH _SiguienteIdTabla(pcNodo,"MAS") FOR id=0  
			
			UPDATE siscata SET siscata.nombre=c_PVT.pvt_descripcion ,;
								siscata.fecmod=ldfec, ;
								siscata.nodo=pcnodo, ;
								siscata.iduser=pnIdUsuario, ;
								siscata.pcuser=SYS(0) ;
				from c_PVT WHERE siscata.cod=c_PVT.pvt_codigo AND siscata.origen='SUC' 
			
			INSERT INTO siscata (id,origen,cod,nombre,tipo,eliminado,status,fecalta,fecmod,nodo,iduser,pcuser) ;
				SELECT id,'SUC',pvt_codigo,pvt_descripcion,0,0,1,ldfec,ldfec,;
					pcnodo,pnIdUsuario,SYS(0) ;
				FROM c_PVT WHERE id<>1 
			
			USE IN c_PVT
			USE IN siscata
			USE IN t_PVT
			
			SQLDISCONNECT(lnCtrlSap)
		ELSE
			WAIT WINDOW 'Imposible conectarse a la base de datos de SAP'	
		ENDIF 
	ENDIF 
	
	
	***********************************
	******* Series (sereis de usuario)
	IF lcmoduloacargar=2
		lnConid=_conectaSAP()
		IF lnConid>0
			
			WAIT WINDOW "Sincronizando SERIES DE DOCUMENTOS ..." NOWAIT 
			lnCtrlSap=SQLEXEC(lnConid,'SELECT * from [@SERIES] ','t_SER')
			
			USE pcsysdir+pcDB+"\sisseries" IN 0 SHARED AGAIN 

			SELECT 0000000000 as id,ALLTRIM(U_tipodocumento)+'_'+ALLTRIM(u_sucursal) as tdc_codigo,;
				ALLTRIM(U_tipodocumento)+'_'+ALLTRIM(u_sucursal) as tdc_descripcion,;
				U_ninic as inicial,U_nfinal as final,U_nsiguiente as siguiente,;
				U_tipodocumento as tipo,'VTA' AS ORIGEN,1 as ctrl FROM t_SER ;
					WHERE ALLTRIM(U_tipodocumento)+'_'+ALLTRIM(u_sucursal) NOT in ;
						(SELECT codser  FROM sisseries WHERE origen='VTA');
			INTO CURSOR c_SER READWRITE 
			
			REPLACE id WITH _SiguienteIdTabla(pcNodo,"MAS") FOR id=0  

			
			INSERT INTO sisseries (idserie,codser,serie,inicial,final,;
						siguiente,digitos,automatica,prefijo,origen,eliminado,;
							status,fecalta,fecmod,nodo,iduser,pcuser) ;
				SELECT id,tdc_codigo,tdc_descripcion,inicial,final,;
						siguiente,8,1,tipo,ORIGEN,0,1,ldfec,ldfec,;
					pcnodo,pnIdUsuario,SYS(0) ;
				FROM c_SER WHERE ctrl=1
			
			USE IN c_SER
			USE IN sisseries
			USE IN t_SER	
			SQLDISCONNECT(lnCtrlSap)
		ELSE
			WAIT WINDOW 'Imposible conectarse a la base de datos de SAP'	
		ENDIF
	ENDIF 
	
	
	***********************************
	******* Bodegas 
	IF lcmoduloacargar=3
		lnConid=_conectaSAP()
		IF lnConid>0
			WAIT WINDOW "Sincronizando BODEGAS ..." NOWAIT 
			lnCtrlSap=SQLEXEC(lnConid,'SELECT * from OWHS','t_BOD')
			
			USE pcsysdir+pcDB+"\siscata" IN 0 SHARED AGAIN 
		
