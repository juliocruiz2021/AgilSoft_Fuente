	oRespuestaApi.titulo='Mensaje del Sistema'
	oRespuestaApi.botones=64		&&&& informacion (ok)
	oRespuestaApi.milisegundos=2000
	RETURN oRespuestaApi
ENDFUNC 


FUNCTION ObtenerTokenApiGano()
	WAIT WINDOW "Obteniendo Tocken para Api Gano ...." NOWAIT 
	LOCAL xhrgano,lcJsonEnvio,lcResultTextGano,oJsonTokenGano,loRetornoApi
	pcTokenApiGano=''

	oJsonTokenGano = CREATEOBJECT("json2")
	loRetornoApi=_RespuestaApi()
			
	IF !EMPTY(pcPTVDISALRUTA) AND pcPTVDisalcomb ='GANO'
		***** creando json para envio de correo y contraseña
		lcJsonEnvio='{'+;
						'"email":"'+pcPTVDISALUSER+'",'+;
						'"password":"'+pcPTVDISALPASS+'" '+;
					'}'
		
		****** creando objeto para consultar api web
		xhrgano = CREATEOBJECT("Microsoft.XMLHTTP")
		xhrgano.Open("POST", pcPTVDISALRUTA+'login', .f.)		&&& suta endpoint
		***** cabecera
		xhrgano.setRequestHeader('Content-Type', 'application/json')
		xhrgano.setRequestHeader("Accept", 'application/json')
		xhrgano.setRequestHeader("Authorization", "Bearer " + pcPTVDisalEmpre)
		**** enviando consulta
		xhrgano.send(lcJsonEnvio)
		
		***** respuesta 
		lcResultTextGano = xhrgano.responseText

		****** parseando json
		obTokenGano=oJsonTokenGano.Parse(lcResultTextGano)
		loRetornoApi.status='error'
		loRetornoApi.botones=16
		loRetornoApi.respuesta=''
		IF xhrgano.status=200	&&& login Exitoso
			IF TYPE("obTokenGano.access_token")='C' 	&&& validando que se obtuvo un token
				loRetornoApi.status='ok'
				loRetornoApi.respuesta=obTokenGano.access_token	&&& almacenando token en variable publica
				loRetornoApi.mensaje='Token valido...'
			ELSE
				loRetornoApi.status='error'
				loRetornoApi.status=16
				loRetornoApi.milisegundos=2000
				loRetornoApi.respuesta=''
				loRetornoApi.titulo="Error al Obtener Token"
				loRetornoApi.mensaje=obTokenGano.message
			ENDIF 
			
*!*				IF TYPE("obTokenGano.status")='C' 
*!*					IF UPPER(NVL(obTokenGano.status,''))='OK'
*!*						pcTokenApiGano=obTokenGano.body.token
*!*					ELSE
*!*						MESSAGEBOX(lcResultTextGano,64,'Error al Obtener Token',2000)
*!*					ENDIF 
*!*				ELSE
*!*					MESSAGEBOX(obTokenGano.message,64,"Error al Obtener Token",2000) 
*!*				ENDIF 
		ELSE 	&&&& Error en el Login
			
			IF xhrgano.status=401
				loRetornoApi.milisegundos=2000
				loRetornoApi.titulo='Usuario sin Autorización... '
				loRetornoApi.mensaje=lcResultTextGano
			ELSE
				loRetornoApi.milisegundos=3000
				loRetornoApi.titulo='Error al Obtener Token, Contacte al Administrador ... '
				loRetornoApi.mensaje=lcResultTextGano
			ENDIF 
		ENDIF 
		RELEASE xhrgano,lcJsonEnvio,oJsonTokenGano,lcResultTextGano,obTokenGano

	ENDIF 

	WAIT CLEAR 
	
	RETURN loRetornoApi
ENDFUNC 





FUNCTION _ObtenerMontoMora(lnidclipromora,lniddocmora,ldFecDocMora)
	lcaliasmora=ALIAS()
	
	 					
	IF !USED("siskardexdoc")
		USE pcSysDir+pcdb+"\siskardexdoc" SHARED AGAIN IN 0 order iddocto
		lnAbriokar=1 
	ELSE
		lnAbriokar=0
	ENDIF 
	IF !USED("invProductos")
		USE pcSysDir+pcdb+"\invProductos" SHARED AGAIN IN 0 order codprod
		lnAbrioInv=1 
	ELSE
		lnAbrioInv=0
	ENDIF 
	
	IF !USED("cyvventasDeta")
		USE pcSysDir+pcdb+"\cyvventasDeta" SHARED AGAIN IN 0 order iddocto
		lnAbrioVta=1 
	ELSE
		lnAbrioVta=0
	ENDIF 

	***** recuperando monto mora de doc. del cliente menor o igual a la factura actual y diferentes del doc. actual
	SELECT SUM(b.totalgravado+b.totalexento+b.totalnosujeto) as mora ;
			FROM siskardexdoc a ;
				INNER JOIN cyvventasdeta b ON a.iddocto=b.iddocto  and a.fechadocto<=ldFecDocMora and a.iddocto<>lniddocmora ;
				INNER JOIN invproductos c ON b.idproducto=c.idproducto AND c.codprod='MORA ' ;
				WHERE  (a.totaldocto-a.rentadocto+a.cargoabono)<>0 AND ;
							a.eliminado=0 AND a.fechadocto<ldFecDocMora AND a.status=1 AND a.condipago=1 and a.ctrolcxcp=1 and ;
							a.idclipro=lnidclipromora AND b.eliminado=0 ;
				INTO CURSOR c_CMora READWRITE
	
	lnvalmoraretorno=NVL(c_CMora.mora,0)
	
	USE IN c_CMora

	IF lnAbriokar=1
		USE IN siskardexdoc
	ENDIF 
	IF lnAbrioInv=1
		USE IN invProductos
	ENDIF 
	IF lnAbrioVta=1
		USE IN cyvVentasDeta
	ENDIF 
	
	IF !EMPTY(lcaliasmora)
		SELECT (lcaliasmora)
	ENDIF 
	RETURN lnvalmoraretorno
ENDFUNC 





****** funcino para saber el tipo de operacion de una venta
FUNCTION TipoOperacionVenta(lnTPTipoIva,pnTPStatus,lnTPVtaGra,lnTPVtaExe,lnTPVtaExc,lnTPVtaTer,lnTPRetRenta)
		lnRetornaTipoPagoIva=0
		
		IF  (lnTPVtaGra+lnTPVtaExe+lnTPVtaExc+lnTPVtaTer)=0 OR pnTPStatus<>1
			**** esta anulada***********************
			*** Exento,0,Gravado,1,No Sujeto,2,Tasa Cero,3
			IF lnTPTipoIva=0
				lnRetornaTipoPagoIva=1
			ELSE 
				DO case
					CASE lnTPTipoIva=0
						lnRetornaTipoPagoIva=2
					CASE lnTPTipoIva=1
						lnRetornaTipoPagoIva=1
					CASE lnTPTipoIva=2
						lnRetornaTipoPagoIva=3
					CASE lnTPTipoIva=3
						lnRetornaTipoPagoIva=12
					OTHERWISE 
						lnRetornaTipoPagoIva=13
				ENDCASE 
			ENDIF 
		ELSE
			**** no esta anulada
			DO case
				CASE (lnTPVtaGra+lnTPVtaExe+lnTPVtaExc)<>0	&&&& es venta normal
					lnConValores=0
					lnConValores=IIF(lnTPVtaGra<>0,1,0)+IIF(lnTPVtaExe<>0,1,0)+IIF(lnTPVtaExc<>0,1,0)
					IF lnConValores=1					&&& solo un valor
						DO case
							CASE lnTPVtaGra<>0
								lnRetornaTipoPagoIva=1
							CASE lnTPVtaExe<>0 
								lnRetornaTipoPagoIva=2
							CASE lnTPVtaExc<>0
								lnRetornaTipoPagoIva=3
						ENDCASE
					ELSE
														**** ex mixto mas de un valor
						lnRetornaTipoPagoIva=4
					ENDIF 
				
				CASE (lnTPVtaTer)<>0		&&& es venta terceros
					lnRetornaTipoPagoIva=4
			
			ENDCASE 
		
		ENDIF 

	RETURN lnRetornaTipoPagoIva
ENDFUNC 




FUNCTION TieneImpresoraLX(lcminombuscar)
