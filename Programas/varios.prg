FUNCTION ReImprimirAhorros(lnIdReg,lnLinImp)
	LOCAL lcAlias,lnidSQL,lcRegMin
	lnidSQL=0
	lcRegMin="0"
	lcAlias=ALIAS()
	lnidSQL=_conecta(pcDB)

	IF lnidSQL>0
		lcComando="SELECT Max(idahorro) as regmax FROM fin_ahorros where idcuentaahorro="+ALLTRIM(STR(lnIdReg))+" and linea="+ALLTRIM(STR(lnLinImp))+";"
		lnCtrlSql=miSQLEXEC(lnidSQL,lcComando,'c_reporte_max')

		IF lnCtrlSql>0
			lcRegMin=ALLTRIM(STR(c_reporte_max.regmax))
			USE IN c_reporte_max
		ENDIF 
		IF VAL(lcRegMin)>0
			lcComando0="set @RNUM =0;"
			lcComando1="select d.*,@RNUM := @RNUM+d.saldotmp as saldo,g.clave from (select b.idconcepto,b.linea,b.idahorro,f.numcuentaahorro,b.codsocionegocio,b.socionegocio,b.dui,b.fecha,b.depositos,b.retiros,b.inicial+b.depositos-b.retiros as saldotmp "
			lcComando2="from (select a.idconcepto,a.linea,a.idcajero,a.idahorro,saldos.*,a.fecha,case when a.sumaresta=1 then a.monto else 0 end as depositos,case when a.sumaresta=2 then a.monto else 0 end as retiros from (select y.idsocionegocio,"
			lcComando3="z.idcuentaahorro,z.numcuentaahorro,y.codsocionegocio,y.socionegocio,y.dui,z.saldo-(select sum(case when sumaresta=1 then monto else  -monto end) as movimi from fin_ahorros where idcuentaahorro="+ALLTRIM(STR(lnIdReg))+"  and impreso=0) as inicial "
			lcComando4="from fin_cuentaahorros z inner join adm_socionegocios y on z.idsocionegocio=y.idsocionegocio and z.idcuentaahorro="+ALLTRIM(STR(lnIdReg))+") as saldos inner join fin_ahorros a on saldos.idcuentaahorro=a.idcuentaahorro where a.impreso=0 "
			lcComando5="order by a.linea) as b  inner join fin_cuentaahorros f on b.idcuentaahorro=f.idcuentaahorro inner join adm_socionegocios c on f.idsocionegocio=c.idsocionegocio order by b.linea) as d inner join fin_conceptos g on d.idconcepto=g.idconcepto;"

			lnCtrlSql=miSQLEXEC(lnidSQL,lcComando0)
			lnCtrlSql=miSQLEXEC(lnidSQL,lcComando1+lcComando2+lcComando3+lcComando4+lcComando5,'c_reporte')

			IF lnCtrlSql>0
				if !EOF()
					WAIT WINDOW "Imprimiendo...." NOWAIT 
					SELECT c_reporte
					GO top
					IF linea<>1
						lnRellena=linea-1
					ELSE
						lnRellena=0
					ENDIF 
					FOR i=1 TO lnRellena
						APPEND BLANK IN c_reporte
					ENDFOR 
					INDEX on idahorro TAG llave
					SET ORDER TO llave
					GO top
					
					STORE SET("Printer",3) TO lcPrinOld
	*				IF !EMPTY(lcImpresorBoucher)
	*					lcPrinter1=ALLTRIM(lcImpresorBoucher)
	*				ELSE
						lcPrinter1=lcPrinOld
	*				ENDIF 
			
					SET PRINTER TO NAME (lcPrinter1)
					
					REPORT FORM (pcSysDir+pcdb+"\formatos\libreta_ahorro1.frx") NOCONSOLE TO PRINTER 
	*				REPORT FORM (pcSysDir+pcdb+"\formatos\libreta_ahorro1.frx") NOCONSOLE TO PRINTER PROMPT PREVIEW 

					SET PRINTER  TO NAME (lcPrinOld)
					
					sn=MESSAGEBOX("Se imprimieron corectamente los registros...? ",32+256+4,"Mensaje del Sistema")
					IF sn=6
						lnCtrlSql=miSQLEXEC(lnidSQL,"update fin_ahorros set impreso=1 where idcuentaahorro="+ALLTRIM(STR(lnIdReg))+";")
						IF lnCtrlSql<=0
							_MostrarErroresSQL(lnidSQL)
						ENDIF 
					ENDIF 

				ELSE
					WAIT WINDOW "No hay Movimientos Pendientes de Imprimir..."
				ENDIF 
				USE IN c_reporte
			ELSE
				_MostrarErroresSQL(lnidSQL)
			ENDIF 
		ELSE
			MESSAGEBOX("El numero de la Linea no es Correcta ",16,'Mensaje de Error...')
		ENDIF 
		=miSQLDISCONNECT(lnidSQL)
	ELSE
		MESSAGEBOX("Imposible conectarse con el Servidor... Intente más tarde...",16,'Error de Conección...')
	ENDIF 
	IF !EMPTY(lcAlias)
		SELECT (lcAlias)
	ENDIF 
ENDFUNC 



