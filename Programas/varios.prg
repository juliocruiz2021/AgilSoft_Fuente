FUNCTION _mitarifa(lnidtari,lnconsu)
	lcAliastari=ALIAS()
	IF lnconsu<0
		lnconsu=0
	ENDIF 
	IF lnidtari<>0
		USE pcSysDir+pcDB+"\cyvtarifasdeta" IN 0 ALIAS c_mitari SHARED AGAIN 
		SELECT fijo+IIF(lnconsu>apartir,(lnconsu-apartir)*tarifa,000000000.00) as mivalor ;
			from c_mitari WHERE BETWEEN(lnconsu,consumoini,consumofin)  AND status=1 AND idtarifa=lnidtari ;
			INTO ARRAY mivalor
		
		lnmivalcon=NVL(mivalor,0.00)
		
		USE IN c_mitari
		IF !EMPTY(lcAliastari)
			SELECT (lcAliastari)
		ENDIF 
	ELSE
		lnmivalcon=0
	ENDIF 
	RETURN lnmivalcon
ENDFUNC 


FUNCTION _miMora(lnidtari)
