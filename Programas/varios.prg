									"where "+IIF(!EMPTY(lcTipoProdFil),lcTipoProdFil+" and ","")+" t0.status=1 and t0.eliminado<>1 and t1.codprod4='"+lcCodProBus+"') as t0 " 
			lnCtrlSqlCtaBus=miSQLEXEC(lnIdSqlCtaBuscar,lcComandoBuscarCta,"c_BuscaProd_tmp")
 
			IF lnCtrlSqlCtaBus>0
				lcidCtaBus=c_BuscaProd_tmp.idproducto
			ENDIF 
			
			IF pnUsarProdMemo=1
				USE pcSysDir+pcdb+'\invProductosMemo' SHARED AGAIN ALIAS c_not IN 0
				SELECT a.*,b.Descripcion as DescripcionNota FROM c_BuscaProd_tmp a LEFT JOIN c_not b ON a.idproducto=b.idproducto INTO CURSOR c_BuscaProd READWRITE 
				USE IN c_not
			ELSE
				SELECT a.*,SPACE(250) as DescripcionNota FROM c_BuscaProd_tmp a  INTO CURSOR c_BuscaProd READWRITE 
			ENDIF 
			**** cambiando a cod. prob base si el factor de la presentacion es 1 y el precio 0
			REPLACE codprod4 WITH codprod,descripcionUnimed WITH producto,unimed WITH unidadmedida, preciosiniva2 WITH preciosiniva,precioconiva2 WITH precioconiva,;
						precioconivaunimed WITH precioconiva, preciosinivaunimed WITH preciosiniva FOR NVL(factorpresenta,1)=1 AND precioconiva2=0 in c_BuscaProd
			GO TOP IN c_BuscaProd
			
			USE IN c_pre_minimo2
			USE IN c_pre_minimo
			USE IN c_pre_SinIva2
			*USE IN c_BuscaCuenta    t0.preciosiniva*((100-t0.pordescuento)/100) as preciominimo
		ENDIF 

		IF !EMPTY(lcfaliasCtaBus)
			SELECT (lcfaliasCtaBus)
		ENDIF 
	ENDIF

	RETURN lcidCtaBus
ENDFUNC 




FUNCTION _BuscaIdProductosKit(lnConect,lnidkit)
