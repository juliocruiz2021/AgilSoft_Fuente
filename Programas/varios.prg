FUNCTION ObtenerTipoOpBco(lnidTip)
	lcAliasTipOp=ALIAS()
	llRetOp=1
	USE pcsysdir+pcDB+"\sisTipoDoctos" IN 0 SHARED AGAIN ALIAS c_TipOpBco
	
	IF SEEK(lnidTip,"c_TipOpBco","IDTIPODOCT")
		DO case
			CASE c_TipOpBco.CtrolCyB=3		&&& transferencias
				llRetOp=2
			CASE c_TipOpBco.CtrolCxC=0	AND c_TipOpBco.CtrolCxP=0 AND c_TipOpBco.CtrolCyB<>3	&&& pagos varios
				llRetOp=1
			CASE c_TipOpBco.CtrolCxC<>0		&&& pago clientes
				llRetOp=3
			CASE c_TipOpBco.CtrolCxP<>0		&&& pago Proveedores
				llRetOp=4
			OTHERWISE
				llRetOp=1
			
		ENDCASE  
	ENDIF 
	USE IN c_TipOpBco
	
	IF !EMPTY(lcAliasTipOp)
		SELECT (lcAliasTipOp)
	ENDIF 
	
	RETURN llRetOp
ENDFUNC 



FUNCTION FiltroTipoOpBco(lnTiOp,lcCursorFil)
	llRetOp=""
	
	IF PCOUNT( )=2
		lcCurFil=ALLTRIM(lcCursorFil)+"."
	ELSE
		lcCurFil=""
	ENDIF
	 
	DO case
		CASE lnTiOp=2		&&& transferencias
			llRetOp=" and "+lcCurFil+"CtrolCyB=3 "
		CASE lnTiOp=1	&&& pagos varios
			llRetOp=" and ("+lcCurFil+"CtrolCxC=0 AND "+lcCurFil+"CtrolCxP=0 AND "+lcCurFil+"CtrolCyB<>3) "
		CASE lnTiOp=3 	&&& pago clientes
			llRetOp=" and "+lcCurFil+"CtrolCxC<>0 "
		CASE lnTiOp=4	&&& pago Proveedores
			llRetOp=" and "+lcCurFil+"CtrolCxP<>0 "
		OTHERWISE
			llRetOp=" and ("+lcCurFil+"CtrolCxC=0 AND "+lcCurFil+"CtrolCxP=0 AND "+lcCurFil+"CtrolCyB<>3) "
			*llRetOp=" "
	ENDCASE  

	RETURN llRetOp
ENDFUNC 


