		SELECT CNT(*) as cuenta FROM comvtakardex a ;
			WHERE a.ctrolcomvta<>IIF(a.origen='VTA',IIF(a.ctrolinv=1,2,1),a.ctrolinv) AND INLIST(a.ctrolinv,1,2) AND a.status=1 AND INLIST(a.origen,'VTA','COM') INTO ARRAY lacomvtamalos

