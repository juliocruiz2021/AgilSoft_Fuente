				INNER JOIN (SELECT aa.idcuenta1,a.idcuenta as idcuenta2,a.idpadre,a.nivel ;
			FROM &lcTablaCuentas a ;
				INNER JOIN (SELECT idcuenta as idcuenta1,idcuenta as idcuenta2,idpadre ;
								FROM &lcTablaCuentas WHERE detalle=1) as aa ON a.idcuenta=aa.idpadre) as bb ;
					ON b.idcuenta=bb.idpadre) as cc ON c.idcuenta=cc.idpadre ) as dd ON d.idcuenta=dd.idpadre ) as ee ;
					ON e.idcuenta=ee.idpadre;
	UNION ALL ;
		SELECT ff.idcuenta1,f.idcuenta as idcuenta2,f.idpadre,f.nivel ;
			FROM &lcTablaCuentas f ;
				INNER JOIN  (SELECT ee.idcuenta1,e.idcuenta as idcuenta2,e.idpadre,e.nivel ;
			FROM &lcTablaCuentas e ;
				INNER JOIN  (SELECT dd.idcuenta1,d.idcuenta as idcuenta2,d.idpadre,d.nivel ;
			FROM &lcTablaCuentas d ;
				INNER JOIN  (SELECT cc.idcuenta1,c.idcuenta as idcuenta2,c.idpadre,c.nivel ;
			FROM &lcTablaCuentas c ;
				INNER JOIN (SELECT bb.idcuenta1,b.idcuenta as idcuenta2,b.idpadre,b.nivel ;
			FROM &lcTablaCuentas b ;
				INNER JOIN (SELECT aa.idcuenta1,a.idcuenta as idcuenta2,a.idpadre,a.nivel ;
			FROM &lcTablaCuentas a ;
				INNER JOIN (SELECT idcuenta as idcuenta1,idcuenta as idcuenta2,idpadre ;
								FROM &lcTablaCuentas WHERE detalle=1) as aa ON a.idcuenta=aa.idpadre) as bb ;
					ON b.idcuenta=bb.idpadre) as cc ON c.idcuenta=cc.idpadre ) as dd ON d.idcuenta=dd.idpadre ) as ee ;
					ON e.idcuenta=ee.idpadre) as ff ON f.idcuenta=ff.idpadre ;
	) as zz ;
	ORDER BY idcuenta1,idcuenta2 ;
	INTO CURSOR &lcmicurpadre &lcfilctaa
	SELECT (lcmicurpadre)
	INDEX on idcuenta TAG idcuenta 
	SET ORDER TO idcuenta
	
	IF llcerrartabla=.t.
		USE IN miCtbCuentas
	ENDIF 
	
	IF !EMPTY(lcaliasmicuentas)
		SELECT (lcaliasmicuentas)
	ENDIF 
ENDFUNC 


function captureScreen()
	&&capture entier screen
	DECLARE INTEGER keybd_event IN Win32API ;
	      INTEGER, INTEGER, INTEGER, INTEGER
	   KEYEVENTF_KEYUP = 2
	   KEYEVENTF_EXTENDEDKEY = 1
	    VK_SNAPSHOT = 44    && from the winuser.h
	*The following commands copy the entier screen to the 
	*clipboard (the equivalent of PrintScrn): 
	DOEVENTS
	keybd_event( VK_SNAPSHOT, 0, KEYEVENTF_EXTENDEDKEY, 0 )
	keybd_event( VK_SNAPSHOT, 0, KEYEVENTF_EXTENDEDKEY + KEYEVENTF_KEYUP, 0 )
	DOEVENTS
ENDFUNC 


function captureWin()
	&&capture active window
	DECLARE INTEGER keybd_event IN Win32API ;
	      INTEGER, INTEGER, INTEGER, INTEGER
	   VK_SNAPSHOT = 44    && from the winuser.h
	   VK_LMENU = 164
	   KEYEVENTF_KEYUP = 2
	   KEYEVENTF_EXTENDEDKEY = 1

	*The following commands copy the active application window to the 
	*clipboard (the equivalent of ALT+PrintScrn):click on the window to getfocus.
	DOEVENTS
	keybd_event( VK_LMENU,    0, KEYEVENTF_EXTENDEDKEY, 0 ) 
	keybd_event( VK_SNAPSHOT, 0, KEYEVENTF_EXTENDEDKEY, 0 )
	keybd_event( VK_SNAPSHOT, 0, KEYEVENTF_EXTENDEDKEY + KEYEVENTF_KEYUP, 0 )
	keybd_event( VK_LMENU,    0, KEYEVENTF_EXTENDEDKEY + KEYEVENTF_KEYUP, 0 )
	DOEVENTS
endfunc


