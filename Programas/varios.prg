			ENDIF 
			xlsheet.Cells(lnFila,1).Value = codprod
			xlsheet.Cells(lnFila,2).Value = UPPER(ALLTRIM(producto))
			xlsheet.Cells(lnFila,3).Value = UPPER(unidadmedida)
			xlsheet.Cells(lnFila,4).Value = cantidad
			xlsheet.Cells(lnFila,5).Value = unitario
			xlsheet.Cells(lnFila,6).Value = total

			IF lnconclipro=1
				xlsheet.Cells(lnFila,7).Value =ALLTRIM(clipro)
			ENDIF 

			lntot1=lntot1+cantidad
			lntot2=lntot2+total
			lntots1=lntots1+Cantidad
			lntots2=lntots2+total
	
			lnFila= lnFila+ 1

		endscan	
		
		***** fin del Reporte
		IF llsubtotalizar=.t.
			xlsheet.Cells(lnFila,3).Value = 'Sub-Total'
			xlsheet.Cells(lnFila,3).HorizontalAlignment =xlRight
			xlsheet.Cells(lnFila,4).Value=lntots1
			xlsheet.Cells(lnFila,4).Borders(8).LineStyle=1
	 		xlsheet.Cells(lnFila,4).Borders(9).LineStyle=9

			xlsheet.Cells(lnFila,6).Value=lntots2
			xlsheet.Cells(lnFila,6).Borders(8).LineStyle=1
	 		xlsheet.Cells(lnFila,6).Borders(9).LineStyle=9

	 		xlsheet.Cells(lnFila,3).Font.Bold = 'True'
	 		xlsheet.Cells(lnFila,4).Font.Bold = 'True'
			xlsheet.Cells(lnFila,6).Font.Bold = 'True'

			lnFila= lnFila+ 2	
		ENDIF 				
		
		xlsheet.Cells(lnFila,3).Value = 'TOTAL '
		xlsheet.Cells(lnFila,3).HorizontalAlignment =xlRight

		xlsheet.Cells(lnFila,4).Value=lntot1
		xlsheet.Cells(lnFila,4).Borders(8).LineStyle=1
 		xlsheet.Cells(lnFila,4).Borders(9).LineStyle=9

		xlsheet.Cells(lnFila,6).Value=lntot2
		xlsheet.Cells(lnFila,6).Borders(8).LineStyle=1
 		xlsheet.Cells(lnFila,6).Borders(9).LineStyle=9
 				
 		xlsheet.Cells(lnFila,3).Font.Bold = 'True'
 		xlsheet.Cells(lnFila,4).Font.Bold = 'True'
		xlsheet.Cells(lnFila,6).Font.Bold = 'True'
 				
 			*XLSheet.RANGE(XLSheet.Cells(lnRowTit,i),XLSheet.Cells(lnRowTit,i)).BorderAround(7)
		xlsheet.Range("C5").Select
   		oExcel.ActiveWindow.FreezePanes=.t.
	
   		WITH xlsheet.PageSetup
   		    .Zoom = .f.	
   			.PrintTitleRows = "$1:$4"
   		 	.FitToPagesWide = 1 
   			.FitToPagesTall = 32767
   		 	.LeftMargin = 40
        	.RightMargin = 40
	        .TopMargin = 40
    	    .CenterHorizontally = .f.
		ENDWITH 
			
		.Visible = .T.
	ENDWITH
	RELEASE oExcel
	RETURN .t.
ENDFUNC 



FUNCTION EnviarDatosWeb(lcmiruta,lcdatos)
	lcmiruta="https://"+ALLTRIM(lcmiruta)
	
	IF EMPTY(lcdatos)
		lcruta=lcmiruta
	ELSE 
		lcruta=lcmiruta+"?"+ALLTRIM(lcdatos)
	ENDIF 
	lcVerTmp=''
	*_cliptext=_cliptext+'               '+lcruta

	**** en lugar de guardar en portapapeles
	m.RespuestaWEB="Ruta: "+lcruta+CHR(13)
	
	LOCAL xhr
	xhr = CREATEOBJECT("Microsoft.XMLHTTP")
	xhr.Open("POST", lcruta, .f.)
	
	xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded')
	xhr.send()

	LOCAL lcResultText
	lcResultText = xhr.responseText
	m.RespuestaWEB=m.RespuestaWEB+lcResultText
	lcVerTmp=ALLTRIM(lcResultText)
	
	RETURN lcVerTmp
ENDFUNC 


FUNCTION SincronizarSitioWebProductos(lctablaActualiza,lcDataEnviada)

	IF SUBSTR(lctablaActualiza,1,2)='DP'
		lcWebSitio="duraplasticsv.com"
		lctablaActualiza=STRTRAN(lctablaActualiza,"DP","")
	ELSE
		lcWebSitio=pcWebSitio
	ENDIF 

	lcmiruta="https://"+ALLTRIM(lcWebSitio)
	IF lctablaActualiza='productos'
		lcmiruta="https://"+ALLTRIM(lcWebSitio)+'/apis/verproductos.php'
	ENDIF 
	IF lctablaActualiza='catalogos'
		lcmiruta="https://"+ALLTRIM(lcWebSitio)+'/apis/vercatalogo.php'
	ENDIF 
	IF lctablaActualiza='existencias'
		lcmiruta="https://"+ALLTRIM(lcWebSitio)+'/apis/verexistencias.php'
	ENDIF 
	IF lctablaActualiza='precios'
		lcmiruta="https://"+ALLTRIM(lcWebSitio)+'/apis/verprecios.php'
	ENDIF 
	IF lctablaActualiza='aplicacion'
		lcmiruta="https://"+ALLTRIM(lcWebSitio)+'/apis/veraplicacion.php'
	ENDIF 

	lcVerTmp=''

	IF !EMPTY(lcWebSitio) AND !EMPTY(lcDataEnviada)
		LOCAL xhr
		xhr = CREATEOBJECT("Microsoft.XMLHTTP")
		xhr.Open("POST", lcmiruta, .f.)
		
		
		xhr.setRequestHeader('Content-Type', 'application/json')
		xhr.send(lcDataEnviada)

		LOCAL lcResultText
		lcResultText = xhr.responseText
		lcVerTmp=ALLTRIM(lcResultText)
		
	ENDIF 
	*_cliptext=_cliptext+'               '+lcruta
	*_cliptext=lcruta
	RETURN lcVerTmp
ENDFUNC 





PROCEDURE pide_permiso_facturaAutorizacionRemota
	LPARAMETERS lcjson,lcidautt
	v_autorizado = ''
	lcWeb=''

	IF !EMPTY(pcSitioWebAutoriza) AND !EMPTY(pcCorreosAutoriza)
		IF PCOUNT( )>1
			mijson=lcjson
			
			***** aqui verificamos si ya esta autorizado en web o solicitamos la autoriacion web	
			lcWeb=EnviarDatosWeb(pcSitioWebAutoriza+'/autoriza.php','contenido={"data":'+mijson+'}')
			
			IF "sigasv.com"$pcSitioWebAutoriza 
				lcSitioCorreo="https://mensajes.sigasv.com"
			ELSE 
				lcSitioCorreo=pcSitioWebAutoriza+"/funcs/mensajes"
			ENDIF 
			
			IF  SUBSTR(lcWeb,1,2)='ok'
				WAIT WINDOW 'Documento Autorizado remotamente..' NOWAIT 
			ELSE
				IF lcWeb='no autorizado'
					WAIT WINDOW 'El documento aun no esta Autorizado Remotamente, Intente mas tarde...' NOWAIT 
				ELSE 
					lcmen=	'remite=autorizaciones@sigasv.com&'+;
						'correo='+pcCorreosAutoriza+'&'+;
						'mensaje=favor autorizar Documento '+"https://"+pcSitioWebAutoriza+'/autorizacion.php?id='+lcidautt
					*lcdiga=EnviarDatosWeb(pcSitioWebAutoriza+'/funcs/mensajes/correo.php',lcmen)
					lcdiga=EnviarDatosWeb(lcSitioCorreo+'/correo.php',lcmen)
					MESSAGEBOX(lcdiga+CHR(13)+CHR(13)+'Se envio un correo para solicitar la autorizacion Remota '+CHR(13)+'y vuelva a intentar en unos segundos',64,'Solicitando Autorizacion..')
				ENDIF 
			ENDIF 	
		ELSE
			mijson=''
			lcmen=''
		ENDIF 	
		
		v_autorizado=lcWeb
		
	ELSE
		v_autorizado='no configurado'
	ENDIF 
	RETURN v_autorizado
	
ENDPROC
