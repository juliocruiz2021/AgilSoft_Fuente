FUNCTION _ConvertirToFechaSQL(ldFecSQLConver as Date())
	lcRetornaFecha=DTOS(ldFecSQLConver)
	lcRetornaFecha=SUBSTR(lcRetornaFecha,1,4)+'-'+SUBSTR(lcRetornaFecha,5,2)+'-'+SUBSTR(lcRetornaFecha,7,2)
	RETURN lcRetornaFecha
ENDFUNC 


FUNCTION _ConvertirToFechaHoraSQL(ldFecSQLConver as Datetime())
	lcRetornaFecha=TTOC(ldFecSQLConver)
	lcRetornaFecha=SUBSTR(lcRetornaFecha,7,4)+'-'+SUBSTR(lcRetornaFecha,4,2)+'-'+SUBSTR(lcRetornaFecha,1,2)+' '+SUBSTR(lcRetornaFecha,12,8)
	RETURN lcRetornaFecha
ENDFUNC 

FUNCTION espere(lcDiga)
	FOR i=1 TO 9
		lcsigno=SUBSTR('|/-\|/-\|',i,1)
		WAIT WINDOW lcDiga+" "+lcsigno NOWAIT 
		=INKEY(.01)
	ENDFOR
	WAIT CLEAR  
ENDFUNC 




