FUNCTION ImprimirPartidas(lnCtrlConecc as integer,lcIds as String,lnsalida as integer,lnCtrl as Integer,lcOrigenPartida as string)
	**** lcids 		= se paso como parametro los numeros de partidas a imprimir
	**** lnsalida 	1=tamaño carta,2=media carta 3=resumida  4 consolidado por dia y tipo
	**** lnCtrl 	1=Imprimir Directo al Impresor ;
					2=Imprimir con Previsualizacion y ;
					3=Mostrar Formulario para Editar
	STORE ALIAS() TO lcAliasOld
	lcids=lcids
	USE pcSysDir+pcdb+"\ctbPartidas" SHARED AGAIN ORDER idPartida IN 0 ALIAS imppar
	USE pcSysDir+pcdb+"\ctbPartidasDeta" SHARED AGAIN ORDER idPartidaD IN 0 alias imppard
	USE pcSysDir+pcdb+"\ctbCuentas" SHARED AGAIN ORDER idCuenta IN 0 ALIAS impparcta
	USE pcSysDir+pcdb+"\sistipodoctos" SHARED AGAIN ORDER idtipodoct IN 0
	*USE pcSysDir+pcdb+"\ctbCuentaspadre" SHARED AGAIN ORDER idCuenta IN 0 ALIAS 
	_CtasPadre (0,'','impparctap')
	USE pcSysDir+pcdb+"\siscata" SHARED AGAIN ORDER id IN 0 ALIAS imppartipo
	
	lcPrintActual=SET("PRINTER", 3)
	lcPrintActual2=SET("PRINTER", 3)

	IF !EMPTY(lcIds)
		_VariableACursor(lcids,'c_idparttidas')

		DO case
			CASE lnsalida=1	&&& Tamañao Carta
				STORE "partidascarta" TO lcArchivo
			CASE lnsalida=2	&&& Tamañao Media Carta
				STORE "partidasmediacarta" TO lcArchivo
			CASE lnsalida=3	&&& Tipo Reporte
				STORE "ctb_partidas_resumen" TO lcArchivo
			OTHERWISE 	&&& Resumido por dia
				STORE "partidasresumen" TO lcArchivo
				
		ENDCASE 
		
		IF lnsalida<>4		&&& no es resumen de partidas
			SELECT tt0.*,tt1.tdebe,tt1.thaber,tt2.codcta,tt2.cuenta,tt2.nivel,tt2.naturaleza,tt2.detalle,SPACE(100) as tipodocto FROM ;
					(select t0.*,t1.idtipopar,t1.fechapartida,t1.numeropartida,t1.concepto,t1.monto,t1.impreso,;
							t1.eliminado as partidaeliminada,t2.cod as tipopar,t2.nombre as nomtipopar,;
							SUBSTR(ALLTRIM(STR(IIF(t0.idorigen=0,IIF(t0.debe>0,1,2),t0.idorigen))),1,1) as cargoabono, ;
						NVL(t3.cod,SPACE(20)) as ctrocosto,t1.presupuesto,t1.ciclo ;
						FROM imppard t0 ;
							INNER JOIN imppar t1 ON t0.idpartida=t1.idpartida ;
							INNER JOIN imppartipo t2 ON t1.idtipopar=t2.id ;
							LEFT  JOIN imppartipo t3 ON t1.idctrocosto=t3.id ; 
							ORDER BY t0.idpartida,cargoabono,t0.idcuenta ;
						WHERE t0.idpartida in (SELECT idllave FROM c_idparttidas)) tt0 ;
				INNER JOIN ;
					(SELECT t0.idpartida as tidpartida,SUM(t0.debe) as tdebe,SUM(t0.haber) thaber,;
							SUBSTR(ALLTRIM(STR(IIF(t0.idorigen=0,IIF(t0.debe>0,1,2),t0.idorigen))),1,1) as tcargoabono,MAX(t0.idcuenta) as tidcuenta,max(t3.idcuentarelacion) as tidcuentarelacion ;
						FROM imppard t0 ;
							INNER JOIN imppar t1 ON t0.idpartida=t1.idpartida ;
							INNER JOIN imppartipo t2 ON t1.idtipopar=t2.id ;
							INNER JOIN impparctap t3 ON t0.idcuenta=t3.idcuenta ;
							INNER JOIN impparcta t4 ON t3.idcuentarelacion=t4.idcuenta ;
							WHERE t0.idpartida in (SELECT idllave FROM c_idparttidas) ;
						group BY t0.idpartida,tcargoabono,t4.codcta ;
						ORDER BY t0.idpartida,tcargoabono,t4.codcta) as tt1 ;
					ON tt0.idpartida=tt1.tidpartida AND tt0.cargoabono=tt1.tcargoabono AND tt0.idcuenta=tt1.tidcuenta ;
				INNER JOIN impparcta tt2 ON tt1.tidcuentarelacion=tt2.idcuenta ;
				ORDER BY tt0.fechapartida,tt0.tipopar,tt0.numeropartida,tt0.cargoabono,tt2.codcta ;
				WHERE tt2.nivel>=pnnivelmayor ;
				INTO CURSOR c_resumen READWRITE
				
		ELSE
			IF lnsalida=4
				SELECT tt0.*,tt1.tdebe,tt1.thaber,tt2.codcta,tt2.cuenta,tt2.nivel,tt2.naturaleza,tt2.detalle,SPACE(100) as tipodocto FROM ;
						(select t0.*,DTOS(t1.fechapartida)+STR(t1.idtipopar) as tidpartida,t1.idtipopar,;
								t1.fechapartida,DTOS(t1.fechapartida) as numeropartida,t1.concepto,t1.monto,t1.impreso,;
								t1.eliminado as partidaeliminada,t2.cod as tipopar,t2.nombre as nomtipopar, ;
								SUBSTR(ALLTRIM(STR(IIF(t0.idorigen=0,IIF(t0.debe>0,1,2),t0.idorigen))),1,1) as cargoabono,t1.presupuesto,t1.ciclo ;
							FROM imppard t0 ;
								INNER JOIN imppar t1 ON t0.idpartida=t1.idpartida ;
								INNER JOIN imppartipo t2 ON t1.idtipopar=t2.id ORDER BY t0.idpartida,cargoabono,t0.idcuenta;
							WHERE t0.idpartida in (SELECT idllave FROM c_idparttidas)) tt0 ;
					INNER JOIN ;
						(SELECT DTOS(t1.fechapartida)+STR(t1.idtipopar) as tidpartida,MAX(t0.idcuenta) as idcuenta,;
								SUM(t0.debe) as tdebe,SUM(t0.haber) thaber,SUBSTR(ALLTRIM(STR(IIF(t0.idorigen=0,IIF(t0.debe>0,1,2),t0.idorigen))),1,1) as tcargoabono,;
								MAX(t0.idcuenta) as tidcuenta,max(t3.idcuentarelacion) as tidcuentarelacion ;
							FROM imppard t0 ;
								INNER JOIN imppar t1 ON t0.idpartida=t1.idpartida ;
								INNER JOIN imppartipo t2 ON t1.idtipopar=t2.id ;
								INNER JOIN impparctap t3 ON t0.idcuenta=t3.idcuenta ;
								INNER JOIN impparcta t4 ON t3.idcuentarelacion=t4.idcuenta ;
								WHERE t0.idpartida in (SELECT idllave FROM c_idparttidas) ;
							group BY tidpartida,tcargoabono,t4.codcta ;
							ORDER BY tidpartida,tcargoabono,t4.codcta) as tt1 ;
						ON tt0.tidpartida=tt1.tidpartida AND tt0.cargoabono=tt1.tcargoabono AND tt0.idcuenta=tt1.tidcuenta ;
					INNER JOIN impparcta tt2 ON tt1.tidcuentarelacion=tt2.idcuenta ;
					ORDER BY tt0.fechapartida,tt0.tipopar,tt0.numeropartida,tt0.cargoabono,tt2.codcta ;
					WHERE tt2.nivel>=pnnivelmayor ;
					INTO CURSOR c_resumen0 READWRITE		
				
				SELECT aa.*,b.tipodocto FROM (SELECT iddocto,origen,idtipodocto FROM cyvventas WHERE iddocto in (SELECT idpartida FROM c_resumen0 WHERE origen='VTA') ;
						UNION ALL ;
						SELECT iddocto,origen,idtipodocto FROM cyvcompras WHERE iddocto in (SELECT idpartida FROM c_resumen0 WHERE origen='COM') ;
						UNION ALL ;
						SELECT iddocto,origen,idtipodocto FROM invinventarios WHERE iddocto in (SELECT idpartida FROM c_resumen0 WHERE origen='INV') ;
						UNION ALL ;
						SELECT iddocto,origen,idtipodocto FROM cybmovimientos WHERE iddocto in (SELECT idpartida FROM c_resumen0 WHERE origen='CYB') ;
				) as aa INNER JOIN sistipodoctos b ON aa.idtipodocto=b.idtipodocto INTO CURSOR c_doctosTipos

 					
				UPDATE c_resumen0 SET tipodocto=a.tipodocto from c_doctosTipos a WHERE c_resumen0.idpartida=a.iddocto AND c_resumen0.origen=a.origen
				
				SELECT MIN(idpartidad) as idpartidad,MIN(idpartida) as idpartida,idcuenta,MIN(conceptod) as conceptod,SUM(debe) as debe,SUM(haber) as haber,;
							periodo,origen,MIN(idorigen) as idorigen,idsucursal,idctrocosto,MIN(fecalta) as fecalta,MIN(fecmod) as fecmod,MIN(fecactu) as fecactu,MIN(nodo) as nodo,;
							MIN(eliminado) as eliminado,MIN(iduser) as iduser,MIN(pcUser) as pcUser,MIN(tidpartida) as tidpartida,MIN(idtipopar) as idtipopar,fechapartida,;
							numeropartida,MIN(concepto) as concepto,max(monto) as monto,MIN(impreso) as Impreso,MIN(partidaeliminada) as partidaeliminada,tipoPar,;
							MIN(nomtipopar) as nomtipopar,cargoabono,MAX(presupuesto) as presupuesto,MAX(ciclo) as ciclo,sum(debe) as tdebe,sum(haber) as thaber,codcta,cuenta,nivel,naturaleza,detalle,tipodocto ;
					FROM c_resumen0 WHERE detalle=1  ;
							ORDER BY fechapartida,tipopar,tipodocto,numeropartida,cargoabono,codcta,idcuenta,periodo,origen,idsucursal,idctrocosto,cuenta,nivel,naturaleza,detalle ;
							GROUP BY fechapartida,tipopar,tipodocto,numeropartida,cargoabono,codcta,idcuenta,periodo,origen,idsucursal,idctrocosto,cuenta,nivel,naturaleza,detalle ;
				INTO CURSOR c_resumen1 READWRITE 

				SELECT c_resumen0
					
				SELECT a.*,cod as ctrocosto ;
					FROM (SELECT * FROM c_resumen0 WHERE detalle<>1 ;
								UNION ALL ;
							SELECT * FROM c_resumen1 ) as a ;
						LEFT JOIN imppartipo b ON a.idctrocosto=b.id AND 'CCO'=b.origen ;
				ORDER BY a.fechapartida,a.tipopar,a.numeropartida,a.cargoabono,a.codcta,b.cod ;
				INTO CURSOR c_resumen READWRITE 
				
				*USE IN c_resumen0
				*USE IN c_resumen1
				
				SELECT c_resumen
				REPLACE concepto WITH 'VENTA DEL DIA '+DTOC(fechapartida) FOR origen='VTA' all
				REPLACE concepto WITH 'COMPRAS Y PAGOS DEL DIA '+DTOC(fechapartida) FOR origen='COM' all
				REPLACE concepto WITH 'MOVIMIENTOS DE INVENTARIO DEL DIA '+DTOC(fechapartida) FOR origen='INV' all
				REPLACE concepto WITH ALLTRIM(UPPER(tipodocto))+' DEL DIA '+DTOC(fechapartida) FOR !INLIST(origen,'INV','VTA','COM') AND !EMPTY(tipodocto) all
				REPLACE concepto WITH 'MOVIMIENTOS DEL DIA '+DTOC(fechapartida) FOR EMPTY(tipodocto) all

				GO top
			ELSE
				SELECT tt0.*,tt1.tdebe,tt1.thaber,tt2.codcta,tt2.cuenta,tt2.nivel,tt2.naturaleza,tt2.detalle,SPACE(100) as tipodocto FROM ;
						(select t0.*,DTOS(t1.fechapartida)+STR(t1.idtipopar) as tidpartida,t1.idtipopar,;
								t1.fechapartida,DTOS(t1.fechapartida) as numeropartida,t1.concepto,t1.monto,t1.impreso,;
								t1.eliminado as partidaeliminada,t2.cod as tipopar,t2.nombre as nomtipopar,;
								SUBSTR(ALLTRIM(STR(IIF(t0.idorigen=0,IIF(t0.debe>0,1,2),t0.idorigen))),1,1) as cargoabono,t1.presupuesto,t1.ciclo  ;
							FROM imppard t0 ;
								INNER JOIN imppar t1 ON t0.idpartida=t1.idpartida ;
								INNER JOIN imppartipo t2 ON t1.idtipopar=t2.id ORDER BY t0.idpartida,cargoabono,t0.idcuenta;
							WHERE t0.idpartida in (SELECT idllave FROM c_idparttidas)) tt0 ;
					INNER JOIN ;
						(SELECT DTOS(t1.fechapartida)+STR(t1.idtipopar) as tidpartida,MAX(t0.idcuenta) as idcuenta,;
								SUM(t0.debe) as tdebe,SUM(t0.haber) thaber,SUBSTR(ALLTRIM(STR(IIF(t0.idorigen=0,IIF(t0.debe>0,1,2),t0.idorigen))),1,1) as tcargoabono,;
								MAX(t0.idcuenta) as tidcuenta,max(t3.idcuentarelacion) as tidcuentarelacion ;
							FROM imppard t0 ;
								INNER JOIN imppar t1 ON t0.idpartida=t1.idpartida ;
								INNER JOIN imppartipo t2 ON t1.idtipopar=t2.id ;
								INNER JOIN impparctap t3 ON t0.idcuenta=t3.idcuenta ;
								INNER JOIN impparcta t4 ON t3.idcuentarelacion=t4.idcuenta ;
								WHERE t0.idpartida in (SELECT idllave FROM c_idparttidas) ;
							group BY tidpartida,tcargoabono,t4.codcta ;
							ORDER BY tidpartida,tcargoabono,t4.codcta) as tt1 ;
						ON tt0.tidpartida=tt1.tidpartida AND tt0.cargoabono=tt1.tcargoabono AND tt0.idcuenta=tt1.tidcuenta ;
					INNER JOIN impparcta tt2 ON tt1.tidcuentarelacion=tt2.idcuenta ;
					ORDER BY tt0.fechapartida,tt0.tipopar,tt0.numeropartida,tt0.cargoabono,tt2.codcta ;
					WHERE tt2.nivel>=pnnivelmayor ;
					INTO CURSOR c_resumen0 READWRITE	

				SELECT a.*,b.cod as ctrocosto FROM c_resumen0 a LEFT JOIN imppartipo b ON a.idctrocosto=b.id and  'CCO'=b.origen ;
					INTO CURSOR c_resumen READWRITE 

				USE IN c_resumen0
				SELECT c_resumen
			ENDIF 
		ENDIF 


		**** ACTUALIZANDO status de impreso
		IF lnsalida<>4
			SELECT idpartida FROM c_resumen INTO CURSOR cc_impresos READWRITE ORDER BY idpartida GROUP BY idpartida
			SELECT cc_impresos
			SCAN 
				lnidaimprimir=idpartida
				ActualizarStatusPartidaImpresa(lnCtrlConecc,lnidaimprimir,lcOrigenPartida)
			ENDSCAN 
			USE IN cc_impresos
		ENDIF 
		
		SELECT c_resumen
		*REPLACE concepto WITH ALLTRIM(nomtipopar)+" del dia "+DTOC(fechapartida),debe WITH 0,haber WITH 0 FOR detalle=0
		REPLACE debe WITH 0,haber WITH 0 FOR detalle=0

		SELECT * FROM c_resumen INTO CURSOR c_ttempo1 READWRITE 
		SELECT * FROM c_resumen WHERE detalle=1 INTO CURSOR c_ttempo2 READWRITE 
		SELECT c_ttempo2
		REPLACE tdebe WITH 0,thaber WITH 0,detalle WITH 2 all
		SELECT c_ttempo1
		*REPLACE debe WITH 0 haber WITH 0 all
		SELECT *,IIF(detalle=1,1,0) as impvaldeta FROM c_ttempo1 ;
			UNION ALL ;
		SELECT *,IIF(detalle=1,1,0) as impvaldeta FROM c_ttempo2 ;
			ORDER BY fechapartida,tipopar,numeropartida,cargoabono,codcta,detalle,conceptod INTO CURSOR c_resumen READWRITE 
	
		SELECT STR(idcuenta)+cargoabono as llave,SUM(1) as reg ;
				from c_resumen ;
				WHERE detalle=1 ;
				ORDER BY idcuenta,cargoabono ;
				GROUP BY idcuenta,cargoabono ;
				INTO CURSOR c_hay
		
		SELECT c_resumen
		UPDATE c_resumen SET impvaldeta=0 ;
			WHERE detalle=1 AND STR(idcuenta)+cargoabono in (selec llave from c_hay WHERE reg =1)
		GO top
		
		USE in c_ttempo1
		USE IN c_ttempo2
		SELECT c_resumen 
 
		IF FILE(pcSysDir+pcDB+"\formatos\"+lcArchivo+".frx")
			**** obteniendo el impresor de reportes
			lcPrinter=ObtieneImpresores(lnCtrlConecc,1)
			STORE SET("Printer",3) TO lcPrinOld
			
			IF pnUsaRedirec=1		&&&& usandoa impresor redireccionado
				lcPrinter=ImpresorRedireccionado(0,3)
			ENDIF 

			IF !EMPTY(lcPrinter)
				SET PRINTER TO NAME (lcPrinter)
			ENDIF 

			SELECT c_resumen
			*lnCtrl=2
			DO case
				CASE lnCtrl=1
					WAIT WINDOW 'Imprimiendo Documento... ' NOWAIT 
*					FOR i=1 TO lnCopias
						lcPrintActual=SET("PRINTER", 3)
						lcPrintActual2=SET("PRINTER", 3)
						_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)
						lcPrintActual=lcPrintActual2
						*REPORT FORM pcSysDir+pcDB+"\formatos\"+lcArchivo TO PRINTER NOCONSOLE NAME lcPrintActual
						IF lnsalida=3	&&& es tipo reporte resumido, solo van cuentas de detalle
							DELETE all FOR detalle<=1
							GO top
						ENDIF 
						
						REPORT FORM pcSysDir+pcDB+"\formatos\"+lcArchivo TO PRINTER PROMPT PREVIEW NOCONSOLE 
						*MODIFY REPORT pcSysDir+pcDB+"\formatos\"+lcArchivo
						*lcPrintActual2=lcPrintActual
*					ENDFOR 
				CASE lnCtrl=2
					lcPrintActual=SET("PRINTER", 3)
					lcPrintActual2=SET("PRINTER", 3)
					_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)
					IF lnsalida=3	&&& es tipo reporte resumido, solo van cuentas de detalle
							DELETE all FOR detalle<=1
							GO top
						ENDIF 
					REPORT FORM pcSysDir+pcDB+"\formatos\"+lcArchivo TO PRINTER PROMPT PREVIEW NOCONSOLE 
					
				CASE lnCtrl=3
					lcPrintActual=SET("PRINTER", 3)
					lcPrintActual2=SET("PRINTER", 3)
					_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)
					IF lnsalida=3	&&& es tipo reporte resumido, solo van cuentas de detalle
							DELETE all FOR detalle<=1
							GO top
						ENDIF 
					MODIFY REPORT pcSysDir+pcDB+"\formatos\"+lcArchivo
			ENDCASE
			IF !EMPTY(lcPrinOld)
				SET PRINTER TO NAME (lcPrinOld)
			ENDIF 
		ENDIF 
		*USE IN C_resumen
		USE IN c_idparttidas
	ELSE
		MESSAGEBOX('No se Encontro el Documento....',16,'Error al Imprimir...')
	ENDIF 

	USE IN imppar
	USE IN imppard
	USE IN impparcta
	USE IN impparctap
	USE IN imppartipo
	
	IF !EMPTY(lcAliasOld)
		SELECT (lcAliasOld)
	ENDIF 
	RETURN .t.
ENDFUNC 


