*------------------------------------------------------------
* Adivina extensión por URL (formato=pdf, json, xml)
*------------------------------------------------------------
FUNCTION GuessExtFromUrl(tcUrl)
    LOCAL lcUrl, lcExt

    lcUrl = LOWER(tcUrl)
    lcExt = "bin"

    IF "formato=pdf" $ lcUrl
        lcExt = "pdf"
    ELSE
        IF "formato=json" $ lcUrl
            lcExt = "json"
        ELSE
            IF "formato=xml" $ lcUrl
                lcExt = "xml"
            ENDIF
        ENDIF
    ENDIF

    RETURN lcExt
ENDFUNC



