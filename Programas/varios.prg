* Devuelve un cursor con un solo campo: iddocto.
* Incluye solamente DTE a los que les falta el PDF, el JSON o ambos.
*
* Uso:
*   DO dte_sin_archivos
*   lcCursor = DTE_SinPdfOJson(DATE(2026,8,1), DATE(2026,8,31))
*   SELECT (lcCursor)
*   BROWSE
*
FUNCTION DTE_SinPdfOJson
    LPARAMETERS tdDesde, tdHasta, tcAliasSalida

    LOCAL lcAliasSalida, ldHasta, lcCarpeta, lcPdf, lcJson
    LOCAL lcControl, lcGeneracion, lcNumero, lcJsonGuardado, llFalta
    LOCAL lnUltimoId

    lcAliasSalida = IIF(VARTYPE(tcAliasSalida) = "C" AND ;
        !EMPTY(ALLTRIM(tcAliasSalida)), ALLTRIM(tcAliasSalida), "curDteSinArchivo")
    ldHasta = tdHasta + 1

    IF !USED("cyvventas")
        USE cyvventas IN 0 SHARED
    ENDIF
    lcCarpeta = ADDBS(JUSTPATH(DBF("cyvventas"))) + "ArchivosPDF\"

    IF USED("curBaseDte")
        USE IN curBaseDte
    ENDIF
    IF USED(lcAliasSalida)
        USE IN (lcAliasSalida)
    ENDIF

    SELECT v.iddocto, v.fechadocto, v.numero, ;
        v.codigogeneracion, v.numerocontrol, ;
        d.codigogeneracion AS dtegeneracion, ;
        d.numerocontrol AS dtecontrol, ;
        d.pdf_path, d.jsonenviado, d.jsonrespuesta ;
    FROM cyvventas v ;
    INNER JOIN sisseries s ON v.idserie = s.idserie ;
    LEFT JOIN sisdte d ON d.iddocto = v.iddocto ;
        AND d.origen = v.origen AND d.status = 1 ;
    WHERE v.fechadocto >= m.tdDesde ;
        AND v.fechadocto < m.ldHasta ;
        AND v.origen = "VTA" ;
        AND v.ctrolvta <> 0 ;
        AND v.eliminado = 0 ;
        AND s.electronica = 1 ;
    ORDER BY v.iddocto, d.intentos DESC ;
    INTO CURSOR curBaseDte READWRITE

    CREATE CURSOR (lcAliasSalida) (iddocto I)
    INDEX ON iddocto TAG iddocto UNIQUE

    SELECT curBaseDte
    lnUltimoId = -1
    SCAN
        * El ORDER BY deja primero el intento DTE mas reciente.
        IF curBaseDte.iddocto = lnUltimoId
            LOOP
        ENDIF
        lnUltimoId = curBaseDte.iddocto

        lcControl = DTE_PrimerValor(curBaseDte.dtecontrol, ;
            curBaseDte.numerocontrol)
        lcGeneracion = DTE_PrimerValor(curBaseDte.dtegeneracion, ;
            curBaseDte.codigogeneracion)
        lcNumero = ALLTRIM(NVL(curBaseDte.numero, ""))
        lcJsonGuardado = DTE_PrimerValor(curBaseDte.jsonrespuesta, ;
            curBaseDte.jsonenviado)

        lcPdf = DTE_ExisteArchivo(lcCarpeta, curBaseDte.fechadocto, ;
            lcControl, lcGeneracion, lcNumero, ".pdf", curBaseDte.pdf_path)
        lcJson = DTE_ExisteArchivo(lcCarpeta, curBaseDte.fechadocto, ;
            lcControl, lcGeneracion, lcNumero, ".json", "")

        llFalta = EMPTY(lcPdf) OR (EMPTY(lcJson) AND EMPTY(lcJsonGuardado))
        IF llFalta AND !SEEK(curBaseDte.iddocto, lcAliasSalida, "iddocto")
            INSERT INTO (lcAliasSalida) (iddocto) VALUES (curBaseDte.iddocto)
        ENDIF
    ENDSCAN

    USE IN curBaseDte
    SELECT (lcAliasSalida)
    SET ORDER TO iddocto
    GO TOP

    RETURN lcAliasSalida
ENDFUNC


FUNCTION DTE_ExisteArchivo
    LPARAMETERS tcCarpeta, ttFecha, tcControl, tcGeneracion, tcNumero, ;
        tcExtension, tcRutaGuardada

    LOCAL lcRuta, lcAno, lcNombre, lnNombre, lnForma
    LOCAL ARRAY laNombres[3]

    lcRuta = ALLTRIM(NVL(tcRutaGuardada, ""))
    IF !EMPTY(lcRuta)
        IF FILE(lcRuta)
            RETURN lcRuta
        ENDIF
        IF !(LEN(lcRuta) >= 2 AND SUBSTR(lcRuta, 2, 1) = ":")
            lcRuta = FULLPATH(lcRuta, JUSTPATH(LEFT(tcCarpeta, LEN(tcCarpeta) - 1)))
            IF FILE(lcRuta)
                RETURN lcRuta
            ENDIF
        ENDIF
    ENDIF

    laNombres[1] = ALLTRIM(NVL(tcControl, ""))
    laNombres[2] = ALLTRIM(NVL(tcGeneracion, ""))
    laNombres[3] = ALLTRIM(NVL(tcNumero, ""))
    lcAno = ALLTRIM(STR(YEAR(ttFecha)))

    FOR lnNombre = 1 TO 3
        lcNombre = laNombres[lnNombre]
        IF EMPTY(lcNombre)
            LOOP
        ENDIF
        FOR lnForma = 1 TO 2
            lcRuta = tcCarpeta + IIF(lnForma = 1, lcNombre, ;
                lcAno + "-" + lcNombre) + LOWER(tcExtension)
            IF FILE(lcRuta)
                RETURN lcRuta
            ENDIF
        ENDFOR
    ENDFOR

    RETURN ""
ENDFUNC


FUNCTION DTE_PrimerValor
    LPARAMETERS tuValor1, tuValor2
    LOCAL lcValor
    lcValor = IIF(ISNULL(tuValor1), "", ALLTRIM(TRANSFORM(tuValor1)))
    IF EMPTY(lcValor)
        lcValor = IIF(ISNULL(tuValor2), "", ALLTRIM(TRANSFORM(tuValor2)))
    ENDIF
    RETURN lcValor
ENDFUNC


* ============================================================
* Seguridad de contrasenas. Funciones incluidas en VARIOS.PRG
* para quedar incorporadas al ejecutar BUILD EXE.
* ============================================================
* Validacion compartida para el alta y cambio de contrasena de usuarios.
FUNCTION ValidarClaveFuerte
    LPARAMETERS tcUsuario, tcClave, tcMensaje
    LOCAL lcUsuario, lcClave, lcCaracter, lnPos, lnCodigo
    LOCAL llMayuscula, llMinuscula, llNumero, llSimbolo

    tcMensaje = ""
    IF VARTYPE(tcUsuario) <> "C" OR VARTYPE(tcClave) <> "C"
        tcMensaje = "Usuario y contrasena deben ser texto."
        RETURN .F.
    ENDIF

    lcUsuario = ALLTRIM(tcUsuario)
    lcClave = tcClave
    IF EMPTY(lcUsuario)
        tcMensaje = "Debe indicar el usuario antes de establecer la contrasena."
        RETURN .F.
    ENDIF
    IF LOWER(lcClave) == LOWER(lcUsuario)
        tcMensaje = "La contrasena no puede ser igual al usuario."
        RETURN .F.
    ENDIF
    IF LEN(lcClave) < 8
        tcMensaje = "La contrasena debe tener al menos 8 caracteres."
        RETURN .F.
    ENDIF
    IF CHR(32) $ lcClave OR CHR(9) $ lcClave OR CHR(13) $ lcClave OR CHR(10) $ lcClave
        tcMensaje = "La contrasena no debe contener espacios en blanco."
        RETURN .F.
    ENDIF

    llMayuscula = .F.
    llMinuscula = .F.
    llNumero = .F.
    llSimbolo = .F.
    FOR lnPos = 1 TO LEN(lcClave)
        lcCaracter = SUBSTR(lcClave, lnPos, 1)
        lnCodigo = ASC(lcCaracter)
        DO CASE
        CASE lnCodigo >= 65 AND lnCodigo <= 90
            llMayuscula = .T.
        CASE lnCodigo >= 97 AND lnCodigo <= 122
            llMinuscula = .T.
        CASE lnCodigo >= 48 AND lnCodigo <= 57
            llNumero = .T.
        OTHERWISE
            llSimbolo = .T.
        ENDCASE
    ENDFOR

    IF NOT (llMayuscula AND llMinuscula AND llNumero AND llSimbolo)
        tcMensaje = "La contrasena debe incluir mayuscula, minuscula, numero y simbolo."
        RETURN .F.
    ENDIF
    RETURN .T.
ENDFUNC

* Despues de completar el login, ofrece cambiar una clave antigua/debil.
* El aviso y el cambio son opcionales; el usuario ya ingreso al sistema.
FUNCTION OfrecerCambioClaveAlIngresar
    LPARAMETERS tcUsuario, tcClave, tnIdUsuario, tcBaseDatos, tnDataSession
    LOCAL lcMotivo, lcAviso, lnRespuesta, lcBaseAnterior, lnUsuarioAnterior
    LOCAL loCambioClave, loError, lcError, lcHashAnterior, llCambiada, lnConsulta, lnConexion

    lcMotivo = ""
    IF ValidarClaveFuerte(tcUsuario, tcClave, @lcMotivo)
        RETURN .T.
    ENDIF

    lcAviso = "La contrase" + CHR(241) + "a actual ya no cumple los requisitos de seguridad." + CHR(13) + CHR(13) + ;
        "Debe tener al menos 8 caracteres, una may" + CHR(250) + "scula, una min" + CHR(250) + ;
        "scula, un n" + CHR(250) + "mero y un s" + CHR(237) + "mbolo." + CHR(13) + ;
        "No debe contener espacios ni ser igual al usuario." + CHR(13) + CHR(13) + ;
        "Se recomienda cambiarla. " + CHR(191) + "Desea hacerlo en este momento?"
    lnRespuesta = MESSAGEBOX(lcAviso, 4 + 48 , "Seguridad de la contrase" + CHR(241) + "a")
    IF lnRespuesta <> 6
        RETURN .T.
    ENDIF

    lcBaseAnterior = pcDB
    lnUsuarioAnterior = pnIdUsuario
    lcHashAnterior = LOWER(STRCONV(Hash(tcClave, 1), 15))
    lcError = ""
    TRY
        pcDB = tcBaseDatos
        pnIdUsuario = tnIdUsuario
        DO FORM (pcSysDir + "comun\frm_com_usuarios_clave") NAME loCambioClave LINKED ;
            WITH tnIdUsuario, 0 NOSHOW
        loCambioClave.Show(1)
    CATCH TO loError
        lcError = loError.Message
    FINALLY
        SET DATASESSION TO tnDataSession
        pcDB = lcBaseAnterior
        pnIdUsuario = lnUsuarioAnterior
    ENDTRY

    IF NOT EMPTY(lcError)
        MESSAGEBOX("No se pudo abrir el cambio de contrase" + CHR(241) + "a: " + lcError, ;
            16, "Seguridad de la contrase" + CHR(241) + "a")
        RETURN .T.
    ENDIF

    llCambiada = .F.
    lnConexion = 0
    IF USED("c_ClaveLoginNueva")
        USE IN c_ClaveLoginNueva
    ENDIF
    TRY
        lnConexion = _conecta(tcBaseDatos)
        IF lnConexion <= 0
            lcError = "No se pudo conectar para comprobar la nueva contrasena."
        ELSE
            lnConsulta = miSQLEXEC(lnConexion, ;
                "SELECT clave FROM sisusuarios WHERE idusuario=" + ALLTRIM(STR(tnIdUsuario)), ;
                "c_ClaveLoginNueva")
            IF lnConsulta > 0 AND USED("c_ClaveLoginNueva")
                SELECT c_ClaveLoginNueva
                IF NOT EOF()
                    llCambiada = LOWER(ALLTRIM(clave)) <> lcHashAnterior
                ENDIF
                USE IN c_ClaveLoginNueva
            ENDIF
        ENDIF
    CATCH TO loError
        lcError = loError.Message
    FINALLY
        IF lnConexion > 0
            =miSQLDISCONNECT(lnConexion)
        ENDIF
    ENDTRY

    IF NOT EMPTY(lcError)
        MESSAGEBOX("No se pudo comprobar el cambio de contrase" + CHR(241) + "a: " + lcError, ;
            16, "Seguridad de la contrase" + CHR(241) + "a")
    ELSE
        IF llCambiada
            MESSAGEBOX("Contrase" + CHR(241) + "a actualizada correctamente.", ;
                64, "Seguridad de la contrase" + CHR(241) + "a")
        ELSE
            MESSAGEBOX("La contrase" + CHR(241) + "a no se cambio. Puede hacerlo desde el sistema.", ;
                48, "Seguridad de la contrase" + CHR(241) + "a")
        ENDIF
    ENDIF
    RETURN .T.
ENDFUNC


************************************************************
* JSON de una venta para integracion con Gestion Interna.
* Genera encabezado e items y permite enviarlos a Gestion Interna.
************************************************************

FUNCTION EnviarJsonGestionInterna
	LPARAMETERS tnIdDocto, tcOrigen, tcLlaveSiga, tlPrueba

	LOCAL lcUrl, lcLlave, lcArchivoLlave, lcJson, lcRespuesta
	LOCAL loHttp, loStream, luCuerpo, loError, loResultado, llPrueba

	loResultado = CREATEOBJECT("Empty")
	ADDPROPERTY(loResultado, "ok", .F.)
	ADDPROPERTY(loResultado, "statusHttp", 0)
	ADDPROPERTY(loResultado, "mensaje", "")
	ADDPROPERTY(loResultado, "respuesta", "")
	ADDPROPERTY(loResultado, "jsonEnviado", "")

	* Todo evento pasa primero por la cola durable SQLite de SigaBridge.Api.
	* La API conserva el JSON exacto de alta/anulacion y lo reintenta si falla.
	lcUrl = ApiPedidosUrlBase() + "/api/integrations/gestion-interna/facturas"
	lcLlave = ""
	llPrueba = .F.

	IF VARTYPE(tcLlaveSiga) = "C"
		lcLlave = ALLTRIM(tcLlaveSiga)
	ENDIF
	IF VARTYPE(tlPrueba) = "L"
		llPrueba = tlPrueba
	ENDIF

	IF EMPTY(lcLlave) AND TYPE("pcSysDir") = "C" AND TYPE("pcdb") = "C"
		lcArchivoLlave = pcSysDir + pcdb + "\gestion_interna.key"
		IF FILE(lcArchivoLlave)
			lcLlave = ALLTRIM(STRTRAN(STRTRAN(FILETOSTR(lcArchivoLlave), CHR(13), ""), CHR(10), ""))
		ENDIF
	ENDIF

	IF EMPTY(lcLlave)
		loResultado.mensaje = "No se configuro la llave x-llave-siga en gestion_interna.key."
		RETURN loResultado
	ENDIF

	lcJson = GenerarJsonDocumentoUniversal(tnIdDocto, tcOrigen, llPrueba)
	loResultado.jsonEnviado = lcJson
	IF EMPTY(lcJson) OR '"error":true' $ LOWER(lcJson)
		loResultado.mensaje = "No fue posible generar el JSON de la factura."
		loResultado.respuesta = lcJson
		RETURN loResultado
	ENDIF

	TRY
		* Se envia el cuerpo como UTF-8 sin BOM para conservar tildes y caracteres especiales.
		loStream = CREATEOBJECT("ADODB.Stream")
		loStream.Type = 2
		loStream.Charset = "utf-8"
		loStream.Open()
		loStream.WriteText(lcJson)
		loStream.Position = 0
		loStream.Type = 1
		loStream.Position = 3
		luCuerpo = loStream.Read()
		loStream.Close()

		loHttp = CREATEOBJECT("MSXML2.ServerXMLHTTP.6.0")
		loHttp.setTimeouts(10000, 10000, 15000, 15000)
		loHttp.Open("POST", lcUrl, .F.)
		loHttp.setRequestHeader("Content-Type", "application/json; charset=utf-8")
		loHttp.setRequestHeader("X-Siga-Tenant", "impmarrq")
		loHttp.setRequestHeader("x-llave-siga", lcLlave)
		loHttp.Send(luCuerpo)

		loResultado.statusHttp = loHttp.Status
		lcRespuesta = ALLTRIM(loHttp.responseText)
		loResultado.respuesta = lcRespuesta
		IF loHttp.Status = 200
			loResultado.ok = .T.
			loResultado.mensaje = "Factura enviada a Gestion Interna."
		ELSE
			loResultado.mensaje = "La API respondio HTTP " + TRANSFORM(loHttp.Status) + "."
		ENDIF
	CATCH TO loError
		loResultado.mensaje = "No fue posible conectar con Gestion Interna: " + loError.Message
	ENDTRY

	RETURN loResultado
ENDFUNC


FUNCTION GenerarJsonDocumentoUniversal
	LPARAMETERS tnIdDocto, tcOrigen, tlPrueba

	LOCAL lnIdDocto, lcOrigen, lcAliasAnterior, lcJson, lcItems
	LOCAL lcCelular, lcTipoIdentificacion, lcNumeroIdentificacion
	LOCAL lcComa, llPrueba, loError

	lnIdDocto = NVL(tnIdDocto, 0)
	lcOrigen = UPPER(ALLTRIM(NVL(tcOrigen, "")))
	lcAliasAnterior = ALIAS()
	lcJson = ""
	llPrueba = .F.
	IF PCOUNT() >= 3 AND VARTYPE(tlPrueba) = "L"
		llPrueba = tlPrueba
	ENDIF

	TRY
		IF lnIdDocto <= 0
			ERROR "El iddocto debe ser mayor que cero."
		ENDIF
		IF lcOrigen <> "VTA"
			ERROR "Esta version admite documentos con origen VTA."
		ENDIF
		IF TYPE("pcSysDir") <> "C" OR TYPE("pcdb") <> "C"
			ERROR "No esta disponible la ruta de la empresa activa."
		ENDIF

		_JsonVentaCerrarCursores()

		USE (pcSysDir + pcdb + "\cyvVentas") IN 0 SHARED AGAIN ALIAS c_JV_Ventas
		USE (pcSysDir + pcdb + "\cyvVentasDeta") IN 0 SHARED AGAIN ALIAS c_JV_Detalle
		USE (pcSysDir + pcdb + "\sisTipoDoctos") IN 0 SHARED AGAIN ALIAS c_JV_TipoDoc
		USE (pcSysDir + pcdb + "\cyvCliPro") IN 0 SHARED AGAIN ALIAS c_JV_Cliente
		USE (pcSysDir + pcdb + "\sisCata") IN 0 SHARED AGAIN ALIAS c_JV_Sucursal

		SELECT a.iddocto, a.origen, a.numero, a.fechadocto, a.totaldocto, a.status AS statusDocumento, ;
			a.clipro AS nombreCliente, a.celular AS celularDocumento, a.dui, a.nit, a.nrc, ;
			NVL(t.clave, "") AS tipoDocumento, ;
			NVL(c.celular, "") AS celularCliente, ;
			NVL(c.telefono, "") AS telefonoCliente, ;
			NVL(s.nombre, "") AS nombreSucursal ;
		FROM c_JV_Ventas a ;
		LEFT JOIN c_JV_TipoDoc t ON a.idtipodocto = t.idtipodocto ;
		LEFT JOIN c_JV_Cliente c ON a.idclipro = c.idclipro ;
		LEFT JOIN c_JV_Sucursal s ON a.idsucursal = s.id AND s.origen = "SUC" ;
		WHERE a.iddocto = m.lnIdDocto AND UPPER(ALLTRIM(a.origen)) = m.lcOrigen ;
		INTO CURSOR c_JV_Encabezado READWRITE

		IF RECCOUNT("c_JV_Encabezado") = 0
			ERROR "No se encontro la factura solicitada."
		ENDIF
		SELECT c_JV_Encabezado
		GO TOP

		SELECT iddoctod, producto, cantiunimed, precioconivaunidad ;
		FROM c_JV_Detalle ;
		WHERE iddocto = m.lnIdDocto AND eliminado = 0 ;
		ORDER BY iddoctod ;
		INTO CURSOR c_JV_Items READWRITE

		lcItems = "["
		lcComa = ""
		SELECT c_JV_Items
		SCAN
			lcItems = lcItems + lcComa + "{" + ;
				'"descripcion":' + _JsonVentaTexto(c_JV_Items.producto) + "," + ;
				'"cantidad":' + _JsonVentaNumero(c_JV_Items.cantiunimed, 8) + "," + ;
				'"precio":' + _JsonVentaNumero(c_JV_Items.precioconivaunidad, 8) + ;
			"}"
			lcComa = ","
		ENDSCAN
		lcItems = lcItems + "]"

		SELECT c_JV_Encabezado
		lcCelular = ALLTRIM(NVL(c_JV_Encabezado.celularDocumento, ""))
		IF EMPTY(lcCelular)
			lcCelular = ALLTRIM(NVL(c_JV_Encabezado.celularCliente, ""))
		ENDIF
		IF EMPTY(lcCelular)
			lcCelular = ALLTRIM(NVL(c_JV_Encabezado.telefonoCliente, ""))
		ENDIF

		lcTipoIdentificacion = ""
		lcNumeroIdentificacion = ""
		IF !EMPTY(ALLTRIM(NVL(c_JV_Encabezado.nrc, "")))
			lcTipoIdentificacion = "nrc"
			lcNumeroIdentificacion = ALLTRIM(c_JV_Encabezado.nrc)
		ELSE
			IF !EMPTY(ALLTRIM(NVL(c_JV_Encabezado.dui, "")))
				lcTipoIdentificacion = "dui"
				lcNumeroIdentificacion = ALLTRIM(c_JV_Encabezado.dui)
			ELSE
				IF !EMPTY(ALLTRIM(NVL(c_JV_Encabezado.nit, "")))
					lcTipoIdentificacion = "nit"
					lcNumeroIdentificacion = ALLTRIM(c_JV_Encabezado.nit)
				ENDIF
			ENDIF
		ENDIF

		lcJson = "{" + ;
			'"iddocto":' + _JsonVentaNumero(c_JV_Encabezado.iddocto, 0) + "," + ;
			'"nombre_cliente":' + _JsonVentaTexto(c_JV_Encabezado.nombreCliente) + "," + ;
			'"celular_cliente":' + _JsonVentaTexto(lcCelular) + "," + ;
			'"identificacion":{' + ;
				'"tipo":' + _JsonVentaTexto(lcTipoIdentificacion) + "," + ;
				'"numero":' + _JsonVentaTexto(lcNumeroIdentificacion) + ;
			'},' + ;
			'"factura":' + _JsonVentaTexto(c_JV_Encabezado.numero) + "," + ;
			'"tipo_documento":' + _JsonVentaTexto(c_JV_Encabezado.tipoDocumento) + "," + ;
			'"fecha_factura":' + _JsonVentaFecha(c_JV_Encabezado.fechadocto) + "," + ;
			'"sucursal":' + _JsonVentaTexto(c_JV_Encabezado.nombreSucursal) + "," + ;
			'"monto_factura":' + _JsonVentaNumero(c_JV_Encabezado.totaldocto, 2) + "," + ;
			'"items":' + lcItems + "," + ;
			'"anulado":' + IIF(NVL(c_JV_Encabezado.statusDocumento, 0) = 0, "true", "false") + "," + ;
			'"prueba":' + IIF(llPrueba, "true", "false") + ;
		"}"

	CATCH TO loError
		lcJson = "{" + ;
			'"error":true,' + ;
			'"mensaje":' + _JsonVentaTexto(loError.Message) + ;
		"}"
	FINALLY
		_JsonVentaCerrarCursores()
		IF !EMPTY(lcAliasAnterior) AND USED(lcAliasAnterior)
			SELECT (lcAliasAnterior)
		ENDIF
	ENDTRY

	RETURN lcJson
ENDFUNC


FUNCTION _JsonVentaTexto
	LPARAMETERS tuValor
	LOCAL lcTexto, lnControl

	IF ISNULL(tuValor)
		RETURN '""'
	ENDIF

	lcTexto = ALLTRIM(TRANSFORM(tuValor))
	lcTexto = STRTRAN(lcTexto, "\", "\\")
	lcTexto = STRTRAN(lcTexto, '"', '\"')
	lcTexto = STRTRAN(lcTexto, CHR(8), "\b")
	lcTexto = STRTRAN(lcTexto, CHR(9), "\t")
	lcTexto = STRTRAN(lcTexto, CHR(10), "\n")
	lcTexto = STRTRAN(lcTexto, CHR(12), "\f")
	lcTexto = STRTRAN(lcTexto, CHR(13), "\r")
	FOR lnControl = 0 TO 31
		IF !INLIST(lnControl, 8, 9, 10, 12, 13)
			lcTexto = STRTRAN(lcTexto, CHR(lnControl), "")
		ENDIF
	ENDFOR

	RETURN '"' + lcTexto + '"'
ENDFUNC


FUNCTION _JsonVentaFecha
	LPARAMETERS tdFecha
	LOCAL lcFecha
	IF ISNULL(tdFecha) OR EMPTY(tdFecha)
		RETURN '""'
	ENDIF
	lcFecha = DTOS(tdFecha)
	RETURN '"' + LEFT(lcFecha, 4) + "-" + SUBSTR(lcFecha, 5, 2) + "-" + RIGHT(lcFecha, 2) + '"'
ENDFUNC


FUNCTION _JsonVentaNumero
	LPARAMETERS tnNumero, tnDecimales
	LOCAL lcNumero, lnDecimales
	IF ISNULL(tnNumero)
		RETURN "0"
	ENDIF
	lnDecimales = MAX(0, MIN(8, NVL(tnDecimales, 2)))
	lcNumero = ALLTRIM(STR(tnNumero, 30, lnDecimales))
	lcNumero = STRTRAN(lcNumero, SET("POINT"), ".")
	IF "." $ lcNumero
		DO WHILE RIGHT(lcNumero, 1) = "0"
			lcNumero = LEFT(lcNumero, LEN(lcNumero) - 1)
		ENDDO
		IF RIGHT(lcNumero, 1) = "."
			lcNumero = LEFT(lcNumero, LEN(lcNumero) - 1)
		ENDIF
	ENDIF
	RETURN IIF(EMPTY(lcNumero), "0", lcNumero)
ENDFUNC


FUNCTION _JsonVentaCerrarCursores()
	LOCAL ARRAY laAlias[7]
	LOCAL lnAlias
	laAlias[1] = "c_JV_Encabezado"
	laAlias[2] = "c_JV_Items"
	laAlias[3] = "c_JV_Ventas"
	laAlias[4] = "c_JV_Detalle"
	laAlias[5] = "c_JV_TipoDoc"
	laAlias[6] = "c_JV_Cliente"
	laAlias[7] = "c_JV_Sucursal"
	FOR lnAlias = 1 TO ALEN(laAlias, 1)
		IF USED(laAlias[lnAlias])
			USE IN (laAlias[lnAlias])
		ENDIF
	ENDFOR
	RETURN .T.
ENDFUNC


************************************************************
* Estado de sincronizacion con API de Importadora Marroquin.
* statusApiIM: 0=pendiente, 1=recibido por la API.
************************************************************

FUNCTION _ValidarVentasStatusApiIM
	LOCAL llExiste, llOk, lnCampo, lcAliasAnterior, lcTabla, lcDBC, lcError
	LOCAL loError

	llExiste = .F.
	llOk = .T.
	lcError = ""
	lcAliasAnterior = ALIAS()
	lcTabla = pcSysDir + pcDB + "\cyvventas"
	lcDBC = pcSysDir + pcDB + "\masterdb.dbc"

*!*		IF UPPER(ALLTRIM(pcDB)) <> "AGILSOFT_001_IMPMARRQ"
*!*			RETURN .T.
*!*		ENDIF

	TRY
		IF USED("cValStatusApiIM")
			USE IN cValStatusApiIM
		ENDIF
		USE (lcTabla) SHARED AGAIN IN 0 ALIAS cValStatusApiIM
		SELECT cValStatusApiIM
		FOR lnCampo = 1 TO FCOUNT()
			IF UPPER(ALLTRIM(FIELD(lnCampo))) == "STATUSAPIIM"
				llExiste = .T.
				EXIT
			ENDIF
		ENDFOR
		USE IN cValStatusApiIM

		IF !llExiste
			IF USED("cyvventas")
				ERROR "Cierre los formularios que utilizan cyvventas antes de agregar statusApiIM."
			ENDIF
			IF !DBUSED("masterdb")
				OPEN DATABASE (lcDBC) SHARED
			ENDIF

			WAIT WINDOW "Agregando status ApiIM." NOWAIT
			USE (lcTabla) EXCLUSIVE IN 0 ALIAS cyvventas
			ALTER TABLE cyvventas ADD COLUMN statusApiIM I DEFAULT 0

			* Todos los documentos existentes ya fueron enviados.
			FLUSH IN cyvventas
			USE IN cyvventas
					
			USE (lcTabla) SHARED AGAIN IN 0 
			SELECT cyvventas
			REPLACE ALL statusApiIM WITH 1 IN cyvventas
			USE IN cyvventas
		ENDIF
	CATCH TO loError
		llOk = .F.
		lcError = loError.Message
	FINALLY
		IF USED("cValStatusApiIM")
			USE IN cValStatusApiIM
		ENDIF
		IF USED("cyvventas")
			USE IN cyvventas
		ENDIF
		WAIT CLEAR
		IF !EMPTY(lcAliasAnterior) AND USED(lcAliasAnterior)
			SELECT (lcAliasAnterior)
		ENDIF
	ENDTRY

	IF !llOk
		WAIT WINDOW "No se pudo agregar statusApiIM: " + lcError NOWAIT
	ENDIF
	RETURN llOk
ENDFUNC


FUNCTION MarcarVentaStatusApiIM
	LPARAMETERS tnIdDocto, tnEstado
	LOCAL llOk, lcAliasAnterior, loError

	llOk = .F.
	lcAliasAnterior = ALIAS()

	IF TYPE("pcSysDir") <> "C" OR TYPE("pcDB") <> "C"
		RETURN .F.
	ENDIF
	IF UPPER(ALLTRIM(pcDB)) <> "AGILSOFT_001_IMPMARRQ"
		RETURN .F.
	ENDIF
	IF !INLIST(NVL(tnEstado, -1), 0, 1)
		RETURN .F.
	ENDIF

	TRY
		IF USED("cStatusApiIM")
			USE IN cStatusApiIM
		ENDIF
		USE (pcSysDir + pcDB + "\cyvventas") SHARED AGAIN IN 0 ALIAS cStatusApiIM
		IF TYPE("cStatusApiIM.statusApiIM") <> "U"
			SELECT cStatusApiIM
			LOCATE FOR iddocto = m.tnIdDocto
			IF FOUND() AND RLOCK("cStatusApiIM")
				REPLACE statusApiIM WITH m.tnEstado IN cStatusApiIM
				FLUSH IN cStatusApiIM
				UNLOCK IN cStatusApiIM
				llOk = .T.
			ENDIF
		ENDIF
	CATCH TO loError
		llOk = .F.
	FINALLY
		IF USED("cStatusApiIM")
			USE IN cStatusApiIM
		ENDIF
		IF !EMPTY(lcAliasAnterior) AND USED(lcAliasAnterior)
			SELECT (lcAliasAnterior)
		ENDIF
	ENDTRY

	RETURN llOk
ENDFUNC


FUNCTION ProcesarPendientesGestionInterna
	LPARAMETERS tnMaximo
	LOCAL lnMaximo, lnProcesados, lnIdDocto, llEsPrueba
	LOCAL lcAliasAnterior, loEnvio, loResultado, loError

	loResultado = CREATEOBJECT("Empty")
	ADDPROPERTY(loResultado, "ok", .F.)
	ADDPROPERTY(loResultado, "pendientes", 0)
	ADDPROPERTY(loResultado, "procesados", 0)
	ADDPROPERTY(loResultado, "enviados", 0)
	ADDPROPERTY(loResultado, "fallidos", 0)
	ADDPROPERTY(loResultado, "mensaje", "")

	lnMaximo = 10
	IF VARTYPE(tnMaximo) = "N" AND tnMaximo > 0
		lnMaximo = INT(tnMaximo)
	ENDIF
	lcAliasAnterior = ALIAS()
	llEsPrueba = .F.
	IF TYPE("PC_USER(1)") = "C"
		llEsPrueba = UPPER(ALLTRIM(PC_USER(1))) == "MOVILRUIZ"
	ENDIF

	IF TYPE("pcSysDir") <> "C" OR TYPE("pcDB") <> "C" OR ;
		UPPER(ALLTRIM(pcDB)) <> "AGILSOFT_001_IMPMARRQ"
		loResultado.mensaje = "La empresa activa no es Importadora Marroquin."
		RETURN loResultado
	ENDIF
	IF TYPE("pnSincronizaIMap") <> "N"
		loResultado.mensaje = "No esta disponible pnSincronizaIMap."
		RETURN loResultado
	ENDIF
	IF pnSincronizaIMap <> 1
		loResultado.mensaje = "La sincronizacion con Importadora Marroquin esta deshabilitada."
		RETURN loResultado
	ENDIF
	IF TYPE("pnIdSucursal") <> "N"
		loResultado.mensaje = "No esta disponible la sucursal activa."
		RETURN loResultado
	ENDIF
	IF pnIdSucursal <= 0
		loResultado.mensaje = "La sucursal activa no es valida."
		RETURN loResultado
	ENDIF

	TRY
		IF USED("cPendStatusApiIM")
			USE IN cPendStatusApiIM
		ENDIF
		IF USED("cPendApiIM")
			USE IN cPendApiIM
		ENDIF

		USE (pcSysDir + pcDB + "\cyvventas") SHARED AGAIN IN 0 ALIAS cPendStatusApiIM
		IF TYPE("cPendStatusApiIM.statusApiIM") = "U"
			ERROR "No existe el campo statusApiIM en cyvventas."
		ENDIF

		SELECT iddocto, fechadocto ;
			FROM cPendStatusApiIM ;
			WHERE statusApiIM = 0 AND eliminado = 0 AND UPPER(ALLTRIM(origen)) = "VTA" AND ;
				idsucursal = m.pnIdSucursal AND ;
				NVL(fechadocto, {}) >= DATE(2026, 10, 19) ;
			ORDER BY fechadocto, iddocto ;
			INTO CURSOR cPendApiIM READWRITE
		USE IN cPendStatusApiIM

		loResultado.pendientes = RECCOUNT("cPendApiIM")
		lnProcesados = 0
		SELECT cPendApiIM
		SCAN WHILE lnProcesados < lnMaximo
			lnIdDocto = cPendApiIM.iddocto
			lnProcesados = lnProcesados + 1
			loEnvio = EnviarJsonGestionInterna(lnIdDocto, "VTA", "", llEsPrueba)
			loResultado.procesados = loResultado.procesados + 1
			IF loEnvio.ok AND MarcarVentaStatusApiIM(lnIdDocto, 1)
				loResultado.enviados = loResultado.enviados + 1
			ELSE
				loResultado.fallidos = loResultado.fallidos + 1
			ENDIF
		ENDSCAN

		loResultado.ok = loResultado.fallidos = 0
		loResultado.mensaje = "Procesados: " + TRANSFORM(loResultado.procesados) + ;
			", enviados: " + TRANSFORM(loResultado.enviados) + ;
			", fallidos: " + TRANSFORM(loResultado.fallidos) + "."
	CATCH TO loError
		loResultado.mensaje = loError.Message
	FINALLY
		IF USED("cPendStatusApiIM")
			USE IN cPendStatusApiIM
		ENDIF
		IF USED("cPendApiIM")
			USE IN cPendApiIM
		ENDIF
		IF !EMPTY(lcAliasAnterior) AND USED(lcAliasAnterior)
			SELECT (lcAliasAnterior)
		ENDIF
	ENDTRY

	RETURN loResultado
ENDFUNC


FUNCTION DebeSincronizarVentaIM
	LPARAMETERS tnIdDocto
	LOCAL llSincroniza, lcAliasAnterior, loError

	llSincroniza = .F.
	lcAliasAnterior = ALIAS()

	IF TYPE("pcSysDir") <> "C" OR TYPE("pcDB") <> "C"
		RETURN .F.
	ENDIF
	IF UPPER(ALLTRIM(pcDB)) <> "AGILSOFT_001_IMPMARRQ"
		RETURN .F.
	ENDIF
	IF TYPE("pnSincronizaIMap") <> "N"
		RETURN .F.
	ENDIF
	IF pnSincronizaIMap <> 1
		RETURN .F.
	ENDIF
	IF TYPE("pnIdSucursal") <> "N"
		RETURN .F.
	ENDIF
	IF pnIdSucursal <= 0
		RETURN .F.
	ENDIF

	TRY
		IF USED("cDebeSyncApiIM")
			USE IN cDebeSyncApiIM
		ENDIF
		USE (pcSysDir + pcDB + "\cyvventas") SHARED AGAIN IN 0 ALIAS cDebeSyncApiIM
		SELECT cDebeSyncApiIM
		LOCATE FOR iddocto = m.tnIdDocto
		IF FOUND()
			llSincroniza = NVL(fechadocto, {}) >= DATE(2026, 10, 19) AND ;
				NVL(idsucursal, 0) = m.pnIdSucursal
		ENDIF
	CATCH TO loError
		llSincroniza = .F.
	FINALLY
		IF USED("cDebeSyncApiIM")
			USE IN cDebeSyncApiIM
		ENDIF
		IF !EMPTY(lcAliasAnterior) AND USED(lcAliasAnterior)
			SELECT (lcAliasAnterior)
		ENDIF
	ENDTRY

	RETURN llSincroniza
ENDFUNC
FUNCTION PrepararDetallePartidasReportes
	LPARAMETERS pdHasta
	LOCAL llResultado, lcAliasAnterior, loError

	llResultado = .F.
	lcAliasAnterior = ALIAS()
	IF VARTYPE(pdHasta) <> "D" OR EMPTY(pdHasta)
		RETURN .F.
	ENDIF

	TRY
		IF USED("c_reportPartidas")
			USE IN c_reportPartidas
		ENDIF

		* Regla contable de reportes: conservar la fila anulada/eliminada con valores cero.
		SELECT d.* ;
			FROM ctbpartidasdeta d ;
			INNER JOIN (SELECT p.idpartida,p.origen,p.fechapartida ;
				FROM ctbpartidas p ;
				WHERE p.origen<>"CYB" AND p.fechapartida<=m.pdHasta ;
				UNION ALL ;
				SELECT z.iddocto AS idpartida,z.origen,z.fechadocto AS fechapartida ;
				FROM cybmovimientos z ;
				WHERE z.fechadocto<=m.pdHasta) h ;
			ON d.idpartida=h.idpartida AND d.origen=h.origen ;
			INTO CURSOR c_reportPartidas READWRITE

		REPLACE debe WITH 0, haber WITH 0 FOR NVL(eliminado,0)<>0 IN c_reportPartidas
		UPDATE c_reportPartidas SET debe=0,haber=0 FROM ctbpartidas p ;
			WHERE c_reportPartidas.idpartida=p.idpartida ;
			AND c_reportPartidas.origen=p.origen AND NVL(p.eliminado,0)<>0
		UPDATE c_reportPartidas SET debe=0,haber=0 FROM cybmovimientos z ;
			WHERE c_reportPartidas.idpartida=z.iddocto AND c_reportPartidas.origen=z.origen ;
			AND (NVL(z.status,0)=0 OR NVL(z.anulado,0)<>0 OR NVL(z.eliminado,0)<>0)
		UPDATE c_reportPartidas SET debe=0,haber=0 FROM cyvventas v ;
			WHERE c_reportPartidas.idpartida=v.iddocto AND c_reportPartidas.origen=v.origen ;
			AND (NVL(v.status,0)=0 OR NVL(v.anulado,0)<>0 OR NVL(v.eliminado,0)<>0)
		UPDATE c_reportPartidas SET debe=0,haber=0 FROM cyvcompras c ;
			WHERE c_reportPartidas.idpartida=c.iddocto AND c_reportPartidas.origen=c.origen ;
			AND (NVL(c.status,0)=0 OR NVL(c.anulado,0)<>0 OR NVL(c.eliminado,0)<>0)
		UPDATE c_reportPartidas SET debe=0,haber=0 FROM invinventarios i ;
			WHERE c_reportPartidas.idpartida=i.iddocto AND c_reportPartidas.origen=i.origen ;
			AND (NVL(i.status,0)=0 OR NVL(i.anulado,0)<>0 OR NVL(i.eliminado,0)<>0)
		UPDATE c_reportPartidas SET debe=0,haber=0 FROM cyvcuentasxcp x ;
			WHERE c_reportPartidas.idpartida=x.iddocto AND c_reportPartidas.origen=x.origen ;
			AND (NVL(x.status,0)=0 OR NVL(x.anulado,0)<>0 OR NVL(x.eliminado,0)<>0)

		llResultado = .T.
	CATCH TO loError
		IF USED("c_reportPartidas")
			USE IN c_reportPartidas
		ENDIF
		llResultado = .F.
	FINALLY
		IF !EMPTY(lcAliasAnterior) AND USED(lcAliasAnterior)
			SELECT (lcAliasAnterior)
		ENDIF
	ENDTRY

	RETURN llResultado
ENDFUNC
