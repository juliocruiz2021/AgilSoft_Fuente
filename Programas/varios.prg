FUNCTION ValidarIndicesVentasLlave()
	IF pntipoconeccion=1
		lcaliasvalida=ALIAS()
		USE pcSysDir+pcdb+"\cyvventas" SHARE again IN 0
		SELECT cyvventas
		llexiste=.f.
		***** buscando indice
		FOR ii = 1 TO 254 
			IF ALLTRIM(UPPER((TAG(ii)))) == 'LLAVE'	&& EL INDICE EXISTE 
				llexiste=.t.
				EXIT && Exit the loop when no more tags are found 
			ENDIF 
		ENDFOR
		USE IN cyvventas
		
		IF !llexiste
			TRY 
				WAIT WINDOW 'Creando Nuevo Indice de Ventas' NOWAIT 
				USE pcSysDir+pcdb+"\cyvventas" EXCLUSIVE IN 0
				
				IF ALIAS()='CYVVENTAS'
					INDEX on origen+DTOS(fechadocto)+numero TAG llave 
					USE IN cyvventas
				ENDIF 
				
			CATCH TO lEx 
				lcerrorllave=" Error " + TRANSFORM(lEx.Message)
				MESSAGEBOX('El Indice LLAVE falló, NO PUDO ACTUALIZARCE...',16,'Error de Actualizacion de Tabla')
			FINALLY	
					***
			ENDTRY 
		ENDIF 
		
		IF !EMPTY(lcaliasvalida)
			SELECT (lcaliasvalida)
		ENDIF 
	ENDIF 
	RETURN .t.
ENDFUNC 


