********* PARTIDA AGRUPADA
FUNCTION _GeneraPartidaAgrupada(lcCursorAgrup,lcllaveAgru)
	
	LOCAL lnTipoImpresion
	lnsalida=3
	
	******* definiendo impresor
	STORE SET("Printer",3) TO lcPrinOld
	lcPrinter=ObtieneImpresores(1,3)

	IF !EMPTY(lcPrinter)
		APRINTERS(lcImipresores)
		llimpresorExiste=.f.
		FOR i=1 TO ALEN(lcImipresores)/2
			IF ALLTRIM(UPPER(lcImipresores(i,1)))=ALLTRIM(UPPER(lcPrinter))
				llimpresorExiste=.t.
			ENDIF 
		ENDFOR 
		
		IF llimpresorExiste=.t.
			SET PRINTER TO NAME (lcPrinter)
		ENDIF 
	ENDIF 
	
	
	DO case
		CASE lnsalida=1	&&& Tamañao Carta
			STORE "partidascarta" TO lcArchivo
		CASE lnsalida=2	&&& Tamañao Media Carta
			STORE "partidasmediacarta" TO lcArchivo
		OTHERWISE 	&&& Tamañao Resumida
			STORE "partidasresumen" TO lcArchivo
	ENDCASE
	
	
	SELECT (lcCursorAgrup)
	GO top
	IF !EOF()
		LOCATE FOR sel=.t.
		IF EOF()
			lcfilsel='where SUBSTR(dtos(a.fechapartida),3,6)+a.origen+SUBSTR(b.cod,1,4) in (select llave from c_ctbpartidas )'
		ELSE
			lcfilsel='where SUBSTR(dtos(a.fechapartida),3,6)+a.origen+SUBSTR(b.cod,1,4) in (select llave from c_ctbpartidas where sel=.t.)'
		ENDIF 

		select MAX(c.idcuenta) as idcuenta,;
			MIN(IIF(INLIST(a.origen,'VTA','CXC','CXP') OR (a.origen='COM' AND SUBSTR(ALLTRIM(STR(IIF(c.idorigen=0,IIF(c.debe>0,100,200),c.idorigen))),2,3)='10'),;
					_conceptodResumido(b.cod,a.origen,a.fechapartida),c.conceptod)) as conceptod,;
			SUM(IIF(d.detalle=1,c.debe,000000000.00)) as debe,;
			SUM(IIF(d.detalle=1,c.haber,000000000.00)) as haber,;
			MIN(SUBSTR(ALLTRIM(STR(IIF(c.idorigen=0,IIF(c.debe>0,100,200),c.idorigen))),1,3)) as idorigen,;
			MIN(SUBSTR(ALLTRIM(STR(IIF(c.idorigen=0,IIF(c.debe>0,1,2),c.idorigen))),1,1)) as cargoabono,;
			MIN(a.fecalta) as fecalta,;
			MIN(a.fecmod) as fecmod,;
			MAX(SUBSTR(dtos(a.fechapartida),3,6)+a.origen+SUBSTR(b.cod,1,4)) as llave1,;
			MAX(RECNO()) as idpartidad,;
			MAX(b.cod) as tipopar,;
			MAX(ba.cod) as CTROCOSTO,;
			SUBSTR(SUBSTR(dtos(a.fechapartida),3,6)+a.origen+SUBSTR(b.cod,1,4)+SUBSTR(ALLTRIM(STR(IIF(c.idorigen=0,IIF(c.debe>0,1,2),c.idorigen))),1,3)+;
					d.codcta+SUBSTR(ba.cod,1,4)+IIF(INLIST(a.origen,'VTA','CXC','CXP') OR (a.origen='COM' AND SUBSTR(ALLTRIM(STR(IIF(c.idorigen=0,IIF(c.debe>0,1,2),c.idorigen))),2,3)='10'),'resumido '+;
					SPACE(10),SUBSTR(conceptod,10,30)),1,50) as llave2 ;
		from ctbpartidas a ;
					INNER JOIN ctbpartidasdeta c ON a.idpartida=c.idpartida ;
					INNER JOIN ctbcuentas d ON c.idcuenta=d.idcuenta ;
					inner join siscata b on a.idtipopar=b.id and b.origen='TPA' ;
					inner join siscata ba on c.idctrocosto=ba.id and ba.origen='CCO' ;
					order by llave2 desc GROUP BY llave2 ;
					&lcfilsel INTO CURSOR c_Agru

		
		***** creando el cursor tempral
		SELECT a.*,dd.*,a.id as idpartida,a.id as tidpartida,a.numero as numeropartida from c_ctbpartidas a ;
					INNER JOIN (select bb.* from (select * FROM c_Agru) as bb) as dd on a.llave=dd.llave1 ;
				order by dd.llave2 INTO CURSOR c_resumenTmp READWRITE 
 										
		SELECT tt0.*,tt1.tdebe,tt1.thaber,tt2.codcta,tt2.cuenta,tt2.nivel,tt2.naturaleza,tt2.detalle ;
			FROM c_resumenTmp tt0 ;
			INNER JOIN (SELECT t0.idpartida as tidpartida,SUM(t0.debe) as tdebe,SUM(t0.haber) thaber,;
						t0.cargoabono as tcargoabono,MAX(t0.idcuenta) as tidcuenta,max(t3.idcuentarelacion) as tidcuentarelacion ;
					FROM c_resumenTmp t0 ;
						INNER JOIN ctbctaspadre t3 ON t0.idcuenta=t3.idcuenta ;
						INNER JOIN ctbCuentas t4 ON t3.idcuentarelacion=t4.idcuenta ;
					group BY t0.idpartida,t0.cargoabono,t4.codcta,t0.ctrocosto ;
					ORDER BY t0.idpartida,t0.cargoabono,t4.codcta,t0.ctrocosto) as tt1 ;
				ON tt0.idpartida=tt1.tidpartida AND tt0.cargoabono=tt1.tcargoabono AND tt0.idcuenta=tt1.tidcuenta ;
			INNER JOIN ctbCuentas tt2 ON tt1.tidcuentarelacion=tt2.idcuenta ;
			WHERE tt2.nivel>2 ORDER BY tt0.llave1,tt0.cargoabono,tt2.codcta,tt0.ctrocosto ;
			INTO CURSOR c_resumenTT READWRITE

		*USE IN c_Agru
		*USE IN c_resumenTmp
		SELECT c_resumenTT
		SELECT * FROM c_resumenTT WHERE detalle=1 INTO CURSOR c_temporal READWRITE 

		REPLACE detalle WITH 2,tdebe WITH 0, thaber WITH 0 FOR detalle=1 IN c_temporal
		REPLACE debe WITH 0,haber WITH 0 ALL IN c_resumenTT
		GO top
		
		SELECT * FROM c_resumenTT UNION ALL SELECT * FROM c_temporal ORDER BY llave1,cargoabono,codcta,detalle INTO CURSOR c_resumen READWRITE 
		USE IN c_resumenTT
		USE IN c_temporal
		
		IF FILE(pcSysDir+pcDB+"\formatos\"+lcArchivo+".frx")
			SELECT c_resumen
			lnCtrl=2
			DO case
				CASE lnCtrl=1
					WAIT WINDOW 'Imprimiendo Documento... ' NOWAIT 
*					FOR i=1 TO lnCopias
						REPORT FORM pcSysDir+pcDB+"\formatos\"+lcArchivo TO PRINTER NOCONSOLE
*					ENDFOR 
				CASE lnCtrl=2
					REPORT FORM pcSysDir+pcDB+"\formatos\"+lcArchivo TO PRINTER PROMPT PREVIEW NOCONSOLE 
				CASE lnCtrl=3
					MODIFY REPORT pcSysDir+pcDB+"\formatos\"+lcArchivo
			ENDCASE
			*USE IN c_resumen
		ENDIF 
		
		SET PRINTER TO NAME (lcPrinOld)
		
	ENDIF 

	RETURN .t. 
ENDFUNC 



***************** PARTIDA DE MOVIMIENTOS DE INVENTARIO

FUNCTION _generaPartidaInventarios(lnsqlid,lnidDoc,lnTipConec)
	llRetornaPartida=.t.
	IF lnsqlid<>0 AND lnidDoc<>0 AND pcnodo=pcnodoctb AND plModuloConta=.t.
		ldfecmodpartida=DATETIME()
		llRetornaPartida=.t.
		
		IF lnTipConec=1		&&&& nativo
			llinvd=!USED("invinventariosdeta")
			IF llinvd
				USE pcSysDir+pcdb+"\invinventariosdeta" IN 0 SHARED AGAIN  ORDER iddoctod
			ENDIF 
			llinvr=!USED("invinventarios")
			IF llinvr
				USE pcSysDir+pcdb+"\invinventarios" IN 0 SHARED AGAIN  ORDER iddocto
			ENDIF 
			llinvp=!USED("invproductos")
			IF llinvp
				USE pcSysDir+pcdb+"\invproductos" IN 0 SHARED AGAIN  ORDER idproducto
			ENDIF 
			llinvf=!USED("invfamilias")
			IF llinvf
				USE pcSysDir+pcdb+"\siscata" IN 0 SHARED AGAIN  ORDER id ALIAS invfamilias
			ENDIF 
			llinvtd=!USED("sistipodoctos")
			IF llinvtd
				USE pcSysDir+pcdb+"\sistipodoctos" IN 0 SHARED AGAIN  ORDER idtipodocto
			ENDIF 
 
			llinvpr=!USED("ctbpartidas")
			IF llinvpr
				USE pcSysDir+pcdb+"\ctbpartidas" IN 0 SHARED AGAIN  ORDER idpartida
			ENDIF 
			llinvpd=!USED("ctbpartidasdeta")
			IF llinvpd
				USE pcSysDir+pcdb+"\ctbpartidasdeta" IN 0 SHARED AGAIN  ORDER idpartidad
			ENDIF 
			llinvCta=!USED("ctbcuentas")
			IF llinvCta
				USE pcSysDir+pcdb+"\ctbcuentas" IN 0 SHARED AGAIN  ORDER idcuenta
			ENDIF 
			
			***** detalle de inventario   jrjrjr
			SELECT t0.iddocto,IIF(NVL(t3.ctainvent,0)=0,IIF(NVL(t5.ctainvent,0)=0,pnCtaInvent,t5.ctainvent),t3.ctainvent) as idcuenta,t4.tipodocto,;
									IIF(t0.entsal=1,IIF(t0.status=0 OR t0.eliminado=1,0000000000.00000000,t0.costototal),0000000000.00000000) as debe,;
									IIF(t0.entsal=1,0000000000.00000000,IIF(t0.status=0 OR t0.eliminado=1,0000000000.00000000,t0.costototal)) as haber,;
									t1.periodo,'INV' as origen,t4.tipoconta,;
									IIF(t0.entsal=1,1,2) as idorigen,t1.fecalta,t1.fecmod,pcnodo as nodo,;
									IIF(t0.entsal=3,t1.idsucursaltras,t1.idsucursal) as idsucursal,t1.idctrocosto,t4.idtipopar,t1.notas,;
									NVL(t5.codmatriz,SPACE(30)) as codmatrizsuc,NVL(t3.codmatriz,SPACE(30)) as codmatrizinv ,0000000000 as idctamatrizinv ;
							FROM invinventariosdeta t0 ;
									INNER JOIN invinventarios t1 ON t0.iddocto=t1.iddocto ;
									INNER JOIN invproductos t2 ON t0.idproducto=t2.idproducto ;
									LEFT JOIN invfamilias t3 ON t2.idfamilia=t3.id AND t3.origen='LIN' ;
									LEFT  JOIN invfamilias t5 ON t1.idsucursal=t5.id AND t5.origen='SUC' ;
									INNER JOIN sistipodoctos t4 ON t1.idtipodocto=t4.idtipodocto  ;
							WHERE t0.iddocto=lnidDoc  ;
						UNION ALL ;
						SELECT t0.iddocto,;
									IIF(t0.entsal=3,IIF(NVL(t3.ctainvent,0)=0,IIF(NVL(t6.ctainvent,0)=0,pnCtaInvent,t6.ctainvent),t3.ctainvent),t4.idctactb) as idcuenta,t4.tipodocto,;
									IIF(t0.entsal<>1,IIF(t0.status=0 OR t0.eliminado=1,0000000000.00000000,t0.costototal),0000000000.00000000) as debe,;
									IIF(t0.entsal<>1,0000000000.00000000,IIF(t0.status=0 OR t0.eliminado=1,0000000000.00000000,t0.costototal)) as haber,;
									t1.periodo,'INV' as origen,t4.tipoconta,;
									IIF(t0.entsal=1,2,1) as idorigen,t1.fecalta,t1.fecmod,pcnodo as nodo,;
									t1.idsucursal,t1.idctrocosto,t4.idtipopar,t1.notas ,;
									NVL(t6.codmatriz,SPACE(30)) as codmatrizsuc,NVL(t3.codmatriz,SPACE(30)) as codmatrizinv ,0000000000 as idctamatrizinv ;
							FROM invinventariosdeta t0 ;
									INNER JOIN invinventarios t1 ON t0.iddocto=t1.iddocto ;
									INNER JOIN invproductos t2 ON t0.idproducto=t2.idproducto ;
									LEFT JOIN invfamilias t3 ON t2.idfamilia=t3.id AND t3.origen='LIN' ;
									LEFT  JOIN invfamilias t6 ON t1.idsucursaltras=t6.id AND t6.origen='SUC' ;
									INNER JOIN sistipodoctos t4 ON t1.idtipodocto=t4.idtipodocto  ;
							WHERE t0.iddocto=lnidDoc  AND t0.eliminado=0 INTO CURSOR cc_invtmp READWRITE 
			
			REPLACE debe WITH ROUND(debe,2),haber WITH ROUND(haber,2) all
			GO top
			
			llSeContabiliza=NVL(tipoconta,0)>0
			
			IF llSeContabiliza=.t.
				******* cambiando a cuentas de matriz (cuenta de detalle )
				IF pnMatrizInv<>0
					REPLACE idctamatrizinv WITH _CuentaMatriz(idcuenta,1,codmatrizinv,codmatrizsuc) all
					REPLACE idcuenta WITH IIF(idctamatrizinv<>0,idctamatrizinv,idcuenta) all
				ENDIF 

				SELECT MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,SPACE(15) as numeropartida,;
							tt0.iddocto as idpartida,idcuenta,;
							MAX(ALLTRIM(tt0.tipodocto)+' del dia '+DTOC(tt1.fechadocto)) as concepto,SUM(debe) as debe,SUM(haber) as haber,;
							MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,idorigen,MIN(0) as impreso,;
							MAX(tt0.fecalta) as fecalta,MAX(ldfecmodpartida) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
							MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocosto,MAX(tt0.notas) as notas ;
					FROM (select * FROM cc_invtmp) as tt0 ;
							INNER JOIN invinventarios tt1 ON tt0.iddocto=tt1.iddocto ;
						GROUP BY tt0.iddocto,tt0.idorigen,tt0.idcuenta,tt0.idctamatrizinv,tt0.idsucursal,tt0.idctrocosto ;
						ORDER BY tt0.iddocto,tt0.idorigen,tt0.idcuenta,tt0.idctamatrizinv,tt0.idsucursal,tt0.idctrocosto ;
					INTO CURSOR c_miPartida READWRITE 
			ENDIF 
			IF _tally>0 AND llSeContabiliza=.t.
				***** evaluando si la partida ya existe o hay que crearla como nueva
				IF SEEK(lnidDoc,"ctbpartidas","idpartida")
					llPartidaNueva=.f.
					lcNumpar=ctbpartidas.numeropartida
				ELSE
					llPartidaNueva=.t.
				ENDIF 
				
				
				SELECT NVL(SUM(NVL(a.debe,0000000000.00)-NVL(a.haber,0000000000.00)),0) ;
					from c_miPartida a INNER JOIN ctbcuentas b ON a.idcuenta=b.idcuenta AND b.detalle=1 ;
					WHERE a.idcuenta<>0 INTO ARRAY laDescuadrada
 
				IF ROUND(laDescuadrada,2) =0
					IF llPartidaNueva
						GO TOP IN c_miPartida
						lnidTipoPartemp=c_miPartida.idtipopar
						lnFecpartemp=c_miPartida.fechapartida
						lcNumpar=AsignaNumeroPartida(lnsqlid,lnidTipoPartemp,lnFecpartemp,pcnodo,1)
						lcconceptmp=SUBSTR(ALLTRIM(concepto)+' '+ALLTRIM(notas),1,250)

						REPLACE idpartidad WITH _SiguienteIdTabla(pcNodo,"DET") all
						INSERT INTO ctbpartidas (idpartida,idtipopar,fechapartida,numeropartida,concepto,monto,;
										periodo,origen,impreso,fecalta,fecmod,nodo,eliminado,iduser,pcuser,idsucursal,idctrocosto);
								SELECT MAX(idpartida),MAX(idtipopar),MAX(fechapartida),MAX(lcNumpar),MAX(lcconceptmp),SUM(debe),;
									MAX(periodo),MAX(origen),MAX(impreso),MAX(fecalta),MAX(fecmod),MAX(nodo),MAX(eliminado),MAX(iduser),;
									MAX(pcuser),MAX(idsucursal),MAX(idctrocosto) FROM c_mipartida order by idpartida group by idpartida
						INSERT INTO ctbpartidasdeta (idpartidad,idpartida,idcuenta,conceptod,debe,haber,periodo,origen,;
										idorigen,fecalta,fecmod,nodo,eliminado,iduser,pcuser,idsucursal,idctrocosto) ;
								SELECT idpartidad,idpartida,idcuenta,concepto,debe,haber,periodo,origen,;
										idorigen,fecalta,fecmod,nodo,eliminado,iduser,pcuser,idsucursal,idctrocosto ;
									FROM c_mipartida 
					ELSE
						GO TOP IN c_miPartida
						ldfecpar=fechapartida
						lcconceptmp=SUBSTR(ALLTRIM(concepto)+' '+ALLTRIM(notas),1,250)
						SUM ALL debe TO lnMontopar

						UPDATE c_miPartida ;
							SET 	idpartidad=a.idpartidad,numeropartida=lcNumpar,fechapartida=ldfecpar FROM ctbpartidasdeta a ;
							WHERE c_miPartida.idpartida=a.idpartida AND ;
									c_miPartida.idorigen=a.idorigen AND ;
									c_miPartida.idcuenta=a.idcuenta AND ;
									c_miPartida.idsucursal=a.idsucursal AND ;
									c_miPartida.idctrocosto=a.idctrocosto AND ;
									c_miPartida.origen=a.origen 

						REPLACE idpartidad WITH _SiguienteIdTabla(pcNodo,"DET") for idpartidad=0 

						UPDATE ctbpartidas SET concepto =lcconceptmp, monto=lnMontopar,fecmod=ldfecmodpartida,fechapartida=ldfecpar WHERE idpartida=lnidDoc
						
						***** pequeños cambios para hacer mas rapido el proceso
						INDEX on idpartidad TAG llave
						SET ORDER TO llave 
						***** borrando registros que ya no estan en la partida
						DELETE FROM ctbpartidasdeta WHERE idpartida=lnidDoc AND idpartidad NOT in (select idpartidad FROM c_mipartida)
						***** actualizando la partida
						UPDATE ctbpartidasdeta ;
							SET 	conceptod=a.concepto,;
									debe=a.debe,;
									haber=a.haber,;
									eliminado=a.eliminado,;
									iduser=a.iduser,;
									fecmod=a.fecmod ,;
									pcuser=a.pcuser ;
								FROM c_miPartida a ;
							WHERE ctbpartidasdeta.idpartidad=a.idpartidad AND ctbpartidasdeta.idpartida=lnidDoc
						SET ORDER TO 
								
						INSERT INTO ctbpartidasdeta (idpartidad,idpartida,idcuenta,conceptod,debe,haber,periodo,origen,;
										idorigen,fecalta,fecmod,nodo,eliminado,iduser,pcuser,idsucursal,idctrocosto) ;
								SELECT idpartidad,idpartida,idcuenta,concepto,debe,haber,periodo,origen,;
										idorigen,fecalta,fecmod,nodo,eliminado,iduser,pcuser,idsucursal,idctrocosto ;
									FROM c_mipartida WHERE EMPTY(numeropartida)
																
					ENDIF 
				ELSE
					IF plRecosteando=.f.
						MESSAGEBOX("Partida Descuadrada..."+CHR(13)+"Diferencia "+ALLTRIM(STR(laDescuadrada,12,2)),16,"Error al Contabilizar....",2000)
						llRetornaPartida=.f.
					ENDIF 
				ENDIF 
			ENDIF 
			
			USE IN cc_invtmp
			
			IF llinvd
				USE IN invinventariosdeta 
			ENDIF 
			IF llinvr
				USE IN invinventarios 
			ENDIF 
			IF llinvp
				USE IN invproductos 
			ENDIF 
			IF llinvf
				USE IN invfamilias
			ENDIF 
			IF llinvtd
				USE IN sistipodoctos 
			ENDIF 
			IF llinvpr
				USE IN ctbpartidas 
			ENDIF 
			IF llinvpd
				USE IN ctbpartidasdeta 
			ENDIF
			IF llinvCta
				USE IN ctbcuentas
			ENDIF 
			IF llSeContabiliza=.t.
				*USE IN c_miPartida
			ENDIF 
		ENDIF 
	ENDIF 
	objObjetos.actualizarventanapadre(1)
	RETURN llRetornaPartida
ENDFUNC 




***************** PARTIDA DE COMPRAS   ******************************
FUNCTION _generaPartidaCompras(lnsqlid,lnidDoc,lnTipConec)
	llRetornaPartida=.t.

	IF TYPE("pnGeneracionMasivadePartidas")<>'N'
		pnGeneracionMasivadePartidas=0
	ENDIF 

	IF lnsqlid<>0 AND lnidDoc<>0 AND pcnodo=pcnodoctb AND plModuloConta=.t.
		ldfecmodpartida=DATETIME()
	*llRetornaPartida=.t.
	llRetornaPartida=''
	 
		IF lnTipConec=1		&&&& nativo
			llinvd=!USED("cyvComprasdeta")
			IF llinvd
				USE pcSysDir+pcdb+"\cyvComprasdeta" IN 0 SHARED AGAIN  ORDER iddoctod
			ENDIF 
			llinvr=!USED("cyvCompras")
			IF llinvr
				USE pcSysDir+pcdb+"\cyvCompras" IN 0 SHARED AGAIN  ORDER iddocto
			ENDIF 
			llinvp=!USED("invproductos")
			IF llinvp
				USE pcSysDir+pcdb+"\invproductos" IN 0 SHARED AGAIN  ORDER idproducto
			ENDIF 
			llinvf=!USED("invfamilias")
			IF llinvf
				USE pcSysDir+pcdb+"\siscata" IN 0 SHARED AGAIN  ORDER id ALIAS invfamilias
			ENDIF 
			llinvtd=!USED("sistipodoctos")
			IF llinvtd
				USE pcSysDir+pcdb+"\sistipodoctos" IN 0 SHARED AGAIN  ORDER idtipodocto
			ENDIF 
			llinvclpr=!USED("cyvclipro")
			IF llinvclpr
				USE pcSysDir+pcdb+"\cyvclipro" IN 0 SHARED AGAIN  ORDER idclipro
			ENDIF 
			llinvcyb=!USED("cybcajabancos")
			IF llinvcyb
				USE pcSysDir+pcdb+"\cybcajabancos" IN 0 SHARED AGAIN  ORDER idcajban
			ENDIF 
			llinvpr=!USED("ctbpartidas")
			IF llinvpr
				USE pcSysDir+pcdb+"\ctbpartidas" IN 0 SHARED AGAIN  ORDER idpartida
			ENDIF 
			llinvpd=!USED("ctbpartidasdeta")
			IF llinvpd
				USE pcSysDir+pcdb+"\ctbpartidasdeta" IN 0 SHARED AGAIN  ORDER idpartidad
			ENDIF 
			llinvCta=!USED("ctbcuentas")
			IF llinvCta
				USE pcSysDir+pcdb+"\ctbcuentas" IN 0 SHARED AGAIN  ORDER idcuenta
			ENDIF 
		
			*** si es una compra de contado se provisiona la renta si es de credito no se toma en cuenta la renta (esto sin efecto.. siempre se va provisionar)
			SELECT t0.iddocto,t0.iddoctod,t0.idproducto,t2.idctaingcostos,(SELECT MAX(tipoiva) as tipoiva FROM cyvComprasdeta WHERE iddocto=lnidDoc) as tipoiva,;
						t1.tiporetper,t1.ctrolcom,t1.periodo,t0.origen,t1.idsucursal,t0.idctrocosto,t1.idctrocosto as idctrocostoSuc,t1.idcajban,;
						t0.status,t0.eliminado,t0.tipoprod,t1.condipago,t0.costototal,;
						t1.rentadocto,t1.FovialDocto,T1.CotransDocto,t1.ivadocto,t1.cescdocto,t1.retperdocto,t1.totaldocto,t1.percepccliq,t1.numeroccliq,;
						IIF(t1.condipago=0,NVL(t6.idctacajban1,000000000),IIF(NVL(t5.ctacliloc,0)=0,IIF(t5.extranjero=0,NVL(pnctaprvloc,000000000),NVL(pnctaprvext,000000000)),t5.ctacliloc)) as idcuentaPago,;
						NVL(pnctaRenta,0000000000) as idcuentaRenta,NVL(pnctaFovial,0000000000) as idcuentaFovial,NVL(pnctaCotrans,0000000000) as idcuentaCotrans,;
						IIF(pnVtasConCosto=1,;
								IIF(NVL(t3.ctainvent,0)=0,IIF(NVL(t7.ctainvent,0)=0,pnCtaInvent,t7.ctainvent),t3.ctainvent),;
								IIF(t1.ctrolcom=1,;
									IIF(NVL(t3.ctaEgrCom,000000000)=0,IIF(NVL(t7.ctaEgrCom,000000000)=0,NVL(pnctaEgrCom,0000000000),t7.ctaEgrCom),t3.ctaEgrCom),;
									IIF(NVL(t3.ctaEgrRYDCom,000000000)=0,IIF(NVL(t7.ctaEgrRYDCom,000000000)=0,NVL(pnctaEgrRYDCom,0000000000),t7.ctaEgrRYDCom),t3.ctaEgrRYDCom))) as idcuentaInvent	,;	
						IIF(NVL(t2.idctaingcostos,000000000)<>0,t2.idctaingcostos,NVL(t2.idctainggasto,000000000)) as idcuentaIngGas,;
						IIF(INLIST(t4.tipoicv,10,11,12,13),NVL(pnctacredfisext,000000000),NVL(pnctacredfisloc,000000000)) as idcuentacredfis,;
						NVL(pnCtaPerc,000000000) as idcuentaperc,NVL(pnCtaCescCom,000000000) as idcuentacesc,NVL(pnctaantiva,000000000) as idcuentaantiva, ;
						SUBSTR(IIF(t1.condipago=0,IIF(t6.tipocajban=2,;
														IIF(t1.ctrolcom=1,'Chq.'+ALLTRIM(t1.numerochq)+' '+ALLTRIM(t1.nomcheque)+' por '+'US$'+ALLTRIM(TRANSFORM(t1.totaldocto-t1.rentadocto,PcmasTotal)),;
																			'Reversion pago '+ALLTRIM(t1.nomcheque)+' por '+'US$'+ALLTRIM(TRANSFORM(t1.totaldocto-t1.rentadocto,PcmasTotal))),;
														IIF(t1.ctrolcom=1,'Pago ','Devolucion ')+ALLTRIM(t4.clave)+' '+ALLTRIM(t1.numero)+' '+ALLTRIM(t1.clipro)+' '+'US$'+ALLTRIM(TRANSFORM(t1.totaldocto-t1.rentadocto,PcmasTotal))),;
											IIF(t1.ctrolcom=1,'Cargo ','Abono ')+ALLTRIM(t4.clave)+' '+ALLTRIM(t1.numero)+' '+ALLTRIM(t1.clipro)+' '+'US$'+ALLTRIM(TRANSFORM(t1.totaldocto,PcmasTotal)));
								,1,250) as conceptoPago,;
						SUBSTR(IIF(t1.ctrolcom=1,"Retencion ","Dev. Retencion ")+ALLTRIM(t4.clave)+' '+;
								ALLTRIM(t1.numero)+' ' +ALLTRIM(IIF(EMPTY(NVL(t1.nomcheque,'')),t1.clipro,t1.nomcheque)),1,250) as conceptoRenta,;
						SUBSTR(IIF(t1.ctrolcom=1,'Compra Mercaderia segun ','Dev. Mercaderia segun ')+ALLTRIM(t4.clave)+' '+ALLTRIM(t1.numero),1,250) as conceptoinvent,;
						SUBSTR(IIF(NVL(t2.idctaingcostos,0)<>0,IIF(t1.ctrolcom=1,'Costo o Gasto ','Dev. Costo o Gasto '),IIF(t1.ctrolcom=1,'Pago ','Dev. pago '))+ALLTRIM(t0.producto),1,250) as conceptoIngGas,;
						SUBSTR(IIF(t1.ctrolcom=1,'','Devolucion ')+ALLTRIM(t4.clave)+' '+ALLTRIM(t1.numero)+' '+ALLTRIM(t1.clipro),1,250) as conceptocredfis,;
						SUBSTR(IIF(t1.ctrolcom=1,IIF(tiporetper=1,'Retencion ','Percepcion '),IIF(tiporetper=1,'Dev. Retencion ','Dev. Percepcion '))+ALLTRIM(t4.clave)+' '+ALLTRIM(t1.numero)+' '+ALLTRIM(t1.clipro),1,250) as conceptoperc,;
						SUBSTR(IIF(t1.ctrolcom=1,'CESC ','Devolucion CESC ')+ALLTRIM(t4.clave)+' '+ALLTRIM(t1.numero)+' '+ALLTRIM(t1.clipro),1,250) as conceptocesc,;
						SUBSTR(IIF(t1.ctrolcom=1,'FOVIAL ','Devolucion FOVIAL ')+ALLTRIM(t4.clave)+' '+ALLTRIM(t1.numero)+' '+ALLTRIM(t1.clipro),1,250) as  conceptoFovial,;
						SUBSTR(IIF(t1.ctrolcom=1,'COTRANS ','Devolucion COTRANS ')+ALLTRIM(t4.clave)+' '+ALLTRIM(t1.numero)+' '+ALLTRIM(t1.clipro),1,250) as  conceptoCotrans,;
						SUBSTR(IIF(t1.ctrolcom=1,'Pago C.C.Liq.','Devol. C.C.Liq.')+ALLTRIM(t1.numeroccliq)+' '+ALLTRIM(t1.clipro),1,250) as conceptoantiva,;
						t1.fecalta,ldfecmodpartida as fecmod,pcnodo as nodo,IIF(pcVersionS=='AZURE',iif(t1.condipago=0,253,251),t4.idtipopar) as idtipopar,t1.notas,t4.tipoconta, ;
						NVL(t7.codmatriz,SPACE(30)) as codmatrizsuc,NVL(t3.codmatriz,SPACE(30)) as codmatrizinv ,0000000000 as idctamatrizinv,t9.cod as TipPar,t1.presupuesto,t1.ciclo,t3.ctainvent as jr ; 
				FROM cyvComprasdeta t0 ;
						INNER JOIN cyvCompras t1 ON t0.iddocto=t1.iddocto ;
						INNER JOIN invproductos t2 ON t0.idproducto=t2.idproducto ;
						LEFT JOIN invfamilias t3 ON t2.idfamilia=t3.id AND t3.origen='LIN' ;
						INNER JOIN sistipodoctos t4 ON t1.idtipodocto=t4.idtipodocto  ;
						INNER JOIN cyvclipro t5 ON t1.idclipro=t5.idclipro ;
						INNER JOIN siscata t7 ON t1.idsucursal=t7.id ;
						LEFT JOIN siscata t9 ON t4.idtipopar=t9.id AND t9.origen='TPA';
						left JOIN cybcajabancos t6 ON t1.idcajban=t6.idcajban;
				WHERE t1.noContabilizable=0 AND t0.iddocto=lnidDoc ORDER BY t0.tipoprod,t2.codprod,t0.producto,t0.idctrocosto INTO CURSOR c_PartTmp READWRITE 
			
			* Control 0 no genera partida; solo 1 y 2 tienen efecto contable.
			IF INLIST(NVL(c_PartTmp.ctrolcom,0),1,2)
			*lnConRenta=c_PartTmp.condipago=0 and rentadocto<>0
			lnConRenta=c_PartTmp.rentadocto<>0
			
			lcpresupuestogano=ALLTRIM(c_PartTmp.presupuesto)
			lcCicloGano=ALLTRIM(c_PartTmp.ciclo)

			lnCtrolComPart=c_PartTmp.ctrolcom
			lntiporetperPart=c_PartTmp.tiporetper
			lnStatusPart=c_PartTmp.status
			lcTipPar=ALLTRIM(TipPar)
			DIMENSION laDescuadrada [1,1]
			laDescuadrada(1)=0
			
			lnSeContabiliza=NVL(tipoconta,0)>0
			
			******* cambiando a cuentas de matriz (cuenta de detalle )
			IF pnMatrizInv<>0
				REPLACE idctamatrizinv WITH _CuentaMatriz(idcuentaInvent,1,codmatrizinv,codmatrizsuc) ALL IN c_PartTmp
			ENDIF 
			
			IF lnSeContabiliza=.t.
			
				**** provision o pago de la compra
				SELECT TOP 1 MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
							tt0.iddocto as idpartida,MAX(tt0.idcuentaPago) as idcuenta,MAX(tt0.conceptopago) as concepto,;
							max(IIF(tt0.ctrolcom=1,0000000000.00000000,tt0.totaldocto-tt0.rentadocto)) as debe,;
							max(IIF(tt0.ctrolcom=1,tt0.totaldocto-tt0.rentadocto,0000000000.00000000)) as haber,;
							MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolcom=1,2,1)))+'10000000')) as idorigen,MIN(0) as impreso,;
							MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
							MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocostoSuc as idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoPago)+' '+tt0.notas,1,250)) as notas ;
					FROM c_PartTmp tt0 ;
							INNER JOIN cyvCompras tt1 ON tt0.iddocto=tt1.iddocto ;
						GROUP BY tt0.iddocto,tt0.idcuentapago,tt0.idsucursal,tt0.idctrocostoSuc ;
						ORDER BY tt0.iddocto,tt0.idcuentapago,tt0.idsucursal,tt0.idctrocostoSuc ;
					INTO CURSOR c_miPar1 READWRITE
				lcConceptoGeneral=notas

				****** retencion renta si es que es contado y aplica la retencion por servicio
				SELECT TOP 1 MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
							tt0.iddocto as idpartida,MAX(tt0.idcuentarenta) as idcuenta,MAX(tt0.conceptorenta) as concepto,;
							max(IIF(tt0.ctrolcom=1,0000000000.00000000,tt0.rentadocto)) as debe,;
							max(IIF(tt0.ctrolcom=1,tt0.rentadocto,0000000000.00000000)) as haber,;
							MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolcom=1,2,1)))+'20000000')) as idorigen,MIN(0) as impreso,;
							MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
							MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocostoSuc as idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoPago)+' '+tt0.notas,1,250)) as notas ;
					FROM c_PartTmp tt0 ;
							INNER JOIN cyvCompras tt1 ON tt0.iddocto=tt1.iddocto ;
						GROUP BY tt0.iddocto,tt0.idcuentarenta,tt0.idsucursal,tt0.idctrocostoSuc ;
						ORDER BY tt0.iddocto,tt0.idcuentarenta,tt0.idsucursal,tt0.idctrocostoSuc ;
					INTO CURSOR c_miPar2 READWRITE

				****** compra de inventarios
				SELECT MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
							tt0.iddocto as idpartida,MAX(IIF(pnMatrizInv<>0,tt0.idctamatrizinv,tt0.idcuentainvent)) as idcuenta,MAX(tt0.conceptoinvent) as concepto,;
							SUM(IIF(tt0.ctrolcom=1,IIF(tt0.status=0 OR tt0.eliminado=1,0000000000.00000000,tt0.costototal),0000000000.00000000)) as debe,;
							SUM(IIF(tt0.ctrolcom=1,0000000000.00000000,IIF(tt0.status=0 OR tt0.eliminado=1,0000000000.00000000,tt0.costototal))) as haber,;
							MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolcom=1,1,2)))+'30000000')) as idorigen,MIN(0) as impreso,;
							MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
							MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocostoSuc as idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoPago)+' '+tt0.notas,1,250)) as notas ;
					FROM c_PartTmp tt0 ;
							INNER JOIN cyvCompras tt1 ON tt0.iddocto=tt1.iddocto ;
						GROUP BY tt0.iddocto,tt0.idcuentainvent,tt0.idctamatrizinv,tt0.idsucursal,tt0.idctrocostoSuc ;
						ORDER BY tt0.iddocto,tt0.idcuentainvent,tt0.idctamatrizinv,tt0.idsucursal,tt0.idctrocostoSuc ;
						WHERE tt0.tipoprod=1 ;
					INTO CURSOR c_miPar3 READWRITE
				
				****** pago de gastos
				SELECT MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
							tt0.iddocto as idpartida,MAX(tt0.idcuentaIngGas) as idcuenta,MAX(tt0.conceptoIngGas) as concepto,;
							SUM(IIF(tt0.ctrolcom=1,IIF(tt0.status=0 OR tt0.eliminado=1,0000000000.00000000,tt0.costototal),0000000000.00000000)) as debe,;
							SUM(IIF(tt0.ctrolcom=1,0000000000.00000000,IIF(tt0.status=0 OR tt0.eliminado=1,0000000000.00000000,tt0.costototal))) as haber,;
							MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolcom=1,1,2)))+'4'+SUBSTR(STR(tt0.iddoctod,9,0),3,7))) as idorigen,MIN(0) as impreso,;
							MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
							MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoPago)+' '+tt0.notas,1,250)) as notas ;
					FROM c_PartTmp tt0 ;
							INNER JOIN cyvCompras tt1 ON tt0.iddocto=tt1.iddocto ;
						GROUP BY tt0.iddocto,tt0.idcuentaIngGas,tt0.idproducto,tt0.idsucursal,tt0.idctrocosto ;
						ORDER BY tt0.iddocto,tt0.idcuentaIngGas,tt0.idproducto,tt0.idsucursal,tt0.idctrocosto ;
						WHERE (tt0.tipoprod=3 OR NVL(tt0.idctaingcostos,0)<>0)  ;
					INTO CURSOR c_miPar4 READWRITE
				
				****** debitos fiscal si es compra con iva
				SELECT MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
							tt0.iddocto as idpartida,MAX(tt0.idcuentacredfis) as idcuenta,MAX(tt0.conceptocredfis) as concepto,;
							max(IIF(tt0.ctrolcom=1,tt0.ivadocto,0000000000.00000000)) as debe,;
							max(IIF(tt0.ctrolcom=1,0000000000.00000000,tt0.ivadocto)) as haber,;
							MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolcom=1,1,2)))+'50000000')) as idorigen,MIN(0) as impreso,;
							MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
							MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocostoSuc as idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoPago)+' '+tt0.notas,1,250)) as notas ;
					FROM c_PartTmp tt0 ;
							INNER JOIN cyvCompras tt1 ON tt0.iddocto=tt1.iddocto ;
						GROUP BY tt0.iddocto,tt0.idcuentacredfis,tt0.idsucursal,tt0.idctrocostoSuc ;
						ORDER BY tt0.iddocto,tt0.idcuentacredfis,tt0.idsucursal,tt0.idctrocostoSuc ;
						WHERE tt0.ivadocto<>0 ;
					INTO CURSOR c_miPar5 READWRITE

				***** percepcion si es que tiene
				IF lntiporetperPart=1		&&& es retencion
					SELECT MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
								tt0.iddocto as idpartida,MAX(tt0.idcuentaperc) as idcuenta,MAX(tt0.conceptoperc) as concepto,;
								max(IIF(tt0.ctrolcom=1,0000000000.00000000,tt0.retperdocto)) as debe,;
								max(IIF(tt0.ctrolcom=1,tt0.retperdocto,0000000000.00000000)) as haber,;
								MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolcom=1,2,1)))+'60000000')) as idorigen,MIN(0) as impreso,;
								MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
								MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocostoSuc as idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoPago)+' '+tt0.notas,1,250)) as notas ;
						FROM c_PartTmp tt0 ;
								INNER JOIN cyvCompras tt1 ON tt0.iddocto=tt1.iddocto ;
							GROUP BY tt0.iddocto,tt0.idcuentaperc,tt0.idsucursal,tt0.idctrocostoSuc ;
							ORDER BY tt0.iddocto,tt0.idcuentaperc,tt0.idsucursal,tt0.idctrocostoSuc ;
							WHERE tt0.retperdocto<>0 ;
						INTO CURSOR c_miPar6  READWRITE
				ELSE
					SELECT MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
								tt0.iddocto as idpartida,MAX(tt0.idcuentaperc) as idcuenta,MAX(tt0.conceptoperc) as concepto,;
								max(IIF(tt0.ctrolcom=1,tt0.retperdocto,0000000000.00000000)) as debe,;
								max(IIF(tt0.ctrolcom=1,0000000000.00000000,tt0.retperdocto)) as haber,;
								MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolcom=1,1,2)))+'60000000')) as idorigen,MIN(0) as impreso,;
								MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
								MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocostoSuc as idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoPago)+' '+tt0.notas,1,250)) as notas ;
						FROM c_PartTmp tt0 ;
								INNER JOIN cyvCompras tt1 ON tt0.iddocto=tt1.iddocto ;
							GROUP BY tt0.iddocto,tt0.idcuentaperc,tt0.idsucursal,tt0.idctrocostoSuc ;
							ORDER BY tt0.iddocto,tt0.idcuentaperc,tt0.idsucursal,tt0.idctrocostoSuc ;
							WHERE tt0.retperdocto<>0 ;
						INTO CURSOR c_miPar6  READWRITE
				ENDIF 
				***** Cesc si es que tiene
				SELECT MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
							tt0.iddocto as idpartida,MAX(tt0.idcuentacesc) as idcuenta,MAX(tt0.conceptocesc) as concepto,;
							max(IIF(tt0.ctrolcom=1,tt0.cescdocto,0000000000.00000000)) as debe,;
							max(IIF(tt0.ctrolcom=1,0000000000.00000000,tt0.cescdocto)) as haber,;
							MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolcom=1,1,2)))+'70000000')) as idorigen,MIN(0) as impreso,;
							MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
							MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocostoSuc as idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoPago)+' '+tt0.notas,1,250)) as notas ;
					FROM c_PartTmp tt0 ;
							INNER JOIN cyvCompras tt1 ON tt0.iddocto=tt1.iddocto ;
						GROUP BY tt0.iddocto,tt0.idcuentaperc,tt0.idsucursal,tt0.idctrocostoSuc ;
						ORDER BY tt0.iddocto,tt0.idcuentaperc,tt0.idsucursal,tt0.idctrocostoSuc ;
						WHERE tt0.cescdocto<>0 ;
					INTO CURSOR c_miPar7  READWRITE
				
				****** Fovial y Contrans en compras
					SELECT MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
								tt0.iddocto as idpartida,MAX(tt0.idcuentafovial) as idcuenta,MAX(tt0.conceptoFovial) as concepto,;
								max(IIF(tt0.ctrolcom=2,0000000000.00000000,tt0.fovialdocto)) as debe,;
								max(IIF(tt0.ctrolcom=2,tt0.fovialdocto,0000000000.00000000)) as haber,;
								MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolcom=1,2,1)))+'91000000')) as idorigen,MIN(0) as impreso,;
								MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
								MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocostoSuc as idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoFovial)+' '+tt0.notas,1,250)) as notas ;
						FROM c_PartTmp tt0 ;
								INNER JOIN cyvCompras tt1 ON tt0.iddocto=tt1.iddocto ;
							GROUP BY tt0.iddocto,tt0.idcuentafovial,tt0.idsucursal,tt0.idctrocostoSuc ;
							ORDER BY tt0.iddocto,tt0.idcuentafovial,tt0.idsucursal,tt0.idctrocostoSuc ;
							WHERE tt0.fovialdocto<>0 ;
						INTO CURSOR c_miPar91 READWRITE
					
					SELECT MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
								tt0.iddocto as idpartida,MAX(tt0.idcuentaCotrans) as idcuenta,MAX(tt0.conceptoCotrans) as concepto,;
								max(IIF(tt0.ctrolcom=2,0000000000.00000000,tt0.cotransdocto)) as debe,;
								max(IIF(tt0.ctrolcom=2,tt0.cotransdocto,0000000000.00000000)) as haber,;
								MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolcom=1,2,1)))+'92000000')) as idorigen,MIN(0) as impreso,;
								MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
								MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocostoSuc as idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoCotrans)+' '+tt0.notas,1,250)) as notas ;
						FROM c_PartTmp tt0 ;
								INNER JOIN cyvCompras tt1 ON tt0.iddocto=tt1.iddocto ;
							GROUP BY tt0.iddocto,tt0.idcuentaCotrans,tt0.idsucursal,tt0.idctrocostoSuc ;
							ORDER BY tt0.iddocto,tt0.idcuentaCotrans,tt0.idsucursal,tt0.idctrocostoSuc ;
							WHERE tt0.cotransdocto<>0 ;
						INTO CURSOR c_miPar92 READWRITE
				
				***** Comprobante contable de liquidacion
				SELECT MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
							tt0.iddocto as idpartida,MAX(tt0.idcuentaantiva) as idcuenta,MAX(tt0.conceptoantiva) as concepto,;
							max(IIF(tt0.ctrolcom=1,tt0.percepccliq,0000000000.00000000)) as debe,;
							max(IIF(tt0.ctrolcom=1,0000000000.00000000,tt0.percepccliq)) as haber,;
							MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolcom=1,1,2)))+'80000000')) as idorigen,MIN(0) as impreso,;
							MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
							MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocostoSuc as idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoPago)+' '+tt0.notas,1,250)) as notas ;
					FROM c_PartTmp tt0 ;
							INNER JOIN cyvCompras tt1 ON tt0.iddocto=tt1.iddocto ;
						GROUP BY tt0.iddocto,tt0.idcuentaperc,tt0.idsucursal,tt0.idctrocostoSuc ;
						WHERE tt0.percepccliq<>0 ;
				UNION ALL ;
				SELECT MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
							tt0.iddocto as idpartida,MAX(tt0.idcuentapago) as idcuenta,MAX(tt0.conceptoantiva) as concepto,;
							max(IIF(tt0.ctrolcom=1,0000000000.00000000,tt0.percepccliq)) as debe,;
							max(IIF(tt0.ctrolcom=1,tt0.percepccliq,0000000000.00000000)) as haber,;
							MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolcom=1,2,1)))+'80000000')) as idorigen,MIN(0) as impreso,;
							MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
							MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocostoSuc as idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoPago)+' '+tt0.notas,1,250)) as notas ;
					FROM c_PartTmp tt0 ;
							INNER JOIN cyvCompras tt1 ON tt0.iddocto=tt1.iddocto ;
						GROUP BY tt0.iddocto,tt0.idcuentaperc,tt0.idsucursal,tt0.idctrocostoSuc ;
						WHERE tt0.percepccliq<>0 ;
					INTO CURSOR c_miPar8  READWRITE

				IF !lnConRenta
					DELETE all IN c_miPar2
				ENDIF 

				SELECT * FROM c_miPar1 UNION ALL ;
				SELECT * FROM c_miPar2 UNION ALL ;
				SELECT * FROM c_miPar3 UNION ALL ;
				SELECT * FROM c_miPar4 UNION ALL ;
				SELECT * FROM c_miPar5 UNION ALL ;
				SELECT * FROM c_miPar6 UNION ALL ;
				SELECT * FROM c_miPar7 UNION ALL ;
				SELECT * FROM c_miPar91 UNION ALL ;
				SELECT * FROM c_miPar92 UNION ALL ;
				SELECT * FROM c_miPar8 ;
				ORDER BY idorigen,idsucursal,idctrocosto  INTO CURSOR c_miPartida READWRITE 
				
				REPLACE debe WITH ROUND(debe,2),haber WITH ROUND(haber,2) all
				
				COUNT TO lnEsQuedan FOR idcuenta=0 AND "QUEDAN"$SUBSTR(concepto,1,15)
				
				IF lnStatusPart=0		&&& anulado
					REPLACE debe WITH 0, haber WITH 0 all
				ELSE 
					REPLACE debe WITH ROUND(debe,2), haber WITH ROUND(haber,2) all
				ENDIF 
				
				***** cuadrando diferencias de centavos
				lnvaldebe=0
				lnvalhaber=0
				lnidorigen=0
		*		lnCtrolComPart
	 
				SCAN all
					lnvaldebe=lnvaldebe+debe
					lnvalhaber=lnvalhaber+haber
					IF SUBSTR(alltrim(STR(idorigen)),2,1)>'2' AND lnidorigen=0
						lnidorigen=idorigen
					ENDIF 
				ENDSCAN 

				lnDifdebhab=lnvaldebe-lnvalhaber
				IF lnDifdebhab<>0
					IF lnCtrolComPart=1		&&& es compra 
						IF lnDifdebhab>0
							REPLACE debe WITH debe-ABS(lnDifdebhab) FOR idorigen=lnidorigen
						ELSE
							REPLACE debe WITH debe+ABS(lnDifdebhab) FOR idorigen=lnidorigen
						ENDIF 
					ELSE					&&& es devolucion
						IF lnDifdebhab>0
							REPLACE haber WITH haber+ABS(lnDifdebhab) FOR idorigen=lnidorigen
						ELSE
							REPLACE haber WITH haber-ABS(lnDifdebhab) FOR idorigen=lnidorigen
						ENDIF 
					ENDIF 
				ENDIF 
				
				 					
				USE IN c_miPar1
				USE IN c_miPar2
				USE IN c_miPar3
				USE IN c_miPar4
				USE IN c_miPar5
				USE IN c_miPar6
				USE IN c_miPar7
				USE IN c_miPar8
				SELECT c_miPartida

				
				SELECT NVL(SUM(NVL(a.debe,0000000000.00)-NVL(a.haber,0000000000.00)),0)  ;
					from c_miPartida a INNER JOIN ctbcuentas b ON a.idcuenta=b.idcuenta AND b.detalle=1 ;
					WHERE a.idcuenta<>0 INTO ARRAY laDescuadrada
				
*SUSPEND 				
				
				IF lnSeContabiliza=.t.
					IF ROUND(laDescuadrada,2) =0 and lnEsQuedan=0

						IF recno()<>0
							***** evaluando si la partida ya existe o hay que crearla como nueva
							IF SEEK(lnidDoc,"ctbpartidas","idpartida")
								llPartidaNueva=.f.
								lcNumpar=ctbpartidas.numeropartida
							ELSE
								llPartidaNueva=.t.
							ENDIF 

							IF llPartidaNueva
								GO TOP IN c_miPartida
								lnidTipoPartemp=c_miPartida.idtipopar
								lnFecpartemp=c_miPartida.fechapartida
								lcNumpar=AsignaNumeroPartida(lnsqlid,lnidTipoPartemp,lnFecpartemp,pcnodo,1)
								lcconceptmp=notas

								REPLACE idpartidad WITH _SiguienteIdTabla(pcNodo,"DET") all
								INSERT INTO ctbpartidas (idpartida,idtipopar,fechapartida,numeropartida,concepto,monto,;
												periodo,origen,impreso,fecalta,fecmod,nodo,eliminado,iduser,pcuser,idsucursal,idctrocosto,presupuesto,ciclo);
										SELECT MAX(idpartida),MAX(idtipopar),MAX(fechapartida),MAX(lcNumpar),MAX(lcconceptmp),SUM(debe),;
											MAX(periodo),MAX(origen),MAX(impreso),MAX(fecalta),MAX(fecmod),MAX(nodo),MAX(eliminado),MAX(iduser),;
											MAX(pcuser),MAX(idsucursal),MAX(idctrocosto),lcpresupuestogano,lcciclogano FROM c_mipartida order by idpartida group by idpartida
								INSERT INTO ctbpartidasdeta (idpartidad,idpartida,idcuenta,conceptod,debe,haber,periodo,origen,;
												idorigen,fecalta,fecmod,nodo,eliminado,iduser,pcuser,idsucursal,idctrocosto) ;
										SELECT idpartidad,idpartida,idcuenta,concepto,debe,haber,periodo,origen,;
												idorigen,fecalta,fecmod,nodo,eliminado,iduser,pcuser,idsucursal,idctrocosto ;
											FROM c_mipartida order by idorigen
								llRetornaPartida=lcTipPar+"-"+lcNumpar
							ELSE

								GO TOP IN c_miPartida
								ldfecpar=fechapartida
								
								lcconceptmp=lcConceptoGeneral
								SUM ALL debe TO lnMontopar

								UPDATE c_miPartida ;
									SET 	idpartidad=a.idpartidad,numeropartida=lcNumpar,fechapartida=ldfecpar FROM ctbpartidasdeta a ;
									WHERE c_miPartida.idpartida=a.idpartida AND ;
											c_miPartida.idorigen=a.idorigen AND ;
											c_miPartida.idcuenta=a.idcuenta AND ;
											c_miPartida.idsucursal=a.idsucursal AND ;
											c_miPartida.idctrocosto=a.idctrocosto AND ;
											c_miPartida.origen=a.origen 

								REPLACE idpartidad WITH _SiguienteIdTabla(pcNodo,"DET") for idpartidad=0 

								UPDATE ctbpartidas SET concepto =lcconceptmp, monto=lnMontopar,fecmod=ldfecmodpartida,fechapartida=ldfecpar,;
													presupuesto=lcpresupuestogano,ciclo=lcCicloGano WHERE idpartida=lnidDoc

								***** pequeños cambios para hacer mas rapido el proceso
								INDEX on idpartidad TAG llave
								SET ORDER TO llave 

								UPDATE ctbpartidasdeta ;
									SET 	conceptod=a.concepto,;
											debe=a.debe,;
											haber=a.haber,;
											eliminado=a.eliminado,;
											iduser=a.iduser,;
											fecmod=a.fecmod,;
											pcuser=a.pcuser ;
										FROM c_miPartida a ;
									WHERE ctbpartidasdeta.idpartidad=a.idpartidad AND ctbpartidasdeta.idpartida=lnidDoc			
								SET ORDER TO 

								INSERT INTO ctbpartidasdeta (idpartidad,idpartida,idcuenta,conceptod,debe,haber,periodo,origen,;
												idorigen,fecalta,fecmod,nodo,eliminado,iduser,pcuser,idsucursal,idctrocosto) ;
										SELECT idpartidad,idpartida,idcuenta,concepto,debe,haber,periodo,origen,;
												idorigen,fecalta,fecmod,nodo,eliminado,iduser,pcuser,idsucursal,idctrocosto ;
											FROM c_mipartida WHERE idpartidad NOT in (select idpartidad FROM ctbpartidasdeta WHERE idpartida=lnidDoc)
											
								DELETE from  ctbpartidasdeta WHERE idpartida=lnidDoc AND idpartidad NOT in (select b.idpartidad FROM c_mipartida b WHERE b.idpartida=lnidDoc AND b.idpartidad<>0)
								
								llRetornaPartida=lcTipPar+"-"+lcNumpar
							ENDIF 
						ENDIF 
					
					ELSE					
						IF lnEsQuedan>0
						ELSE 
							IF plRecosteando=.f. and pnGeneracionMasivadePartidas=0
								MESSAGEBOX("Partida Descuadrada..."+CHR(13)+"Diferencia "+ALLTRIM(STR(laDescuadrada,12,2)),16,"Error al Contabilizar....",2000)
								
								llRetornaPartida=""
							ENDIF 
						ENDIF 
					ENDIF 
				ENDIF 
				USE IN  c_miPartida
			
			ENDIF
			ENDIF
		
			* Una compra anulada nunca debe conservar importes contables, incluso si
			* cambio la configuracion contable o quedaron lineas antiguas sin empatar.
			IF TYPE("lnStatusPart") = "N" AND lnStatusPart = 0 AND USED("ctbpartidas") AND USED("ctbpartidasdeta")
				UPDATE ctbpartidas SET monto=0,fecmod=ldfecmodpartida WHERE idpartida=lnidDoc AND UPPER(ALLTRIM(origen))="COM"
				UPDATE ctbpartidasdeta SET debe=0,haber=0,fecmod=ldfecmodpartida WHERE idpartida=lnidDoc AND UPPER(ALLTRIM(origen))="COM"
			ENDIF

			USE IN c_PartTmp
 
					
			IF llinvd
				USE IN cyvComprasdeta 
			ENDIF 
			IF llinvr
				USE IN cyvCompras 
			ENDIF 
			IF llinvp
				USE IN invproductos 
			ENDIF 
			IF llinvf
				USE IN invfamilias
			ENDIF 
			IF llinvtd
				USE IN sistipodoctos 
			ENDIF 

			IF llinvclpr
				USE IN cyvclipro
			ENDIF 
			IF llinvcyb
				USE IN cybcajabancos
			ENDIF 

			IF llinvpr
				USE IN ctbpartidas 
			ENDIF 
			IF llinvpd
				USE IN ctbpartidasdeta 
			ENDIF 
			IF llinvCta
				USE IN ctbcuentas
			ENDIF 
		ENDIF 
	ENDIF 

	IF pnGeneracionMasivadePartidas=0
		*objObjetos.actualizarventanapadre(1)	
	ENDIF 
	RETURN llRetornaPartida
ENDFUNC 





******* obtener la cuenta de la matriz
FUNCTION _CuentaMatriz(idCtaMatri,lnTipoCta,lcCodInv,lcCodSuc)
	lcaliasmatriz=ALIAS()
	lnIdCtaMatriz=0
	
	IF SEEK(idCtaMatri,"ctbcuentas")
		lccodsi=ALLTRIM(ctbcuentas.codcta)
		IF SEEK(lccodsi,"ctbCuentas","codcta")
			DO case
				CASE lnTipoCta=1		&&&& inventarios
					IF pnMatrizInv=1
						IF SEEK(ALLTRIM(lccodsi)+ALLTRIM(lcCodInv)+ALLTRIM(lcCodSuc),"ctbCuentas","codcta")
							IF ctbCuentas.detalle=1
								lnIdCtaMatriz=ctbCuentas.idcuenta
							ENDIF
						ENDIF 
					ELSE
						IF SEEK(ALLTRIM(lccodsi)+ALLTRIM(lcCodSuc)+ALLTRIM(lcCodInv),"ctbCuentas","codcta")
							IF ctbCuentas.detalle=1
								lnIdCtaMatriz=ctbCuentas.idcuenta
							ENDIF
						ENDIF 
					ENDIF 
				
				CASE lnTipoCta=2		&&&& Costos
					IF pnMatrizCos=1 OR pnMatrizCos=3
						IF SEEK(ALLTRIM(lccodsi)+ALLTRIM(lcCodInv)+ALLTRIM(lcCodSuc),"ctbCuentas","codcta")
							IF ctbCuentas.detalle=1
								lnIdCtaMatriz=ctbCuentas.idcuenta
							ENDIF
						ENDIF 
					ELSE
						IF SEEK(ALLTRIM(lccodsi)+ALLTRIM(lcCodSuc)+ALLTRIM(lcCodInv),"ctbCuentas","codcta")
							IF ctbCuentas.detalle=1
								lnIdCtaMatriz=ctbCuentas.idcuenta
							ENDIF
						ENDIF 
					ENDIF 
				
				CASE lnTipoCta=3		&&&& ventas
					IF pnMatrizVta=1 OR pnMatrizVta=3
						IF SEEK(ALLTRIM(lccodsi)+ALLTRIM(lcCodInv)+ALLTRIM(lcCodSuc),"ctbCuentas","codcta")
							IF ctbCuentas.detalle=1
								lnIdCtaMatriz=ctbCuentas.idcuenta
							ENDIF
						ENDIF 
					ELSE 
						IF SEEK(ALLTRIM(lccodsi)+ALLTRIM(lcCodSuc)+ALLTRIM(lcCodInv),"ctbCuentas","codcta")
							IF ctbCuentas.detalle=1
								lnIdCtaMatriz=ctbCuentas.idcuenta
							ENDIF
						ENDIF 
					ENDIF 
			ENDCASE 
		ENDIF 
	ENDIF 
	IF !EMPTY(lcaliasmatriz)
		SELECT (lcaliasmatriz)
	ENDIF  
	
	RETURN lnIdCtaMatriz
ENDFUNC 



***************** PARTIDA DE ventas   ******************************
FUNCTION _generaPartidaventas(lnsqlid,lnidDoc,lnTipConec)
 
	llRetornaPartida=.t.
	IF TYPE("pnGeneracionMasivadePartidas")<>'N'
		pnGeneracionMasivadePartidas=0
	ENDIF 
	IF lnsqlid<>0 AND lnidDoc<>0 AND plModuloConta=.t.
		ldfecmodpartida=DATETIME()
		llRetornaPartida=.t.
		
		IF lnTipConec=1		&&&& nativo
			llinvd=!USED("cyvventasdeta")
			IF llinvd
				USE pcSysDir+pcdb+"\cyvventasdeta" IN 0 SHARED AGAIN  ORDER iddoctod
			ENDIF 
			llinvr=!USED("cyvventas")
			IF llinvr
				USE pcSysDir+pcdb+"\cyvventas" IN 0 SHARED AGAIN  ORDER iddocto
			ENDIF 
			llinvp=!USED("invproductos")
			IF llinvp
				USE pcSysDir+pcdb+"\invproductos" IN 0 SHARED AGAIN  ORDER idproducto
			ENDIF 
			llinvf=!USED("invfamilias")
			IF llinvf
				USE pcSysDir+pcdb+"\siscata" IN 0 SHARED AGAIN  ORDER id ALIAS invfamilias
			ENDIF 
			llinvtd=!USED("sistipodoctos")
			IF llinvtd
				USE pcSysDir+pcdb+"\sistipodoctos" IN 0 SHARED AGAIN  ORDER idtipodocto
			ENDIF 
			llinvclpr=!USED("cyvclipro")
			IF llinvclpr
				USE pcSysDir+pcdb+"\cyvclipro" IN 0 SHARED AGAIN  ORDER idclipro
			ENDIF 
			llinvcyb=!USED("cybcajabancos")
			IF llinvcyb
				USE pcSysDir+pcdb+"\cybcajabancos" IN 0 SHARED AGAIN  ORDER idcajban
			ENDIF 
			llinvpr=!USED("ctbpartidas")
			IF llinvpr
				USE pcSysDir+pcdb+"\ctbpartidas" IN 0 SHARED AGAIN  ORDER idpartida
			ENDIF 
			llinvpd=!USED("ctbpartidasdeta")
			IF llinvpd
				USE pcSysDir+pcdb+"\ctbpartidasdeta" IN 0 SHARED AGAIN  ORDER idpartidad
			ENDIF 
			llinvCta=!USED("ctbcuentas")
			IF llinvCta
				USE pcSysDir+pcdb+"\ctbcuentas" IN 0 SHARED AGAIN  ORDER idcuenta
			ENDIF 


			*** si es una venta de contado se provisiona la renta si es de credito no se toma en cuenta la renta(Esto ya no es asi.. contado o credito se aplica la renta)
			SELECT t0.iddocto,t0.iddoctod,t0.idproducto,(SELECT MAX(tipoiva) as tipoiva FROM cyvventasdeta WHERE iddocto=lnidDoc) as tipoiva,;
						t1.tiporetper,t1.ctrolvta,t1.periodo,t0.origen,t1.idsucursal,t0.idctrocosto,t1.idctrocosto as idctrocostoSuc,t2.idfamilia,t1.idcajban,;
						t0.status,t0.eliminado,t0.tipoprod,t1.condipago,t0.totalventasiniva,t0.costototal,t1.entsal,;
						IIF(NVL(t7.ctapropina1,0)=0,NVL(pnCtaPropina1,0000000000),t7.ctapropina1) as ctaPropi1,IIF(NVL(t7.ctapropina2,0)=0,NVL(pnCtaPropina2,000000000),t7.ctapropina2) as ctaPropi2,;
						t1.rentadocto,t1.FovialDocto,T1.CotransDocto,t1.ivadocto,t1.cescdocto,t1.retperdocto,t1.propina,t1.totaldocto,t1.percepccliq,t1.numeroccliq,;
						IIF(NVL(t3.ctainvent,000000000)=0,IIF(NVL(t7.ctainvent,000000000)=0,NVL(pnctainvent,0000000000),t7.ctainvent),t3.ctainvent) as idcuentaInvent,;
						IIF(NVL(t3.ctacosvta,000000000)=0,IIF(NVL(t7.ctacosvta,000000000)=0,NVL(pnctacosvta,0000000000),t7.ctacosvta),t3.ctacosvta) as idcuentacostovta,;
						IIF(t1.condipago=0,NVL(t6.idctacajban1,000000000),IIF(NVL(t5.ctacliloc,0)=0,IIF(t5.extranjero=0,NVL(pnctacliloc,000000000),NVL(pnctacliext,000000000)),t5.ctacliloc)) as idcuentaPago,;
						NVL(pnctaRentaVta,0000000000) as idcuentaRenta,NVL(pnctaFovialV,0000000000) as idcuentaFovialV,NVL(pnctaCotransV,0000000000) as idcuentaCotransV,;
						IIF(pnVtasConCosto=1,;
							IIF(t1.condipago=0,IIF(NVL(t3.ctaingvta,000000000)=0,IIF(NVL(t7.ctaingvta,000000000)=0,NVL(pnctaingvta,0000000000),t7.ctaingvta),t3.ctaingvta),;
									IIF(NVL(t3.ctaingvtacred,000000000)=0,IIF(NVL(t7.ctaingvtacred,000000000)=0,NVL(pnctaingvtacred,0000000000),t7.ctaingvtacred),t3.ctaingvtacred)),;
							IIF(t1.ctrolvta=1,;
								IIF(t1.condipago=0,IIF(NVL(t3.ctaingvta,000000000)=0,IIF(NVL(t7.ctaingvta,000000000)=0,NVL(pnctaingvta,0000000000),t7.ctaingvta),t3.ctaingvta),;
										IIF(NVL(t3.ctaingvtacred,000000000)=0,IIF(NVL(t7.ctaingvtacred,000000000)=0,NVL(pnctaingvtacred,0000000000),t7.ctaingvtacred),t3.ctaingvtacred)),;
								IIF(NVL(t3.ctaIngRYDVta,000000000)=0,IIF(NVL(t7.ctaIngRYDVta,000000000)=0,NVL(pnctaIngRYDVta,0000000000),t7.ctaIngRYDVta),t3.ctaIngRYDVta))) as idcuentaingvtas,;
						IIF(NVL(t2.idctainggasto,000000000)=0,IIF(NVL(t7.ctaingvta,000000000)=0,IIF(NVL(t3.ctaingvta,0000000000)=0,NVL(pnctaingvta,000000000),NVL(t3.ctaingvta,0000000000)),t7.ctaingvta),t2.idctainggasto) as idcuentaIngGas,NVL(pnCtaReten,000000000) as idcuentareten,;
						IIF(INLIST(t4.tipoicv,4,5,6,7,8),NVL(pnctadebfisccf,000000000),NVL(pnctadebfisfac,000000000)) as idcuentadebfis,;
						NVL(pnCtaPerc,000000000) as idcuentaperc,NVL(pnctacescvta,000000000) as idcuentacesc,NVL(pnctaantiva,000000000) as idcuentaantiva, ;
						SUBSTR(IIF(t1.condipago=0,IIF(t6.tipocajban=2,;
														IIF(t1.ctrolvta=1,'Chq.'+ALLTRIM(t1.numerochq)+' '+ALLTRIM(t1.nomcheque)+' por '+'US$'+ALLTRIM(TRANSFORM(t1.totaldocto-t1.rentadocto,PcmasTotal)),;
																			'Reversion Venta '+ALLTRIM(t1.nomcheque)+' por '+'US$'+ALLTRIM(TRANSFORM(t1.totaldocto-t1.rentadocto,PcmasTotal))),;
														IIF(t1.ctrolvta=1,IIF(t4.tipoicv=13,'Donación ','Venta '),'Devol. ')+ALLTRIM(t4.clave)+' '+IIF(ALLTRIM(t1.numero)=ALLTRIM(t1.numerofin),ALLTRIM(t1.numero),ALLTRIM(t1.numero)+' - '+ALLTRIM(t1.numerofin))+' '+ALLTRIM(t1.clipro)+' '+'US$'+ALLTRIM(TRANSFORM(t1.totaldocto-t1.rentadocto,PcmasTotal))),;
											IIF(t1.ctrolvta=1,'Cargo ',IIF(t1.origen='VTA','Abono ',ALLTRIM(t4.tipodocto))+' ')+ALLTRIM(t4.clave)+' '+IIF(ALLTRIM(t1.numero)=ALLTRIM(t1.numerofin),ALLTRIM(t1.numero),ALLTRIM(t1.numero)+' - '+ALLTRIM(t1.numerofin))+' '+ALLTRIM(t1.clipro)+' '+'US$'+ALLTRIM(TRANSFORM(t1.totaldocto,PcmasTotal)));
								,1,250) as conceptoPago,;
						'Propina '+ALLTRIM(t4.clave)+' '+IIF(ALLTRIM(t1.numero)=ALLTRIM(t1.numerofin),ALLTRIM(t1.numero),ALLTRIM(t1.numero)+' - '+ALLTRIM(t1.numerofin))+' '+ALLTRIM(t1.clipro)+' '+'US$'+ALLTRIM(TRANSFORM(t1.totaldocto,PcmasTotal)) as conceptoPropina,;
						SUBSTR(IIF(t1.ctrolvta=1,"Retencion ","Dev. Retencion ")+ALLTRIM(t4.clave)+' '+;
								IIF(ALLTRIM(t1.numero)=ALLTRIM(t1.numerofin),ALLTRIM(t1.numero),ALLTRIM(t1.numero)+' - '+ALLTRIM(t1.numerofin))+' ' +ALLTRIM(IIF(EMPTY(NVL(t1.nomcheque,'')),t1.clipro,t1.nomcheque)),1,250) as conceptoRenta,;
						SUBSTR(IIF(t1.ctrolvta=1,IIF(t4.tipoicv=13,'Donación según','Vta. según '),IIF(T1.origen='VTA','Dev. segun ','AutoConsumo Segun '))+ALLTRIM(t4.clave)+' '+IIF(ALLTRIM(t1.numero)=ALLTRIM(t1.numerofin),ALLTRIM(t1.numero),ALLTRIM(t1.numero)+' - '+ALLTRIM(t1.numerofin)),1,250) as conceptoinvent,;
						SUBSTR(IIF(t1.ctrolvta=1,IIF(t4.tipoicv=13,'',IIF(pcVersionS='AZURE','','Pago ')),IIF(pcVersionS='AZURE','Devol. ','Devol. pago '))+ALLTRIM(t0.producto)+IIF(t4.tipoicv=13," "+ALLTRIM(t1.notas),""),1,250) as conceptoIngGas,;
						SUBSTR(IIF(t1.ctrolvta=1,'','Devolucion ')+ALLTRIM(t4.clave)+' '+IIF(ALLTRIM(t1.numero)=ALLTRIM(t1.numerofin),ALLTRIM(t1.numero),ALLTRIM(t1.numero)+' - '+ALLTRIM(t1.numerofin))+' '+ALLTRIM(t1.clipro),1,250) as conceptodebfis,;
						SUBSTR(IIF(t1.ctrolvta=1,IIF(tiporetper=1,'Retencion ','Percepcion '),IIF(tiporetper=1,'Devolucion Retencion ','Devolucion Percepcion '))+ALLTRIM(t4.clave)+' '+IIF(ALLTRIM(t1.numero)=ALLTRIM(t1.numerofin),ALLTRIM(t1.numero),ALLTRIM(t1.numero)+' - '+ALLTRIM(t1.numerofin))+' '+ALLTRIM(t1.clipro),1,250) as conceptoperc,;
						SUBSTR(IIF(t1.ctrolvta=1,'CESC ','Devolucion CESC ')+ALLTRIM(t4.clave)+' '+IIF(ALLTRIM(t1.numero)=ALLTRIM(t1.numerofin),ALLTRIM(t1.numero),ALLTRIM(t1.numero)+' - '+ALLTRIM(t1.numerofin))+' '+ALLTRIM(t1.clipro),1,250) as conceptocesc,;
						SUBSTR(IIF(t1.ctrolvta=1,'FOVIAL ','Devolucion FOVIAL ')+ALLTRIM(t4.clave)+' '+IIF(ALLTRIM(t1.numero)=ALLTRIM(t1.numerofin),ALLTRIM(t1.numero),ALLTRIM(t1.numero)+' - '+ALLTRIM(t1.numerofin))+' '+ALLTRIM(t1.clipro),1,250) as conceptoFovial,;
						SUBSTR(IIF(t1.ctrolvta=1,'COTRANS ','Devolucion COTRANS ')+ALLTRIM(t4.clave)+' '+IIF(ALLTRIM(t1.numero)=ALLTRIM(t1.numerofin),ALLTRIM(t1.numero),ALLTRIM(t1.numero)+' - '+ALLTRIM(t1.numerofin))+' '+ALLTRIM(t1.clipro),1,250) as conceptoCotrans,;
						SUBSTR(IIF(t1.ctrolvta=1,'Pago C.C.Liq.','Devol. C.C.Liq.')+ALLTRIM(t1.numeroccliq)+' '+ALLTRIM(t1.clipro),1,250) as conceptoantiva,;
						t1.fecalta,ldfecmodpartida as fecmod,pcnodo as nodo,IIF(pcVersionS=='AZURE',iif(t1.condipago=0,252,251),t4.idtipopar) as idtipopar,t1.notas,t4.tipoconta, ;
						NVL(t77.codmatriz,SPACE(30)) as codmatrizPTV,NVL(t7.codmatriz,SPACE(30)) as codmatrizsuc,NVL(t3.codmatriz,SPACE(30)) as codmatrizinv ,0000000000 as idctamatrizinv,000000000 as idctamatrizcos,000000000 as idctamatrizvta,t4.ctrolinv,t1.presupuesto,t1.ciclo ;
				FROM cyvventasdeta t0 ;
						INNER JOIN cyvventas t1 ON t0.iddocto=t1.iddocto AND t1.origen='VTA' ;
						INNER JOIN invproductos t2 ON t0.idproducto=t2.idproducto AND NVL(t2.esnota,0)=0;
						INNER JOIN invfamilias t3 ON t2.idfamilia=t3.id AND t3.origen='LIN' ;
						INNER JOIN sistipodoctos t4 ON t1.idtipodocto=t4.idtipodocto  ;
						INNER JOIN cyvclipro t5 ON t1.idclipro=t5.idclipro ;
						INNER JOIN siscata t7 ON t1.idsucursal=t7.id ;
						left JOIN siscata t77 ON t1.idptovta=t77.id ;
						left JOIN cybcajabancos t6 ON t1.idcajban=t6.idcajban;
				WHERE t1.noContabilizable=0 AND t0.iddocto=lnidDoc AND T0.origen='VTA' ORDER BY t0.tipoprod,t2.codprod,t0.producto,t0.idctrocosto INTO CURSOR c_PartTmp READWRITE 
			*lnConRenta=c_PartTmp.condipago=0 and rentadocto<>0
			lnConRenta=c_PartTmp.rentadocto<>0
			lcOrigenDoc=ALLTRIM(origen)
			
			lnctrolvtaPart=c_PartTmp.ctrolvta
			lnctrolinvPart=c_PartTmp.ctrolinv
			lntiporetperPart=c_PartTmp.tiporetper
			lnStatusPart=c_PartTmp.status
			lcpresupuestogano=ALLTRIM(c_PartTmp.presupuesto)
			lcCicloGano=ALLTRIM(c_PartTmp.ciclo)
			

			lnSeContabiliza=tipoconta>0

			******* cambiando a cuentas de matriz (cuenta de detalle )
			IF pnMatrizInv<>0 
				REPLACE idctamatrizinv WITH _CuentaMatriz(idcuentaInvent,1,codmatrizinv,codmatrizsuc) all
			ENDIF 
			IF pnMatrizCos<>0
				REPLACE idctamatrizCos WITH _CuentaMatriz(idcuentacostovta,2,codmatrizinv,IIF(INLIST(pnMatrizCos,1,2),codmatrizsuc,codmatrizPTV)) ALL  
			ENDIF 
			IF pnMatrizVta<>0
				REPLACE idctamatrizVta WITH _CuentaMatriz(idcuentaingvtas,3,codmatrizinv,IIF(INLIST(pnMatrizVta,1,2),codmatrizsuc,codmatrizPTV)) all
			ENDIF 
	 		
			IF lnSeContabiliza=.t.
				lcConceptoGeneral=''

				IF NVL(lnctrolvtaPart,0)<>0
				
					**** provision o pago de la venta
					SELECT TOP 1 MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
								tt0.iddocto as idpartida,MAX(tt0.idcuentaPago) as idcuenta,MAX(tt0.conceptopago) as concepto,;
								max(IIF(tt0.ctrolvta=1,tt0.totaldocto-tt0.rentadocto,0000000000.00000000)) as debe,;
								max(IIF(tt0.ctrolvta=1,0000000000.00000000,tt0.totaldocto-tt0.rentadocto)) as haber,;
								MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolvta=1,1,2)))+'10000000')) as idorigen,MIN(0) as impreso,;
								MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
								MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocostoSuc as idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoPago)+' '+tt0.notas,1,250)) as notas ;
						FROM c_PartTmp tt0 ;
								INNER JOIN cyvventas tt1 ON tt0.iddocto=tt1.iddocto ;
							GROUP BY tt0.iddocto,tt0.idcuentapago,tt0.idsucursal,tt0.idctrocostoSuc ;
							ORDER BY tt0.iddocto,tt0.idcuentapago,tt0.idsucursal,tt0.idctrocostoSuc ;
						INTO CURSOR c_miPar1 READWRITE
					lcConceptoGeneral=notas
					
					**** Propina efectivo 
					SELECT TOP 1 MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
								tt0.iddocto as idpartida,MAX(tt0.idcuentaPago) as idcuenta,MAX(SUBSTR(tt0.conceptopropina,1,240)) as concepto,;
								max(IIF(tt0.ctrolvta=1,tt0.propina,0000000000.00000000)) as debe,;
								max(IIF(tt0.ctrolvta=1,0000000000.00000000,tt0.propina)) as haber,;
								MAX(tt0.periodo) as periodo,MAX('010000000') as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolvta=1,1,2)))+'10000000')) as idorigen,MIN(0) as impreso,;
								MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
								MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocostoSuc as idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptopropina)+' '+tt0.notas,1,250)) as notas ;
						FROM c_PartTmp tt0 ;
								INNER JOIN cyvventas tt1 ON tt0.iddocto=tt1.iddocto ;
							GROUP BY tt0.iddocto,tt0.idcuentapago,tt0.idsucursal,tt0.idctrocostoSuc ;
							ORDER BY tt0.iddocto,tt0.idcuentapago,tt0.idsucursal,tt0.idctrocostoSuc ;
							WHERE tt0.propina<>0 ;
						INTO CURSOR c_miPar0 READWRITE
					**** Propina Provision EMpleado
					SELECT TOP 1 MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
								tt0.iddocto as idpartida,MAX(ctaPropi2) as idcuenta,MAX(SUBSTR(tt0.conceptopropina,1,240)) as concepto,;
								max(IIF(tt0.ctrolvta<>1,tt0.propina,0000000000.00000000)) as debe,;
								max(IIF(tt0.ctrolvta<>1,0000000000.00000000,tt0.propina)) as haber,;
								MAX(tt0.periodo) as periodo,MAX('020000000') as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolvta=1,1,2)))+'10000000')) as idorigen,MIN(0) as impreso,;
								MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
								MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocostoSuc as idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptopropina)+' '+tt0.notas,1,250)) as notas ;
						FROM c_PartTmp tt0 ;
								INNER JOIN cyvventas tt1 ON tt0.iddocto=tt1.iddocto ;
							GROUP BY tt0.iddocto,tt0.idcuentapago,tt0.idsucursal,tt0.idctrocostoSuc ;
							ORDER BY tt0.iddocto,tt0.idcuentapago,tt0.idsucursal,tt0.idctrocostoSuc ;						
							WHERE tt0.propina<>0 ;
						INTO CURSOR c_miPar00 READWRITE
							
					****** retencion renta si es que es contado y aplica la retencion por servicio
					SELECT TOP 1 MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
								tt0.iddocto as idpartida,MAX(tt0.idcuentarenta) as idcuenta,MAX(tt0.conceptorenta) as concepto,;
								max(IIF(tt0.ctrolvta=1,tt0.rentadocto,0000000000.00000000)) as debe,;
								max(IIF(tt0.ctrolvta=1,0000000000.00000000,tt0.rentadocto)) as haber,;
								MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolvta=1,2,1)))+'20000000')) as idorigen,MIN(0) as impreso,;
								MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
								MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocostoSuc as idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoPago)+' '+tt0.notas,1,250)) as notas ;
						FROM c_PartTmp tt0 ;
								INNER JOIN cyvventas tt1 ON tt0.iddocto=tt1.iddocto ;
							GROUP BY tt0.iddocto,tt0.idcuentarenta,tt0.idsucursal,tt0.idctrocostoSuc ;
							ORDER BY tt0.iddocto,tt0.idcuentarenta,tt0.idsucursal,tt0.idctrocostoSuc ;
						INTO CURSOR c_miPar2 READWRITE

					****** venta de inventarios
					SELECT MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
								tt0.iddocto as idpartida,MAX(IIF(pnMatrizVta<>0,tt0.idctamatrizVta,tt0.idcuentaingvtas)) as idcuenta,MAX(tt0.conceptoinvent) as concepto,;
								SUM(IIF(tt0.ctrolvta=1,0000000000.00000000,IIF(tt0.status=0 OR tt0.eliminado=1,0000000000.00000000,tt0.totalventasiniva))) as debe,;
								SUM(IIF(tt0.ctrolvta=1,IIF(tt0.status=0 OR tt0.eliminado=1,0000000000.00000000,tt0.totalventasiniva),0000000000.00000000)) as haber,;
								MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolvta=1,2,1)))+'30000000')) as idorigen,MIN(0) as impreso,;
								MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
								MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoPago)+' '+tt0.notas,1,250)) as notas ;
						FROM c_PartTmp tt0 ;
								INNER JOIN cyvventas tt1 ON tt0.iddocto=tt1.iddocto ;
							GROUP BY tt0.iddocto,tt0.idcuentaingvtas,tt0.idctamatrizVta,tt0.idsucursal,tt0.idctrocosto ;
							ORDER BY tt0.iddocto,tt0.idcuentaingvtas,tt0.idctamatrizVta,tt0.idsucursal,tt0.idctrocosto ;
							WHERE tt0.tipoprod=1 ;
						INTO CURSOR c_miPar3 READWRITE
	 			
					****** Venta de Servicio 
					SELECT MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
								tt0.iddocto as idpartida,MAX(IIF(pnMatrizVta<>0,tt0.idctamatrizVta,tt0.idcuentaIngGas)) as idcuenta,MAX(tt0.conceptoIngGas) as concepto,;
								SUM(IIF(tt0.ctrolvta=1,0000000000.00000000,IIF(tt0.status=0 OR tt0.eliminado=1,0000000000.00000000,tt0.totalventasiniva))) as debe,;
								SUM(IIF(tt0.ctrolvta=1,IIF(tt0.status=0 OR tt0.eliminado=1,0000000000.00000000,tt0.totalventasiniva),0000000000.00000000)) as haber,;
								MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolvta=1,2,1)))+'4'+SUBSTR(STR(tt0.iddoctod,9,0),3,7))) as idorigen,MIN(0) as impreso,;
								MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
								MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoPago)+' '+tt0.notas,1,250)) as notas ;
						FROM c_PartTmp tt0 ;
								INNER JOIN cyvventas tt1 ON tt0.iddocto=tt1.iddocto ;
							GROUP BY tt0.iddocto,tt0.idcuentaIngGas,tt0.idproducto,tt0.idsucursal,tt0.idctrocosto ;
							ORDER BY tt0.iddocto,tt0.idcuentaIngGas,tt0.idproducto,tt0.idsucursal,tt0.idctrocosto ;
							WHERE tt0.tipoprod=2 ;
						INTO CURSOR c_miPar4 READWRITE
						
					****** debitos fiscal si es venta con iva
					SELECT MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
								tt0.iddocto as idpartida,MAX(tt0.idcuentadebfis) as idcuenta,MAX(tt0.conceptodebfis) as concepto,;
								max(IIF(tt0.ctrolvta=1,0000000000.00000000,tt0.ivadocto)) as debe,;
								max(IIF(tt0.ctrolvta=1,tt0.ivadocto,0000000000.00000000)) as haber,;
								MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolvta=1,2,1)))+'50000000')) as idorigen,MIN(0) as impreso,;
								MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
								MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocostoSuc as idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoPago)+' '+tt0.notas,1,250)) as notas ;
						FROM c_PartTmp tt0 ;
								INNER JOIN cyvventas tt1 ON tt0.iddocto=tt1.iddocto ;
							GROUP BY tt0.iddocto,tt0.idcuentadebfis,tt0.idsucursal,tt0.idctrocostoSuc ;
							ORDER BY tt0.iddocto,tt0.idcuentadebfis,tt0.idsucursal,tt0.idctrocostoSuc ;
							WHERE tt0.ivadocto<>0 ;
						INTO CURSOR c_miPar5 READWRITE
						
					***** percepcion si es que tiene
					IF NVL(lntiporetperPart,0)=1		&&& es retencion
						SELECT MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
									tt0.iddocto as idpartida,MAX(tt0.idcuentareten) as idcuenta,MAX(tt0.conceptoperc) as concepto,;
									max(IIF(tt0.ctrolvta=1,tt0.retperdocto,0000000000.00000000)) as debe,;
									max(IIF(tt0.ctrolvta=1,0000000000.00000000,tt0.retperdocto)) as haber,;
									MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolvta=1,1,2)))+'60000000')) as idorigen,MIN(0) as impreso,;
									MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
									MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocostoSuc as idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoPago)+' '+tt0.notas,1,250)) as notas ;
							FROM c_PartTmp tt0 ;
									INNER JOIN cyvventas tt1 ON tt0.iddocto=tt1.iddocto ;
								GROUP BY tt0.iddocto,tt0.idcuentaperc,tt0.idsucursal,tt0.idctrocostoSuc ;
								ORDER BY tt0.iddocto,tt0.idcuentaperc,tt0.idsucursal,tt0.idctrocostoSuc ;
								WHERE tt0.retperdocto<>0 ;
							INTO CURSOR c_miPar6  READWRITE
							
					ELSE
						SELECT MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
									tt0.iddocto as idpartida,MAX(tt0.idcuentaperc) as idcuenta,MAX(tt0.conceptoperc) as concepto,;
									max(IIF(tt0.ctrolvta=1,0000000000.00000000,tt0.retperdocto)) as debe,;
									max(IIF(tt0.ctrolvta=1,tt0.retperdocto,0000000000.00000000)) as haber,;
									MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolvta=1,2,1)))+'60000000')) as idorigen,MIN(0) as impreso,;
									MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
									MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocostoSuc as idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoPago)+' '+tt0.notas,1,250)) as notas ;
							FROM c_PartTmp tt0 ;
									INNER JOIN cyvventas tt1 ON tt0.iddocto=tt1.iddocto ;
								GROUP BY tt0.iddocto,tt0.idcuentaperc,tt0.idsucursal,tt0.idctrocostoSuc ;
								ORDER BY tt0.iddocto,tt0.idcuentaperc,tt0.idsucursal,tt0.idctrocostoSuc ;
								WHERE tt0.retperdocto<>0 ;
							INTO CURSOR c_miPar6  READWRITE

					ENDIF 

					***** Cesc si es que tiene
					SELECT MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
								tt0.iddocto as idpartida,MAX(tt0.idcuentacesc) as idcuenta,MAX(tt0.conceptocesc) as concepto,;
								max(IIF(tt0.ctrolvta=1,0000000000.00000000,tt0.cescdocto)) as debe,;
		 						max(IIF(tt0.ctrolvta=1,tt0.cescdocto,0000000000.00000000)) as haber,;
								MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolvta=1,2,1)))+'70000000')) as idorigen,MIN(0) as impreso,;
								MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
								MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocostoSuc as idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoPago)+' '+tt0.notas,1,250)) as notas ;
						FROM c_PartTmp tt0 ;
								INNER JOIN cyvventas tt1 ON tt0.iddocto=tt1.iddocto ;
							GROUP BY tt0.iddocto,tt0.idcuentacesc,tt0.idsucursal,tt0.idctrocostoSuc ;
							ORDER BY tt0.iddocto,tt0.idcuentacesc,tt0.idsucursal,tt0.idctrocostoSuc ;
							WHERE tt0.cescdocto<>0 ;
						INTO CURSOR c_miPar7  READWRITE

					****** Fovial y Contrans en ventas
					SELECT MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
								tt0.iddocto as idpartida,MAX(tt0.idcuentafovialv) as idcuenta,MAX(tt0.conceptoFovial) as concepto,;
								max(IIF(tt0.ctrolvta=1,0000000000.00000000,tt0.fovialdocto)) as debe,;
								max(IIF(tt0.ctrolvta=1,tt0.fovialdocto,0000000000.00000000)) as haber,;
								MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolvta=1,2,1)))+'91000000')) as idorigen,MIN(0) as impreso,;
								MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
								MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocostoSuc as idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoFovial)+' '+tt0.notas,1,250)) as notas ;
						FROM c_PartTmp tt0 ;
								INNER JOIN cyvventas tt1 ON tt0.iddocto=tt1.iddocto ;
							GROUP BY tt0.iddocto,tt0.idcuentadebfis,tt0.idsucursal,tt0.idctrocostoSuc ;
							ORDER BY tt0.iddocto,tt0.idcuentadebfis,tt0.idsucursal,tt0.idctrocostoSuc ;
							WHERE tt0.fovialdocto<>0 ;
						INTO CURSOR c_miPar91 READWRITE

			
					SELECT MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
								tt0.iddocto as idpartida,MAX(tt0.idcuentaCotransV) as idcuenta,MAX(tt0.conceptoCotrans) as concepto,;
								max(IIF(tt0.ctrolvta=1,0000000000.00000000,tt0.cotransdocto)) as debe,;
								max(IIF(tt0.ctrolvta=1,tt0.cotransdocto,0000000000.00000000)) as haber,;
								MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.ctrolvta=1,2,1)))+'92000000')) as idorigen,MIN(0) as impreso,;
								MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
								MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocostoSuc as idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoCotrans)+' '+tt0.notas,1,250)) as notas ;
						FROM c_PartTmp tt0 ;
								INNER JOIN cyvventas tt1 ON tt0.iddocto=tt1.iddocto ;
							GROUP BY tt0.iddocto,tt0.idcuentadebfis,tt0.idsucursal,tt0.idctrocostoSuc ;
							ORDER BY tt0.iddocto,tt0.idcuentadebfis,tt0.idsucursal,tt0.idctrocostoSuc ;
							WHERE tt0.cotransdocto<>0 ;
						INTO CURSOR c_miPar92 READWRITE
				ENDIF 
				
				IF NVL(lnctrolinvPart,0)<>0
				
					***** contabilizacion del Costo de Venta (inventarios)
					SELECT MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
								tt0.iddocto as idpartida,MAX(IIF(pnMatrizInv<>0,tt0.idctamatrizinv,tt0.idcuentaInvent)) as idcuenta,MAX(tt0.conceptoinvent) as concepto,;
								sum(IIF(tt0.entsal=2,0000000000.00000000,IIF(tt0.status=0 OR tt0.eliminado=1,0000000000.00000000,tt0.costototal))) as debe,;
								sum(IIF(tt0.entsal=2,IIF(tt0.status=0 OR tt0.eliminado=1,0000000000.00000000,tt0.costototal),0000000000.00000000)) as haber,;
								MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.entsal=2,2,1)))+'80000000')) as idorigen,MIN(0) as impreso,;
								MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
								MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocostoSuc as idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoPago)+' '+tt0.notas,1,250)) as notas ;
						FROM c_PartTmp tt0 ;
								INNER JOIN cyvventas tt1 ON tt0.iddocto=tt1.iddocto ;
							GROUP BY tt0.iddocto,tt0.idcuentaInvent,tt0.idctamatrizinv,tt0.idsucursal,tt0.idctrocostoSuc ;
							WHERE tt0.entsal<>0 AND tt0.tipoprod=1 AND pnVtasConCosto=1 ;
					UNION ALL ;
					SELECT MAX(000000000) as idpartidad,MAX(tt0.idtipopar) as idtipopar,MAX(fechadocto) as fechapartida,MAX(SPACE(15)) as numeropartida,;
								tt0.iddocto as idpartida,MAX(IIF(pnMatrizCos<>0,tt0.idctamatrizCos,tt0.idcuentacostovta)) as idcuenta,MAX(tt0.conceptoinvent) as concepto,;
								sum(IIF(tt0.entsal=2,IIF(tt0.status=0 OR tt0.eliminado=1,0000000000.00000000,tt0.costototal),0000000000.00000000)) as debe,;
								sum(IIF(tt0.entsal=2,0000000000.00000000,IIF(tt0.status=0 OR tt0.eliminado=1,0000000000.00000000,tt0.costototal))) as haber,;
								MAX(tt0.periodo) as periodo,MAX(tt0.origen) as origen,MAX(VAL(ALLTRIM(STR(IIF(tt0.entsal=2,1,2)))+'80000000')) as idorigen,MIN(0) as impreso,;
								MAX(tt0.fecalta) as fecalta,MAX(tt0.fecmod) as fecmod,MAX(tt0.nodo) as nodo,MAX(0) as eliminado,;
								MAX(tt1.iduser) as iduser,MAX(tt1.pcuser) as pcuser,tt0.idsucursal,tt0.idctrocosto,MAX(SUBSTR(ALLTRIM(tt0.conceptoPago)+' '+tt0.notas,1,250)) as notas ;
						FROM c_PartTmp tt0 ;
								INNER JOIN cyvventas tt1 ON tt0.iddocto=tt1.iddocto ;
							GROUP BY tt0.iddocto,tt0.idcuentacostovta,tt0.idctamatrizCos,tt0.idsucursal,tt0.idctrocosto ;
							WHERE tt0.entsal<>0 AND tt0.tipoprod=1 AND pnVtasConCosto=1 ;
						INTO CURSOR c_miPar8  READWRITE

						lcConceptoGeneral=notas
				ENDIF 
 					
				IF !lnConRenta AND lnctrolvtaPart<>0
					DELETE all IN c_miPar2
				ENDIF 
				
				IF NVL(lnctrolvtaPart,0)<>0 AND NVL(lnctrolinvPart,0)<>0		&&& es venta con costo de venta
					SELECT * FROM c_miPar1 UNION ALL ;
					SELECT * FROM c_miPar0 UNION ALL ;
					SELECT * FROM c_miPar00 UNION ALL ;
					SELECT * FROM c_miPar2 UNION ALL ;
					SELECT * FROM c_miPar3 UNION ALL ;
					SELECT * FROM c_miPar4 UNION ALL ;
					SELECT * FROM c_miPar5 UNION ALL ;
					SELECT * FROM c_miPar6 UNION ALL ;
					SELECT * FROM c_miPar7 UNION ALL ;
					SELECT * FROM c_miPar91 UNION ALL ;
					SELECT * FROM c_miPar92 UNION ALL ;
					SELECT * FROM c_miPar8 ;
					ORDER BY idorigen,idsucursal,idctrocosto  INTO CURSOR c_miPartida READWRITE 
				ENDIF 
				
				
				IF NVL(lnctrolvtaPart,0)<>0 AND NVL(lnctrolinvPart,0)=0		&&& es venta sin costo de venta
					SELECT * FROM c_miPar1 UNION ALL ;
					SELECT * FROM c_miPar0 UNION ALL ;
					SELECT * FROM c_miPar00 UNION ALL ;
					SELECT * FROM c_miPar2 UNION ALL ;
					SELECT * FROM c_miPar3 UNION ALL ;
					SELECT * FROM c_miPar4 UNION ALL ;
					SELECT * FROM c_miPar5 UNION ALL ;
					SELECT * FROM c_miPar6 UNION ALL ;
					SELECT * FROM c_miPar7 UNION ALL ;
					SELECT * FROM c_miPar91 UNION ALL ;
					SELECT * FROM c_miPar92 ;
					ORDER BY idorigen,idsucursal,idctrocosto  INTO CURSOR c_miPartida READWRITE 
				ENDIF 
				IF NVL(lnctrolvtaPart,0)=0 AND NVL(lnctrolinvPart,0)<>0		&&& es solo costo de venta
					SELECT * FROM c_miPar8 ;
					ORDER BY idorigen,idsucursal,idctrocosto  INTO CURSOR c_miPartida READWRITE 
				ENDIF 
 				
				IF NVL(lnStatusPart,0)=0		&&& anulado
					REPLACE debe WITH 0, haber WITH 0 all
				ELSE 
					REPLACE debe WITH ROUND(debe,2), haber WITH ROUND(haber,2) all
				ENDIF 

				***** cuadrando diferencias de centavos
				lnvaldebe=0
				lnvalhaber=0
				lnidorigen=0
		*		lnctrolvtaPart
				SCAN all
					lnvaldebe=lnvaldebe+debe
					lnvalhaber=lnvalhaber+haber
					IF SUBSTR(alltrim(STR(idorigen)),2,1)>'2' AND lnidorigen=0 AND SUBSTR(alltrim(STR(idorigen)),2,1)<>'8'
						lnidorigen=idorigen
					ENDIF 
				ENDSCAN 
				lnDifdebhab=lnvaldebe-lnvalhaber

				IF lnDifdebhab<>0
					IF lnctrolvtaPart=1		&&& es venta 
						IF lnDifdebhab>0
							LOCATE FOR idorigen=lnidorigen
							IF !EOF()
								REPLACE debe WITH IIF(debe=0,debe,debe-ABS(lnDifdebhab)), ;
										haber WITH IIF(debe=0,haber+ABS(lnDifdebhab),haber) ;
										NEXT 1
							ENDIF 
						ELSE
							LOCATE FOR idorigen=lnidorigen
							IF !EOF()
								REPLACE debe WITH IIF(debe=0,debe,debe+ABS(lnDifdebhab)),;
										haber WITH IIF(debe=0,haber-ABS(lnDifdebhab),haber) ;
										NEXT 1
							ENDIF 
						ENDIF 
					ENDIF 
					IF lnctrolvtaPart=2						&&& es devolucion
						IF lnDifdebhab>0
							LOCATE FOR idorigen=lnidorigen
							IF !EOF()
								REPLACE haber WITH IIF(haber=0,haber,haber+ABS(lnDifdebhab)),;
										debe WITH IIF(haber=0,debe-ABS(lnDifdebhab),debe) ;
										NEXT 1
							ENDIF 

						ELSE
							LOCATE FOR idorigen=lnidorigen
							IF !EOF()
								REPLACE haber WITH IIF(haber=0,haber,haber-ABS(lnDifdebhab)),;
										debe WITH IIF(haber=0,debe+ABS(lnDifdebhab),debe) ;
										NEXT 1
							ENDIF 
						ENDIF 
					ENDIF 
				ENDIF 

				IF lnctrolvtaPart<>0	
					USE IN c_miPar0
					USE IN c_miPar00
					USE IN c_miPar1
					USE IN c_miPar2
					USE IN c_miPar3
					USE IN c_miPar4
					USE IN c_miPar5
					USE IN c_miPar6
					USE IN c_miPar7
				ENDIF 
				IF lnctrolinvPart<>0	
					USE IN c_miPar8
				ENDIF 
				
				
				SELECT c_miPartida

				SELECT NVL(SUM(NVL(a.debe,0000000000.00)-NVL(a.haber,0000000000.00)),0)  ;
					from c_miPartida a INNER JOIN ctbcuentas b ON a.idcuenta=b.idcuenta AND b.detalle=1 ;
					WHERE a.idcuenta<>0 INTO ARRAY laDescuadrada

				IF ROUND(laDescuadrada,2) =0		
					IF recno()<>0
						***** evaluando si la partida ya existe o hay que crearla como nueva
						
						IF SEEK(STR(lnidDoc)+lcOrigenDoc,"ctbpartidas","LLAVE2")
							llPartidaNueva=.f.
							lcNumpar=ctbpartidas.numeropartida
						ELSE
							IF SEEK(lnidDoc,"ctbpartidas","idpartida")
								llPartidaNueva=.f.
								lcNumpar=ctbpartidas.numeropartida
							ELSE
								llPartidaNueva=.t.
							ENDIF
							SET ORDER TO LLAVE2 IN ctbpartidas
						ENDIF 
						
						IF llPartidaNueva
							GO TOP IN c_miPartida
							lnidTipoPartemp=c_miPartida.idtipopar
							lnFecpartemp=c_miPartida.fechapartida
							lcNumpar=AsignaNumeroPartida(lnsqlid,lnidTipoPartemp,lnFecpartemp,pcnodo,1)
							lcconceptmp=notas

							DELETE FROM ctbpartidasdeta WHERE idpartida=lnidDoc AND origen=lcOrigenDoc
							REPLACE idpartidad WITH _SiguienteIdPartidaDetaDisponible(pcNodo) ALL
							INSERT INTO ctbpartidas (idpartida,idtipopar,fechapartida,numeropartida,concepto,monto,;
											periodo,origen,impreso,fecalta,fecmod,nodo,eliminado,iduser,pcuser,idsucursal,idctrocosto,presupuesto,ciclo);
									SELECT MAX(idpartida),MAX(idtipopar),MAX(fechapartida),MAX(lcNumpar),MAX(lcconceptmp),SUM(debe),;
										MAX(periodo),MAX(origen),MAX(impreso),MAX(fecalta),MAX(fecmod),MAX(nodo),MAX(eliminado),MAX(iduser),;
										MAX(pcuser),MAX(idsucursal),MAX(idctrocosto),MAX(lcpresupuestogano),MAX(lcciclogano) FROM c_mipartida order by idpartida group by idpartida

							INSERT INTO ctbpartidasdeta (idpartidad,idpartida,idcuenta,conceptod,debe,haber,periodo,origen,;
											idorigen,fecalta,fecmod,nodo,eliminado,iduser,pcuser,idsucursal,idctrocosto) ;
									SELECT idpartidad,idpartida,idcuenta,concepto,debe,haber,periodo,origen,;
											idorigen,fecalta,fecmod,nodo,eliminado,iduser,pcuser,idsucursal,idctrocosto ;
										FROM c_mipartida order by idorigen

						ELSE
							GO TOP IN c_miPartida
							ldfecpar=fechapartida
							*lcconceptmp=lcConceptoGeneral
							lcconceptmp=notas
							SUM ALL debe TO lnMontopar

							UPDATE c_miPartida ;
								SET 	idpartidad=a.idpartidad,numeropartida=lcNumpar,fechapartida=ldfecpar FROM ctbpartidasdeta a ;
								WHERE c_miPartida.idpartida=a.idpartida AND ;
										c_miPartida.idorigen=a.idorigen AND ;
										c_miPartida.idcuenta=a.idcuenta AND ;
										c_miPartida.idsucursal=a.idsucursal AND ;
										c_miPartida.idctrocosto=a.idctrocosto AND ;
										c_miPartida.origen=a.origen 

							REPLACE idpartidad WITH _SiguienteIdPartidaDetaDisponible(pcNodo) FOR idpartidad=0 

							DELETE from  ctbpartidasdeta WHERE idpartida=lnidDoc AND idpartidad NOT in (select b.idpartidad FROM c_mipartida b WHERE b.idpartida=lnidDoc AND b.idpartidad<>0)

							UPDATE ctbpartidas SET concepto =lcconceptmp, monto=lnMontopar,fecmod =ldfecmodpartida,fechapartida=ldfecpar ,;
												presupuesto=lcpresupuestogano,ciclo=lcCicloGano WHERE idpartida=lnidDoc

							***** pequeños cambios para hacer mas rapido el proceso
							INDEX on idpartidad TAG llave
							SET ORDER TO llave 

							UPDATE ctbpartidasdeta ;
								SET 	conceptod=a.concepto,;
										debe=a.debe,;
										haber=a.haber,;
										eliminado=a.eliminado,;
										iduser=a.iduser,;
										pcuser=a.pcuser, ;
										fecmod=a.fecmod ;
									FROM c_miPartida a ;
								WHERE ctbpartidasdeta.idpartidad=a.idpartidad and ctbpartidasdeta.idpartida=lnidDoc
							SET ORDER TO 
							
							INSERT INTO ctbpartidasdeta (idpartidad,idpartida,idcuenta,conceptod,debe,haber,periodo,origen,;
											idorigen,fecalta,fecmod,nodo,eliminado,iduser,pcuser,idsucursal,idctrocosto) ;
									SELECT idpartidad,idpartida,idcuenta,concepto,debe,haber,periodo,origen,;
											idorigen,fecalta,fecmod,nodo,eliminado,iduser,pcuser,idsucursal,idctrocosto ;
										FROM c_mipartida WHERE idpartidad NOT in (select idpartidad FROM ctbpartidasdeta WHERE idpartida=lnidDoc)

						ENDIF 
					ENDIF 
				
				ELSE
			
					DELETE from  ctbpartidasdeta WHERE idpartida=lnidDoc AND origen='VTA'
					DELETE from  ctbpartidas WHERE idpartida=lnidDoc AND origen='VTA'
					
					IF plRecosteando=.f. and pnGeneracionMasivadePartidas=0
					
						MESSAGEBOX("Partida Descuadrada..."+CHR(13)+"Diferencia "+ALLTRIM(STR(laDescuadrada,12,2)),16,"Error al Contabilizar....",2000)

						llRetornaPartida=.f.
					ENDIF 

				ENDIF 
			
				USE IN  c_miPartida
			ENDIF 
			
			USE IN c_PartTmp
			
			
			IF llinvd
				USE IN cyvventasdeta 
			ENDIF 
			IF llinvr
				USE IN cyvventas 
			ENDIF 
			IF llinvp
				USE IN invproductos 
			ENDIF 
			IF llinvf
				USE IN invfamilias
			ENDIF 
			IF llinvtd
				USE IN sistipodoctos 
			ENDIF 

			IF llinvclpr
				USE IN cyvclipro
			ENDIF 
			IF llinvcyb
				USE IN cybcajabancos
			ENDIF 

			IF llinvpr
				USE IN ctbpartidas 
			ENDIF 
			IF llinvpd
				USE IN ctbpartidasdeta 
			ENDIF 
			IF llinvCta
				USE IN ctbcuentas
			ENDIF 
		ENDIF 
	ENDIF 
	IF pnGeneracionMasivadePartidas=0
		objObjetos.actualizarventanapadre(1)	
	ENDIF  


	RETURN llRetornaPartida
ENDFUNC 


