    ENDDO

    RETURN lcCol
ENDFUNC



FUNCTION EnviaraExcel_old(lcOpcion,lctablaxls,lnTipoOrden)
	IF PCOUNT( )=2
		lnTipoOrden=0
	ENDIF 
	**** lcOpcion  Existencias,Existencias_Suc,Existencias_Suc_Bod,Ventas_Producto_Controlado etc
	**** lnNumColum    (numero de Columnas del Select)
	**** lcCurEstFin    (Cursor de donde se tomaran los Datos)
	**** lcTitFechaEstFin (titulo para la Fecha del Reporte Eje. del 1 al 31 de Agosto de 2018)
	IF !EMPTY(lcTablaxls)
		SELECT (lcTablaxls)
		GO top
		IF lcOpcion=='Existencias' OR lcOpcion=='Existencias_Suc' OR lcOpcion=='Existencias_Lote' OR lcOpcion=='Existencias_Suc_Bod' OR lcOpcion=='Existencias_Cobertura' 
			LOCATE FOR fisico<>0
			IF !EOF()
				lnConfisico=1
			ELSE
				lnConfisico=0
			ENDIF 
		ENDIF 
		GO top
	ENDIF 
	
	Local oExcel
	oExcel = Createobject("Excel.Application")

	#DEFINE xlCenter -4108
	#UNDEFINE xlTop
	#DEFINE xlTop -4160	
	#DEFINE xlRight -4152

	With oExcel
		.WorkBooks.Add
		xlsheet = .ActiveSheet

		***** ANCHO DE LAS COLUMNAS
		DO case
			CASE lcOpcion=='Existencias' OR lcOpcion=='Existencias_Suc' OR lcOpcion=='Existencias_Lote' OR lcOpcion=='Existencias_Suc_Bod' OR lcOpcion=='Existencias_Cobertura'
				WITH xlsheet
					.COLUMNS("A:A").ColumnWidth = 12.00
					.COLUMNS("B:B").ColumnWidth = 0
					.COLUMNS("C:C").ColumnWidth = 35.00
					.COLUMNS("D:D").ColumnWidth = 20.00
					.COLUMNS("E:E").ColumnWidth = IIF(pnOcultaCostos=1,0,15.00)
					.COLUMNS("F:F").ColumnWidth = 15.00
					.COLUMNS("G:G").ColumnWidth = IIF(pnOcultaCostos=1,0,15.00)
					.COLUMNS("A:A").NumberFormat = "@"
					.COLUMNS("B:B").NumberFormat = "@"
					.COLUMNS("C:C").NumberFormat = "@"
					.COLUMNS("D:D").NumberFormat = "@"
					.COLUMNS("E:E").NumberFormat = "#,##0.0000"
					.COLUMNS("F:F").NumberFormat = "#,##0.00"
					.COLUMNS("G:G").NumberFormat = "#,##0.00"
					IF lcOpcion=='Existencias_Cobertura'
						.COLUMNS("H:H").NumberFormat = "#,##0.00"
						.COLUMNS("I:I").NumberFormat = "#,##0.00"
						.COLUMNS("J:J").NumberFormat = "@"
						.COLUMNS("H:H").ColumnWidth = 12.00
						.COLUMNS("I:I").ColumnWidth = 12.00
						.COLUMNS("J:J").ColumnWidth = 15.00
						
						lcRango1='A1:J1'
						lcRango2='A2:J2'
						lcRango3='A4:J4'
						
						lncolrep=10
					ELSE
						.COLUMNS("H:H").NumberFormat = "@"
						IF lnConfisico=1
							.COLUMNS("H:H").ColumnWidth = 15.00
							.COLUMNS("H:H").NumberFormat = "#,##0.00"
							.COLUMNS("I:I").ColumnWidth = 15.00
							.COLUMNS("J:J").NumberFormat = "@"
							.COLUMNS("J:J").ColumnWidth = 10
						ELSE
							IF lcOpcion=='Existencias_Lote'
