FUNCTION CopiarAnalisisTabla
    LPARAMETERS tcTabla

    LOCAL lnAreaActual, lcAliasActual, lcAliasTrabajo, llAbrioTabla
    LOCAL lcTexto, lcTablaMostrar
    LOCAL lnCampos, lnRegistros
    LOCAL i, j
    LOCAL lcCampo, lcTipo
    LOCAL llTieneDato, llTodosUsados
    LOCAL lnRecnoActual
    LOCAL lnTags
    LOCAL lcTag, lcExpresion, lcFor
    LOCAL lcAscDesc
    LOCAL llPrimario, llCandidato, llUnico
    LOCAL xValor
    LOCAL llOk

    LOCAL ARRAY laEstructura[1]
    LOCAL ARRAY laUsado[1]
    LOCAL ARRAY laTags[1]

    llOk = .F.
    llAbrioTabla = .F.
    lcAliasTrabajo = ""
    lcTexto = ""

    lnAreaActual = SELECT()
    lcAliasActual = ALIAS()

    *----------------------------------------------------------
    * 1) Determinar tabla a usar
    *----------------------------------------------------------
    IF VARTYPE(tcTabla) = "C" AND !EMPTY(ALLTRIM(tcTabla))
        tcTabla = ALLTRIM(tcTabla)

        * Si es alias abierto
        IF USED(tcTabla)
            lcAliasTrabajo = tcTabla
            SELECT (lcAliasTrabajo)

        ELSE
            * Si es ruta o nombre de DBF
            IF FILE(tcTabla)
                USE (tcTabla) IN 0 SHARED AGAIN ALIAS __tmpAnalisisTabla
                lcAliasTrabajo = "__tmpAnalisisTabla"
                llAbrioTabla = .T.
                SELECT (lcAliasTrabajo)
            ELSE
                MESSAGEBOX("La tabla o alias indicado no existe: " + tcTabla, 16, "Error")
                RETURN .F.
            ENDIF
        ENDIF
    ELSE
        * Usar tabla actual
        IF USED()
            lcAliasTrabajo = ALIAS()
        ELSE
            MESSAGEBOX("No hay tabla abierta ni se recibió nombre de tabla.", 16, "Error")
            RETURN .F.
        ENDIF
    ENDIF

    IF EMPTY(lcAliasTrabajo)
        MESSAGEBOX("No se pudo determinar la tabla a procesar.", 16, "Error")
        RETURN .F.
    ENDIF

    SELECT (lcAliasTrabajo)

    lcTablaMostrar = DBF()
    lnRegistros = RECCOUNT()
    lnCampos = AFIELDS(laEstructura)
    DIMENSION laUsado[lnCampos]

    FOR i = 1 TO lnCampos
        laUsado[i] = .F.
    ENDFOR

    *----------------------------------------------------------
    * 2) Revisar qué campos tienen datos
    *----------------------------------------------------------
    IF lnRegistros > 0
        lnRecnoActual = RECNO()
        GO TOP

        SCAN
            FOR i = 1 TO lnCampos
                IF laUsado[i]
                    LOOP
                ENDIF

                lcCampo = laEstructura[i,1]
                lcTipo  = laEstructura[i,2]
                llTieneDato = .F.

                xValor = EVALUATE(lcCampo)

                DO CASE
                    CASE lcTipo == "C"
                        IF !ISNULL(xValor) AND !EMPTY(ALLTRIM(xValor))
                            llTieneDato = .T.
                        ENDIF

                    CASE lcTipo == "M"
                        IF !ISNULL(xValor) AND !EMPTY(ALLTRIM(xValor))
                            llTieneDato = .T.
                        ENDIF

                    CASE INLIST(lcTipo, "N","F","B","I","Y")
                        IF !ISNULL(xValor) AND xValor <> 0
                            llTieneDato = .T.
                        ENDIF

                    CASE lcTipo == "L"
                        IF !ISNULL(xValor) AND xValor = .T.
                            llTieneDato = .T.
                        ENDIF

                    CASE lcTipo == "D"
                        IF !ISNULL(xValor) AND !EMPTY(xValor)
                            llTieneDato = .T.
                        ENDIF

                    CASE lcTipo == "T"
                        IF !ISNULL(xValor) AND !EMPTY(xValor)
                            llTieneDato = .T.
                        ENDIF

                    OTHERWISE
                        * Para tipos raros o no contemplados,
                        * se consideran "sin uso" para evitar errores
                        llTieneDato = .F.
                ENDCASE

                IF llTieneDato
                    laUsado[i] = .T.
                ENDIF
            ENDFOR

            llTodosUsados = .T.
            FOR j = 1 TO lnCampos
                IF !laUsado[j]
                    llTodosUsados = .F.
                    EXIT
                ENDIF
            ENDFOR

            IF llTodosUsados
                EXIT
            ENDIF
        ENDSCAN

        IF BETWEEN(lnRecnoActual, 1, RECCOUNT())
            GO lnRecnoActual
        ENDIF
    ENDIF

    *----------------------------------------------------------
    * 3) Armar salida
    *----------------------------------------------------------
    lcTexto = lcTexto + "ANALISIS DE TABLA" + CHR(13) + CHR(10)
    lcTexto = lcTexto + "Tabla: " + lcTablaMostrar + CHR(13) + CHR(10)
    lcTexto = lcTexto + "Registros: " + TRANSFORM(lnRegistros) + CHR(13) + CHR(10)
    lcTexto = lcTexto + REPLICATE("=", 80) + CHR(13) + CHR(10) + CHR(13) + CHR(10)

    *----------------------------------------------------------
    * SEGMENTO 1 - CAMPOS CON DATOS
    *----------------------------------------------------------
    lcTexto = lcTexto + "1) CAMPOS CON DATOS" + CHR(13) + CHR(10)
    lcTexto = lcTexto + REPLICATE("-", 80) + CHR(13) + CHR(10)
    lcTexto = lcTexto + PADR("CAMPO", 30) + PADR("TIPO", 8) + PADL("TAM", 8) + PADL("DEC", 8) + CHR(13) + CHR(10)
    lcTexto = lcTexto + REPLICATE("-", 80) + CHR(13) + CHR(10)

    j = 0
    FOR i = 1 TO lnCampos
        IF laUsado[i]
            j = j + 1
            lcTexto = lcTexto + ;
                PADR(laEstructura[i,1], 30) + ;
                PADR(laEstructura[i,2], 8) + ;
                PADL(TRANSFORM(laEstructura[i,3]), 8) + ;
                PADL(TRANSFORM(laEstructura[i,4]), 8) + ;
                CHR(13) + CHR(10)
        ENDIF
    ENDFOR

    IF j = 0
        lcTexto = lcTexto + "(Ninguno)" + CHR(13) + CHR(10)
    ENDIF

    lcTexto = lcTexto + CHR(13) + CHR(10)

    *----------------------------------------------------------
    * SEGMENTO 2 - CAMPOS SIN DATOS
    *----------------------------------------------------------
    lcTexto = lcTexto + "2) CAMPOS SIN DATOS" + CHR(13) + CHR(10)
    lcTexto = lcTexto + REPLICATE("-", 80) + CHR(13) + CHR(10)
    lcTexto = lcTexto + PADR("CAMPO", 30) + PADR("TIPO", 8) + PADL("TAM", 8) + PADL("DEC", 8) + CHR(13) + CHR(10)
    lcTexto = lcTexto + REPLICATE("-", 80) + CHR(13) + CHR(10)

    j = 0
    FOR i = 1 TO lnCampos
        IF !laUsado[i]
            j = j + 1
            lcTexto = lcTexto + ;
                PADR(laEstructura[i,1], 30) + ;
                PADR(laEstructura[i,2], 8) + ;
                PADL(TRANSFORM(laEstructura[i,3]), 8) + ;
                PADL(TRANSFORM(laEstructura[i,4]), 8) + ;
                CHR(13) + CHR(10)
        ENDIF
    ENDFOR

    IF j = 0
        lcTexto = lcTexto + "(Ninguno)" + CHR(13) + CHR(10)
    ENDIF

    lcTexto = lcTexto + CHR(13) + CHR(10)

    *----------------------------------------------------------
    * SEGMENTO 3 - INDICES
    *----------------------------------------------------------
    lcTexto = lcTexto + "3) INDICES" + CHR(13) + CHR(10)
    lcTexto = lcTexto + REPLICATE("-", 80) + CHR(13) + CHR(10)

    lnTags = 0
    lnTags = ATAGINFO(laTags)

    IF lnTags <= 0
        lcTexto = lcTexto + "No se encontraron indices." + CHR(13) + CHR(10)
    ELSE
        FOR i = 1 TO lnTags
            lcTag = ""
            lcExpresion = ""
            lcFor = ""
            lcAscDesc = "ASC"
            llPrimario = .F.
            llCandidato = .F.
            llUnico = .F.

            lcTag = TRANSFORM(laTags[i,1])

            IF ALEN(laTags,2) >= 2
                lcExpresion = TRANSFORM(laTags[i,2])
            ENDIF

            IF ALEN(laTags,2) >= 3
                lcFor = TRANSFORM(laTags[i,3])
            ENDIF

            IF ALEN(laTags,2) >= 4
                IF laTags[i,4]
                    lcAscDesc = "DESC"
                ELSE
                    lcAscDesc = "ASC"
                ENDIF
            ENDIF

            IF ALEN(laTags,2) >= 5
                llPrimario = laTags[i,5]
            ENDIF

            IF ALEN(laTags,2) >= 6
                llCandidato = laTags[i,6]
            ENDIF

            IF ALEN(laTags,2) >= 7
                llUnico = laTags[i,7]
            ENDIF

            lcTexto = lcTexto + "Tag       : " + lcTag + CHR(13) + CHR(10)
            lcTexto = lcTexto + "Expresion : " + lcExpresion + CHR(13) + CHR(10)
            lcTexto = lcTexto + "Orden     : " + lcAscDesc + CHR(13) + CHR(10)
            lcTexto = lcTexto + "Primario  : " + IIF(llPrimario, "Si", "No") + CHR(13) + CHR(10)
            lcTexto = lcTexto + "Candidato : " + IIF(llCandidato, "Si", "No") + CHR(13) + CHR(10)
            lcTexto = lcTexto + "Unico     : " + IIF(llUnico, "Si", "No") + CHR(13) + CHR(10)

            IF !EMPTY(ALLTRIM(lcFor))
                lcTexto = lcTexto + "Filtro/FOR: " + lcFor + CHR(13) + CHR(10)
            ENDIF

            lcTexto = lcTexto + REPLICATE("-", 80) + CHR(13) + CHR(10)
        ENDFOR
    ENDIF

    *----------------------------------------------------------
    * 4) Copiar al portapapeles
    *----------------------------------------------------------
    _CLIPTEXT = lcTexto
    llOk = .T.

    *----------------------------------------------------------
    * 5) Restaurar entorno
    *----------------------------------------------------------
    IF llAbrioTabla AND USED(lcAliasTrabajo)
        USE IN (lcAliasTrabajo)
    ENDIF

    IF !EMPTY(lcAliasActual) AND USED(lcAliasActual)
        SELECT (lcAliasActual)
    ELSE
        SELECT (lnAreaActual)
    ENDIF

    IF llOk
        MESSAGEBOX("Analisis copiado al portapapeles.", 64, "Proceso terminado")
    ENDIF

    RETURN llOk
ENDFUNC





FUNCTION CrearCursorPendientesDocto
	LPARAMETERS tdFec1, tdFec2, tcOrigen, tcCursor, tlDetallado

	LOCAL lcOrigen, lcCursor, llDetallado

	lcOrigen = UPPER(ALLTRIM(tcOrigen))
	lcCursor = IIF(EMPTY(tcCursor), "cc_cyvventas", ALLTRIM(tcCursor))
	llDetallado = IIF(TYPE("tlDetallado")="L", tlDetallado, .F.)

	IF EMPTY(lcOrigen)
		lcOrigen = "VTP"
	ENDIF

	SELECT cyvventas
	SET ORDER TO llave

	SELECT cyvventasdeta
	*SET ORDER TO origiddoc

	DO CASE

	CASE lcOrigen = "VTA"

		IF llDetallado
			SELECT d.*, ;
					000000000000000000.00000000 AS CantidadPendiente ;
				FROM cyvventasdeta d ;
					INNER JOIN cyvventas e ON d.iddocto = e.iddocto ;
				WHERE e.origen = "VTA" ;
					AND e.fechadocto >= tdFec1 ;
					AND e.fechadocto <= tdFec2 ;
				INTO CURSOR (lcCursor) READWRITE
		ELSE
			SELECT e.*, ;
					000000000000000000.00000000 AS CantidadPendiente ;
				FROM cyvventas e ;
				WHERE e.origen = "VTA" ;
					AND e.fechadocto >= tdFec1 ;
					AND e.fechadocto <= tdFec2 ;
				INTO CURSOR (lcCursor) READWRITE
		ENDIF

	CASE lcOrigen = "VTP"

		SELECT e.* ;
			FROM cyvventas e ;
			WHERE e.origen = "VTP" ;
				AND e.fechadocto >= tdFec1 ;
				AND e.fechadocto <= tdFec2 ;
			ORDER BY e.iddocto ;
			INTO CURSOR tmp_doc_enc READWRITE

		SELECT d.* ;
			FROM cyvventasdeta d ;
				INNER JOIN tmp_doc_enc e ON d.iddocto = e.iddocto ;
			WHERE d.origen = "VTP" ;
				AND d.status = 1 ;
				AND d.eliminado = 0 ;
			INTO CURSOR tmp_doc_det READWRITE

		SELECT cyvventasdeta
		SET ORDER TO idpedidod

		SELECT vd.idpedidod AS iddoctod, ;
				vd.iddocto AS iddoctofac, ;
				vd.cantidad ;
			FROM cyvventasdeta vd ;
				INNER JOIN tmp_doc_det od ON vd.idpedidod = od.iddoctod ;
			WHERE vd.idpedidod <> 0 ;
				AND vd.status = 1 ;
				AND vd.eliminado = 0 ;
				AND vd.cantidad > 0 ;
			INTO CURSOR tmp_fac_det READWRITE

		SELECT cyvventas
		SET ORDER TO iddocto

		SELECT fd.iddoctod, ;
				SUM(fd.cantidad) AS cantidadfacturada ;
			FROM tmp_fac_det fd ;
				INNER JOIN cyvventas fv ON fd.iddoctofac = fv.iddocto ;
			WHERE fv.origen = "VTA" ;
				AND fv.status = 1 ;
				AND fv.anulado = 0 ;
				AND fv.eliminado = 0 ;
			GROUP BY fd.iddoctod ;
			INTO CURSOR tmp_fac_vtp READWRITE

		SELECT od.*, ;
				od.cantidad - NVL(fa.cantidadfacturada,0) AS CantidadPendiente ;
			FROM tmp_doc_det od ;
				LEFT JOIN tmp_fac_vtp fa ON od.iddoctod = fa.iddoctod ;
			INTO CURSOR tmp_pend_det READWRITE

		IF llDetallado

			SELECT * ;
				FROM tmp_pend_det ;
				INTO CURSOR (lcCursor) READWRITE

		ELSE

			SELECT iddocto, ;
					SUM(NVL(CantidadPendiente,0)) AS CantPend ;
				FROM tmp_pend_det ;
				GROUP BY iddocto ;
				INTO CURSOR tmp_pend_res READWRITE

			SELECT e.*, ;
					NVL(p.CantPend,0) AS CantidadPendiente ;
				FROM tmp_doc_enc e ;
					LEFT JOIN tmp_pend_res p ON e.iddocto = p.iddocto ;
				INTO CURSOR (lcCursor) READWRITE

		ENDIF

	ENDCASE

	SELECT cyvventasdeta
	SET ORDER TO

	SELECT cyvventas
	SET ORDER TO llave

	RETURN .T.
ENDFUNC




FUNCTION GenerarLibroMayorPDF(tnEjercicio, tnMes, tcRutaDestino, tlNoIncluirCierre)
	LOCAL lnEjercicio, lnMesParam, lnMesIni, lnMesFin, lcRutaDestino, llNoIncluirCierre, lnSql, lnMes
	LOCAL ldFec1, ldFec2, lcArchivoPdf, lcReporte, lcAliasAnt, lcReportBehaviorAnt
	LOCAL llOk, lcWhere, lcSqlMayor, lccodcta, lnlincuenta
	LOCAL lcPrinOld, lcPrinter, llimpresorExiste, i, llCancelado
	LOCAL lcDefaultAnt, lcCsv, lcJson, lcPy, lcCmd, lcLog, lcComillas, lnRun, lnLargoCuenta, lnEspera
	PUBLIC pcFecha

	lnEjercicio = VAL(ALLTRIM(TRANSFORM(tnEjercicio)))
	IF lnEjercicio <= 0
		MESSAGEBOX("Ejercicio invalido para generar Libro Mayor PDF.", 64, "Libro Mayor")
		RETURN .F.
	ENDIF

	IF TYPE("tnMes") = "C" AND TYPE("tcRutaDestino") # "C"
		tcRutaDestino = tnMes
		lnMesParam = 0
	ELSE
		lnMesParam = IIF(TYPE("tnMes") = "N", tnMes, 0)
	ENDIF

	IF TYPE("tcRutaDestino") = "L" AND TYPE("tlNoIncluirCierre") # "L"
		tlNoIncluirCierre = tcRutaDestino
		tcRutaDestino = ""
	ENDIF

	IF lnMesParam < 0 OR lnMesParam > 12
		MESSAGEBOX("Mes invalido para generar Libro Mayor PDF.", 64, "Libro Mayor")
		RETURN .F.
	ENDIF
	lnMesIni = IIF(lnMesParam >= 1, lnMesParam, 1)
	lnMesFin = IIF(lnMesParam >= 1, lnMesParam, 12)

	lcRutaDestino = IIF(TYPE("tcRutaDestino") = "C" AND !EMPTY(tcRutaDestino), ADDBS(ALLTRIM(tcRutaDestino)), ;
		"D:\borreme\")
	llNoIncluirCierre = IIF(TYPE("tlNoIncluirCierre") = "L", tlNoIncluirCierre, .F.)
	lcReporte = pcSysDir + "reportes\ctb_Mayor"

	IF !DIRECTORY(ADDBS(pcSysDir + pcDB + "\ArchivosPDF"))
		MKDIR (ADDBS(pcSysDir + pcDB + "\ArchivosPDF"))
	ENDIF
	IF !DIRECTORY(ADDBS(pcSysDir + pcDB + "\ArchivosPDF\LibroMayor"))
		MKDIR (ADDBS(pcSysDir + pcDB + "\ArchivosPDF\LibroMayor"))
	ENDIF
	IF !DIRECTORY(lcRutaDestino)
		MKDIR (lcRutaDestino)
	ENDIF

	IF !FILE(lcReporte + ".frx")
		MESSAGEBOX("No se encontro el reporte: " + lcReporte + ".frx", 64, "Libro Mayor")
		RETURN .F.
	ENDIF

	lnSql = _conecta(pcDB)
	IF lnSql <= 0
		MESSAGEBOX("No fue posible conectar con la base de datos.", 64, "Libro Mayor")
		RETURN .F.
	ENDIF
	PUBLIC pnNivelMayor, pnNivelMaximo, pnNivel, pnTNivel, paLargoNivel
	PUBLIC pnidUEjer, pnidPEjer, pnidUCAuto, pnidPCAuto
	DIMENSION pnNivel(9), pnTNivel(9), paLargoNivel(9)

	USE (pcSysDir + pcDB + "\sisempresas") IN 0 ALIAS c_param SHARED AGAIN
	SELECT c_param
	LOCATE FOR idempresa = 1
	IF !FOUND()
		MESSAGEBOX("No se encontro sisempresas idempresa=1.", 64, "Libro Mayor")
		RETURN .F.
	ENDIF

	pnNivel(1)=nivel1
	pnNivel(2)=nivel2
	pnNivel(3)=nivel3
	pnNivel(4)=nivel4
	pnNivel(5)=nivel5
	pnNivel(6)=nivel6
	pnNivel(7)=nivel7
	IF TYPE('nivel8')<>'N'
		pnNivel(8)=0
		pnNivel(9)=0
	ELSE
		pnNivel(8)=nivel8
		pnNivel(9)=nivel9
	ENDIF

	pnNivelMayor=nivelmayor
	pnTNivel(1)=pnNivel(1)
	FOR i = 2 TO 9
		pnTNivel(i)=pnTNivel(i-1)+pnNivel(i)
	ENDFOR
	pnNivelMaximo = 1
	FOR i = 1 TO 9
		IF pnNivel(i) <> 0
			pnNivelMaximo = i
		ENDIF
	ENDFOR
	lnLargoCuenta = 0
	FOR i = 1 TO 9
		IF i <= pnNivelMaximo
			lnLargoCuenta = lnLargoCuenta + pnNivel(i)
			paLargoNivel(i) = lnLargoCuenta
		ELSE
			paLargoNivel(i) = lnLargoCuenta + 1
		ENDIF
	ENDFOR

	pnidUEjer=idUEjer
	pnidPEjer=idPEjer
	pnidUCAuto=idUCAuto
	pnidPCAuto=idPCAuto
	USE IN c_param
	lcAliasAnt = ALIAS()
	lcDefaultAnt = SYS(5) + CURDIR()
	lcReportBehaviorAnt = SET("REPORTBEHAVIOR")
	llOk = .T.
	llCancelado = .F.

	FOR lnMes = lnMesIni TO lnMesFin
		ldFec1 = DATE(lnEjercicio, lnMes, 1)
		ldFec2 = GOMONTH(ldFec1, 1) - 1

		WAIT WINDOW "Generando Libro Mayor " + PADL(ALLTRIM(STR(lnMes)),2,"0") + ;
			"/" + ALLTRIM(STR(lnEjercicio,4,0)) + "  -  ESC para cancelar" NOWAIT
		IF INKEY(.1) = 27
			llCancelado = .T.
			llOk = .F.
			EXIT
		ENDIF

		lcSqlMayor = _ConsultaLibroMayorPDF(lnSql, ldFec1, ldFec2, llNoIncluirCierre)
		IF INKEY(.1) = 27
			llCancelado = .T.
			llOk = .F.
			EXIT
		ENDIF
		lcWhere = " where (SaldoIni<>0 or Debe<>0 or Haber<>0) and nivel<=" + ;
			ALLTRIM(STR(pnNivelMayor)) + " order by codcta,tip"

		_CerrarCursorSiExiste("c_movimi")
		IF miSQLEXEC(lnSql, ALLTRIM(lcSqlMayor + lcWhere), "c_movimi") <= 0
			llOk = .F.
			EXIT
		ENDIF

		SELECT c_movimi
		GO TOP

		pcFecha = nombremes(lnMes) + "/" + STR(lnEjercicio,4,0)

		_CerrarCursorSiExiste("c_Imp")
		SELECT *, 0000000000 AS linea FROM c_movimi INTO CURSOR c_Imp READWRITE

		SELECT c_Imp
		REPLACE llave WITH IIF(tip=1, "0", "1") ALL
		GO TOP

		SELECT c_Imp
		INDEX ON RECNO() TAG llave DESCENDING
		SET ORDER TO llave
		lccodcta = ""
		lnlincuenta = 0
		SCAN
			IF lccodcta + " " <> ALLTRIM(SUBSTR(codcta,1,2)) + " " AND llave = "1"
				lnlincuenta = lnlincuenta + 1
				REPLACE linea WITH lnlincuenta
				lccodcta = ALLTRIM(SUBSTR(codcta,1,pnNivelMayor-1))
			ELSE
				REPLACE linea WITH lnlincuenta
			ENDIF
		ENDSCAN
		SET ORDER TO

		_CerrarCursorSiExiste("c_resumen")
		SELECT * FROM c_Imp INTO CURSOR c_resumen

		SELECT c_resumen
		lcArchivoPdf = lcRutaDestino + "Libro_Mayor_" + ALLTRIM(STR(lnEjercicio,4,0)) + "_" + ;
			PADL(ALLTRIM(STR(lnMes)),2,"0") + ".pdf"
		lcCsv = lcRutaDestino + "Libro_Mayor_" + ALLTRIM(STR(lnEjercicio,4,0)) + "_" + ;
			PADL(ALLTRIM(STR(lnMes)),2,"0") + ".csv"
		lcJson = lcRutaDestino + "Libro_Mayor_" + ALLTRIM(STR(lnEjercicio,4,0)) + "_" + ;
			PADL(ALLTRIM(STR(lnMes)),2,"0") + ".json"
		lcLog = lcRutaDestino + "Libro_Mayor_" + ALLTRIM(STR(lnEjercicio,4,0)) + "_" + ;
			PADL(ALLTRIM(STR(lnMes)),2,"0") + ".log"
		IF FILE(lcArchivoPdf)
			DELETE FILE (lcArchivoPdf)
		ENDIF
		IF FILE(lcCsv)
			DELETE FILE (lcCsv)
		ENDIF
		IF FILE(lcJson)
			DELETE FILE (lcJson)
		ENDIF
		COPY TO (lcCsv) TYPE CSV
		lcPy = pcSysDir + "Programas\generar_libro_mayor_pdf.py"
		lcComillas = CHR(34)
		lcCmd = GETENV("COMSPEC") + " /C python " + lcComillas + lcPy + lcComillas + " " + ;
			lcComillas + lcCsv + lcComillas + " " + lcComillas + lcArchivoPdf + lcComillas + " " + ;
			lcComillas + pcFecha + lcComillas + " " + lcComillas + lcJson + lcComillas + " > " + ;
			lcComillas + lcLog + lcComillas + " 2>&1"
		USE IN c_resumen
		USE IN c_Imp
		USE IN c_movimi
		RUN /N7 &lcCmd
		lnRun = 0
		lnEspera = 0
		DO WHILE !FILE(lcArchivoPdf) AND lnEspera < 120
			INKEY(1)
			lnEspera = lnEspera + 1
		ENDDO
		IF lnRun <> 0 OR !FILE(lcArchivoPdf)
			MESSAGEBOX("No se pudo generar el PDF. Revise: " + lcLog, 16, "Libro Mayor")
			llOk = .F.
			EXIT
		ENDIF
		IF INKEY(.1) = 27
			llCancelado = .T.
			llOk = .F.
			EXIT
		ENDIF
	ENDFOR

	SET REPORTBEHAVIOR &lcReportBehaviorAnt
	IF !EMPTY(lcPrinOld)
		SET PRINTER TO NAME (lcPrinOld)
	ENDIF
	IF !EMPTY(lcAliasAnt) AND USED(lcAliasAnt)
		SELECT (lcAliasAnt)
	ENDIF

	IF llCancelado
		WAIT WINDOW "Generacion de Libro Mayor cancelada por el usuario." TIMEOUT 2
	ELSE
		IF llOk
			WAIT WINDOW "PDF de Libro Mayor generado en: " + lcRutaDestino TIMEOUT 2
		ENDIF
	ENDIF

	RETURN llOk
ENDFUNC


FUNCTION _ConsultaLibroMayorPDF(tnSql, tdFec1, tdFec2, tlNoIncluirCierre)
	LOCAL lnSql, ldfec1, ldfec2, ldfec11, lcesteano, lcfecff, lcFec1, lcFec2
	LOCAL filCCco, lcfilt2, lcfilta, lcfiltdd, lc_c_ctbPartidas, lc_c_Detalle
	LOCAL lcIngresoGasto, lnCtrlSql, lnsiLiquidar, lnIdctaUtilAnte, lnIdctaUtilPer
	LOCAL lnidAntePerGas, lnidActuPerGas, lcComanBalanza, lcSaldoIni, lcMovMes
	LOCAL lnNivel

	lnSql = tnSql
	ldfec1 = tdFec1
	ldfec2 = tdFec2
	ldfec11 = DATE(YEAR(ldfec1), 1, 1)
	lcesteano = STR(YEAR(ldfec1), 4, 0)
	lcfecff = DTOC(ldfec2)
	lcFec1 = DTOC(ldfec1)
	lcFec2 = DTOC(ldfec2)
	filCCco = ""
	lcfilt2 = ""
	lcfilta = ""
	lcfiltdd = ""

	IF tlNoIncluirCierre
		lcfilt2 = " and !(BETWEEN(t2.fechapartida,CTOD('" + lcFec1 + ;
			"'),CTOD('" + lcFec2 + "')) and t2.idtipopar=254) "
		lcfilta = " and !(BETWEEN(a.fechapartida,CTOD('" + lcFec1 + ;
			"'),CTOD('" + lcFec2 + "')) and a.idtipopar=254) "
		lcfiltdd = " and !(BETWEEN(d.fechapartida,CTOD('" + lcFec1 + ;
			"'),CTOD('" + lcFec2 + "')) and d.idtipopar=254) "
	ENDIF

	lnIdctaUtilAnte = _idCuentaUtilidadOperdidaEjercicioAnterior(lnSql, ldfec11)
	lnIdctaUtilPer = _idCuentaUtilidadOperdidaEjercicioPeriodo(lnSql, ldfec11, ldfec2)

	_CerrarCursorSiExiste("c_detalle")
	SELECT t1.idcuenta, ;
		IIF(YEAR(t2.fechapartida)<YEAR(ldfec1), ROUND(t1.debe-t1.haber,2), 000000000000.00) AS anopasado, ;
		IIF(YEAR(t2.fechapartida)=YEAR(ldfec1) AND t2.fechapartida<ldfec1, ROUND(t1.debe-t1.haber,2), 000000000000.00) AS inicial, ;
		IIF(BETWEEN(t2.fechapartida, ldfec1, ldfec2), ROUND(t1.debe,2), 000000000000.00) AS debe, ;
		IIF(BETWEEN(t2.fechapartida, ldfec1, ldfec2), ROUND(t1.haber,2), 000000000000.00) AS haber, ;
		t2.fechapartida, t1.idctrocosto, t1.idpartida ;
		FROM ctbpartidasdeta t1 ;
		INNER JOIN ctbpartidas t2 ON t1.idpartida=t2.idpartida ;
		WHERE t2.origen<>'CYB' AND t2.fechapartida<=ldfec2 &lcfilt2 ;
	UNION ALL ;
	SELECT t1.idcuenta, ;
		IIF(YEAR(z.fechadocto)<YEAR(ldfec1), ROUND(t1.debe-t1.haber,2), 000000000000.00) AS anopasado, ;
		IIF(YEAR(z.fechadocto)=YEAR(ldfec1) AND z.fechadocto<ldfec1, ROUND(t1.debe-t1.haber,2), 000000000000.00) AS inicial, ;
		IIF(BETWEEN(z.fechadocto, ldfec1, ldfec2), ROUND(t1.debe,2), 000000000000.00) AS debe, ;
		IIF(BETWEEN(z.fechadocto, ldfec1, ldfec2), ROUND(t1.haber,2), 000000000000.00) AS haber, ;
		z.fechadocto AS fechapartida, t1.idctrocosto, t1.idpartida ;
		FROM ctbpartidasdeta t1 ;
		INNER JOIN cybmovimientos z ON t1.idpartida=z.iddocto ;
		WHERE z.fechadocto<=ldfec2 ;
		INTO CURSOR c_detalle READWRITE
	lcIngresoGasto = "SELECT SUM(IIF(YEAR(b.fechapartida)<" + lcesteano + ;
		",anopasado,0000000000.00000)) as ini," + ;
		"SUM(IIF(YEAR(b.fechapartida)=" + lcesteano + ;
		",inicial+ROUND(debe-haber,2),0000000000.00000)) as fin " + ;
		"FROM c_Detalle b inner join ctbcuentas a on b.idcuenta=a.idcuenta " + ;
		"and BETWEEN(a.idtipocuenta,400,900) "

	_CerrarCursorSiExiste("c_sal")
	lnCtrlSql = miSQLEXEC(lnSql, lcIngresoGasto, "c_sal")
	lnsiLiquidar = 1

	IF USED("c_sal")
		IF NVL(c_sal.ini,0) > 0
			lnidAntePerGas = STR(pnidpcauto,10,0)
		ELSE
			lnidAntePerGas = STR(pnidUcauto,10,0)
		ENDIF

		IF lnsiLiquidar = 1
			IF NVL(c_sal.ini,0) > 0
				lnidActuPerGas = STR(pnidpejer,10,0)
			ELSE
				lnidActuPerGas = STR(pniduejer,10,0)
			ENDIF
		ELSE
			lnidActuPerGas = "0         "
		ENDIF
	ELSE
		lnidAntePerGas = "0         "
		lnidActuPerGas = "0         "
	ENDIF

	_CerrarCursorSiExiste("c_ctbpartidasdeta")
	SELECT a.idpartidad, a.idpartida, t4.idcuenta, t4.codcta, t4.cuenta, ;
			a.conceptod, ROUND(a.debe,2) AS debe, ROUND(a.haber,2) AS haber, ;
			a.origen, a.idorigen, a.idsucursal, a.idctrocosto, a.nodo, a.eliminado, ;
			IIF(d.fechapartida<ldfec11, ldfec11-1, d.fechapartida) AS fechapartida ;
		FROM ctbpartidasdeta a ;
			INNER JOIN ctbpartidas d ON a.idpartida=d.idpartida ;
			INNER JOIN ctbcuentas b ON a.idcuenta=b.idcuenta ;
			INNER JOIN ctbcuentas t4 ON IIF(BETWEEN(b.idtipocuenta,400,999), ;
				IIF(d.fechapartida<ldfec11, lnIdctaUtilPer, a.idcuenta), ;
				a.idcuenta)=t4.idcuenta ;
		WHERE d.fechapartida<=ldfec2 &lcfiltdd ;
		INTO CURSOR c_ctbpartidasdeta READWRITE

	_CerrarCursorSiExiste("c_ctbpartidas")
	SELECT a.idpartida, a.periodo, a.idtipopar, a.numeropartida, a.monto, ;
			a.origen, a.idsucursal, a.idctrocosto, a.nodo, a.eliminado, ;
			IIF(a.fechapartida<ldfec11, ldfec11-1, a.fechapartida) AS fechapartida ;
		FROM ctbpartidas a ;
		WHERE a.fechapartida<=ldfec2 &lcfilta ;
		INTO CURSOR c_ctbpartidas READWRITE
	REPLACE periodo WITH DTOS(fechapartida) ALL

	lcSaldoIni = "SELECT t0.idcuenta,t0.debe-t0.haber as SaldoIni " + ;
		"FROM c_ctbpartidasdeta t0 INNER JOIN c_ctbpartidas t1 " + ;
		"ON t0.idpartida=t1.idpartida WHERE t1.fechapartida<CTOD('" + lcFec1 + "') "

	FOR lnNivel = 7 TO 2 STEP -1
		lcSaldoIni = lcSaldoIni + "UNION ALL SELECT t3.idcuenta," + ;
			"t0.debe-t0.haber as SaldoIni FROM c_ctbpartidasdeta t0 " + ;
			"INNER JOIN c_ctbpartidas t1 ON t0.idpartida=t1.idpartida " + ;
			"INNER JOIN ctbcuentas t2 ON t0.idcuenta=t2.idcuenta " + ;
			"INNER JOIN ctbcuentas t3 ON t3.idcuenta=_ObtenerPadreCta2(t2.codcta," + ;
			ALLTRIM(STR(lnNivel)) + ") WHERE t1.fechapartida<CTOD('" + lcFec1 + "') "
	ENDFOR

	lcMovMes = "SELECT t0.idcuenta,t0.debe,t0.haber FROM c_ctbpartidasdeta t0 " + ;
		"INNER JOIN c_ctbpartidas t1 ON t0.idpartida=t1.idpartida " + ;
		"WHERE BETWEEN(t1.fechapartida,CTOD('" + lcFec1 + "'),CTOD('" + lcFec2 + "')) "

	FOR lnNivel = 7 TO 2 STEP -1
		lcMovMes = lcMovMes + "UNION ALL SELECT t3.idcuenta,t0.debe,t0.haber " + ;
			"FROM c_ctbpartidasdeta t0 INNER JOIN c_ctbpartidas t1 " + ;
			"ON t0.idpartida=t1.idpartida INNER JOIN ctbcuentas t2 " + ;
			"ON t0.idcuenta=t2.idcuenta INNER JOIN ctbcuentas t3 " + ;
			"ON t3.idcuenta=_ObtenerPadreCta2(t2.codcta," + ALLTRIM(STR(lnNivel)) + ") " + ;
			"WHERE BETWEEN(t1.fechapartida,CTOD('" + lcFec1 + "'),CTOD('" + lcFec2 + "')) "
	ENDFOR

	lcComanBalanza = "SELECT *,' ' as llave FROM (SELECT c1.idcuenta," + ;
		"c1.codcta,c1.cuenta,NVL(c9.SaldoIni,0000000000.00) as SaldoIni," + ;
		"NVL(c10.debe,0000000000.00) as debe,NVL(c10.haber,0000000000.00) as haber," + ;
		"NVL(c9.SaldoIni,0000000000.00)+NVL(c10.debe,0000000000.00)-" + ;
		"NVL(c10.haber,0000000000.00) as SaldoFin,c1.nivel,c1.naturaleza," + ;
		"c1.status,c1.detalle,1 as tip,CTOD(' ') as fechapartida " + ;
		"FROM ctbcuentas c1 LEFT JOIN (select Jc.idcuenta as idcuenta,SaldoIni " + ;
		"from (SELECT idcuenta,SUM(SaldoIni) as SaldoIni FROM (" + lcSaldoIni + ;
		") as t9 ORDER BY idcuenta GROUP BY idcuenta ) as jj inne join ctbcuentas jc " + ;
		"on jj.idcuenta=jc.idcuenta ) as c9 ON c1.idcuenta=c9.idcuenta " + ;
		"LEFT JOIN (SELECT idcuenta,SUM(debe) as debe, SUM(haber) as haber FROM (" + ;
		lcMovMes + ") as t9 ORDER BY idcuenta GROUP BY idcuenta ) as c10 " + ;
		"ON c1.idcuenta=c10.idcuenta union all selec mov.* from " + ;
		"(SELECT t2.idcuenta,MIN(t2.codcta)as codcta,MIN(t2.cuenta) as cuenta," + ;
		"SUM(0000000000.00) as SaldoIni,sum(t0.debe) as debe,SUM(t0.haber) as haber," + ;
		"SUM(0000000000.00) as saldoFin,min(t2.nivel) as nivel," + ;
		"MIN(t2.naturaleza) as naturaleza,MIN(t2.status) as status," + ;
		"MIN(t2.detalle) as detalle,MIN(2) as Tip,t1.fechapartida " + ;
		"FROM c_ctbpartidasdeta t0 INNER JOIN c_ctbpartidas t1 ON t0.idpartida=t1.idpartida " + ;
		"INNER JOIN ctbcuentas t9 ON t0.idcuenta=t9.idcuenta INNER JOIN ctbcuentas t2 " + ;
		"ON SUBSTR(t9.codcta,1,pnTNivel(pnNivelMayor))=t2.codcta " + ;
		"INNER JOIN siscata t4 ON t1.idtipopar=t4.id " + ;
		"WHERE BETWEEN(t1.fechapartida,CTOD('" + lcFec1 + "'),CTOD('" + lcFec2 + "')) " + ;
		"order by t2.idcuenta,t1.fechapartida group by t2.idcuenta,t1.fechapartida " + ;
		") as mov) as cur "
	RETURN lcComanBalanza
ENDFUNC


FUNCTION _CerrarCursorSiExiste(tcAlias)
	IF TYPE("tcAlias") = "C" AND USED(tcAlias)
		USE IN (tcAlias)
	ENDIF
	RETURN .T.
ENDFUNC



FUNCTION EnviarCorreoSMTPReal(tcSmtpServer, tnSmtpPort, tlUsaSSL, tcUsuario, tcClave, ;
		tcRemitente, tcNombreRemitente, tcPara, tcCC, tcBCC, tcAsunto, tcCuerpo, ;
		tcAdjunto1, tcAdjunto2, tcImapServer, tnImapPort, tlImapSSL, ;
		tcCarpetaEnviados, tcMensajeRetorno)
	LOCAL lcSchema, loConfig, loMsg, loError, lcErr, lcEml, llOk, llGuardarEnviados
	LOCAL lcFrom, lcPara, lcCC, lcBCC, lcAdjunto1, lcAdjunto2, lcMsgEnviados
	LOCAL lcMessageId, llYaEstaEnEnviados

	lcErr = ""
	lcEml = ""
	tcMensajeRetorno = ""
	llOk = .F.
	llYaEstaEnEnviados = .F.
	llGuardarEnviados = !EMPTY(ALLTRIM(EVL(tcImapServer, ""))) AND ;
		!EMPTY(ALLTRIM(EVL(tcCarpetaEnviados, "")))

	lcPara = ALLTRIM(EVL(tcPara, ""))
	lcCC = ALLTRIM(EVL(tcCC, ""))
	lcBCC = ALLTRIM(EVL(tcBCC, ""))
	lcAdjunto1 = ALLTRIM(EVL(tcAdjunto1, ""))
	lcAdjunto2 = ALLTRIM(EVL(tcAdjunto2, ""))

	IF EMPTY(ALLTRIM(EVL(tcSmtpServer, "")))
		tcMensajeRetorno = "No se envio el correo: falta servidor SMTP."
		RETURN .F.
	ENDIF
	IF EMPTY(lcPara) AND EMPTY(lcCC) AND EMPTY(lcBCC)
		tcMensajeRetorno = "No se envio el correo: falta destinatario, CC o BCC."
		RETURN .F.
	ENDIF
	IF !EMPTY(lcAdjunto1) AND !FILE(lcAdjunto1)
		tcMensajeRetorno = "No se envio el correo: no existe el adjunto 1: " + lcAdjunto1
		RETURN .F.
	ENDIF
	IF !EMPTY(lcAdjunto2) AND !FILE(lcAdjunto2)
		tcMensajeRetorno = "No se envio el correo: no existe el adjunto 2: " + lcAdjunto2
		RETURN .F.
	ENDIF

	IF VARTYPE(tnSmtpPort) <> "N" OR tnSmtpPort <= 0
		tnSmtpPort = IIF(tlUsaSSL, 465, 25)
	ENDIF

	TRY
		lcSchema = "http://schemas.microsoft.com/cdo/configuration/"
		loConfig = CREATEOBJECT("CDO.Configuration")
		WITH loConfig.FIELDS
			.ITEM(lcSchema + "smtpserver") = ALLTRIM(tcSmtpServer)
			.ITEM(lcSchema + "smtpserverport") = tnSmtpPort
			.ITEM(lcSchema + "sendusing") = 2
			.ITEM(lcSchema + "smtpusessl") = tlUsaSSL
			IF !EMPTY(ALLTRIM(EVL(tcUsuario, "")))
				.ITEM(lcSchema + "smtpauthenticate") = 1
				.ITEM(lcSchema + "sendusername") = ALLTRIM(tcUsuario)
				.ITEM(lcSchema + "sendpassword") = ALLTRIM(EVL(tcClave, ""))
			ELSE
				.ITEM(lcSchema + "smtpauthenticate") = 0
			ENDIF
			.UPDATE
		ENDWITH

		lcFrom = ALLTRIM(EVL(tcRemitente, ""))
		IF !EMPTY(ALLTRIM(EVL(tcNombreRemitente, "")))
			lcFrom = ALLTRIM(tcNombreRemitente) + " <" + lcFrom + ">"
		ENDIF

		lcMessageId = _SMTPGenerarMessageId(tcRemitente)
		loMsg = CREATEOBJECT("CDO.Message")
		WITH loMsg
			.Configuration = loConfig
			.From = lcFrom
			.To = lcPara
			IF !EMPTY(lcCC)
				.CC = lcCC
			ENDIF
			IF !EMPTY(lcBCC)
				.BCC = lcBCC
			ENDIF
			.Subject = ALLTRIM(EVL(tcAsunto, ""))
			.TextBody = EVL(tcCuerpo, "")
			.Fields.Item("urn:schemas:mailheader:message-id").Value = lcMessageId
			.Fields.Update
			IF !EMPTY(lcAdjunto1)
				.AddAttachment(lcAdjunto1)
			ENDIF
			IF !EMPTY(lcAdjunto2)
				.AddAttachment(lcAdjunto2)
			ENDIF
		ENDWITH

		lcEml = _SMTPGuardarEmlTemporal(loMsg)
		loMsg.Send()
		llOk = .T.

	CATCH TO loError
		lcErr = "No se envio el correo por SMTP." + CHR(13) + ;
			"Error: " + TRANSFORM(loError.ERRORNO) + CHR(13) + ;
			"Linea: " + TRANSFORM(loError.LINENO) + CHR(13) + ;
			"Motivo: " + loError.MESSAGE
	FINALLY
		IF TYPE("loMsg") = "O"
			RELEASE loMsg
		ENDIF
		IF TYPE("loConfig") = "O"
			RELEASE loConfig
		ENDIF
	ENDTRY

	IF !EMPTY(lcErr)
		tcMensajeRetorno = lcErr
		IF !EMPTY(lcEml) AND FILE(lcEml)
			DELETE FILE (lcEml)
		ENDIF
		RETURN .F.
	ENDIF

	IF llGuardarEnviados
		lcMsgEnviados = ""
		INKEY(2)
		llYaEstaEnEnviados = _SMTPExisteEnEnviadosIMAP(lcMessageId, tcImapServer, tnImapPort, tlImapSSL, ;
			EVL(tcUsuario, ""), EVL(tcClave, ""), tcCarpetaEnviados, @lcMsgEnviados)
		IF llYaEstaEnEnviados
			tcMensajeRetorno = "Correo enviado por SMTP. El servidor ya guardo copia en Enviados."
		ELSE
			IF !_SMTPAgregarAEnviadosIMAP(lcEml, tcImapServer, tnImapPort, tlImapSSL, ;
					EVL(tcUsuario, ""), EVL(tcClave, ""), tcCarpetaEnviados, @lcMsgEnviados)
				tcMensajeRetorno = "El servidor SMTP acepto el correo, pero no se pudo confirmar ni guardar en Enviados." + ;
					CHR(13) + lcMsgEnviados
				IF !EMPTY(lcEml) AND FILE(lcEml)
					DELETE FILE (lcEml)
				ENDIF
				RETURN .F.
			ENDIF
			tcMensajeRetorno = "Correo enviado por SMTP y guardado en Enviados por IMAP."
		ENDIF
	ELSE
		tcMensajeRetorno = "Correo enviado por SMTP. No se verifico Enviados porque no se indicaron datos IMAP."
	ENDIF

	IF !EMPTY(lcEml) AND FILE(lcEml)
		DELETE FILE (lcEml)
	ENDIF
	RETURN llOk
ENDFUNC


FUNCTION _SMTPGuardarEmlTemporal(toMsg)
	LOCAL loStream, lcEml
	lcEml = ADDBS(SYS(2023)) + SYS(2015) + ".eml"
	loStream = toMsg.GetStream()
	loStream.SaveToFile(lcEml, 2)
	loStream.Close()
	RELEASE loStream
	RETURN lcEml
ENDFUNC


FUNCTION _SMTPExisteEnEnviadosIMAP(tcMessageId, tcImapServer, tnImapPort, tlImapSSL, ;
		tcUsuario, tcClave, tcCarpetaEnviados, tcMensajeRetorno)
	LOCAL lcCfg, lcLog, lcUrl, lcCmd, loShell, lnExit, lcSalida, loErr, lcRequest

	tcMensajeRetorno = ""
	IF EMPTY(ALLTRIM(EVL(tcMessageId, "")))
		tcMensajeRetorno = "No se puede verificar Enviados: falta Message-ID."
		RETURN .F.
	ENDIF
	IF EMPTY(ALLTRIM(EVL(tcUsuario, "")))
		tcMensajeRetorno = "No se puede verificar Enviados por IMAP: falta usuario."
		RETURN .F.
	ENDIF
	IF VARTYPE(tnImapPort) <> "N" OR tnImapPort <= 0
		tnImapPort = IIF(tlImapSSL, 993, 143)
	ENDIF

	lcCfg = ADDBS(SYS(2023)) + SYS(2015) + ".cfg"
	lcLog = ADDBS(SYS(2023)) + SYS(2015) + ".log"
	lcUrl = IIF(tlImapSSL, "imaps://", "imap://") + ALLTRIM(tcImapServer) + ":" + ;
		ALLTRIM(STR(tnImapPort)) + "/" + _SMTPUrlBasico(ALLTRIM(tcCarpetaEnviados))
	lcRequest = 'SEARCH HEADER Message-ID "' + tcMessageId + '"'

	STRTOFILE("url = " + _SMTPCurlTexto(lcUrl) + CHR(13) + ;
		"user = " + _SMTPCurlTexto(ALLTRIM(tcUsuario) + ":" + ALLTRIM(EVL(tcClave, ""))) + CHR(13) + ;
		"request = " + _SMTPCurlTexto(lcRequest) + CHR(13) + ;
		"silent" + CHR(13) + ;
		"show-error" + CHR(13), lcCfg, 0)

	lcCmd = GETENV("COMSPEC") + " /C curl.exe --config " + ;
		_SMTPComillas(lcCfg) + " > " + _SMTPComillas(lcLog) + " 2>&1"

	TRY
		loShell = CREATEOBJECT("WScript.Shell")
		lnExit = loShell.Run(lcCmd, 0, .T.)
	CATCH TO loErr
		tcMensajeRetorno = "No se pudo ejecutar curl.exe para buscar en Enviados: " + loErr.MESSAGE
		RETURN .F.
	FINALLY
		IF TYPE("loShell") = "O"
			RELEASE loShell
		ENDIF
	ENDTRY

	lcSalida = IIF(FILE(lcLog), FILETOSTR(lcLog), "")
	IF FILE(lcCfg)
		DELETE FILE (lcCfg)
	ENDIF
	IF FILE(lcLog)
		DELETE FILE (lcLog)
	ENDIF

	IF lnExit <> 0
		tcMensajeRetorno = "No se pudo consultar Enviados por IMAP. Codigo: " + TRANSFORM(lnExit) + ;
			IIF(EMPTY(lcSalida), "", CHR(13) + lcSalida)
		RETURN .F.
	ENDIF

	IF "* SEARCH " $ UPPER(lcSalida) AND !EMPTY(ALLTRIM(STRTRAN(STRTRAN(UPPER(lcSalida), "* SEARCH", ""), CHR(13)+CHR(10), "")))
		tcMensajeRetorno = "El mensaje ya existe en Enviados."
		RETURN .T.
	ENDIF

	tcMensajeRetorno = "El mensaje no aparece aun en Enviados."
	RETURN .F.
ENDFUNC


FUNCTION _SMTPAgregarAEnviadosIMAP(tcEml, tcImapServer, tnImapPort, tlImapSSL, ;
		tcUsuario, tcClave, tcCarpetaEnviados, tcMensajeRetorno)
	LOCAL lcCfg, lcLog, lcUrl, lcCmd, loShell, lnExit, lcSalida, loErr

	tcMensajeRetorno = ""
	IF EMPTY(tcEml) OR !FILE(tcEml)
		tcMensajeRetorno = "No existe el archivo EML temporal para guardar en Enviados."
		RETURN .F.
	ENDIF
	IF EMPTY(ALLTRIM(EVL(tcUsuario, "")))
		tcMensajeRetorno = "No se puede guardar en Enviados por IMAP: falta usuario."
		RETURN .F.
	ENDIF
	IF VARTYPE(tnImapPort) <> "N" OR tnImapPort <= 0
		tnImapPort = IIF(tlImapSSL, 993, 143)
	ENDIF

	lcCfg = ADDBS(SYS(2023)) + SYS(2015) + ".cfg"
	lcLog = ADDBS(SYS(2023)) + SYS(2015) + ".log"
	lcUrl = IIF(tlImapSSL, "imaps://", "imap://") + ALLTRIM(tcImapServer) + ":" + ;
		ALLTRIM(STR(tnImapPort)) + "/" + _SMTPUrlBasico(ALLTRIM(tcCarpetaEnviados))

	STRTOFILE("url = " + _SMTPCurlTexto(lcUrl) + CHR(13) + ;
		"user = " + _SMTPCurlTexto(ALLTRIM(tcUsuario) + ":" + ALLTRIM(EVL(tcClave, ""))) + CHR(13) + ;
		"upload-file = " + _SMTPCurlTexto(tcEml) + CHR(13) + ;
		"silent" + CHR(13) + ;
		"show-error" + CHR(13) + ;
		"fail" + CHR(13), lcCfg, 0)

	lcCmd = GETENV("COMSPEC") + " /C curl.exe --config " + ;
		_SMTPComillas(lcCfg) + " > " + _SMTPComillas(lcLog) + " 2>&1"

	TRY
		loShell = CREATEOBJECT("WScript.Shell")
		lnExit = loShell.Run(lcCmd, 0, .T.)
	CATCH TO loErr
		tcMensajeRetorno = "No se pudo ejecutar curl.exe para IMAP APPEND: " + loErr.MESSAGE
		RETURN .F.
	FINALLY
		IF TYPE("loShell") = "O"
			RELEASE loShell
		ENDIF
	ENDTRY

	lcSalida = IIF(FILE(lcLog), FILETOSTR(lcLog), "")
	IF FILE(lcCfg)
		DELETE FILE (lcCfg)
	ENDIF
	IF FILE(lcLog)
		DELETE FILE (lcLog)
	ENDIF

	IF lnExit <> 0
		tcMensajeRetorno = "IMAP APPEND fallo. Codigo: " + TRANSFORM(lnExit) + ;
			IIF(EMPTY(lcSalida), "", CHR(13) + lcSalida)
		RETURN .F.
	ENDIF

	tcMensajeRetorno = "Guardado en carpeta IMAP: " + tcCarpetaEnviados
	RETURN .T.
ENDFUNC


FUNCTION _SMTPGenerarMessageId(tcRemitente)
	LOCAL lcDominio, lnPos
	lcDominio = "localhost"
	lnPos = AT("@", ALLTRIM(EVL(tcRemitente, "")))
	IF lnPos > 0
		lcDominio = SUBSTR(ALLTRIM(tcRemitente), lnPos + 1)
	ENDIF
	RETURN "<" + SYS(2015) + "." + TRANSFORM(SECONDS() * 1000, "999999999") + "@" + lcDominio + ">"
ENDFUNC


FUNCTION _SMTPCurlTexto(tcTexto)
	RETURN '"' + STRTRAN(STRTRAN(EVL(tcTexto, ""), "\", "\\"), '"', '\"') + '"'
ENDFUNC


FUNCTION _SMTPComillas(tcTexto)
	RETURN '"' + STRTRAN(EVL(tcTexto, ""), '"', '\"') + '"'
ENDFUNC


FUNCTION _SMTPUrlBasico(tcTexto)
	LOCAL lcTexto
	lcTexto = EVL(tcTexto, "")
	lcTexto = STRTRAN(lcTexto, " ", "%20")
	RETURN lcTexto
ENDFUNC



FUNCTION _ValidarCamposContaAgua
    LOCAL llOk,llTablaOk,llExiste,lnCampo,lcAviso,loError
    llOk=.T.

    * Clientes: revisar compartido y pedir exclusivo solo si falta algun campo GPS.
    llExiste=.T.
    lcAviso=''
    TRY
        USE pcSysDir+pcDB+'\cyvclipro' SHARED AGAIN IN 0 ALIAS cValContaAguaCli
        llExiste=TYPE("cValContaAguaCli.gpslatitud")<>"U" AND ;
            TYPE("cValContaAguaCli.gpslongitud")<>"U" AND ;
            TYPE("cValContaAguaCli.gpsprecision")<>"U" AND ;
            TYPE("cValContaAguaCli.gpsfecha")<>"U"
    CATCH TO loError
        llTablaOk=.F.
        llOk=.F.
        lcAviso="No se pudo revisar CYVCLIPRO: "+loError.Message
    FINALLY
        IF USED("cValContaAguaCli")
            USE IN cValContaAguaCli
        ENDIF
    ENDTRY

    IF llTablaOk AND !llExiste
        TRY
            USE pcSysDir+pcDB+'\cyvclipro' EXCLUSIVE IN 0 ALIAS cActContaAguaCli
            IF TYPE("cActContaAguaCli.gpslatitud")="U"
                ALTER TABLE cActContaAguaCli ADD COLUMN gpslatitud N(12,8) DEFAULT 0
            ENDIF
            IF TYPE("cActContaAguaCli.gpslongitud")="U"
                ALTER TABLE cActContaAguaCli ADD COLUMN gpslongitud N(13,8) DEFAULT 0
            ENDIF
            IF TYPE("cActContaAguaCli.gpsprecision")="U"
                ALTER TABLE cActContaAguaCli ADD COLUMN gpsprecision N(12,2) DEFAULT 0
            ENDIF
            IF TYPE("cActContaAguaCli.gpsfecha")="U"
                ALTER TABLE cActContaAguaCli ADD COLUMN gpsfecha T
            ENDIF
            lcAviso="Campos GPS actualizados en CYVCLIPRO."
        CATCH TO loError
            llOk=.F.
            lcAviso="Actualizacion pendiente en CYVCLIPRO; la tabla esta siendo utilizada. "+loError.Message
        FINALLY
            IF USED("cActContaAguaCli")
                USE IN cActContaAguaCli
            ENDIF
        ENDTRY
    ENDIF
    IF !EMPTY(lcAviso)
        WAIT WINDOW lcAviso NOWAIT
    ENDIF

    * Lecturas: validar todos los campos y el indice antes de solicitar exclusivo.
    llExiste=.T.
    lcAviso=''
    TRY
        USE pcSysDir+pcDB+'\cyvlecturas' SHARED AGAIN IN 0 ALIAS cValContaAguaLect
        llExiste=TYPE("cValContaAguaLect.gpslatitud")<>"U" AND ;
            TYPE("cValContaAguaLect.gpslongitud")<>"U" AND ;
            TYPE("cValContaAguaLect.gpsprecision")<>"U" AND ;
            TYPE("cValContaAguaLect.gpsfecha")<>"U" AND ;
            TYPE("cValContaAguaLect.syncuuid")<>"U" AND ;
            TAGNO("syncuuid","cValContaAguaLect")>0
    CATCH TO loError
        llTablaOk=.F.
        llOk=.F.
        lcAviso="No se pudo revisar CYVLECTURAS: "+loError.Message
    FINALLY
        IF USED("cValContaAguaLect")
            USE IN cValContaAguaLect
        ENDIF
    ENDTRY

    IF llTablaOk AND !llExiste
        TRY
            USE pcSysDir+pcDB+'\cyvlecturas' EXCLUSIVE IN 0 ALIAS cActContaAguaLect
            IF TYPE("cActContaAguaLect.gpslatitud")="U"
                ALTER TABLE cActContaAguaLect ADD COLUMN gpslatitud N(12,8) DEFAULT 0
            ENDIF
            IF TYPE("cActContaAguaLect.gpslongitud")="U"
                ALTER TABLE cActContaAguaLect ADD COLUMN gpslongitud N(13,8) DEFAULT 0
            ENDIF
            IF TYPE("cActContaAguaLect.gpsprecision")="U"
                ALTER TABLE cActContaAguaLect ADD COLUMN gpsprecision N(12,2) DEFAULT 0
            ENDIF
            IF TYPE("cActContaAguaLect.gpsfecha")="U"
                ALTER TABLE cActContaAguaLect ADD COLUMN gpsfecha T
            ENDIF
            IF TYPE("cActContaAguaLect.syncuuid")="U"
                ALTER TABLE cActContaAguaLect ADD COLUMN syncuuid C(36) DEFAULT ''
            ENDIF
            IF TAGNO("syncuuid","cActContaAguaLect")=0
                SELECT cActContaAguaLect
                INDEX ON UPPER(ALLTRIM(syncuuid)) TAG syncuuid
            ENDIF
            lcAviso="Campos GPS actualizados en CYVLECTURAS."
        CATCH TO loError
            llOk=.F.
            lcAviso="Actualizacion pendiente en CYVLECTURAS; la tabla esta siendo utilizada. "+loError.Message
        FINALLY
            IF USED("cActContaAguaLect")
                USE IN cActContaAguaLect
            ENDIF
        ENDTRY
    ENDIF
    IF !EMPTY(lcAviso)
        WAIT WINDOW lcAviso NOWAIT
    ENDIF

    RETURN llOk
ENDFUNC
FUNCTION _ValidarSisVinculos
    LOCAL lcRutaDatos, lcDatabase, lcTabla
    LOCAL lcError, llCreada

    lcRutaDatos = ADDBS(pcSysDir + pcdb)
    lcDatabase  = lcRutaDatos + "masterdb.dbc"
    lcTabla     = lcRutaDatos + "sisVinculos.dbf"
    lcError     = ""
    llCreada    = .F.

    IF FILE(lcTabla)
        RETURN .T.
    ENDIF

    TRY
        IF USED("sisVinculos")
            USE IN sisVinculos
        ENDIF

        OPEN DATABASE (lcDatabase) SHARED

        WAIT WINDOW ;
            "Agregando tabla de vínculos documentales..." ;
            NOWAIT

        CREATE TABLE (lcTabla) ;
            ( idvinc    I AUTOINC NEXTVALUE 1 STEP 1 PRIMARY KEY, ;
              iddoc     C(36)  NOT NULL, ;
              origen    C(10)  NOT NULL, ;
              iddocto   I      NOT NULL, ;
              idclipro  I      NOT NULL, ;
              idarchivo C(36)  NOT NULL, ;
              urlarchivo M     NOT NULL, ;
              nomarchivo C(180) NOT NULL, ;
              mimetype  C(100) NOT NULL, ;
              sha256    C(64)  NOT NULL, ;
              tamanoby  N(18,0) NOT NULL, ;
              tipoent   C(20)  NOT NULL, ;
              identidad C(40)  NOT NULL, ;
              naturalez C(20)  NOT NULL, ;
              tipodoc   C(30)  NOT NULL, ;
              titulo    C(120) NOT NULL, ;
              fechadoc  D      NULL, ;
              idusuario I      NOT NULL, ;
              fechacrea T      NOT NULL, ;
              estado    C(15)  NOT NULL, ;
              intentos  I      NOT NULL, ;
              ultsync   T      NULL, ;
              ulterror  M      NOT NULL, ;
              activo    L      NOT NULL )

        INDEX ON ;
            UPPER(PADR(ALLTRIM(tipoent), 20) + ;
                  PADR(ALLTRIM(identidad), 40)) ;
            TAG entidad

        INDEX ON iddoc TAG iddoc

        INDEX ON UPPER(PADR(ALLTRIM(origen), 10)) + ;
            PADL(ALLTRIM(STR(iddocto)), 12, "0") TAG docorigen

        INDEX ON PADL(ALLTRIM(STR(idclipro)), 12, "0") TAG idclipro

        INDEX ON idarchivo TAG idarchivo

        INDEX ON ;
            UPPER(PADR(ALLTRIM(estado), 15)) + ;
            TTOC(fechacrea, 1) ;
            TAG estado

        USE IN sisVinculos
        llCreada = .T.

    CATCH TO loError
        lcError = ;
            "No se pudo crear sisVinculos: " + ;
            loError.Message

        IF USED("sisVinculos")
            USE IN sisVinculos
        ENDIF

        WAIT WINDOW lcError NOWAIT
        llCreada = .F.

    FINALLY
        WAIT CLEAR
    ENDTRY

    RETURN llCreada
ENDFUNC


FUNCTION _ValidarSisVinculosCamposNube
    LOCAL lcRutaTabla, lcAliasAnterior, llOk, llExiste, lnCampo, loError

    lcRutaTabla = ADDBS(pcSysDir + pcDB) + "sisVinculos.dbf"
    lcAliasAnterior = ALIAS()
    llOk = .F.
    llExiste = .F.

    IF !FILE(lcRutaTabla)
        WAIT WINDOW "No existe sisVinculos; la actualizacion queda pendiente." NOWAIT
        RETURN .F.
    ENDIF

    TRY
        IF USED("cSisVincVal")
            USE IN cSisVincVal
        ENDIF
        USE (lcRutaTabla) SHARED AGAIN IN 0 ALIAS cSisVincVal
        SELECT cSisVincVal
        FOR lnCampo = 1 TO FCOUNT()
            IF UPPER(ALLTRIM(FIELD(lnCampo))) == "TAMANOBY"
                llExiste = .T.
                EXIT
            ENDIF
        ENDFOR
        llOk = .T.
    CATCH TO loError
        llOk = .F.
        WAIT WINDOW "No se pudo revisar sisVinculos: " + loError.Message NOWAIT
    FINALLY
        IF USED("cSisVincVal")
            USE IN cSisVincVal
        ENDIF
    ENDTRY

    IF !llOk
        IF !EMPTY(lcAliasAnterior) AND USED(lcAliasAnterior)
            SELECT (lcAliasAnterior)
        ENDIF
        RETURN .F.
    ENDIF

    IF llExiste
        IF !EMPTY(lcAliasAnterior) AND USED(lcAliasAnterior)
            SELECT (lcAliasAnterior)
        ENDIF
        RETURN .T.
    ENDIF

    TRY
        IF USED("sisVinculos")
            USE IN sisVinculos
        ENDIF

        WAIT WINDOW "Actualizando vinculos de SIGA Documentos..." NOWAIT
        USE (lcRutaTabla) EXCLUSIVE IN 0 ALIAS sisVinculos
        SELECT sisVinculos

        IF TYPE("sisVinculos.origen") = "U"
            ALTER TABLE sisVinculos ADD COLUMN origen C(10) DEFAULT ''
        ENDIF
        IF TYPE("sisVinculos.iddocto") = "U"
            ALTER TABLE sisVinculos ADD COLUMN iddocto I DEFAULT 0
        ENDIF
        IF TYPE("sisVinculos.idclipro") = "U"
            ALTER TABLE sisVinculos ADD COLUMN idclipro I DEFAULT 0
        ENDIF
        IF TYPE("sisVinculos.idarchivo") = "U"
            ALTER TABLE sisVinculos ADD COLUMN idarchivo C(36) DEFAULT ''
        ENDIF
        IF TYPE("sisVinculos.urlarchivo") = "U"
            ALTER TABLE sisVinculos ADD COLUMN urlarchivo M
        ENDIF
        IF TYPE("sisVinculos.nomarchivo") = "U"
            ALTER TABLE sisVinculos ADD COLUMN nomarchivo C(180) DEFAULT ''
        ENDIF
        IF TYPE("sisVinculos.mimetype") = "U"
            ALTER TABLE sisVinculos ADD COLUMN mimetype C(100) DEFAULT ''
        ENDIF
        IF TYPE("sisVinculos.sha256") = "U"
            ALTER TABLE sisVinculos ADD COLUMN sha256 C(64) DEFAULT ''
        ENDIF

        SELECT sisVinculos
        IF TAGNO("docorigen", "sisVinculos") = 0
            INDEX ON UPPER(PADR(ALLTRIM(origen), 10)) + ;
                PADL(ALLTRIM(STR(iddocto)), 12, "0") TAG docorigen
        ENDIF
        IF TAGNO("idclipro", "sisVinculos") = 0
            INDEX ON PADL(ALLTRIM(STR(idclipro)), 12, "0") TAG idclipro
        ENDIF
        IF TAGNO("idarchivo", "sisVinculos") = 0
            INDEX ON idarchivo TAG idarchivo
        ENDIF

        * Campo testigo: se crea al final de toda la migracion.
        IF TYPE("sisVinculos.tamanoby") = "U"
            ALTER TABLE sisVinculos ADD COLUMN tamanoby N(18,0) DEFAULT 0
        ENDIF

        llOk = .T.
    CATCH TO loError
        WAIT WINDOW "No se pudo actualizar sisVinculos: " + loError.Message NOWAIT
        llOk = .F.
    FINALLY
        IF USED("sisVinculos")
            USE IN sisVinculos
        ENDIF
        IF !EMPTY(lcAliasAnterior) AND USED(lcAliasAnterior)
            SELECT (lcAliasAnterior)
        ENDIF
        WAIT CLEAR
    ENDTRY

    RETURN llOk
ENDFUNC


