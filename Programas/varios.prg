FUNCTION _ValidarExistencias()
	IF pntipoconeccion=1
		WAIT WINDOW 'Iniciando la Validacion de Existencias....' NOWAIT 
		lcaliasvalida=ALIAS()
		pdFecIni=DATE()
		
		USE pcSysDir+pcdb+"\siskardexdoc" 	IN 0 SHARED AGAIN  ALIAS c_cxcMov
		USE pcSysDir+pcdb+"\siskardex" 		IN 0 SHARED AGAIN  ALIAS c_kar
		USE pcSysDir+pcdb+"\invproductos" 	IN 0 SHARED AGAIN  ALIAS c_invpro ORDER idproducto
		USE pcSysDir+pcdb+"\siscata" 		IN 0 SHARED AGAIN  ALIAS c_cat
		USE pcSysDir+pcdb+"\invexisbodega" 	IN 0 SHARED AGAIN  ALIAS c_exi ORDER LLAVE   && STR(IDBODEGA)+STR(IDPRODUCTO)
		
		SELECT cc.idproducto,SUM(cc.cantidad) as cantidad,SUM(cc.costototal) as costototal,cc.idbodega ;
			from 	(SELECT a.idproducto,IIF(a.ctrolinv=1,a.cantidad,a.cantidad*-1) as cantidad,;
						IIF(a.ctrolinv=1,a.costototal,a.costototal*-1) as costototal,a.idbodega ;
					FROM c_kar a ;
					left JOIN c_cxcMov b ON a.iddocto=b.iddocto ;
					WHERE a.fechadocto<=pdFecIni AND INLIST(a.ctrolinv,1,2,3) AND a.status=1 AND a.eliminado=0 ;
				UNION ALL ;
				SELECT a.idproducto,a.cantidad,a.costototal,a.idbodegatras ;
					FROM c_kar a ;
					LEFT JOIN c_cxcMov b ON a.iddocto=b.iddocto ;
					WHERE a.fechadocto<=pdFecIni AND a.ctrolinv=3 AND a.status=1 AND a.eliminado=0 AND a.idbodegatras<>0) as cc ;
		INNER JOIN c_cat b ON cc.idbodega=b.id AND origen='BOD' ;
		order by cc.idproducto,cc.idbodega GROUP BY cc.idproducto,cc.idbodega ;
		INTO CURSOR c_imptmp READWRITE  
		
		UPDATE c_exi set existencia=0, costototal =0 WHERE idproducto<>0
		UPDATE c_exi SET existencia = c_imptmp.cantidad, costototal =c_imptmp.costototal,;
					costo=IIF(c_imptmp.cantidad=0,costo,ROUND(ABS(c_imptmp.costototal/c_imptmp.cantidad),8)) ;
				from c_imptmp WHERE c_exi.idbodega=c_imptmp.idbodega AND c_exi.idproducto=c_imptmp.idproducto  
	
		****** resumiendo existencias por producto
		SELECT idproducto,SUM(cantidad) as cantidad,SUM(costototal) as costototal FROM c_imptmp ;
			ORDER BY idproducto GROUP BY idproducto INTO CURSOR c_pro READWRITE 
		
		UPDATE 	c_invpro set existencia=0, costototal =0 WHERE idproducto<>0
		UPDATE c_invpro SET existencia = c_pro.cantidad, costototal =c_pro.costototal,;
					costopromedio=IIF(c_pro.cantidad=0,costopromedio,ROUND(ABS(c_pro.costototal/c_pro.cantidad),8)) ;
				from c_pro WHERE c_invpro.idproducto=c_pro.idproducto  
	
		USE IN c_cxcMov
		USE IN c_invpro
		USE IN c_cat
		USE IN c_kar
		USE IN c_exi
		USE IN c_pro
		USE IN c_imptmp
		
		IF !EMPTY(lcaliasvalida)
			SELECT (lcaliasvalida)
		ENDIF 
	ENDIF 
	WAIT CLEAR 
	RETURN .t.
ENDFUNC 

FUNCTION _RecalcularSaldosdeClientesyProveedores(lcMiorigenRecostear)
	IF EMPTY(NVL(lcMiorigenRecostear,''))
		lcorigen='CLI'
	ELSE 
		lcorigen=lcMiorigenRecostear
	ENDIF 
	
	lcaliascxc=ALIAS()

	IF !USED("cyvclipro")
		llseabrioclipro=.t.
		USE pcSysDir+pcdb+"\siskardexdoc" IN 0 SHARE AGAIN 
		USE pcSysDir+pcdb+"\siskardexapli" IN 0 SHARE AGAIN 
		USE pcSysDir+pcdb+"\sistipodoctos" IN 0 SHARE AGAIN 
		USE pcSysDir+pcdb+"\cyvclipro" IN 0 SHARE AGAIN 
		USE pcSysDir+pcdb+"\siscata" IN 0 SHARE AGAIN 
		USE pcSysDir+pcdb+"\cyvventas" IN 0 SHARE AGAIN 
		USE pcSysDir+pcdb+"\cyvcompras" IN 0 SHARE AGAIN 
		USE pcSysDir+pcdb+"\ctbNumPar" IN 0 SHARE AGAIN 
	ELSE
		llseabrioclipro=.f.
	ENDIF 
	
	***** preparando detalle de documentos
	ldfec1=DATE()
	lcfilsaldo=''
	lcfilsaldo2=''
	
	*** corrigiendo renta de dockardes
	REPLACE rentaabono WITH 0 ALL IN siskardexdoc FOR rentaabono<>0 
	
	IF lcorigen='CLI'
		lcFiltroOrigen=" and t0.origen in ('CXC','VTA','CYB')"
		lctipoclipro=" and a.tipoclipro=1 "
		lcWhere2="where cyvclipro.tipoclipro=1 "
		lcinner='left join cyvventas t3 on t0.iddocto=t3.iddocto '
	ELSE 
		lcFiltroOrigen=" and t0.origen in ('CXP','COM','CYB')"
		lctipoclipro=" and a.tipoclipro=2 "
		lcWhere2="where cyvclipro.tipoclipro=2 "
		lcinner='left join cyvcompras t3 on t0.iddocto=t3.iddocto '
	ENDIF 
	lccomando="SELECT t0.idclipro,t0.saldo "
			lcfrom="FROM (SELECT t1.fechadocto,IIF(t1.ctrolcxcp=1,'C',IIF(t1.ctrolcxcp=2,'A','')) AS carabo,t1.numero,t1.fechavenci,DATE()-t1.fechavenci as dias,"+;
										"IIF(t1.ctrolcxcp=1,t1.totaldocto-t1.rentadocto,IIF(t1.ctrolcxcp=2,(t1.totaldocto-t1.rentadocto)*-1,0)) as totaldocto,"+;
										"IIF(t1.ctrolcxcp=1,t1.totaldocto-t1.rentadocto+NVL(t5.cargoabono,0.000000),IIF(t1.ctrolcxcp=2,-(t1.totaldocto-t1.rentadocto)+NVL(t5.cargoabono,0.000000),0)) as saldo,t1.idclipro,"+;
										"t1.iddocto,t1.idtipodocto,t1.condipago,t1.origen,t1.idsucursal "+;
									"FROM siskardexdoc t1 "+;
										"left join (SELECT iddocto,SUM(IIF(carabo=1,monto*-1,monto)) as cargoabono from siskardexapli "+;
													"where status=1 AND eliminado=0 AND fechaaplicar<=CTOD('"+DTOC(ldfec1)+"') GROUP BY iddocto UNION ALL  "+;
												"SELECT iddoctoaplicar as iddocto,SUM(IIF(carabo=1,monto,monto*-1)) as cargoabono from siskardexapli "+;
													"where status=1 AND eliminado=0 AND fechaaplicar<=CTOD('"+DTOC(ldfec1)+"') GROUP BY iddoctoaplicar) as t5 on t1.iddocto=t5.iddocto "+;
									"WHERE t1.eliminado=0 AND t1.status=1 and t1.condipago=1) as t0  "+;
							"inner join sistipodoctos t2 on t0.idtipodocto=t2.idtipodocto "+;
							"left join siscata t99 on t0.idsucursal=t99.id and t99.origen='SUC' "+lcinner


	lccursor="c_movjr"
	lcwhere="where t0.idclipro<>0 and t0.saldo<>0 and t0.fechadocto<=CTOD('"+DTOC(ldfec1)+"') "+lcfilsaldo+lcFiltroOrigen
	lcOrder="order by t0.fechadocto,t2.clave,t0.numero "
	lcgroup=''
	lclimit=''

	lnCtrlSql=miSQLEXEC(1,ALLTRIM(lccomando+' '+lcfrom+' '+lcwhere+' '+lcgroup+' '+lcOrder+' '+lclimit),"c_movjr0")

	lnCtrlSql=miSQLEXEC(1,"select aa.idclipro,SUM(aa.saldo) as saldo from (select * from c_movjr0) as aa order by aa.idclipro group by aa.idclipro ","c_movjr")

	IF lcorigen='CLI'
		REPLACE saldo WITH 0 FOR tipoclipro=1 IN cyvclipro  
	ELSE
		REPLACE saldo WITH 0 FOR tipoclipro=2 IN cyvclipro  
	ENDIF 

	UPDATE cyvclipro SET cyvclipro.saldo=a.saldo from cyvclipro inner join c_movjr a on cyvclipro.idclipro=a.idclipro &lcWhere2

	IF !EMPTY(lcaliascxc)
		SELECT (lcaliascxc)
	ENDIF 

	IF llseabrioclipro=.t.
		USE IN cyvclipro
		USE IN siskardexdoc
		USE IN siskardexapli
		USE IN sistipodoctos
		USE IN siscata
		USE IN cyvventas
		USE IN cyvcompras
		USE IN ctbNumPar
	ENDIF 
	IF USED("C_MOVJR")
		USE IN c_movjr
		USE IN c_movjr0
	ENDIF 
	WAIT WINDOW "Saldos Actualizados " NOWAIT 
ENDFUNC 


FUNCTION _AgregarKardexDocFaltantesAlIngresar
	LOCAL lcAliasAnterior, llSincronizandoAnterior, llTeniaSincronizando, ;
		llAbrioVentas, llAbrioCompras, llAbrioBancos, llAbrioCxcp, ;
		llAbrioKardex, lnPendientes, loError

	lcAliasAnterior=ALIAS()
	llTeniaSincronizando=TYPE("pnSincronizandoTablas")="L"
	llSincronizandoAnterior=.F.
	IF llTeniaSincronizando
		llSincronizandoAnterior=pnSincronizandoTablas
	ENDIF
	llAbrioVentas=.F.
	llAbrioCompras=.F.
	llAbrioBancos=.F.
	llAbrioCxcp=.F.
	llAbrioKardex=.F.
	lnPendientes=0

	TRY
		pnSincronizandoTablas=.T.

		IF !USED("siskardexdoc")
			USE pcSysDir+pcdb+"\siskardexdoc" IN 0 SHARED AGAIN ALIAS siskardexdoc
			llAbrioKardex=.T.
		ENDIF
		IF !USED("cyvventas")
			USE pcSysDir+pcdb+"\cyvventas" IN 0 SHARED AGAIN ALIAS cyvventas
			llAbrioVentas=.T.
		ENDIF
		IF !USED("cyvcompras")
			USE pcSysDir+pcdb+"\cyvcompras" IN 0 SHARED AGAIN ALIAS cyvcompras
			llAbrioCompras=.T.
		ENDIF
		IF !USED("cybmovimientos")
			USE pcSysDir+pcdb+"\cybmovimientos" IN 0 SHARED AGAIN ALIAS cybmovimientos
			llAbrioBancos=.T.
		ENDIF
		IF !USED("cyvcuentasxcp")
			USE pcSysDir+pcdb+"\cyvcuentasxcp" IN 0 SHARED AGAIN ALIAS cyvcuentasxcp
			llAbrioCxcp=.T.
		ENDIF

		* Cada UPDATE conserva los datos y dispara la funcion historica del DBC.
		SELECT a.iddocto,a.idtipodocto ;
			FROM cyvcompras a ;
			LEFT JOIN siskardexdoc b ON a.iddocto=b.iddocto AND a.idtipodocto=b.idtipodocto ;
			WHERE a.status=1 AND ;
				a.anulado=0 AND a.eliminado=0 AND NVL(b.iddocto,0)=0 ;
			INTO CURSOR c_loginKarCom READWRITE
		lnPendientes=lnPendientes+RECCOUNT("c_loginKarCom")
		UPDATE cyvcompras SET pcuser=pcuser WHERE STR(iddocto)+STR(idtipodocto) IN ;
			(SELECT STR(iddocto)+STR(idtipodocto) FROM c_loginKarCom)

		SELECT a.iddocto,a.idtipodocto ;
			FROM cyvventas a ;
			LEFT JOIN siskardexdoc b ON a.iddocto=b.iddocto AND a.idtipodocto=b.idtipodocto ;
			WHERE a.status=1 AND ;
				a.anulado=0 AND a.eliminado=0 AND NVL(b.iddocto,0)=0 ;
			INTO CURSOR c_loginKarVta READWRITE
		lnPendientes=lnPendientes+RECCOUNT("c_loginKarVta")
		UPDATE cyvventas SET pcuser=pcuser WHERE STR(iddocto)+STR(idtipodocto) IN ;
			(SELECT STR(iddocto)+STR(idtipodocto) FROM c_loginKarVta)

		SELECT a.iddocto,a.idtipodocto ;
			FROM cybmovimientos a ;
			LEFT JOIN siskardexdoc b ON a.iddocto=b.iddocto AND a.idtipodocto=b.idtipodocto ;
			WHERE a.status=1 AND ;
				a.anulado=0 AND a.eliminado=0 AND NVL(b.iddocto,0)=0 ;
			INTO CURSOR c_loginKarBco READWRITE
		lnPendientes=lnPendientes+RECCOUNT("c_loginKarBco")
		UPDATE cybmovimientos SET pcuser=pcuser WHERE STR(iddocto)+STR(idtipodocto) IN ;
			(SELECT STR(iddocto)+STR(idtipodocto) FROM c_loginKarBco)

		* Se revisa al final para no duplicar lo ya reconstruido desde VTA, COM o CYB.
		SELECT a.iddocto,a.idtipodocto ;
			FROM cyvcuentasxcp a ;
			LEFT JOIN siskardexdoc b ON a.iddocto=b.iddocto AND a.idtipodocto=b.idtipodocto ;
			WHERE a.status=1 AND a.anulado=0 AND ;
				a.eliminado=0 AND NVL(b.iddocto,0)=0 ;
			INTO CURSOR c_loginKarCxp READWRITE
		lnPendientes=lnPendientes+RECCOUNT("c_loginKarCxp")
		UPDATE cyvcuentasxcp SET pcuser=pcuser WHERE STR(iddocto)+STR(idtipodocto) IN ;
			(SELECT STR(iddocto)+STR(idtipodocto) FROM c_loginKarCxp)

		IF lnPendientes>0
			* Libera solo las tablas abiertas aqui antes de ejecutar los recalculos existentes.
			IF llAbrioVentas AND USED("cyvventas")
				USE IN cyvventas
				llAbrioVentas=.F.
			ENDIF
			IF llAbrioCompras AND USED("cyvcompras")
				USE IN cyvcompras
				llAbrioCompras=.F.
			ENDIF
			IF llAbrioBancos AND USED("cybmovimientos")
				USE IN cybmovimientos
				llAbrioBancos=.F.
			ENDIF
			IF llAbrioCxcp AND USED("cyvcuentasxcp")
				USE IN cyvcuentasxcp
				llAbrioCxcp=.F.
			ENDIF
			IF llAbrioKardex AND USED("siskardexdoc")
				USE IN siskardexdoc
				llAbrioKardex=.F.
			ENDIF
			_RecalcularSaldosdeClientesyProveedores('CLI')
			_RecalcularSaldosdeClientesyProveedores('PRV')
			_recalcularSaldosBancos()
		ENDIF
	CATCH TO loError
		lnPendientes=-1
	FINALLY
		IF USED("c_loginKarCom")
			USE IN c_loginKarCom
		ENDIF
		IF USED("c_loginKarVta")
			USE IN c_loginKarVta
		ENDIF
		IF USED("c_loginKarBco")
			USE IN c_loginKarBco
		ENDIF
		IF USED("c_loginKarCxp")
			USE IN c_loginKarCxp
		ENDIF
		IF llAbrioVentas AND USED("cyvventas")
			USE IN cyvventas
		ENDIF
		IF llAbrioCompras AND USED("cyvcompras")
			USE IN cyvcompras
		ENDIF
		IF llAbrioBancos AND USED("cybmovimientos")
			USE IN cybmovimientos
		ENDIF
		IF llAbrioCxcp AND USED("cyvcuentasxcp")
			USE IN cyvcuentasxcp
		ENDIF
		IF llAbrioKardex AND USED("siskardexdoc")
			USE IN siskardexdoc
		ENDIF
		IF llTeniaSincronizando
			pnSincronizandoTablas=llSincronizandoAnterior
		ELSE
			pnSincronizandoTablas=.F.
		ENDIF
		IF !EMPTY(lcAliasAnterior) AND USED(lcAliasAnterior)
			SELECT (lcAliasAnterior)
		ENDIF
	ENDTRY

	RETURN lnPendientes
ENDFUNC


