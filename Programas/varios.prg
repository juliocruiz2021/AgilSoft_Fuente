FUNCTION ObtieneImpresores(lnIdSqlConec,lnTipoImpresor)
	*** recupera los impresores predeterminados del sistema y si no estan los almacena
	*** paImpresores(3)  1=impresor de Reportes,2=impresor de ticket,3=impresor de Documentos
	LOCAL pcNombrepc,llBuscar,llExiste,lcRetornaImpresor
	pcNombrepc=UPPER(ALLTRIM(SYS(0)))
	lcAliBusAyu=ALIAS()
	lniduserprn= pnidusuario

	IF pnTipoConeccion=1	&&& usando coneccion Nativa local
		USE pcSysDir+pcdb+"\siscata" IN 0 SHARED AGAIN ALIAS c_sisImpre
	ENDIF 

	IF lnTipoImpresor<>0
		lcComandoBuscarCta="SELECT * FROM c_sisImpre where nombre='"+pcNombrepc+"' and origen='PRN' and tipo="+ALLTRIM(STR(lnTipoImpresor))
		lnCtrlSqlCtaBus=miSQLEXEC(lnIdSqlConec,lcComandoBuscarCta,"c_BuscaPrinter")

		IF _tallY=0
			llBuscar=.t.
		ELSE
			lcRetornaImpresor=ALLTRIM(c_BuscaPrinter.notas)
		ENDIF 
		USE IN c_BuscaPrinter
	ELSE 
		llBuscar=.t.
	ENDIF 
	
	IF llBuscar
		lcRetornaImpresor=SET("Printer",3)
		lnidreg=_SiguienteIdTabla(pcNodo,"MAS")
		lccodunico=UPPER(PC_USER(2))+SYS(3)
		ldfecmod=DATETIME()
		IF lnTipoImpresor<>0
			INSERT INTO c_sisImpre (id,origen,cod,nombre,tipo,notas,status,fecalta,fecmod,nodo,iduser,pcuser) ;
						VALUES (lnidreg,'PRN',lccodunico,pcNombrepc,lnTipoImpresor,lcRetornaImpresor,;
						1,ldfecmod,ldfecmod,pcnodo,lniduserprn,pcNombrepc)
		ENDIF 
		llBuscar=.f.
	ENDIF 

	lcRetornaImpresor=ValidarImpresor(lcRetornaImpresor)
	
	USE IN c_sisImpre
	IF !EMPTY(lcAliBusAyu)
		SELECT (lcAliBusAyu)
	ENDIF 
	
	RETURN ALLTRIM(lcRetornaImpresor)
ENDFUNC 




