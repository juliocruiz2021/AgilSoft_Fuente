FUNCTION  _EscribirIni(tcFileName as Character,;
		tcSection as Character,tcEntry as Character,;
		tcValue as Character)
	* Si no existe el archivo, la sección o la entrada, la crea.
	* Retorna .T. si tuvo éxito
	* PARAMETROS:
	*  tcFileName = Nombre y ruta completa del archivo.INI
	*  tcSection = Sección del archivo.INI
	*  tcEntry = Entrada del archivo.INI
	*  tcValue = Valor de la entrada
	*  USO: ? _EscribirIni(cSistemDir+"Setupiva.ini","Setup","IvaPorc","0.13")
	* RETORNO: Logico
	*----------------------------------------------------
	DECLARE INTEGER WritePrivateProfileString ;
		IN WIN32API ;
		STRING cSection,STRING cEntry,STRING cEntry,;
		STRING cFileName
	RETURN IIF(WritePrivateProfileString(tcSection,tcEntry,tcValue,tcFileName)=1,.T.,.F.)
ENDFUNC  

FUNCTION  _LeerIni(tcFileName as Character,;
		tcSection as Character,tcEntry as Character)
	* Si no existe el archivo, la sección o la entrada, retorna .NULL.
	* PARAMETROS:
	*  tcFileName = Nombre y ruta completa del archivo.INI
	*  tcSection = Sección del archivo.INI
	*  tcEntry = Entrada del archivo.INI
	* USO: ISNUL(_LeerIni(cSistemDir+"Setupiva.ini","Setup","IvaPorc"))
	*      si no existe devuelve .t.
	* RETORNO: Caracter
	*----------------------------------------------------
	LOCAL lcIniValue, lnResult, lnBufferSize
	DECLARE INTEGER GetPrivateProfileString ;
	    IN WIN32API ;
	    STRING cSection,;
	    STRING cEntry,;
	    STRING cDefault,;
	    STRING @cRetVal,;
	    INTEGER nSize,;
	    STRING cFileName
	lnBufferSize = 255
	lcIniValue = spac(lnBufferSize)
	lnResult=GetPrivateProfileString(tcSection,tcEntry,"*NULL*",;
	    @lcIniValue,lnBufferSize,tcFileName)
	lcIniValue=SUBSTR(lcIniValue,1,lnResult)
	IF lcIniValue="*NULL*"
	    lcIniValue=.NULL.
	ENDIF
	RETURN lcIniValue 
ENDFUNC  

FUNCTION  NombreMes(nNumMes as Number,lnanoCorto as Integer,lNombreCorto as Boolean)
	store subs("Enero     Febrero   Marzo     Abril     Mayo      Junio     Julio     Agosto    SeptiembreOctubre   Noviembre Diciembre ",(nNumMes*10)-9,10) to cNombreMes
	IF PCOUNT()=3
		IF lNombreCorto=.t.
			cNombreMes=SUBSTR(cNombreMes,1,3)
		ENDIF 
	ELSE
		lNombreCorto=.f.
	ENDIF 
	
	IF PCOUNT()>=2
		cNumMes=ALLTRIM(STR(lnanoCorto))
		IF lNombreCorto=.t.
			cNumMes=SUBSTR(cNumMes,3,2)
		ENDIF 
	ELSE
		cNumMes=""
	ENDIF 
	
	retu alltrim(ALLTRIM(cNombreMes)+IIF(!EMPTY(cNumMes),"/"+cNumMes,cNumMes))
	
ENDFUNC  

FUNCTION  NombreMesCorto(nNumMes as Number,lnanoCorto as Integer)
	store subs("Enero     Febrero   Marzo     Abril     Mayo      Junio     Julio     Agosto    SeptiembreOctubre   Noviembre Diciembre ",(nNumMes*10)-9,10) to cNombreMes
	cNombreMes=SUBSTR(cNombreMes,1,2)
	
	IF PCOUNT()>=2
		cNumMes=ALLTRIM(STR(lnanoCorto))
		cNumMes=SUBSTR(cNumMes,3,2)
	ELSE
		cNumMes=""
	ENDIF 
	
	retu alltrim(ALLTRIM(cNombreMes)+IIF(!EMPTY(cNumMes),""+cNumMes,cNumMes))
	
ENDFUNC  

FUNCTION FechaCorta(lddFecha,lnIdioma)
	lcanof=ALLTRIM(STR(YEAR(lddFecha)))
	lnmesf=MONTH(lddFecha)
	lcdayf=PADL(ALLTRIM(STR(DAY(lddFecha))),2,"0")
	IF lnIdioma=1		&&& 1 español    2 ingles
		lcMesf=SUBSTR(NombreMes(lnmesf),1,3)
	ELSE
		lcMesf=SUBSTR(NombreMesIngles(lnmesf),1,3)
	ENDIF 
	RETURN lcdayf+'-'+ lcMesf+'-'+lcanof
ENDFUNC 

FUNCTION  NombreMesIngles(nNumMes as Number)
	store subs("January   February  March     April     May       June      July      August    September October   November  December  ",(nNumMes*10)-9,10) to cNombreMes
	retu alltrim(cNombreMes)
ENDFUNC  


