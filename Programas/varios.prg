

******* Procedimiento para controlar los Errores del sistemas
FUNCTION _Errores(merror, mess, mess1, mprog, mlineno)
	IF !INLIST(merror,-1,39,1884) && IF !INLIST(merror,1957,39,1231,13)		&&& error cola de impresion no se evalua y facturas a cero de ticket
	   SNError=MESSAGEBOX(;
	   		'Error Numero:  ' + LTRIM(STR(merror))+CHR(13)+;
	   		'Mensaje del Error:  ' + mess+CHR(13)+;
	   		'Linea del Codigo del Error:  ' + mess1+CHR(13)+;
	   		'Numero de Linea del Error:  ' + LTRIM(STR(mlineno))+CHR(13)+;
	   		'Programa con Error:  '+mprog+CHR(13)+CHR(13)+;
	   		'Desea ANULAR, REINTENTAR O OMITIR ?',290,"Mensaje de ERROR.....")
		do case
			case SNError=3
				on error
				messagebox("Programa Cancelado........",16,"Cancelar")
				ON SHUTDOWN
				on error
				SET TALK OFF
				set sysmenu to defa
				clos data
				*clos all
				clea event
				*rele all
				if type("tlbMenu")="O"
					tlbMenu.release
				endif
				canc
			case SNError=4
				retry
			case SNError=5 
				retu
		ENDCASE
	ENDIF 
	retu   		
ENDFUNC


