FUNCTION ImprimirCajaBancosClientes(lnIdDocto as Integer,lnCtrl as Integer ,lnIdConec as integer,lnTipoConec as integer)
	**** se paso como parametro el numero de documento a imprimir
	**** lnCtrl 1=Imprimir Directo al Impresor ;
				2=Imprimir con Previsualizacion y ;
				3=Mostrar Formulario para Editar

	LOCAL lcAlias,lnidSQL
	lnidSQL=0
	lcAlias=ALIAS()
	lnidSQL=_conecta(pcDB)
		
	USE pcSysDir+pcdb+"\cybmovimientos" SHARED AGAIN ORDER iddocto IN 0 ALIAS CXCImp
	USE pcSysDir+pcdb+"\siskardexapli" SHARED AGAIN ORDER idaplica IN 0 ALIAS ACXCImp
	USE pcSysDir+pcdb+"\siscata" SHARED AGAIN ORDER id IN 0 ALIAS VenImp
	USE pcSysDir+pcdb+"\sistipodoctos" SHARED AGAIN ORDER idtipodocto IN 0 ALIAS TDImp
	USE pcSysDir+pcdb+"\sisseries" SHARED AGAIN ORDER idserie IN 0 ALIAS CXCSer
	USE pcSysDir+pcdb+"\cybcajabancos" SHARED AGAIN ORDER idcajban IN 0 ALIAS CajImp
	USE pcSysDir+pcdb+"\cyvclipro" SHARED AGAIN ORDER idclipro IN 0 ALIAS SNImp
	USE pcSysDir+pcdb+"\siskardexdoc" SHARED AGAIN ORDER idclipro IN 0 ALIAS CXCDoc
	USE pcSysDir+pcdb+"\sisformatos" SHARED AGAIN ORDER idformato IN 0 ALIAS CXCFor

	lcPrintActual=SET("PRINTER", 3)


	IF lnidSQL>0
		lcComando0="SELECT CXCImp.*,ALLTRIM(b.CodCliPro) as CodCliPro,b.clipro,b.direccion,d.codser as codserie,d.serie as serie,"+;
					"NVL(j.cod,SPACE(30)) as codvende,NVL(j.nombre,SPACE(200)) as vende,"+;
					"c.codtipo,c.tipodocto,c.clave,iif(c.ctrolCXC=0,c.ctrolcxp,c.ctrolcxc) as sumaresta,e.codcajban,e.cajban,"+;
					"f.carabo,f.monto,f.iddoctoaplicar,h.codtipo as codtipo2,h.tipodocto as tipodocto2,h.clave as clave2,"+;
					"i.codser as codserie2,i.serie as serie2,"+;
					"ALLTRIM(h.codtipo)+'-'+ALLTRIM(g.numero)+IIF(EMPTY(g.numerocontrol) or EMPTY(g.numero),'',' / ')+IIF(!EMPTY(g.numerocontrol),ALLTRIM(SUBSTR(g.numerocontrol,1,11)+'... '+RIGHT(ALLTRIM(g.numerocontrol),08)),SPACE(25))+SPACE(25) as numero2,"+;
					"g.fechadocto as fechadocto2,g.fechavenci as fecvenci2,g.totaldocto as totaldocto1,g.totaldocto-g.rentadocto as totaldocto2,g.fechadocto as fecdocto2,g.fechavenci as fecvenci2,"+;
					"g.totaldocto-g.cargoabono-g.rentadocto as saldodocto2,b.saldo as saldoclipro,"+;
					"pcnomempresa as nomempresa,pcgiro as giroempresa,pcnit as nitempresa,pcnrc as nrcempresa,c.tipoicv,000000000.00 as cargosyabonos "+;
					"FROM CXCImp left JOIN SNImp b ON CXCImp.IdCliPro=b.IdCliPro "+;
								   "INNER JOIN TDImp c ON CXCImp.IdTipoDocto=c.IdTipoDocto "+;
								   "LEFT JOIN CXCSer d ON CXCImp.idserie=d.idserie "+;
								   "LEFT JOIN CajImp e ON CXCImp.idcajban=e.idcajban "+;
								   "LEFT JOIN ACXCImp f ON CXCImp.iddocto=f.iddocto "+;
								   "LEFT JOIN CXCDoc g ON f.iddoctoaplicar=g.iddocto "+;
								   "left JOIN TDImp h ON g.IdTipoDocto=h.IdTipoDocto "+;
								   "LEFT JOIN CXCSer i ON CXCImp.idserie=i.idserie "+;
								   "LEFT JOIN VenImp j ON CXCImp.idagente=j.id "+;								   
					" where CXCImp.iddocto="+ALLTRIM(STR(lnIdDocto))+" "

		lnCtrlSql=miSQLEXEC(lnidSQL,lcComando0,'c_imp')
		lnTipoICVPrn=c_imp.tipoicv
		
		IF lnCtrlSql>0
			if !EOF()
				SELECT c_imp
				GO top
				**** aplicando abonos a la fecha
				ldfecdoc=fechadocto
				lncliproabo=idclipro
				_aplicacionesDocumentosCredito(lncliproabo,ldfecdoc)
				UPDATE c_imp SET cargosyabonos=a.cargoabono from c_apldoc a WHERE c_imp.idclipro=a.idclipro AND c_imp.iddoctoaplicar=a.iddocto
				USE IN c_apldoc
				SELECT c_imp
				GO top
				
								
				IF NVL(idclipro,0)=0
					REPLACE monto WITH totaldocto NEXT 1
				ENDIF 
				lnidtd=idtipodocto
				lnidse=idserie
				lnidca=idcajban
				lnidsu=idsucursal
				*lnCondipago=condipago
				lcComando0="SELECT TOP 1 * FROM (SELECT 0 as llave,*,SPACE(250) as print2,codfor FROM CXCFor WHERE idtipodocto="+ALLTRIM(STR(lnidtd))+" AND idserie="+ALLTRIM(STR(lnidse))+" AND idsucursal="+ALLTRIM(STR(lnidsu))+" and idcajban=="+ALLTRIM(STR(lnidca))+" "+;
								"UNION ALL "+;
								"SELECT 1 as llave,*,SPACE(250) as print2,codfor FROM CXCFor WHERE idtipodocto="+ALLTRIM(STR(lnidtd))+" AND idserie="+ALLTRIM(STR(lnidse))+" AND idsucursal=="+ALLTRIM(STR(lnidsu))+" "+;
								"UNION ALL "+;
								"SELECT 2 as llave,*,SPACE(250) as print2,codfor FROM CXCFor WHERE idtipodocto="+ALLTRIM(STR(lnidtd))+" AND idserie="+ALLTRIM(STR(lnidse))+") as t0 "+;
							"ORDER BY t0.llave,t0.idtipodocto" 
				lnCtrlSql2=miSQLEXEC(lnidSQL,lcComando0,'c_formatosTmp')
				lnImpresor2Prn=c_formatosTmp.impresor2
		
				IF lnCtrlSql2>0
					lntipprint=1
					IF impresor2<>0
						lntipprint=impresor2
						lcimpresortmp=ObtieneImpresores(lnidSQL,lntipprint)
						REPLACE print2 WITH lcimpresortmp NEXT 1
					ENDIF
					GO top
					lcArchivo=ALLTRIM(archivo)
					lcPrinter=ALLTRIM(impresor1)
					lcPrinter2=ALLTRIM(print2)
					lnTipoImpresion=tipoimpresion
					lnTipoDetalle=tipodetalle
					lnCopiasPrint=IIF(copias=0,1,copias)
					
					lcmensajeimpresor='Impresor :'+SET("Printer",3)
					SELECT c_imp					
					IF !EMPTY(lcArchivo) and FILE(pcSysDir+pcdb+"\formatos\"+lcArchivo)

						STORE SET("Printer",3) TO lcPrinOld
						IF !EMPTY(lcPrinter)
							APRINTERS(lcImipresores)
							llimpresorExiste=.f.
							FOR i=1 TO ALEN(lcImipresores)/2
								IF ALLTRIM(UPPER(lcImipresores(i,1)))=ALLTRIM(UPPER(lcPrinter))
									llimpresorExiste=.t.
										EXIT 
								ENDIF 
							ENDFOR 
							
							IF pnUsaRedirec=1		&&&& usandoa impresor redireccionado
								lcPrinter=ImpresorRedireccionado(lnTipoICVPrn,lnImpresor2Prn)
							ENDIF 	

							IF llimpresorExiste=.t.
								SET PRINTER TO NAME (lcPrinter)
								lcmensajeimpresor='Impresor: '+ALLTRIM(lcPrinter)+'  Tipo: '+ALLTRIM(STR(lntipprint))
							ENDIF 
							
						ELSE
							IF !EMPTY(lcPrinter2)
								APRINTERS(lcImipresores)
								llimpresorExiste=.f.
								FOR i=1 TO LEN(lcImipresores)-1
									IF ALLTRIM(UPPER(lcImipresores(i,1)))=ALLTRIM(UPPER(lcPrinter2))
										llimpresorExiste=.t.
										EXIT 
									ENDIF 
								ENDFOR 
								
								IF llimpresorExiste=.t.
									SET PRINTER TO NAME (lcPrinter2)
									lcmensajeimpresor='Impresor: '+ALLTRIM(lcPrinter2)+'  Tipo: '+ALLTRIM(STR(lntipprint))
								ENDIF 
							ENDIF 
						ENDIF 
						
						IF TYPE('_screen.ActiveForm')='O'
							_screen.ActiveForm.cntDiga.diga(lcmensajeimpresor,3,3)
						ENDIF 
						
						llseimprimio=0
						SELECT c_imp
						
*!*							IF lnTipoDetalle=3		&&&& impresion agrupada
*!*								SELECT t0.*,cc.* FROM c_impdetaTmp t0 INNER JOIN ;
*!*										(SELECT  MIN(iddoctod) as iddoctodg,SUM(cantiunimed) as cantidadG ,codagrupador as codagrupadorg,;
*!*												MAX(agrupador) as agrupadorg,SUM(totaliva) as totalivag,SUM(totalventaconiva) as totalventaconivag,;
*!*												SUM(totalventasiniva) as totalventasinivag,SUM(totalgravado) as totalgravadog,SUM(totalexento) as totalexentog,;
*!*												SUM(totalnosujeto) as totalnosujetog  ;
*!*											FROM c_impdetaTmp ORDER BY codagrupador GROUP BY codagrupador) as cc on t0.iddoctod=cc.iddoctodg ;
*!*									INTO CURSOR c_impdeta READWRITE ORDER BY t0.codprod
*!*							else
*!*								SELECT t0.*,cc.* FROM c_impdetaTmp t0 INNER JOIN ;
*!*										(SELECT  iddoctod as iddoctodg,sum(cantiunimed) as cantidadG ,MAX(codagrupador) as codagrupadorg,;
*!*												MAX(agrupador) as agrupadorg,SUM(totaliva) as totalivag,SUM(totalventaconiva) as totalventaconivag,;
*!*												SUM(totalventasiniva) as totalventasinivag,SUM(totalgravado) as totalgravadog,SUM(totalexento) as totalexentog,;
*!*												SUM(totalnosujeto) as totalnosujetog  ;
*!*											FROM c_impdetaTmp ORDER BY iddoctod GROUP BY iddoctod) as cc on t0.iddoctod=cc.iddoctodg ;
*!*									INTO CURSOR c_impdeta READWRITE ORDER BY t0.codprod
*!*							ENDIF 
						*USE IN c_impdetaTmp
						*SELECT c_impdeta
						SELECT c_imp
						
						IF lnCtrl=5	OR INLIST(lnCtrl,3)		&&&&INLIST(lnCtrl,3,4)
							lcPrintActual=SET("PRINTER", 3)
							IF TYPE("_screen.ActiveForm")='O'
								_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)
							ENDIF 
							IF lnCtrl=5
								MODIFY REPORT pcSysDir+pcdb+"\formatos\"+lcArchivo
							ELSE
								REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER PREVIEW NOCONSOLE 
								llseimprimio=1
							ENDIF 
						ELSE 
							DO case
								CASE lnTipoImpresion=1 
										lnsn=MESSAGEBOX("Desea ver el Documento ?",4+32+256,"Imprimir...")
										IF lnsn=6
											WAIT WINDOW 'Imprimiendo Documento... ' NOWAIT 
											lcPrintActual=SET("PRINTER", 3)
											lcPrintActual2=lcPrintActual
											lcPrintActualjr=lcPrintActual
											_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)

											REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER PROMPT PREVIEW NOCONSOLE 
											llseimprimio=1
										ENDIF 
								CASE lnTipoImpresion=2 
										lnsn=MESSAGEBOX("Desea Imprimir el Documento ?",4+32+256,"Imprimir...")
										IF lnsn=6
											WAIT WINDOW 'Imprimiendo Documento... ' NOWAIT 
											lcPrintActual=SET("PRINTER", 3)
											lcPrintActual2=lcPrintActual
											lcPrintActualjr=lcPrintActual
											_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)
											FOR iprin=1 TO lnCopiasPrint
												lcPrintActual=lcPrintActual2
												REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER NOCONSOLE NAME lcPrintActual
												lcPrintActual2=lcPrintActualjr
											ENDFOR 
											llseimprimio=1
										ENDIF 
								CASE lnTipoImpresion=3
										lcPrintActual=SET("PRINTER", 3)
										_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)
										REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER PROMPT PREVIEW NOCONSOLE 
										llseimprimio=1
								CASE lnTipoImpresion=4 
										lcPrintActual=SET("PRINTER", 3)
										lcPrintActual2=lcPrintActual
										lcPrintActualjr=lcPrintActual
										_screen.ActiveForm.cntDiga.diga("Imprimiendo en "+lcPrintActual,3,3)
										FOR iprin=1 TO lnCopiasPrint
											lcPrintActual=lcPrintActual2
											REPORT FORM pcSysDir+pcdb+"\formatos\"+lcArchivo TO PRINTER NOCONSOLE NAME lcPrintActual
											lcPrintActual2=lcPrintActualjr
										ENDFOR 
										llseimprimio=1
								
							ENDCASE
						ENDIF 
						GO TOP IN c_imp
						
						IF !EMPTY(lcPrinOld)
							SET PRINTER TO NAME (lcPrinOld)
						ENDIF 
						GO TOP IN c_imp
						IF c_imp.impreso=0 AND llseimprimio=1		&&& cambiando status de Impreso
							=miSQLEXEC(lnidSQL,"update CXCImp set impreso=1 where impreso=0 and iddocto="+ALLTRIM(STR(lnIdDocto))+" ")
						ENDIF
						USE IN c_formatostmp
					ELSE 
					 MESSAGEBOX('No se encontro el Archivo del Formato de impresion....  '+lcArchivo,16,'Error al Imprimir...')
					ENDIF 
				ELSE
					MESSAGEBOX('No se Encontro el Formato de Impresion para este Documento....',16,'Error al Imprimir...')
				ENDIF 
			ELSE
				MESSAGEBOX('No se Encontro el Documento....',16,'Error al Imprimir...')
			ENDIF 
		ELSE
			_MostrarErroresSQL(lnidSQL)
		ENDIF 
		*USE in c_imp
		=miSQLDISCONNECT(lnidSQL)
	ELSE
		MESSAGEBOX("Imposible conectarse con el Servidor... Intente más tarde...",16,'Error de Conección...')
	ENDIF 
	
	USE IN CXCImp
	USE IN ACXCImp
	USE IN VenImp
	USE IN TDImp
	USE IN CXCSer
	USE IN CajImp
	USE IN SNImp
	USE IN CXCDoc
	USE IN CXCFor
	
	IF !EMPTY(lcAlias)
		SELECT (lcAlias)
	ENDIF 
ENDFUNC 



