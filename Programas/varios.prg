FUNCTION enviarDatosProducto()

	lnsql=_conectaSURTI()
	
	IF lnsql>0
		WAIT WINDOW 'Preparando datos.....'  NOWAIT 
		lcComando=''
		SELECT a.idproducto,a.codprod,a.producto,b.nombre as marca,c.nombre as familia,a.precioconiva as preciopublico,NVL(d.existencia,000000000.00) as existencia ;
			FROM invproductos a ;
				LEFT JOIN siscata b ON a.idmarca=b.id ;
				LEFT JOIN siscata c ON a.idfamilia=c.id ;
				LEFT JOIN invexisbodega d ON a.idproducto=d.idproducto;
				LEFT JOIN siscata e ON d.idbodega=e.id ;
			WHERE a.status=1 AND e.cod='01' INTO CURSOR c_misProd

		lntotReg=RECCOUNT()
		lnpartes=CEILING(lntotReg/500)
		lcCursorWeb ='productos'
		
		FOR i=1 TO lnpartes
			
			lcComando="INSERT INTO "+lcCursorWeb+" (codprod,producto,nombre1,nombre2,codmarca,marca,codfamilia,familia,existencia,preciopublico) "+;
					"VALUES "
				lcComaUnion=""
			
			recini=(i*500)-499
			IF i=lnpartes
				recfin=lntotReg
			ELSE
				recfin=i*500
			ENDIF 
			SCAN for BETWEEN(RECNO(),recini,recfin)
				lcComando=lcComando+lcComaUnion+;
					"('"+ALLTRIM(codprod)+"',"+;
					"'"+ALLTRIM(_sincomillias(producto))+"',"+;
					"'"+ALLTRIM(_sincomillias(''))+"',"+;
					"'"+ALLTRIM(_sincomillias(''))+"',"+;
					"'"+ALLTRIM(_sincomillias(''))+"',"+;
					"'"+ALLTRIM(_sincomillias(marca))+"',"+;
					"'"+ALLTRIM(_sincomillias(''))+"',"+;
					"'"+ALLTRIM(_sincomillias(familia))+"',"+;
					""+ALLTRIM(STR(existencia,16,6))+","+;
					""+ALLTRIM(STR(preciopublico,16,6))+" "+;
					")"
				lcComaUnion=","+CHR(13)
			ENDSCAN 
			lcComando=lcComando+" ON DUPLICATE KEY UPDATE "+;
					"producto= VALUES(producto),"+;
					"familia= VALUES(familia),"+;
					"marca= VALUES(marca),"+;
					"existencia= VALUES(existencia),"+;
					"preciopublico= VALUES(preciopublico)"
		
			WAIT WINDOW 'Enviando Productos a consulta web...  '+ ALLTRIM(STR(i))+'/'+ALLTRIM(str(lnpartes))+;
							'   - Reg.:'+ALLTRIM(STR(recini))+' al '+ALLTRIM(STR(recfin))  NOWAIT 
			lnctrl=SQLEXEC(lnsql,lcComando,'')

			IF lnctrl<1
				EXIT 
			ENDIF 
		ENDFOR 
		
		IF lnctrl<1
			WAIT WINDOW "Error al Enviar Datos a la Web" NOWAIT 
		ELSE
			*USE IN 	c_misProd		
			WAIT WINDOW 'Envio Terminado   ' +ALLTRIM(STR(lntotReg))+" Reg. Enviados" NOWAIT 
		ENDIF 
		lnCt=SQLDISCONNECT(lnsql)
	ELSE 
		WAIT WINDOW 'Error de Coneccion....' NOWAIT 
	ENDIF 
ENDFUNC 
		


