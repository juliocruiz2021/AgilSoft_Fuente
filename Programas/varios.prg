FUNCTION _mostrarMedidas(lnidsesionmed,lnidprodmedida,lnleftmed,lntopmed)
	LOCAL oMedida
	oMedida= CREATE("Custom")
	oMedida.AddProperty('id')
	oMedida.AddProperty('preciocon')
	oMedida.AddProperty('preciosin')
	oMedida.AddProperty('nombre')
	oMedida.AddProperty('cod')
	oMedida.id=0
	oMedida.preciocon=0
	oMedida.preciosin=0
	oMedida.nombre=''
	oMedida.cod=''
	
	lcDecimed=CuantosDecimales(pcMasPrecio)
	
	lnRetornaIdMedida=0
	IF lnidprodmedida=0
		RETURN oMedida
	ELSE
		lcaliasmed=ALIAS()
		SELECT * FROM (;
			SELECT unidadmedida as unimed,ROUND(precioconiva,lcDecimed) as precioconiva,ROUND(preciosiniva,lcDecimed) as preciosiniva,;
					000000001 as factor,status,000000000 as idunimed,codprod,producto as descripcionunimed, 1 as ctrol ;
				FROM invproductos WHERE idproducto=lnidprodmedida AND status=1 ;
			UNION ALL ;
			SELECT unimed,ROUND(precioconiva,lcDecimed) as precioconiva,ROUND(preciosiniva,lcDecimed) as preciosiniva,;
					factor,status,idunimed,codprod4 as codprod,descripcionunimed,2 as ctrol;
				FROM invprodunimed WHERE idproducto=lnidprodmedida AND status=1 ) as cc ORDER BY cc.ctrol,cc.factor ;
		INTO CURSOR c_Medidas READWRITE 
		
		IF EOF()
		ELSE
			DO FORM pcSysDir+"comun\frm_com_buscar_medida" WITH lnidsesionmed,lntopmed,lnleftmed TO oMedida.id
			IF oMedida.id>=0
				oMedida.preciocon=precioconiva
				oMedida.preciosin=preciosiniva
				oMedida.nombre=ALLTRIM(descripcionunimed)
				oMedida.cod=ALLTRIM(codprod)
			ENDIF 
		ENDIF 
		USE in c_Medidas
		
		IF !EMPTY(lcaliasmed)
			SELECT (lcaliasmed)
		ENDIF 
		
		RETURN oMedida
	ENDIF 
ENDFUNC 


FUNCTION _listarJson(lcMiRuta)
	LOCAL oNombresImagenes
	oNombresImagenes = CREATE("Custom")
	oNombresImagenes.AddProperty('CantidadImagenes')
	oNombresImagenes.AddProperty('imagenActual')
	oNombresImagenes.AddProperty('NombreImagen')
	oNombresImagenes.imagenActual=0
	


	IF !EMPTY(lcMiRuta)
		IF right(lcMiRuta,1)<>'\'
			lcMiRuta=lcMiRuta+'\'
		ENDIF 
		lcDirFotos=lcMiRuta
	ELSE 
		lcDirFotos=GETDIR()
	ENDIF 
	
	IF !EMPTY(lcDirFotos)
		lnCantidadArchivos=ADIR(laArchivos,lcDirFotos+'*.json')
		IF NVL(lnCantidadArchivos,0)>0
			oNombresImagenes.AddProperty('aImagenes[lnCantidadArchivos,2]')
			FOR i=1 TO lnCantidadArchivos
				oNombresImagenes.aImagenes(i,1)=laArchivos(i,1)
				oNombresImagenes.aImagenes(i,2)=.f.
			ENDFOR 
			oNombresImagenes.CantidadImagenes=lnCantidadArchivos
			oNombresImagenes.imagenActual=1
		ENDIF 
	ENDIF 
	
	SET DEFAULT TO (pcSysDir)
	RETURN oNombresImagenes
	
ENDFUNC 


FUNCTION UTF8FileToStr(tcFile)
    LOCAL loStream, lcTexto

    loStream = CREATEOBJECT("ADODB.Stream")
    loStream.Type = 2 && Texto
    loStream.Charset = "utf-8"
    loStream.Open()
    loStream.LoadFromFile(tcFile)
    lcTexto = loStream.ReadText()
    loStream.Close()

    RETURN lcTexto
ENDFUNC




****** funcion definitiva para enviar correo
FUNCTION EnviarCorreoNew(lcNumControlDTECorreo,lcNombreCliDTEenvio,lcCorreoDTeEnviar,lcFileDTEENVio1,lcFileDTEENVio2,lcOperacionRealizadaDTE)
	LOCAL lcSchema, loConfig, loMsg, loError, lcErr, lcCorreoRemite
	LOCAL lcCorreDTEenvio, lcCorreDTEenvioCC, lcRecipient, lcSubject, lcBody
	LOCAL lcAttachment1, lcAttachment2, lcAsuntoDTE, llEnviado
	lcErr = ""
	llEnviado = .F.
	loConfig = .NULL.
	loMsg = .NULL.
	DO case
		CASE lcOperacionRealizadaDTE='VENTA'
			lcAsuntoDTE='Adjuntamos Documentos ...   '
		CASE lcOperacionRealizadaDTE='ANULACION'
			lcAsuntoDTE='Anulacion de Documento ...   '
		CASE lcOperacionRealizadaDTE='COMPRA'
			lcAsuntoDTE='Adjuntamos Documentos ...   '
		OTHERWISE
		lcAsuntoDTE='Mensaje ...   '
	ENDCASE 

	IF pcNombreComercial='MOBILE SOLUTIONS, S.A. DE C.V.'
		lcAsuntoDTE='DTE MOBILE SOLUTIONS - '+lcAsuntoDTE
	ENDIF 

	lcNombreCliDTEenvio=STRTRAN(lcNombreCliDTEenvio,',',' ')
	lcNombreCliDTEenvio=STRTRAN(lcNombreCliDTEenvio,'"',' ')
	lcNombreCliDTEenvio=STRTRAN(lcNombreCliDTEenvio,';',' ')
	lcNombreCliDTEenvio=STRTRAN(lcNombreCliDTEenvio,':',' ')
	lcCorreDTEenvio=ValidarVariosCorreos(ALLTRIM(lcCorreoDTeEnviar),1)
	lcCorreDTEenvioCC=ValidarVariosCorreos(ALLTRIM(lcCorreoDTeEnviar),2)
	lcNombreCliDTEenvio=ALLTRIM(lcNombreCliDTEenvio)
	lcFileDTEENVio1=ALLTRIM(lcFileDTEENVio1)
	lcFileDTEENVio2=ALLTRIM(lcFileDTEENVio2)

	IF EMPTY(lcCorreDTEenvio)
		MESSAGEBOX("No existe un correo destinatario valido.",16,"Correo")
		RETURN .F.
	ENDIF
	IF EMPTY(lcFileDTEENVio1) OR !FILE(lcFileDTEENVio1)
		MESSAGEBOX("No existe el archivo principal que se debe adjuntar:"+CHR(13)+lcFileDTEENVio1,16,"Correo")
		RETURN .F.
	ENDIF
	IF !EMPTY(lcFileDTEENVio2) AND !FILE(lcFileDTEENVio2)
		MESSAGEBOX("No existe el segundo archivo que se debe adjuntar:"+CHR(13)+lcFileDTEENVio2,16,"Correo")
		RETURN .F.
	ENDIF

	TRY
	  lcSchema = "http://schemas.microsoft.com/cdo/configuration/"

	  IF !EMPTY(pcusuariowebpdf)
	  	lcCorreoRemite=pcusuariowebpdf
	  ELSE
	  	lcCorreoRemite=pccorreovtadte
	  ENDIF 
	  *-- Configuración SMTP
	  loConfig = CREATEOBJECT("CDO.Configuration")
	  WITH loConfig.FIELDS
	    .ITEM(lcSchema + "smtpserver")       = ALLTRIM(pcpaginawebpdf)		&& gmail SMTP: smtp.gmail.com
	    .ITEM(lcSchema + "smtpserverport")   = 465		&& gmail 465
	    .ITEM(lcSchema + "sendusing")        = 2
	    .ITEM(lcSchema + "smtpauthenticate") = .T.
	    .ITEM(lcSchema + "smtpusessl")       = .T.
	    .ITEM(lcSchema + "smtpconnectiontimeout") = 30
	    .ITEM(lcSchema + "sendusername")     = ALLTRIM(lcCorreoRemite)
	    .ITEM(lcSchema + "sendpassword")     = ALLTRIM(pcclavewebpdf)
	    .UPDATE
	  ENDWITH

	lcRecipient = lcCorreDTEenvio
	
	lcSubject = lcAsuntoDTE+lcNumControlDTECorreo
	lcBody = "Adjuntamos Archivos "+CHR(13)+CHR(13)+Justfname(lcFileDTEENVio1)+CHR(13)+Justfname(lcFileDTEENVio2)
	lcAttachment1 = lcFileDTEENVio1
	lcAttachment2 = lcFileDTEENVio2


	  *-- Crear mensaje
	  loMsg = CREATEOBJECT("CDO.Message")
	  WITH loMsg
	    .Configuration = loConfig
	    .FROM     = quitarcomasypuntos(pcNombreComercial)+" <" + ALLTRIM(lcCorreoRemite) + ">"
	    .TO       = lcRecipient
	    IF NOT EMPTY(lcCorreDTEenvioCC)
	    	.CC= ALLTRIM(lcCorreDTEenvioCC)	    
	    ENDIF
	    .Subject  = ALLTRIM(lcSubject)
	    .TextBody = ALLTRIM(lcBody)

	    *-- Adjuntar archivos
	    IF NOT EMPTY(lcAttachment1)
	    	IF FILE(lcAttachment1)
	     		 .AddAttachment(ALLTRIM(lcAttachment1))
	     	ELSE
	     		=INKEY(2)
	     		.AddAttachment(ALLTRIM(lcAttachment1))
	     	ENDIF 
	    ENDIF
	    IF NOT EMPTY(lcAttachment2)
	    	IF FILE(lcAttachment2)
	      		.AddAttachment(ALLTRIM(lcAttachment2))
	      	ELSE
	      		=INKEY(2)
	      		.AddAttachment(ALLTRIM(lcAttachment2))
	      	ENDIF 
	    ENDIF

	    .Send()
	    llEnviado = .T.
	  ENDWITH

	CATCH TO loError
	  lcErr = "Error: " + STR(loError.ERRORNO) + CHR(13) + ;
	          "Línea: " + STR(loError.LINENO) + CHR(13) + ;
	          "Mensaje: " + loError.MESSAGE

	FINALLY
	  STORE .NULL. TO loConfig, loMsg

	  IF llEnviado
	  	 IF TYPE("_vfp.ActiveForm")='O'
 			_vfp.ActiveForm.cntDiga.diga('Correo enviado con éxito....',4,1)
		 ENDIF 
	     WAIT WINDOW "El correo se envió con éxito....." NOWAIT 
	  ELSE
	  	 IF TYPE("_vfp.ActiveForm")='O'
			_vfp.ActiveForm.cntDiga.diga('No se pudo enviar el correo!',4,1)
		 ENDIF
		 MESSAGEBOX("No se pudo enviar el mensaje!" + CHR(13) + ;
		    "Servidor: "+ALLTRIM(pcpaginawebpdf)+CHR(13)+;
		    "Puerto: 465"+CHR(13)+;
		    "Usuario: "+ALLTRIM(lcCorreoRemite)+CHR(13)+CHR(13)+;
		    lcErr, 16, "Error SMTP")
	  ENDIF
	ENDTRY

	RETURN llEnviado
ENDFUNC




FUNCTION enviarcorreoporOutlook(lcNumControlDTECorreo,lcNombreCliDTEenvio,lcCorreoDTeEnviar,lcFileDTEENVio1,lcFileDTEENVio2,lcOperacionRealizadaDTE)
	#DEFINE olMailItem 0
	LOCAL loOutlook, loMailItem, loErr
	LOCAL lcRecipient, lcSubject, lcBody, lcAttachment1, lcAttachment2
	LOCAL lcCorreDTEenvio, lcCorreDTEenvioCC, lcAsuntoDTE, llEnviado
	llEnviado = .F.
	loOutlook = .NULL.
	loMailItem = .NULL.
	
	***** si esta configurado el correo en los parametros usamos ese correo
	IF !EMPTY(pccorreovtadte)
		RETURN EnviarCorreoNew(lcNumControlDTECorreo,lcNombreCliDTEenvio,lcCorreoDTeEnviar,lcFileDTEENVio1,lcFileDTEENVio2,lcOperacionRealizadaDTE)
	ELSE
	
		DO case
			CASE lcOperacionRealizadaDTE='VENTA'
				lcAsuntoDTE='Adjuntamos Documentos ...   '
			CASE lcOperacionRealizadaDTE='ANULACION'
				lcAsuntoDTE='Anulacion de Documento ...   '
			CASE lcOperacionRealizadaDTE='COMPRA'
				lcAsuntoDTE='Adjuntamos Documentos ...   '
			OTHERWISE
			lcAsuntoDTE='Mensaje ...   '
		ENDCASE 
		IF pcNombreComercial='MOBILE SOLUTIONS, S.A. DE C.V.'
			lcAsuntoDTE='DTE MOBILE SOLUTIONS - '+lcAsuntoDTE
		ENDIF
		
		IF TYPE("_vfp.ActiveForm")='O'
			_vfp.ActiveForm.cntDiga.diga('Conectando con el Servidor...',4,1)
		ENDIF 
		WAIT WINDOW "Conectando con el Servidor... " NOWAIT 
		
		lcCorreDTEenvio=ValidarVariosCorreos(ALLTRIM(lcCorreoDTeEnviar),1)
		lcCorreDTEenvioCC=ValidarVariosCorreos(ALLTRIM(lcCorreoDTeEnviar),2)
		lcNombreCliDTEenvio=ALLTRIM(lcNombreCliDTEenvio)
		lcFileDTEENVio1=ALLTRIM(lcFileDTEENVio1)
		lcFileDTEENVio2=ALLTRIM(lcFileDTEENVio2)
	 
		* Inicializa las variables del correo
		lcRecipient = lcCorreDTEenvio
		
		lcSubject = lcAsuntoDTE+lcNumControlDTECorreo
		lcBody = "Adjuntamos Archivos "+CHR(13)+CHR(13)+Justfname(lcFileDTEENVio1)+CHR(13)+Justfname(lcFileDTEENVio2)
		lcAttachment1 = lcFileDTEENVio1
		lcAttachment2 = lcFileDTEENVio2

		IF EMPTY(lcRecipient)
			MESSAGEBOX("No existe un correo destinatario valido.",16,"Correo")
			RETURN .F.
		ENDIF
		IF EMPTY(lcAttachment1) OR !FILE(lcAttachment1)
			MESSAGEBOX("No existe el archivo principal que se debe adjuntar:"+CHR(13)+lcAttachment1,16,"Correo")
			RETURN .F.
		ENDIF
		IF !EMPTY(lcAttachment2) AND !FILE(lcAttachment2)
			MESSAGEBOX("No existe el segundo archivo que se debe adjuntar:"+CHR(13)+lcAttachment2,16,"Correo")
			RETURN .F.
		ENDIF

		try
			* Crea una instancia de Outlook
			loOutlook = CREATEOBJECT("Outlook.Application")

			* Crea un nuevo elemento de correo
			loMailItem = loOutlook.CreateItem(olMailItem)
			IF TYPE("_vfp.ActiveForm")='O'
				_vfp.ActiveForm.cntDiga.diga('Enviando Correo... ',4,1)
			ENDIF 
			WAIT WINDOW "Enviando Correo... " NOWAIT 
			WITH loMailItem
			    .Subject = lcSubject
			    .Body = lcBody
			    .To = lcRecipient
			    IF !EMPTY(lcCorreDTEenvioCC)
					.CC=lcCorreDTEenvioCC
				ENDIF

			    IF !EMPTY(lcFileDTEENVio1) AND FILE(lcFileDTEENVio1)
			    	.Attachments.Add(lcAttachment1)
			    ENDIF 
			    IF !EMPTY(lcFileDTEENVio2) AND FILE(lcFileDTEENVio2)
			   		.Attachments.Add(lcAttachment2)
			   	ENDIF 
			   	
			    .Send()
			    llEnviado = .T.
			    IF TYPE("_vfp.ActiveForm")='O'
					_vfp.ActiveForm.cntDiga.diga('Correo enviado con éxito.',4,1)
				ENDIF 
			    WAIT WINDOW "Correo enviado con éxito." NOWAIT 
			ENDWITH

			* Libera las referencias a los objetos COM

		CATCH TO loErr 
			llEnviado = .F.
			IF TYPE("_vfp.ActiveForm")='O'
				_vfp.ActiveForm.cntDiga.diga('No se pudo enviar el correo...',4,1)
			ENDIF
			  MESSAGEBOX("No se pudo enviar el mensaje" + CHR(13) + ;
			    "Error: " + TRANSFORM(loErr.ErrorNo) + CHR(13) + ;
