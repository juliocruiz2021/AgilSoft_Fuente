	UNION ALL ;
	SELECT idproducto,idunimed as idproductoUniMed,codprod4 as codprod,IIF(EMPTY(NVL(Unimed,'')),'Uni.'+SPACE(16),unimed) as UnidadMedida,factor as factor ;
