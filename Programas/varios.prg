FUNCTION ValidarCtbSaldosIndice2()
	IF pntipoconeccion=1
		lcaliasvalida=ALIAS()
		USE pcSysDir+pcdb+"\ctbsaldos" again IN 0
		SELECT ctbsaldos
		llexiste=.f.
		***** buscando indice
		FOR ii = 1 TO 254 
			IF ALLTRIM(UPPER((TAG(ii)))) == 'LLAVE2'	&& EL INDICE EXISTE 
				llexiste=.t.
				EXIT && Exit the loop when no more tags are found 
			ENDIF 
		ENDFOR
		USE IN ctbsaldos
		
		IF !llexiste
			TRY 
				USE pcSysDir+pcdb+"\ctbsaldos" EXCLUSIVE IN 0
				IF ALIAS()='CTBSALDOS'
					SELECT idcuenta,periodo,MIN(idsaldo) as id 	FROM ctbsaldos ORDER BY idcuenta,periodo GROUP BY idcuenta,periodo INTO CURSOR c_aborrar
					SELECT ctbSaldos
					DELETE FROM ctbsaldos WHERE idsaldo NOT in (select id FROM c_aborrar)
					PACK 
					USE IN c_aborrar
					SELECT ctbsaldos
					
					INDEX on STR(idcuenta)+periodo TAG llave2 CANDIDATE  
					USE IN ctbsaldos
				ENDIF 
			
			CATCH TO lEx 
				lcerrorllave=" Error " + TRANSFORM(lEx.Message)
				MESSAGEBOX('El Indice de Saldos LLAVE2, NO PUDO ACTUALIZARCE...',16,'Error de Actualizacion de Tabla')
			
			FINALLY	
				IF ALIAS()='CTBSALDOS'
					
				ENDIF 
			ENDTRY 
		ENDIF 
		
		IF !EMPTY(lcaliasvalida)
			SELECT (lcaliasvalida)
		ENDIF 
	ENDIF 
	RETURN .t.
ENDFUNC 




