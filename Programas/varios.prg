	UPDATE cyvventas  SET pcuser=ALLTRIM(pcuser)+' ' WHERE STR(iddocto)+STR(idtipodocto) in (selec STR(iddocto)+STR(idtipodocto) from c_malosV)

	WAIT WINDOW 'Verificando Kardex de Documentos ...' NOWAIT 
	***** Bancos
	SELECT a.iddocto,a.idtipodocto ;
		FROM cybmovimientos a ;
		LEFT JOIN siskardexdoc b ON a.iddocto=b.iddocto AND  a.idtipodocto=b.idtipodocto ;
		WHERE a.status=1 AND a.anulado=0 AND a.eliminado=0 AND NVL(b.iddocto,0)=0 &lcFilclipro &lcFilcajbanco ;
	INTO CURSOR c_malosB READWRITE
	UPDATE cybmovimientos  SET pcuser=ALLTRIM(pcuser)+' ' WHERE STR(iddocto)+STR(idtipodocto) in (selec STR(iddocto)+STR(idtipodocto) from c_malosB)

	WAIT WINDOW 'Verificando Kardex de Documentos ....' NOWAIT 
	***** Cuentas por Cobrar y Pagar
	SELECT a.iddocto,a.idtipodocto ;
		FROM cyvcuentasxcp a ;
		LEFT JOIN siskardexdoc b ON a.iddocto=b.iddocto AND  a.idtipodocto=b.idtipodocto ;
		WHERE a.status=1 AND a.anulado=0 AND a.eliminado=0 AND NVL(b.iddocto,0)=0 &lcFilclipro ;
	INTO CURSOR c_malosCP READWRITE
	UPDATE cyvcuentasxcp  SET pcuser=ALLTRIM(pcuser)+' ' WHERE STR(iddocto)+STR(idtipodocto) in (selec STR(iddocto)+STR(idtipodocto) from c_malosCP)

	*** Los documentos no contabilizables conservan su espejo informativo en siskardexdoc.

	USE IN ctbpartidas
	USE IN ctbpartidasdeta
	USE pcSysDir+pcdb+"\ctbpartidas" IN 0 SHARE AGAIN 
	USE pcSysDir+pcdb+"\ctbpartidasdeta" IN 0 SHARE AGAIN 
	DELETE from ctbpartidasdeta WHERE origen+STR(idpartida) in (select origen+STR(iddocto) FROM cyvcompras WHERE noContabilizable=1 AND status=1)
	DELETE from ctbpartidasdeta WHERE origen+STR(idpartida) in (select origen+STR(iddocto) FROM cyvventas WHERE noContabilizable=1 AND status=1)
	DELETE from ctbpartidas WHERE origen+STR(idpartida) in (select origen+STR(iddocto) FROM cyvcompras WHERE noContabilizable=1 AND status=1)
	DELETE from ctbpartidas WHERE origen+STR(idpartida) in (select origen+STR(iddocto) FROM cyvventas WHERE noContabilizable=1 AND status=1)

	USE IN c_malosV
	USE IN c_malosC
	USE IN c_malosB
	USE IN c_malosCP
	
	USE IN ctbpartidas
	USE IN ctbpartidasdeta
	
	WAIT WINDOW 'Verificando Kardex de Documentos .....' NOWAIT 

	SELECT * FROM siskardexapli WHERE status=1 AND ;
			(iddocto NOT in (SELECT iddocto FROM siskardexdoc) OR ;
			iddoctoaplicar NOT in (SELECT iddocto FROM siskardexdoc) ) ;
		INTO CURSOR c_noaplica READWRITE 
		
	SELECT iddocto,SUM(monto) as monto FROM ;
			(SELECT iddocto,monto*IIF(carabo=2,1,-1) as monto FROM siskardexapli WHERE status=1 AND idaplica NOT in (SELECT idaplica FROM c_noaplica) ;
			UNION ALL ;
			SELECT iddoctoaplicar,monto*IIF(carabo=2,-1,1) as monto FROM siskardexapli WHERE status=1 AND idaplica NOT in (SELECT idaplica FROM c_noaplica)) as cc  ;
		INTO CURSOR c_aplicar READWRITE  ORDER BY iddocto GROUP BY iddocto

	UPDATE siskardexdoc SET cargoabono=a.monto from c_aplicar a WHERE siskardexdoc.iddocto=a.iddocto AND siskardexdoc.cargoabono<>a.monto
	UPDATE siskardexdoc SET rentaabono=rentadocto*-1 WHERE cargoabono<>0 AND rentadocto<>0
	
	USE IN c_noaplica 
	USE IN c_aplicar
	
	USE IN cyvventas
	IF llsisKardexAbrio=.t.
		USE IN siskardexdoc
	ENDIF 
	USE IN cyvcompras
	IF llcybmovseAbrio=.t.
		USE IN cybmovimientos
	ENDIF 
	IF llsisctascpSeAbrio=.t.
		USE IN cyvcuentasxcp
	ENDIF 
	IF llsisKarApliAbrio=.t.
		USE IN siskardexapli
	ENDIF 
	
	IF USED("tacajban")
		USE IN tacajban
	ENDIF 
	IF USED("sispermisos")
		USE IN sispermisos
	ENDIF 
	IF USED("sisusuarios")
		USE IN sisusuarios
	ENDIF 
	
	IF !EMPTY(lcaliascxc)
		SELECT (lcaliascxc)
	ENDIF 

	pnSincronizandoTablas=.f.
	WAIT WINDOW "Proceso Terminado ..." nowait
ENDFUNC 





