FUNCTION ColExcel(lnCol)
    LOCAL lcCol, lnResiduo

    lcCol = ""

    DO WHILE lnCol > 0
        lnResiduo = MOD(lnCol - 1, 26)
        lcCol = CHR(65 + lnResiduo) + lcCol
        lnCol = INT((lnCol - 1) / 26)
    ENDDO

    RETURN lcCol
ENDFUNC









