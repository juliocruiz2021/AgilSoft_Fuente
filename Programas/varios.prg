FUNCTION obtenerUnidadesdeMedidadeDSC()
	SELECT 000000000 as idprod,000000000 as idprodUM,a.pro_codigo,a.pro_nombre,b.pre_codigo,;
				b.pre_descripcion,a.pro_factor,c.tip_codigo,c.tip_descripcion,d.asp_precio,a.pro_codigo_inventario ;
	FROM t_productos a ;
		inner JOIN t_tipos_presentacion b ON  a.pro_empresa=b.pre_empresa AND a.pro_presentacion=b.pre_codigo ;
		LEFT JOIN t_asignacion_precios d ON a.pro_empresa=d.asp_empresa AND a.pro_codigo=d.asp_producto ;
		INNER JOIN t_tipos_precio c ON a.pro_empresa=c.tip_empresa AND d.asp_tipo_precio=c.tip_codigo ;
	WHERE !EMPTY(a.pro_codigo_inventario) AND d.asp_precio>0 AND !INLIST(a.pro_codigo,'1290342067') AND pro_grupo<>'MK' ORDER by a.pro_codigo,d.asp_precio 
ENDFUNC 



