	***********************************
	******* sisTipodoctos (t_tipos_documentos) tipos de documentos tipo1=venta,2=compras,3=venta y compra
	IF lcmoduloacargar=8
		WAIT WINDOW "Sincronizando TIPOS DE DOCUMENTO DE VENTAS Y COMPRAS ..." NOWAIT 
		USE pcsysdir+pcDB+"\sistipodoctos" IN 0 SHARED AGAIN 
		USE pcPTVDisalRuta+'facturacion\t_tipos_documento' IN 0 SHARED AGAIN ALIAS t_TIP

		SELECT 000000000 as id,tdc_codigo,tdc_descripcion,tdc_tipo,1 as cyv,ALLTRIM(tdc_codigo)+'V' as tipo,'VTA' AS ORIGEN FROM t_TIP ;
				WHERE (tdc_tipo=1 OR tdc_tipo=3) AND ALLTRIM(tdc_codigo)+'V' NOT in ;
					(SELECT codtipo FROM sistipodoctos ) ;
		UNION ALL ;
			SELECT 000000000 as id,tdc_codigo,tdc_descripcion,tdc_tipo,2 as cyv,ALLTRIM(tdc_codigo)+'C' as tipo,'COM' AS ORIGEN FROM t_TIP ;
				WHERE (tdc_tipo=2 OR tdc_tipo=3) AND ALLTRIM(tdc_codigo)+'C' NOT in ;
					(SELECT codtipo FROM sistipodoctos ) ;
		UNION ALL ;
			SELECT 000000001 as id,tdc_codigo,tdc_descripcion,tdc_tipo,1 as cyv,ALLTRIM(tdc_codigo)+'V' as tipo,'VTA' AS ORIGEN FROM t_TIP ;
				WHERE (tdc_tipo=1 OR tdc_tipo=3) AND ALLTRIM(tdc_codigo)+'V' in ;
					(SELECT codtipo FROM sistipodoctos ) ;
		UNION ALL ;
			SELECT 000000001 as id,tdc_codigo,tdc_descripcion,tdc_tipo,2 as cyv,ALLTRIM(tdc_codigo)+'C' as tipo,'COM' AS ORIGEN FROM t_TIP ;
				WHERE (tdc_tipo=2 OR tdc_tipo=3) AND ALLTRIM(tdc_codigo)+'C' in ;
					(SELECT codtipo FROM sistipodoctos ) ;
		INTO CURSOR c_TIP READWRITE 
		REPLACE id WITH _SiguienteIdTabla(pcNodo,"MAS") FOR id=0  
		
		UPDATE sistipodoctos SET sistipodoctos.tipodocto=c_TIP.tdc_descripcion ,;
							sistipodoctos.origen=c_TIP.ORIGEN, ;
							sistipodoctos.fecmod=ldfec, ;
							sistipodoctos.nodo=pcnodo, ;
							sistipodoctos.iduser=pnIdUsuario, ;
							sistipodoctos.pcuser=SYS(0) ;
			from c_TIP WHERE sistipodoctos.codtipo=c_TIP.tipo
		
		INSERT INTO sistipodoctos (idtipodocto,codtipo,tipodocto,clave,tipoicv,;
					origen,eliminado,status,fecalta,fecmod,nodo,iduser,pcuser) ;
			SELECT id,tipo,tdc_descripcion,tdc_codigo,0,ORIGEN,0,1,ldfec,ldfec,;
				pcnodo,pnIdUsuario,SYS(0) ;
			FROM c_TIP WHERE id<>1 
		
		USE IN c_TIP
		USE IN sistipodoctos
		USE IN t_TIP	
	ENDIF 
	
ENDFUNC 






FUNCTION _SincronizaCatalogos(lnmimodcargar)
	
	***********************************
	******* Productos
	IF lnmimodcargar=1
		WAIT WINDOW "Sincronizando Productos " NOWAIT 
		USE pcsysdir+pcDB+"\invProductos" IN 0 SHARED AGAIN 
		USE pcsysdir+pcDB+"\siscata" IN 0 SHARED AGAIN 
		
		lnidConDSCF=_conectaDSCFOX("facturacion\base.dbc")

		IF lnidConDSCF>0
		
*!*				USE pcPTVDisalRuta+'facturacion\t_productos' IN 0 SHARED AGAIN ALIAS t_PRO
*!*				USE pcPTVDisalRuta+'facturacion\t_tipos_presentacion' IN 0 SHARED AGAIN ALIAS t_UME
*!*				USE pcPTVDisalRuta+'facturacion\t_asignacion_precios' IN 0 SHARED AGAIN ALIAS t_PRE
*!*				USE pcPTVDisalRuta+'facturacion\t_existencias_costos' IN 0 share AGAIN ALIAS t_exi
			lccomanDSCF='select * from t_productos'
			=SQLEXEC(lnidConDSCF,lccomanDSCF,"t_PRO")
			lccomanDSCF='select * from t_tipos_presentacion'
			=SQLEXEC(lnidConDSCF,lccomanDSCF,"t_UME")
			lccomanDSCF='select * from t_asignacion_precios'
			=SQLEXEC(lnidConDSCF,lccomanDSCF,"t_PRE")
			lccomanDSCF='select * from t_existencias_costos'
			=SQLEXEC(lnidConDSCF,lccomanDSCF,"t_EXI")
			
			=SQLDISCONNECT(lnidConDSCF)
			
			SELECT 000000000 as id,PRO_codigo,pro_nombre, padr(left(PRO_nota_cotizacion,len(PRO_nota_cotizacion)),250," ") as descripcion,;
					1 as tipoprod,pro_barra,181 as iddivision,191 as idsistema,NVL(c_lin.id,0000000000) as idfamilia,NVL(c_rub.id,110012765) as idrubro,0 as idagrupador,;
					NVL(t_UME.pre_descripcion,SPACE(20)) as unidadmedida,221 as idmarca,1 as gravado,0 as concesc,0 as conretencion,;
					1 as idimpuestoiva,0 as idimpuestorenta,0 as idimpuestofovial,0 as idimpuestocotrans,0 idimpuestocesc,;
					0 pordescuento,50 as factorganancia,0 as esprodcontrolado,0 as esprodregulado,0 as escombustible,;
					0 as esfabricado,0 as fabautomatica,0 as connegativos,0 as conarea,0 as conserielote,;
					0 as enliquidacion,0 as costoinicial,0 as costototal,1 as juegocompra,;
					0 as pedidosrecibir,0 as pedidossurtir,NVL(asp_precio,0) as precioconiva, NVL(asp_precio,0)/1.13 as preciosiniva,;
					1 as juegoventa,1 as factorpresenta,0 as idctainggasto,NVL(EXC_existencia,000000000.000000) as existencia,NVL(exc_costo,000000000.00) as costopromedio ;
					FROM t_PRO LEFT JOIN t_UME ON pro_empresa=pre_empresa AND pro_presentacion=pre_codigo ;
								LEFT JOIN t_pre ON pro_empresa=asp_empresa AND pro_codigo=asp_producto AND asp_tipo_precio='01' ;
								LEFT JOIN siscata as c_rub ON t_pro.pro_grupo=c_rub.cod AND c_rub.origen='RUB' AND t_pro.pro_grupo<>'' ;
								LEFT JOIN siscata as c_lin ON t_pro.pro_subgrupo=c_lin.cod AND c_lin.origen='LIN' AND t_pro.pro_subgrupo<>'' ;
								LEFT JOIN t_exi ON t_exi.exc_año=ALLTRIM(STR(YEAR(DATE()))) AND t_pro.pro_empresa=t_exi.exc_empresa AND ;
											t_pro.pro_codigo=t_exi.exc_producto AND t_exi.exc_bodega='09' ;
					WHERE PRO_empresa=pcPTVDisalEmpre AND EMPTY(pro_codigo_inventario) AND PRO_codigo NOT in ;
						(SELECT codprod FROM invProductos) ;
			UNION ALL ;
				SELECT 000000001 as id,PRO_codigo,pro_nombre,padr(left(PRO_nota_cotizacion,len(PRO_nota_cotizacion)),250," ")  as descripcion,;
					1 as tipoprod,pro_barra,181 as iddivision,191 as idsistema,NVL(c_lin.id,0000000000) as idfamilia,NVL(c_rub.id,0000000000) as idrubro,0 as idagrupador,;
					NVL(t_UME.pre_descripcion,SPACE(20)) as unidadmedida,221 as idmarca,1 as gravado,0 as concesc,0 as conretencion,;
					1 as idimpuestoiva,0 as idimpuestorenta,0 as idimpuestofovial,0 as idimpuestocotrans,0 idimpuestocesc,;
					0 pordescuento,50 as factorganancia,0 as esprodcontrolado,0 as esprodregulado,0 as escombustible,;
					0 as esfabricado,0 as fabautomatica,0 as connegativos,0 as conarea,0 as conserielote,;
					0 as enliquidacion,0 as costoinicial,0 as costototal,1 as juegocompra,;
					0 as pedidosrecibir,0 as pedidossurtir,NVL(asp_precio,0) as precioconiva, NVL(asp_precio,0)/1.13 as preciosiniva,;
					1 as juegoventa,1 as factorpresenta,0 as idctainggasto,NVL(EXC_existencia,000000000.000000) as existencia,NVL(exc_costo,000000000.00) as costopromedio ;
					FROM t_PRO LEFT JOIN t_UME ON pro_empresa=pre_empresa AND pro_presentacion=pre_codigo ;
								LEFT JOIN t_pre ON pro_empresa=asp_empresa AND pro_codigo=asp_producto AND asp_tipo_precio='01' ;
								LEFT JOIN siscata as c_rub ON t_pro.pro_grupo=c_rub.cod AND c_rub.origen='RUB' AND t_pro.pro_grupo<>'' ;
								LEFT JOIN siscata as c_lin ON t_pro.pro_subgrupo=c_lin.cod AND c_lin.origen='LIN' AND t_pro.pro_subgrupo<>'' ;
								LEFT JOIN t_exi ON t_exi.exc_año=ALLTRIM(STR(YEAR(DATE()))) AND t_pro.pro_empresa=t_exi.exc_empresa AND ;
										t_pro.pro_codigo=t_exi.exc_producto AND t_exi.exc_bodega='09' ;
					WHERE PRO_empresa=pcPTVDisalEmpre AND EMPTY(pro_codigo_inventario) AND PRO_codigo in ;
						(SELECT codprod FROM invProductos ) ;
			INTO CURSOR c_PRO READWRITE 
			REPLACE id WITH _SiguienteIdTabla(pcNodo,"MAS") FOR id=0  
			REPLACE idfamilia WITH 211 FOR idfamilia=0

			*UPDATE invproductos SET invproductos.producto=c_PRO.PRO_nombre ,;
								invproductos.descripcion=c_pro.descripcion ,;
								invproductos.codoriginal=c_pro.pro_barra,;
								invproductos.idrubro=c_pro.idrubro,;
								invproductos.idfamilia=c_pro.idfamilia,;
								invproductos.precioconiva=c_pro.precioconiva,;
								invproductos.preciosiniva=c_pro.preciosiniva,;
								invproductos.existencia=c_pro.existencia,;
								invproductos.fecmod=ldfec,;
								invproductos.nodo=pcnodo,;
								invproductos.iduser=pnIdUsuario, ;
								invproductos.pcuser=SYS(0) ;
				from c_PRO WHERE invproductos.codprod=c_PRO.PRO_codigo 
			
			INSERT INTO invproductos (idproducto,codprod,producto,descripcion,tipoprod,codoriginal,;
					iddivision,idsistema,idfamilia,idrubro,idagrupador,;
					unidadmedida,idmarca,gravado,concesc,conretencion,;
					idimpuestoiva,idimpuestorenta,idimpuestofovial,idimpuestocotrans,idimpuestocesc,;
					pordescuento,factorganancia,esprodcontrolado,esprodregulado,escombustible,;
					esfabricado,fabautomatica,connegativos,conarea,conserielote,;
					enliquidacion,costoinicial,costopromedio,costototal,juegocompra,;
					existencia,pedidosrecibir,pedidossurtir,precioconiva,preciosiniva,;
					juegoventa,factorpresenta,idctainggasto,eliminado,status,fecalta,fecmod,nodo,iduser,pcuser) ;
				SELECT id,PRO_codigo,pro_nombre,descripcion,tipoprod,pro_barra,;
					iddivision,idsistema,idfamilia,idrubro,idagrupador,;
					unidadmedida,idmarca,gravado,concesc,conretencion,;
					idimpuestoiva,idimpuestorenta,idimpuestofovial,idimpuestocotrans,idimpuestocesc,;
					pordescuento,factorganancia,esprodcontrolado,esprodregulado,escombustible,;
					esfabricado,fabautomatica,connegativos,conarea,conserielote,;
					enliquidacion,costoinicial,costopromedio,costototal,juegocompra,;
					existencia,pedidosrecibir,pedidossurtir,precioconiva,preciosiniva,;
					juegoventa,factorpresenta,idctainggasto,0,1,ldfec,ldfec,;
					pcnodo,pnIdUsuario,SYS(0) ;
				FROM c_PRO WHERE id<>1 

			USE IN c_PRO
			USE IN t_PRO	
			USE IN t_UME
			USE IN t_PRE

		ELSE 
			MESSAGEBOX("Imposible conectarse con el servidor de DISALCOMB",16,"Error.....")
		ENDIF 
		USE IN siscata
		USE IN invProductos
	ENDIF 
	
	
	***********************************
	******* CLIENTES
	IF lnmimodcargar=2
		WAIT WINDOW "Sincronizando Clientes" NOWAIT 
		USE pcsysdir+pcDB+"\cyvCliPro" IN 0 SHARED AGAIN 

		lnidConDSCF=_conectaDSCFOX("facturacion\base.dbc")

		IF lnidConDSCF>0

