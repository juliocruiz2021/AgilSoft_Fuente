FUNCTION CreaCuentasparaRenta
	lcmialias=ALIAS()
	OPEN DATABASE pcsysdir+pcdb+"\masterdb.dbc" SHARED
    lctablacrear = pcsysdir+pcdb+"\ctbCuentas"

	USE (lctablacrear) IN 0 SHARED AGAIN ALIAS CtaRen
	SELECT codcta,tipoOperacion,tipoGasto,idCuenta,LEN(ALLTRIM(codcta)) as largo,nivel ;
			FROM CtaRen ORDER BY nivel,codcta WHERE  tipoOperacion+tipoGasto<>0 INTO CURSOR ctaPadresRenta
	lnMinNivel=nivel
	SELECT codcta,tipoOperacion,tipoGasto,idCuenta,LEN(ALLTRIM(codcta)) as largo,nivel ;
			FROM  CtaRen ORDER BY nivel,codcta INTO CURSOR CtaHija READWRITE 
	SELECT CtaHija
	GO bott
	lnmaxnivel=nivel
	GO top
	FOR iiniv=lnMinNivel TO lnmaxnivel
		SELECT * FROM CtaHija WHERE tipoOperacion+tipoGasto<>0 INTO CURSOR  ctaPadresRenta
		SCAN FOR nivel=iiniv
			lcCodCta=ALLTRIM(codcta)
			lnlargo=largo
			lnTipO=tipooperacion
			lntipg=tipogasto
			SELECT CtaHija
			SCAN FOR nivel=iiniv+1
				IF ALLTRIM(lcCodCta)+' '==SUBSTR(codcta,1,lnlargo)+' ' AND (TipoOperacion=0 OR TipoGasto=0)
					REPLACE tipooperacion WITH  IIF(tipooperacion=0,lnTipO,tipooperacion),;
						tipogasto WITH IIF(tipogasto=0,lntipg,tipogasto)  NEXT 1
				ENDIF 
			ENDSCAN 
		ENDSCAN 
	ENDFOR 
	
	SELECT a.idCuenta,NVL(b.tipoOperacion,a.tipoOperacion) as tipoOperacion,;
		NVL(b.tipoGasto,a.tipoGasto) as tipoGasto,a.codcta ;
	FROM CtaRen a LEFT JOIN CtaHija as b ON a.idcuenta=b.idcuenta ;
		WHERE a.idcuenta<>0 ORDER BY a.idcuenta INTO CURSOR ctbcuentasRenta
	
	INDEX on idcuenta TAG idcuenta
	SET ORDER TO idcuenta
	
	USE IN ctaPadresRenta
	USE IN CtaRen
	use in CtaHija
	
	IF !EMPTY(lcmialias)
		SELECT (lcmialias)
	ENDIF 
ENDFUNC 



