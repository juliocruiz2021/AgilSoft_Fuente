		CASE pnTipoconeccion=3	&&& SQL
			miConec = +pcDriver+";";
			+"SERVER="+pcserver+";";
			+"DATABASE="+lcDB+";";
			+"UID="+pcroot+";";
			+"PWD="+pcclave+";"
					
