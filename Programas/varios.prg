FUNCTION _SiguienteCodigo(lcCodCtaBusSig)
	lcCodCtaBusSig=ALLTRIM(lcCodCtaBusSig)
	lcidCtaBus=0
	IF !EMPTY(lcCodCtaBusSig)
		***** buscando nivel
		STORE LEN(ALLTRIM(lcCodCtaBusSig)) TO lnTCta2
		STORE 0 TO lnNivelCta2
		FOR iCta=1 TO pnNivelDetalle
			IF lnTCta2=pnTNivel[iCta]
				lnNivelCta2=iCta
			ENDIF 
		ENDFOR 
		IF lnNivelCta2#0
			lcfaliasCtaBus=ALIAS()
			lnCorreNivel=VAL(RIGHT(lcCodCtaBusSig,pnNivel(lnNivelCta2)))+1

			IF LEN(ALLTRIM(STR(lnCorreNivel)))>pnNivel(lnNivelCta2)
				lnCorreNivel=lnCorreNivel-1
			ENDIF 
			IF !EMPTY(lcfaliasCtaBus)
				SELECT (lcfaliasCtaBus)
			ENDIF 
		ENDIF 
	ENDIF 
	IF lnNivelCta2=1
		RETURN ALLTRIM(STR(VAL(lcCodCtaBusSig)+1))
	ELSE
		RETURN SUBSTR(lcCodCtaBusSig,1,pnTNivel(lnNivelCta2-1))+PADL(ALLTRIM(STR(lnCorreNivel)),pnNivel(lnNivelCta2),"0")
	ENDIF 
ENDFUNC 


