FUNCTION ImportExcelToCursor(lcFileName)
    *----------------------------------------------------
    * Función para cargar datos de un archivo Excel a cursores en VFP
    * Utiliza la automatización de Excel para leer los datos
    * Solicita el archivo Excel, lo muestra y carga dos hojas: "Resumen" y "Detalle"
    *----------------------------------------------------

    LOCAL  loWorkbook, lcFileName
	PUBLIC loExcel
	
    * Solicitar archivo Excel
    *lcFileName = GETFILE("xlsx", "Seleccionar archivo Excel", "", 0, "Archivos de Excel (*.xlsx)|*.xlsx")

    IF EMPTY(lcFileName)
        MESSAGEBOX("No se seleccionó ningún archivo.", 16, "Error")
        RETURN .F.
    ENDIF

    * Crear instancia de Excel
    loExcel = CREATEOBJECT("Excel.Application")

   * TRY
        loWorkbook = loExcel.Workbooks.Open(lcFileName)

        * Mostrar el archivo en Excel
        *loExcel.Visible = .T.

        * Procesar la hoja "Resumen"
        WAIT WINDOW "Importando Resumen..." NOWAIT 
        IF NOT ProcessSheet(loWorkbook, "Resumen", "c_xlsResumen", 4, "G")
            RETURN .F.
        ENDIF

        * Procesar la hoja "Detalle"
        WAIT WINDOW "Importando Detalle..." NOWAIT 
        IF NOT ProcessSheet(loWorkbook, "Detalle", "c_xlsDetalle", 3, "F")
            RETURN .F.
        ENDIF

        * Asegurar que los cursores permanezcan abiertos
*!*	        USE IN SELECT("c_xlsResumen")
*!*	        USE IN SELECT("c_xlsDetalle")
*!*	        SELECT CursorResumen
*!*	        SELECT CursorDetalle

   * CATCH TO loException

       ** MESSAGEBOX("Error al procesar el archivo: " + loException.Message, 16, "Error")
     *   loExcel.Quit()
     *   RETURN .F.
   * ENDTRY

    * Cerrar el archivo y la instancia de Excel
    loWorkbook.Close(.F.)
    loExcel.Quit()

    * Liberar objetos COM
    RELEASE loWorkbook, loExcel

    RETURN .T.

ENDFUNC 

FUNCTION ProcessSheet(loWorkbook, tcSheetName, tcCursorName, tnStartRow, tcValidationCol)
    *----------------------------------------------------
    * Función para procesar una hoja específica y cargarla en un cursor
    * Parámetros:
    * loWorkbook - Objeto Workbook de Excel
    * tcSheetName - Nombre de la hoja a procesar
    * tcCursorName - Nombre del cursor a crear
    * tnStartRow - Fila de inicio para los registros
    * tcValidationCol - Columna a validar para determinar si se importa la fila
    *----------------------------------------------------

    LOCAL loSheet, lnRow, lnCol, lnLastRow, lnLastCol, lcCellValue, lnErrors

    lnErrors = 0

    TRY
        loSheet = loWorkbook.Sheets(tcSheetName)
    CATCH TO loException
        MESSAGEBOX("Error al abrir la hoja: " + tcSheetName + " - " + loException.Message, 16, "Error")
        RETURN .F.
    ENDTRY

    * Obtener el rango de datos
    lnLastRow = loSheet.UsedRange.Rows.Count
    lnLastCol = IIF(UPPER(tcSheetName)='RESUMEN',15,8)	&&& hoja detalle solo leer 15 y 11 columnas 

    * Crear el cursor dinámico con 20 campos
    CREATE CURSOR (tcCursorName) (F1 C(250), F2 C(250), F3 C(250), F4 C(250), F5 C(250), F6 C(250), F7 C(250), F8 C(250), F9 C(250), F10 C(250), F11 C(250), F12 C(250), F13 C(250), F14 C(250), F15 C(250), F16 C(250), F17 C(250), F18 C(250), F19 C(250), F20 C(250))

*!*		IF !UPPER(tcSheetName)='RESUMEN'
*!*			SUSPEND 
*!*		ENDIF 


    * Leer los datos de la hoja y cargarlos en el cursor
    FOR lnRow = tnStartRow TO lnLastRow
    	lnvaltmp=loSheet.Cells(lnRow, ASC(tcValidationCol) - 64).Value

    	IF type("lnvaltmp")='C' AND SUBSTR(ALLTRIM(lnvaltmp),1,1)='$'		&&& es un valor numero con simbolo de dolares $
    		lnvaltmp=VAL(STRTRAN(lnvaltmp,'$',''))
    	ENDIF 

        ** correccion importacion GANO: aceptar importes numericos (N) y monetarios (Y) *****
        IF INLIST(TYPE("lnvaltmp"),'N','Y') AND lnvaltmp<>0
            APPEND BLANK
            FOR lnCol = 1 TO MIN(20, lnLastCol)
                TRY
                	* Validación para manejar #N/D
                	IF INLIST(lnCol,2,9) AND UPPER(tcSheetName)='RESUMEN'
                		lcCellValue = ""  && Reemplazar por un valor predeterminado
					ELSE
	                    ** correccion importacion GANO: las celdas opcionales nulas se importan como texto vacio *****
	                    IF ISNULL(loSheet.Cells(lnRow, lnCol).Value)
	                        lcCellValue = ""
	                    ELSE
	                        lcCellValue = ALLTRIM(TRANSFORM(loSheet.Cells(lnRow, lnCol).Value))
	                    ENDIF
                	ENDIF
                	
                    * Validación de datos
                    IF !ISNULL(loSheet.Cells(lnRow, lnCol).Value)
                        IF INLIST(VARTYPE(loSheet.Cells(lnRow, lnCol).Value), "N", "Y") AND loSheet.Cells(lnRow, lnCol).Value < 0
                            lnErrors = lnErrors + 1
                            MESSAGEBOX("Valor negativo encontrado en: " + tcSheetName + "!R" + TRANSFORM(lnRow) + "C" + TRANSFORM(lnCol), 16, "Error")
                        ENDIF
                    ENDIF
                    IF type("lcCellValue")='C' AND SUBSTR(ALLTRIM(lcCellValue),1,1)='$'		&&& quitando signo de dolar en los valores
                    	lcCellValue=SUBSTR(ALLTRIM(lcCellValue),2,LEN(ALLTRIM(lcCellValue)))
                    ENDIF 
                    
					IF TYPE("lcCellValue")='N'
						lcCellValue=ALLTRIM(STR(lcCellValue,12,2))
					ENDIF 
					IF TYPE("lcCellValue")='D'
						lcCellValue=DTOC(lcCellValue)
					ENDIF 
					IF TYPE("lcCellValue")='T'
						lcCellValue=TTOC(lcCellValue)
					ENDIF 
                    REPLACE ("F" + TRANSFORM(lnCol)) WITH lcCellValue
                CATCH TO loException
                    lnErrors = lnErrors + 1
                    MESSAGEBOX("Error en la celda: " + tcSheetName + "!R" + TRANSFORM(lnRow) + "C" + TRANSFORM(lnCol) + " - " + loException.Message, 16, "Error")
                    RETURN .F.
                ENDTRY
            ENDFOR
		ELSE
			EXIT 
        ENDIF
    ENDFOR

    IF lnErrors > 0
        MESSAGEBOX("Se encontraron " + TRANSFORM(lnErrors) + " errores durante la validación de datos.", 48, "Advertencia")
    ENDIF

    * Liberar el objeto Sheet
    RELEASE loSheet

    RETURN .T.

ENDFUNC 


