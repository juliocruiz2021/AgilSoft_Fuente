FUNCTION CuantosDecimales(lcMimas) 
	lnDecim=AT('.',lcMimas)
	IF lnDecim=0
		ln=0
	ELSE
		ln=LEN(ALLTRIM(SUBSTR(lcMimas,lnDecim+1,12)))
	ENDIF 
  RETURN ln 
ENDFUNC 


FUNCTION CuantosDecimalesOld(tn) 
  LOCAL ln
  ln = 0 
  DO WHILE .T. 
    IF INT(tn * 10 ^ ln) == tn * 10 ^ ln 
      EXIT 
    ENDIF 
    ln = ln + 1 
  ENDDO 
  RETURN ln 
ENDFUNC 





