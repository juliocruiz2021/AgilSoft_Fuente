	ENDIF
RETURN llRetError
ENDFUNC 

FUNCTION _validadNit(lcNitVal)
lcNitVal=SoloNumeros(lcNitVal)
llRetNitVal=.t.

IF LEN(lcNitVal)<>14
	llRetNitVal=.f.
ENDIF 

IF (VAL(SUBSTR(lcNitVal,1,1))=9 OR VAL(SUBSTR(lcNitVal,1,2))>14)
	llRetNitVal=.f.
ENDIF 

IF CTOD(SUBSTR(lcNitVal,5,2)+'/'+SUBSTR(lcNitVal,7,2)+'/'+SUBSTR(lcNitVal,9,2))=CTOD(' ')
	llRetNitVal=.f.
ENDIF 

lcNitVal=PADL(lcNitVal,14,'0')

lnvalNitVeri=VAL(SUBSTR(lcNitVal,14,1))
lnValNit14=VAL(SUBSTR(lcNitVal,1,1))*14
lnValNit13=VAL(SUBSTR(lcNitVal,2,1))*13
lnValNit12=VAL(SUBSTR(lcNitVal,3,1))*12
lnValNit11=VAL(SUBSTR(lcNitVal,4,1))*11
lnValNit10=VAL(SUBSTR(lcNitVal,5,1))*10
lnValNit9=VAL(SUBSTR(lcNitVal,6,1))*9
lnValNit8=VAL(SUBSTR(lcNitVal,7,1))*8
lnValNit7=VAL(SUBSTR(lcNitVal,8,1))*7
lnValNit6=VAL(SUBSTR(lcNitVal,9,1))*6
lnValNit5=VAL(SUBSTR(lcNitVal,10,1))*5
lnValNit4=VAL(SUBSTR(lcNitVal,11,1))*4
lnValNit3=VAL(SUBSTR(lcNitVal,12,1))*3
lnValNit2=VAL(SUBSTR(lcNitVal,13,1))*2
lnValNitT=lnValNit14+lnValNit13+lnValNit12+lnValNit11+lnValNit10+lnValNit9+lnValNit8+lnValNit7+lnValNit6+lnValNit5+lnValNit4+lnValNit3+lnValNit2
lnValNitMod=MOD(lnValNitT,10)
lnValNitRes=10-lnValNitMod

IF lnValNitRes<>lnvalNitVeri
*	llRetNitVal=.f.
	ENDIF 

	RETURN 	llRetNitVal
ENDFUNC 


FUNCTION _validadDui(lcDuiValor)
	lcDuiVal=SoloNumeros(lcDuiValor)
	lcDuiVal=PADL(lcDuiVal,9,'0')
	llRetDuiVal=.t.

	lnvalduiVeri=VAL(SUBSTR(lcDuiVal,9,1))
	lnValDui9=VAL(SUBSTR(lcDuiVal,1,1))*9
	lnValDui8=VAL(SUBSTR(lcDuiVal,2,1))*8
	lnValDui7=VAL(SUBSTR(lcDuiVal,3,1))*7
	lnValDui6=VAL(SUBSTR(lcDuiVal,4,1))*6
	lnValDui5=VAL(SUBSTR(lcDuiVal,5,1))*5
	lnValDui4=VAL(SUBSTR(lcDuiVal,6,1))*4
	lnValDui3=VAL(SUBSTR(lcDuiVal,7,1))*3
	lnValDui2=VAL(SUBSTR(lcDuiVal,8,1))*2
	lnValDuiT=lnValDui9+lnValDui8+lnValDui7+lnValDui6+lnValDui5+lnValDui4+lnValDui3+lnValDui2
	lnValDuiMod=MOD(lnValDuiT,10)
	lnValDuiRes=10-lnValDuiMod
	IF lnValDuiRes<>lnvalduiVeri
		llRetDuiVal=.t.
*		llRetDuiVal=.f.
	ENDIF 
	
	IF LEN(ALLTRIM(SoloNumeros(lcDuiValor)))>9
		llRetDuiVal=.t.
*		llRetDuiVal=.f.
	ENDIF 

	RETURN 	llRetDuiVal
ENDFUNC 




FUNCTION SoloNumeros(lcCampo)
	LOCAL lcValor,lcRetorna
	lcValor = ALLTRIM(lcCampo) 
	lcRetorna=""
	IF !EMPTY(lcValor)
		nLong = LEN(lcValor) 
		FOR nCont = 1 TO nLong 
	        IF BETWEEN(ASC(SUBSTR(lcValor, nCont, 1)), 48, 57) 
	           lcRetorna=lcRetorna+SUBSTR(lcValor, nCont, 1)
	        ENDIF 
		ENDFOR 
	ENDIF 
	RETURN lcRetorna
ENDFUNC 


Function ObtenerDatosdeSemana(ldFecmiFec,lnTipoDatFec,lnMenosSemanas)
	*** lnTipoDatFec 1=numero de la semana, 2=primer dia de la semana,3=Ultimo dia de la Semana  4 = Restar x semanas a la fecha y retornar el ultimo de esa semana
	lnRetornaDiaSeman=0
	DO case
		CASE lnTipoDatFec=1
			lnRetornaDiaSeman=PADl(ALLTRIM(STR(WEEK(ldFecmiFec),2)),2,"0")
		CASE lnTipoDatFec=2
			lnRetornaDiaSeman=ldFecmiFec-DOW(ldFecmiFec)+1
		CASE lnTipoDatFec=3
			lnRetornaDiaSeman=ldFecmiFec-DOW(ldFecmiFec)+7
		CASE lnTipoDatFec=4
			lnRetornaDiaSeman=(ldFecmiFec-(lnMenosSemanas*7))-DOW(ldFecmiFec)+7
	ENDCASE 
	RETURN lnRetornaDiaSeman
ENDFUNC 

Function ObtenerDatosdeMes(ldFecmiFecM,lnTipoDatFecM,lnMenosMeses)
	*** lnTipoDatFec 1=Periodo (añomes), 2=primer dia del mes,3=Ultimo dia del mes, ;
						4 = restar x meses a la fecha actual y retorna el ultimo de mes de la fecha,;
						9 =restar x meses a la fecha actual y retornar el mismo dia del mes
	lnRetornaDiaMes=0

	IF EMPTY(ldFecmiFecM)
		ldFecmiFecM=DATE()
	ENDIF 
	DO case
		CASE lnTipoDatFecM=1		&&& periodo 202201
			lnRetornaDiaMes=SUBSTR(DTOS(ldFecmiFecM),1,6)
		CASE lnTipoDatFecM=2		&&& primer dia del mes
			lnRetornaDiaMes=DATE(YEAR(ldFecmiFecM),MONTH(ldFecmiFecM),1)
		CASE lnTipoDatFecM=3		&&& ultimo dia del mes
			lnRetornaDiaMes=GOMONTH(ldFecmiFecM,1)-DAY(GOMONTH(ldFecmiFecM,1))
		CASE lnTipoDatFecM=4		&&& restar x meses ala fecha actual y retornar el ultimo de mes (lnMenosMeses= a cantidad de meses a restar)
			lnRetornaDiaMes=GOMONTH(ldFecmiFecM,(lnMenosMeses*-1)+1)-DAY(GOMONTH(ldFecmiFecM,(lnMenosMeses*-1)+1))
		CASE lnTipoDatFecM=5		&&& siguiente DIA
			lnRetornaDiaMes=ldFecmiFecM+1
		CASE lnTipoDatFecM=6		&&& siguiente semana
			lnRetornaDiaMes=ldFecmiFecM+7
		CASE lnTipoDatFecM=7		&&& siguiente catorcena
			lnRetornaDiaMes=ldFecmiFecM+14
		CASE lnTipoDatFecM=8		&&& siguiente mes
			lnMenosMeses=1
			lnRetornaDiaMes=GOMONTH(ldFecmiFecM,(lnMenosMeses)+1)-DAY(GOMONTH(ldFecmiFecM,(lnMenosMeses)+1))
			lnDiadelmes=DAY(ldFecmiFecM)
			lnanodelmes=YEAR(lnRetornaDiaMes)
			lnmesdelmes=MONTH(lnRetornaDiaMes)
			DO WHILE .t.
				IF !EMPTY(DATE(lnanodelmes,lnmesdelmes,lndiadelmes))
					lnRetornaDiaMes=DATE(lnanodelmes,lnmesdelmes,lndiadelmes)
					EXIT 
				ELSE
					lnDiadelmes=lnDiadelmes-1
				ENDIF 
			ENDDO
		CASE lnTipoDatFecM=9		&&& restar x meses ala fecha actual y retornar el mismo dia de la fecha original
			lnRetornaDiaMes=GOMONTH(ldFecmiFecM,lnMenosMeses) 	
	ENDCASE 

	RETURN lnRetornaDiaMes
ENDFUNC 



FUNCTION ObtenerDiasHabiles(ldfecin,ledfecfin,lcdiano)
	lndi=0
	FOR i=1 TO (ledfecfin-ldfecin)+1
		lndi=lndi+IIF(INLIST(DOW(ldfecin+i-1),&lcdiano),0,1)
	ENDFOR 
	RETURN lndi
ENDFUNC 


FUNCTION ObtenerFechaFiltroAutomatico(lnfecfil)
	ldretfec=DATE()
	DO case
		CASE lnfecfil=1
			ldretfec=DATE()
		CASE lnfecfil=2
			ldretfec=ObtenerDatosdeSemana(DATE(),2,0)
		CASE lnfecfil=3
			ldretfec=ObtenerDatosdeMes(DATE(),2,0)
	ENDCASE 
	RETURN ldretfec
ENDFUNC 


FUNCTION CalcularFechaVencimientoSegunParametro(ldFecFac,lnDiasCred)
	ldFecVEncinuew=ldFecFac
	IF !EMPTY(ldFecFac)
		newfecha=IIF(DAY(ldFecFac)>=pnDiaVencimiento,ObtenerDatosdeMes(ldFecFac,3)+1,ObtenerDatosdeMes(ldFecFac,2))

		IF !EMPTY(ldFecFac)
			ldFecVEncinuew=IIF(pnVencimientoFijo=0,ldFecFac+lnDiasCred,;
											IIF(pnVencimientoFijo=1,ObtenerDatosdeMes(ldFecFac,3,0),;
											IIF(pnVencimientoFijo=2,ObtenerDatosdeMes(ObtenerDatosdeMes(ldFecFac,8),2),;
											ObtenerDatosdeMes(newfecha,2)+pnDiaVencimiento-1)))
			
			***** validando que el dia sea un dia abierto del negocio
			DO WHILE .T.
				lnevaluddia=.f.
				lcdiavencsemana=ALLTRIM(STR(DOW(ldFecVEncinuew)))
				lccomandovalidafecha="lnevaluddia=INLIST("+lcdiavencsemana+","+pcDiasAbiertos+")"
				&lccomandovalidafecha
				IF lnevaluddia=.t.
					EXIT
				ELSE
					ldFecVEncinuew=ldFecVEncinuew+1
				ENDIF		
			ENDDO 
		ENDIF 
	ENDIF 
	RETURN ldFecVEncinuew
ENDFUNC 

