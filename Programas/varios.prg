FUNCTION FechaPuntodeVentaNodo(lnidsqlidconec as Integer,lcnodotmp AS Character,ldfecptvatmp as Date,lnTurnoActivo as integer ,lnPuntoVtaEstacion as Integer)
	IF PCOUNT( )<=2
		ldfecptvatmp=DATE()
	ENDIF 
	IF PCOUNT( )<=4
		lnPuntoVtaEstacion=0
	ENDIF 
	IF PCOUNT( )<=3
		lnTurnoActivo=IIF(NVL(pnTurno,0)=0,1,pnTurno)
	ENDIF
	****pcCorreosAutoriza,pcSitioWebAutoriza
	IF TYPE("lcnodotmp")<>"C"
		lcnodotmp=ALLTRIM(STR(lcnodotmp))
	ENDIF 
	lcaliasparaautoriza=ALIAS()
	
	IF lnidsqlidconec<>0
		
		IF pnTipoConeccion=1	&&& usando coneccion Nativa local
			USE pcSysDir+pcdb+"\siscata" IN 0 SHARED AGAIN ALIAS c_sisParaAuto
			lcmitabla=' c_sisParaAuto '
		ELSE
			lcmitabla=' siscata '
		ENDIF 

		IF pnEsGasolinera=1
			***** fecha corte punto de venta		tipo=turno / idpadre=punto de venta
			lcComandoBuscarCta="SELECT * FROM "+lcmitabla+" where cod='"+lcnodotmp+"' and origen='FEC' and idpadre="+ALLTRIM(STR(lnPuntoVtaEstacion))
			lnCtrlSqlCtaBus=miSQLEXEC(lnidsqlidconec,lcComandoBuscarCta,"c_BuscaParametrosAutorizacion")
			pnTurno=IIF(NVL(c_BuscaParametrosAutorizacion.tipo,0)=0,1,c_BuscaParametrosAutorizacion.tipo)
			lnTurnoActivo=pnTurno
 		ELSE
 			***** fecha corte punto de venta
			lcComandoBuscarCta="SELECT * FROM "+lcmitabla+" where cod='"+lcnodotmp+"' and origen='FEC' "
			lnCtrlSqlCtaBus=miSQLEXEC(lnidsqlidconec,lcComandoBuscarCta,"c_BuscaParametrosAutorizacion")
			pnTurno=1
			lnTurnoActivo=1
 		ENDIF 
 		
		IF RECCOUNT()=0
			lnidreg=_SiguienteIdTabla(pcNodo,"MAS")
			lccodunico=UPPER(PC_USER(2))+SYS(3)
			ldfecmod=DATETIME()
			ldfecptvatmp=IIF(EMPTY(ldfecptvatmp),DATE(),ldfecptvatmp)
			IF pnEsGasolinera=1
				INSERT INTO c_sisParaAuto (id,origen,cod,nombre,tipo,idpadre,notas,status,fecalta,fecmod,nodo,iduser,pcuser) ;
						VALUES (lnidreg,'FEC',lcnodotmp,DTOC(ldfecptvatmp),lnTurnoActivo,lnPuntoVtaEstacion,'',1,ldfecmod,ldfecmod,pcnodo,pnidusuario,SYS(0))
			ELSE
				INSERT INTO c_sisParaAuto (id,origen,cod,nombre,tipo,notas,status,fecalta,fecmod,nodo,iduser,pcuser) ;
						VALUES (lnidreg,'FEC',lcnodotmp,DTOC(ldfecptvatmp),0,'',1,ldfecmod,ldfecmod,pcnodo,pnidusuario,SYS(0))
			ENDIF 
			pdFechaPTV=ldfecptvatmp
			
		ELSE
			
			IF EMPTY(CTOD(c_BuscaParametrosAutorizacion.nombre))
				pdFechaPTV=ldfecptvatmp
				IF pnEsGasolinera=1
					FechaPuntodeVentaNodoGuardar(1,lcnodotmp,ldfecptvatmp,lnTurnoActivo,lnPuntoVtaEstacion)
				ELSE
					FechaPuntodeVentaNodoGuardar(1,lcnodotmp,ldfecptvatmp)
				ENDIF 
			ELSE 
				pdFechaPTV=CTOD(c_BuscaParametrosAutorizacion.nombre)
			ENDIF 
		ENDIF 
			
		USE IN c_BuscaParametrosAutorizacion
		IF USED("c_sisParaAuto")
			USE IN c_sisParaAuto
		ENDIF  
	ENDIF 
	

	IF !EMPTY(lcaliasparaautoriza)
		SELECT (lcaliasparaautoriza)
	ENDIF 
	
	RETURN pdFechaPTV
ENDFUNC 

