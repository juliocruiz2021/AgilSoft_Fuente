	ENDIF 
	SUM ALL Interes  TO lnTotInteres
	IF !EMPTY(lcAliasMaca)
		SELECT (lcAliasMaca)
	ENDIF 
	IF llRetorInt=.t.
		USE IN (lcCursorMacamor)
	ENDIF 
	 
	RETURN lnTotInteres
ENDFUNC 



FUNCTION _CalcularDebeSerExacto(lnMon,lnTipPag,lnIntMens,lnCuot,ldFecPresta,lcCursorMacamor,lnidptmo,lccli,lctip,lnpla,llRetorInt)
	lcAliasMaca=ALIAS()
	
	lnMiCPres=_CalcularcuotaPrestamoExacto(lnMon,lnTipPag,lnIntMens,lnCuot)
	
	IF EMPTY(NVL(lcCursorMacamor,""))
		lcCursorMacamor="c_Macamor"
	ENDIF 
	
	IF EMPTY(ldFecPresta)
		ldFecPresta=DATE()
	ENDIF 
	
	CREATE CURSOR (lcCursorMacamor) (Monto n(16,2),cuota i,fechaCuota d,dias i,IntDiario n(16,8),Interes n(16,2),capital n(16,2),;
					cuotaPago n(16,2), saldo n(16,2), id i, cli c(250),tip c(200),pla n(16,2),fecini d)
	lnSaldo=lnMon
	ldFecIni=ldFecPresta
	FOR i=1 TO lnCuot
		ldFecFin=ObtenerDatosdeMes(ldFecIni,lnTipPag+4,0)
		*lnNewInt=_CalcularInteresCuota(lnSaldo,lnTipPag,lnIntMens)
		lnNewInt=_CalcularInteresExacto(lnSaldo,lnIntMens,ldFecIni,ldFecFin)
		
		INSERT INTO (lcCursorMacamor) ;
			VALUES (lnMon,i,ldFecFin,ldFecFin-ldFecIni,;
					ROUND((lnNewInt+0.00000000)/(ldFecFin-ldFecIni),8),lnNewInt,lnMiCPres-lnNewInt,;
					lnMiCPres,lnMon-(lnMiCPres-lnNewInt),lnIdPtmo,lccli,lctip,lnpla,ldfecpresta)
		
		lnSaldo=ROUND(lnMon-(lnMiCPres-lnNewInt),2)
		lnMon=lnSaldo
		ldFecIni=ldFecFin
		
	ENDFOR 
	IF saldo<>0
		lnNewCuota=monto+Interes
		lnNewcap=monto
	
		REPLACE capital WITH lnNewcap, cuotapago WITH lnNewCuota, saldo WITH 0 NEXT 1
	ENDIF 
	SUM ALL Interes  TO lnTotInteres
	IF !EMPTY(lcAliasMaca)
		SELECT (lcAliasMaca)
	ENDIF 
	IF llRetorInt=.t.
		USE IN (lcCursorMacamor)
	ENDIF 
	RETURN lnTotInteres
ENDFUNC 


FUNCTION _CalcularcuotaPrestamo(lnmiMonto,lnmiTipoCuota,lnmiInteres,lnmiCuotas)
	lnmonto=lnmiMonto
	lnTipoCuotas=lnmiTipoCuota
	lnCantidadAbonosMensuales=IIF(lnTipoCuotas=1,30,IIF(lnTipoCuotas=2,4,IIF(lnTipoCuotas=3,2,1)))
	lncuotas=lnmiCuotas
	lnint=lnmiInteres/100/lnCantidadAbonosMensuales

	lnCuotaPrestamo=payment(lnmonto,lnint,lncuotas)
	
	RETURN ROUND(lnCuotaPrestamo,2)
ENDFUNC 


FUNCTION _CalcularcuotaPrestamoExacto(lnmiMonto,lnmiTipoCuota,lnmiInteres,lnmiCuotas)
	lnmonto=lnmiMonto
	lnTipoCuotas=lnmiTipoCuota
	lnCantidadAbonosMensuales=IIF(lnTipoCuotas=1,30,IIF(lnTipoCuotas=2,4,IIF(lnTipoCuotas=3,2,1)))
	lncuotas=lnmiCuotas
	lnint=lnmiInteres/100/lnCantidadAbonosMensuales

	*lnCuotaPrestamo=payment(lnmonto,lnint,lncuotas)
	lnCuotaPrestamo=(lnmonto*lnint)/(1-(1+lnint)^(-lncuotas))
	
	RETURN ROUND(lnCuotaPrestamo,2)
ENDFUNC 


FUNCTION _CalcularInteresCuotaNew(lnmiMonto,lnmiTipoCuota,lnmiInteresMensual)
	lnPIntMensual=lnmiInteresMensual
	lnmonto=lnmiMonto
	lnTipoCuotas=lnmiTipoCuota
	lnCuoasenelMes=IIF(lnTipoCuotas=1,30,IIF(lnTipoCuotas=2,4,IIF(lnTipoCuotas=3,2,1)))
	lnint=lnPIntMensual/lnCuoasenelMes/100

	lnInteresActual=ROUND(lnmonto*lnint,2)
	
	RETURN ROUND(lnInteresActual,2)
ENDFUNC 


FUNCTION _CalcularInteresCuota(lnmiMonto,lnmiTipoCuota,lnmiInteres)
	lnPIntDiario=((lnmiInteres+0.000000)*12)/365
	lnmonto=lnmiMonto
	lnTipoCuotas=lnmiTipoCuota
	lnDiasaCalcular=IIF(lnTipoCuotas=1,1,IIF(lnTipoCuotas=2,7,IIF(lnTipoCuotas=3,15,30)))
	lnint=lnPIntDiario*lnDiasaCalcular/100

	lnInteresActual=ROUND(lnmonto*lnint,2)
	
	RETURN ROUND(lnInteresActual,2)
ENDFUNC 

FUNCTION _CalcularInteresCuotaMensual(lnmiMonto,lnmiTipoCuota,lnmiInteresMensual,lndiasmes,ldfec01,ldfec02)
	*lnPIntDiario=((lnmiInteres+0.000000)*12)/365
	lnmonto=lnmiMonto
	lnTipoCuotas=lnmiTipoCuota
	*lnDiasaCalcular=IIF(lnTipoCuotas=1,30,IIF(lnTipoCuotas=2,7,IIF(lnTipoCuotas=3,15,1)))
	lnDiasaCalcular=IIF(lnTipoCuotas=1,1,IIF(lnTipoCuotas=2,7,IIF(lnTipoCuotas=3,15,30)))
	*lnint=(((lnmiInteresMensual*lnmonto)/30)/100)*lnDiasaCalcular
	lnInteresActual=(((lnmiInteresMensual*lnmonto)/30)/100)*lnDiasaCalcular

	*lnInteresActual=ROUND(lnmonto*lnint,2)
	
	IF lndiasmes<>0		&&& si viene dias se calcula en base a la fecha los intereses
		
	ENDIF 
	
	RETURN ROUND(lnInteresActual,2)
ENDFUNC 


FUNCTION _CalcularInteresExacto(lnmiMonto,lnmiInteres,ldFecInisal,ldFecFinsal)
	*** lnmiMonto = capital a calcular ,lnmiInteres= interes mensual, ldFecInisal= fecha inicial, ldFecFinsal= Fecha final
	
	lnmonto=lnmiMonto
	lnDiasAno=IIF(INT(YEAR(ldFecFinsal)/4)=(YEAR(ldFecFinsal)/4),366,365)	&&& CALCULANDO DIAS DEL AÑO
	lnIntdiario=(((lnmiInteres+0.000000)*12)/lnDiasAno/100)
	lnDiasaCalcular=ABS(ldFecFinsal-ldFecInisal)

	lnInteresReal=ROUND(lnmonto*(lnIntdiario*lnDiasaCalcular),2)
	
	RETURN ROUND(lnInteresReal,2)
ENDFUNC 


FUNCTION _calularCuotaActualYDatosPrestamo(lnidPtmocuota,lnCuotaPagar,ldFechaPagoActual)
	lcaliasptmo=ALIAS()
	IF !used("finPrestamos")
		USE pcSysDir+pcDB+"\finPrestamos" IN 0 SHARED AGAIN 
		llCerrarPrestamos=.t.
	ELSE
		llCerrarPrestamos=.f.
	ENDIF 
	IF !used("finSolicitudes")
		USE pcSysDir+pcDB+"\finSolicitudes" IN 0 SHARED AGAIN 
		llCerrarSolicitudes=.t.
	ELSE
		llCerrarSolicitudes=.f.
	ENDIF 
	IF !used("finTipoPrestamos")
		USE pcSysDir+pcDB+"\finTipoPrestamos" IN 0 SHARED AGAIN 
		llCerrarTipoPrestamos=.t.
	ELSE
		llCerrarTipoPrestamos=.f.
	ENDIF
	
	IF lnidPtmocuota<>0
		SELECT a.*,b.plazo,c.tipopago,c.diasgracia ;
			FROM finPrestamos a ;
				INNER JOIN finSolicitudes b ON a.idptmo=b.idptmo ;
				INNER JOIN finTipoPrestamos c ON a.idtipoPtmo=c.idtipoPtmo ;
			WHERE a.idptmo=lnidPtmocuota INTO CURSOR c_PtemocuotaCuotas READWRITE 

		lnmon=c_PtemocuotaCuotas.monto
		lntpa=c_PtemocuotaCuotas.tipoCuotas
		lniitn=c_PtemocuotaCuotas.pintereses
		ldfecc=c_PtemocuotaCuotas.fechadesembolso
		lcCursorMacamor="c_CuotasDebeSer"
		lnpla=c_PtemocuotaCuotas.cuotas
		
		*_CalcularDebeSerExacto(lnMon,lntpa,lniitn,lnpla,ldfecc,lcCursorMacamor,lnidPtmocuota,"","",lnpla,.f.)
		_CalcularDebeSerMensual(lnMon,lntpa,lniitn,lnpla,ldfecc,lcCursorMacamor,lnidPtmocuota,"","",lnpla,.f.)
 		
		SELECT c_CuotasDebeSer
		DELETE ALL FOR cuota<>lnCuotaPagar
 		RECALL FOR saldo=0 AND saldopen>0		&&&& el prestamo tiene saldo hay que seguir pagando cuotas

 	
		SELECT a.*,c.tipoPtmo,c.intereses,c.gastos,c.mora,c.comision,c.pmora,c.diasgracia, ;
				b.monto as MontoPrestamo,b.abonos,b.tipoCuotas,b.cuotas,b.valorcuotas,;
				b.fechaultimopago,b.cuotaultimopago,b.fechaultimocalculoInt ;
			FROM c_CuotasDebeSer a ;
				INNER JOIN finPrestamos b ON b.idptmo=lnidPtmocuota ;
				INNER JOIN finTipoPrestamos c ON b.idtipoPtmo=c.idTipoPtmo ;
			WHERE b.idptmo=lnidPtmocuota INTO CURSOR c_PtemocuotaCuotas READWRITE 
		SELECT c_CuotasDebeSer
		RECALL all
		GO top
		***** obteniendo el saldo del prestamo en base a la fecha de abono actual
		lnMiSaldo=0
		lnDiasNuevo=0
		SCAN all
			
			IF fechacuota<=ldFechaPagoActual OR cuota=lnCuotaPagar
				lnMiSaldo=saldo
				lnDiasNuevo=dias
			ELSE
				EXIT 
			ENDIF 
		ENDSCAN 
		
		USE IN c_CuotasDebeSer
		

		SELECT c_PtemocuotaCuotas
		GO TOP
		*REPLACE saldo WITH lnMiSaldo,dias WITH lnDiasNuevo NEXT 1
		REPLACE saldo WITH lnMiSaldo NEXT 1
		
	ENDIF 
	
	IF llCerrarSolicitudes=.t.
		USE IN finSolicitudes
	ENDIF 
	
	IF llCerrarTipoPrestamos=.t.
		USE IN finTipoPrestamos
	ENDIF
	
	IF llCerrarPrestamos=.t.
		USE IN finPrestamos
	ENDIF
	
	IF !EMPTY(lcaliasptmo)
		SELECT (lcaliasptmo)
	ENDIF 
ENDFUNC 


FUNCTION _calularCuotaActual(lnidPtmocuota,lnCuotaPagar)
	lcaliasptmo=ALIAS()
	
	IF lnidPtmocuota<>0
		SELECT a.*,b.plazo FROM finPrestamos a INNER JOIN finSolicitudes b ON a.idptmo=b.idptmo;
				WHERE a.idptmo=lnidPtmocuota INTO CURSOR c_PtemocuotaCuotas READWRITE 
		lnmon=c_PtemocuotaCuotas.monto
		lntpa=c_PtemocuotaCuotas.tipoCuotas
		lniitn=c_PtemocuotaCuotas.pintereses
		ldfecc=c_PtemocuotaCuotas.fechadesembolso
		lcCursorMacamor="c_CuotasDebeSer"
		lnpla=c_PtemocuotaCuotas.plazo
		
		*_CalcularDebeSer(lnMon,lntpa,lniitn,lnpla,ldfecc,lcCursorMacamor,lnidPtmocuota,"","",lnpla,.f.)
		_CalcularDebeSerMensual(lnMon,lntpa,lniitn,lnpla,ldfecc,lcCursorMacamor,lnidPtmocuota,"","",lnpla,.f.)
		
		
