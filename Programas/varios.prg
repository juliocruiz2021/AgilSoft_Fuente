FUNCTION EnviaraExcelCompas(lcOpcion,lctablaxls)
	**** lcOpcion  Existencias,Existencias_Suc,Existencias_Suc_Bod,Ventas_Producto_Controlado etc
	**** lnNumColum    (numero de Columnas del Select)
	**** lcCurEstFin    (Cursor de donde se tomaran los Datos)
	**** lcTitFechaEstFin (titulo para la Fecha del Reporte Eje. del 1 al 31 de Agosto de 2018)
	IF !EMPTY(lcTablaxls)
		SELECT (lcTablaxls)
		GO top
	ENDIF 
	
	Local oExcel
	oExcel = Createobject("Excel.Application")

	#DEFINE xlCenter -4108
	#UNDEFINE xlTop
	#DEFINE xlTop -4160	
	#DEFINE xlRight -4152

	With oExcel
		.WorkBooks.Add
		xlsheet = .ActiveSheet
		IF TYPE('codclipro')='C'
			lnconclipro=1
		ELSE
			lnconclipro=2
		ENDIF 

		***** ANCHO DE LAS COLUMNAS
		WITH xlsheet
			.COLUMNS("A:A").ColumnWidth = 12.00
			.COLUMNS("B:B").ColumnWidth = 40.00
			.COLUMNS("C:C").ColumnWidth = 10.00
			.COLUMNS("D:D").ColumnWidth = 15.00
			.COLUMNS("E:E").ColumnWidth = 15.00
			.COLUMNS("F:F").ColumnWidth = 15.00
			.COLUMNS("A:A").NumberFormat = "@"
			.COLUMNS("B:B").NumberFormat = "@"
			.COLUMNS("C:C").NumberFormat = "@"
			.COLUMNS("D:D").NumberFormat = "#,##0.0000"
			.COLUMNS("E:E").NumberFormat = "#,##0.00"
			.COLUMNS("F:F").NumberFormat = "#,##0.00"
			IF lnconclipro=1
				.COLUMNS("G:G").ColumnWidth = 15.00
				.COLUMNS("G:G").NumberFormat = "@"
			ENDIF 
			
		ENDWITH
		IF lnconclipro=1
			lcRango1='Range("A1:G1")'
			lcRango2='Range("A2:G2")'
			lcRango3='Range("A4:G4")'
			lncolrep=7
		ELSE
			lcRango1='Range("A1:F1")'
			lcRango2='Range("A2:F2")'
			lcRango3='Range("A4:F4")'
			lncolrep=6
		ENDIF 
		lnFila= 1


		***** ENCABEZADO DEL ARCHIVO
		xlsheet.Cells(lnFila,1).Value = ALLTRIM(pcNomEmpresa)
		* xlsheet.&lcRango1
		IF lnconclipro=1
			WITH xlsheet.Range("A1:G1")
				.Font.Bold = 'True'
				.Font.ColorIndex = 11
				.Font.Size = '18'
				.WrapText = 'False'
				.Merge
				.HorizontalAlignment = xlCenter
				.VerticalAlignment = xlTop
			ENDWITH
		ELSE
			WITH xlsheet.Range("A1:F1")
				.Font.Bold = 'True'
				.Font.ColorIndex = 11
				.Font.Size = '18'
				.WrapText = 'False'
				.Merge
				.HorizontalAlignment = xlCenter
				.VerticalAlignment = xlTop
			ENDWITH
		ENDIF 
		lnFila= lnFila+ 1
		
		xlsheet.Cells(lnFila,1).Value = alltrim(pcTitulo)+'  Del '+dtoc(pdFecIni)+'   Al '+dtoc(pdFecFin)
		
		IF lnconclipro=1
			WITH xlsheet.Range("A2:G2")
				.Font.Bold = 'True'
				.Font.Size = '14'
				.WrapText = 'False'
				.Merge     
