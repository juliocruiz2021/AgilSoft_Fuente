FUNCTION EscapeJsonString(tcString)
    LOCAL lcEscapedString
    lcEscapedString = tcString
    
    * Escapar comillas dobles
    lcEscapedString = STRTRAN(lcEscapedString, '"', '\"')
    * Escapar barra invertida
    lcEscapedString = STRTRAN(lcEscapedString, '\', '\\')
    * Escapar barra de avance
    lcEscapedString = STRTRAN(lcEscapedString, CHR(12), '\f')
    * Escapar nueva línea
    lcEscapedString = STRTRAN(lcEscapedString, CHR(10), '\n')
    * Escapar retorno de carro
    lcEscapedString = STRTRAN(lcEscapedString, CHR(13), '\r')
    * Escapar tabulador
    lcEscapedString = STRTRAN(lcEscapedString, CHR(9), '\t')
    * Escapar retroceso
    lcEscapedString = STRTRAN(lcEscapedString, CHR(8), '\b')
	
    * Manejo de caracteres especiales
    FOR i = 0 TO 31
        lcEscapedString = STRTRAN(lcEscapedString, CHR(i), '\u'+PADL(TRANSFORM(i, "@0"), 4, "0"))
    ENDFOR

    RETURN lcEscapedString
ENDFUNC




FUNCTION CadaPrimeraMayuscula(tcString)
    LOCAL lnLength, lcResult, lcChar, lNewWord, i
    lnLength = LEN(tcString)
    lcResult = ""
    lNewWord = .T.
    
    * Convertimos la cadena a minúsculas
    tcString = LOWER(tcString)
    
    FOR i = 1 TO lnLength
        lcChar = SUBSTR(tcString, i, 1)
        
        IF lNewWord AND ISALPHA(lcChar)
            * Convertimos la primera letra de la palabra a mayúscula
            lcChar = UPPER(lcChar)
            lNewWord = .F.
        ELSE
            IF lcChar = " "
                lNewWord = .T.
            ENDIF
        ENDIF
        
        lcResult = lcResult + lcChar
    ENDFOR
    
    RETURN lcResult
ENDFUNC


FUNCTION PrimeraMayuscula(tcString)
    LOCAL lnLength, lcResult, lcChar, lNewWord, i
    lnLength = LEN(tcString)
    lcResult = ""
    lNewWord = .T.
    
    * Convertimos la cadena a minúsculas
    tcString = LOWER(tcString)
    tcString =UPPER(SUBSTR(tcString,1,1))+SUBSTR(tcString,2,lnLength)
    
    RETURN tcString
ENDFUNC



FUNCTION ValidarDUI
    PARAMETERS cDUI
    LOCAL lnSuma, lnMultiplicador, lnDigitoVerificador, i, lnResto, lnVerificadorCalculado
    
    cDUI=ALLTRIM(NVL(cDUI,SPACE(9)))
    cDUI2=cDUI
   
    IF !EMPTY(cDUI)
    	cDUI=PADL(SoloNumeros(ALLTRIM(cDUI2)),9,'0')
	    cDUI=SUBSTR(cDUI,1,8)+'-'+SUBSTR(cDUI,9,1)
	    
	    * El formato debe ser 00000000-0
	    IF NOT BETWEEN(LEN(cDUI), 10, 10)
	        RETURN ''
	    ENDIF

	    * Los primeros 8 caracteres deben ser dígitos
	    IF NOT ISDIGIT(SUBSTR(cDUI, 1, 8))
	        RETURN ''
	    ENDIF

	    * El noveno carácter debe ser un guion
	    IF SUBSTR(cDUI, 9, 1) <> "-"
	        RETURN ''
	    ENDIF

	    * El décimo carácter debe ser un dígito
	    IF NOT ISDIGIT(SUBSTR(cDUI, 10, 1))
	        RETURN ''
	    ENDIF

	    lnSuma = 0
	    lnMultiplicador = 9

	    FOR i = 1 TO 8
	        lnSuma = lnSuma + (VAL(SUBSTR(cDUI, i, 1)) * lnMultiplicador)
	        lnMultiplicador = lnMultiplicador - 1
	    ENDFOR

	    lnResto = MOD(lnSuma, 10)
	    lnVerificadorCalculado = 10 - lnResto
	    IF lnVerificadorCalculado = 10
	        lnVerificadorCalculado = 0
	    ENDIF

	    lnDigitoVerificador = VAL(SUBSTR(cDUI, 10, 1))

	    IF lnVerificadorCalculado = lnDigitoVerificador
	        cDUI=PADL(SoloNumeros(ALLTRIM(cDUI2)),9,'0')
	        cDUI=SUBSTR(cDUI,1,8)+'-'+SUBSTR(cDUI,9,1)
	    ELSE
	        cDUI=''
	    ENDIF
	ELSE
		cDUI=''
	ENDIF 
    RETURN cDUI
ENDFUNC




