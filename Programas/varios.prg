FUNCTION _listarImagenes(lcMiRuta)
	LOCAL oNombresImagenes
	oNombresImagenes = CREATE("Custom")
	oNombresImagenes.AddProperty('CantidadImagenes')
	oNombresImagenes.AddProperty('imagenActual')
	oNombresImagenes.AddProperty('NombreImagen')
	oNombresImagenes.imagenActual=0
	


	IF !EMPTY(lcMiRuta)
		IF right(lcMiRuta,1)<>'\'
			lcMiRuta=lcMiRuta+'\'
		ENDIF 
		lcDirFotos=lcMiRuta
	ELSE 
		lcDirFotos=GETDIR()
	ENDIF 
	
	IF !EMPTY(lcDirFotos)
		lnCantidadArchivos=ADIR(laArchivos,lcDirFotos+'*.jp?')
		IF NVL(lnCantidadArchivos,0)>0
			oNombresImagenes.AddProperty('aImagenes[lnCantidadArchivos,2]')
			FOR i=1 TO lnCantidadArchivos
				oNombresImagenes.aImagenes(i,1)=laArchivos(i,1)
				oNombresImagenes.aImagenes(i,2)=.f.
			ENDFOR 
			oNombresImagenes.CantidadImagenes=lnCantidadArchivos
			oNombresImagenes.imagenActual=1
		ENDIF 
	ENDIF 
	IF TYPE("oNombresImagenes.CantidadImagenes")='L'
		oNombresImagenes.CantidadImagenes=0
	ENDIF 
	SET DEFAULT TO (pcSysDir)
	RETURN oNombresImagenes
	
ENDFUNC 




